],[1,"col-lg-12","mt-lg-5","mt-2"],[1,"screen-reader",3,"innerHtml"]],template:function(e,i){1&e&&(Me(0,"app-navigation"),s(1,"div",0)(2,"div",1)(3,"div",2)(4,"div",3)(5,"div",4),Me(6,"img",5),a()(),s(7,"div",6)(8,"h2",7),c(9,"About the Ministry"),a(),s(10,"p"),c(11," The Ministry of Mines is responsible for the formulation and administration of policies, laws and regulations relating to the exploration, development, conservation and sustainable utilisation of the country's mineral resources, excluding petroleum, natural gas, coal and atomic minerals. The Ministry plays a pivotal role in ensuring the scientific and responsible development of India's mineral sector to support economic growth, industrial development and national resource security. "),a(),s(12,"p"),c(13," The Ministry oversees the implementation of the Mines and Minerals (Development and Regulation) Act, 1957 and other key legislations governing the mining sector. It is responsible for policy formulation, mineral concession framework, auction of mineral blocks, royalty-related matters, sustainable mining practices, and coordination with State Governments on mineral development. "),a(),s(14,"p"),c(15," The Ministry promotes systematic geological mapping and mineral exploration through its attached and subordinate organizations, facilitates scientific research and technological innovation, supports mineral processing and recycling initiatives, and encourages private sector participation in exploration. It also focuses on strengthening exploration of strategic and critical minerals, promoting circular economy practices, and advancing research through dedicated Science & Technology programmes "),a(),s(16,"p"),c(17," The Ministry exercises administrative oversight over key organizations and Central Public Sector Enterprises in the mining and non-ferrous metals sector, including the Geological Survey of India, Indian Bureau of Mines, Mineral Exploration and Consultancy Limited, National Mineral Exploration and Development Trust, National Aluminium Company Limited and Hindustan Copper Limited. "),a(),s(18,"p"),c(19,"The Ministry also fosters international cooperation in the mining sector through bilateral and multilateral partnerships, promotes overseas mineral asset acquisition, facilitates critical mineral security initiatives, and works closely with stakeholders to enhance transparency, investment, innovation and ease of doing business in the mineral sector."),a(),s(20,"p"),c(21," Committed to the vision of Atmanirbhar Bharat and sustainable resource management, the Ministry of Mines strives to ensure the efficient, transparent and environmentally responsible development of India's mineral wealth for the benefit of present and future generations. "),a()(),s(22,"div",8),Me(23,"p",9),a()()()()),2&e&&(f(23),te("innerHtml",i.contentService.decodeHtml("Hindi"==i.language&&""!=i.aboutSnipetHinid?i.aboutSnipetHinid:i.aboutSnipet),ht))},dependencies:[en]}),t})(),aB=(()=>{class t{constructor(){}ngOnInit(){}}return t.\u0275fac=function(e){return new(e||t)},t.\u0275cmp=wt({type:t,selectors:[["app-national-mineral-scenario"]],decls:819,vars:0,consts:[[1,"inner-section"],[1,"container","screen-reader"],[1,"mt-4"],[1,"text-center"],[1,"m-0"],["src","assets/img/mineral-production/index-mineral-production.png","alt","Mineral production chart","height","300px;"],[1,"row"],[1,"col-lg-8","mb-lg-0","mb-3"],["src","assets/img/mineral-production/index-mineral-production3.png","alt","Value of Minerals Production ","height","300px;"],[1,"col-lg-4"],["src","assets/img/mineral-production/index-mineral-production2.png","alt","Value of Minerals Production ","height","300px;"],[1,"text-center","mb-4"],[1,"table-responsive"],[1,"table","table-bordered","table-striped"],[1,"table-warning"],["rowspan","2","width","300px","valign","top"],["colspan","2"],[1,"d-block","text-center"],[1,"text-center","mt-4"],["scope","col"],[1,"text-end"],["scope","col",1,"text-end"],[1,"mt-0","mb-3","alert","d-block","alert-warning","d-block","p-2"],["src","assets/img/mineral-production/index-mineral-production5.png","alt","Value of Minerals Production ","height","300px"],["rowspan","2","scope","col",1,"align-middle"],["colspan","2","scope","col",1,"align-middle","text-center"],["colspan","","scope","col","rowspan","2",1,"align-middle"],["scope","col",1,"align-middle"],[1,"align-middle"],["colspan","6","scope","col",1,"text-white"],["colspan","6",1,"text-white"],[1,"table","table-striped","table-bordered"],[1,"align-middle","table-warning"],["colspan","5",1,"text-white"],["src","assets/img/mineral-production/index-mineral-production6.png","alt","Value of Minerals Production "],["width","100%","src","assets/img/mineral-production/index-mineral-production7.png","alt","Value of Minerals Production ",1,"mb-5"],["width","100%","src","assets/img/mineral-production/index-mineral-production8.png","alt","Value of Minerals Production ",1,"mb-5"],["width","100%","src","assets/img/mineral-production/index-mineral-production9.png","alt","Value of Minerals Production ",1,"mb-5"],["width","100%","src","assets/img/mineral-production/index-mineral-production10.png","alt","Value of Minerals Production "]],template:function(e,i){1&e&&(Me(0,"app-navigation"),s(1,"div",0)(2,"div",1)(3,"p"),c(4,"Minerals are valuable natural resources being finite and non-renewable. They constitute the vital raw materials for many basic industries and are a major resource for development. The history of mineral extraction in India dates back to the days of the Harappan civilization. The wide availability of the minerals in the form of abundant rich reserves made it very conducive for the growth and development of the mining sector in India. "),a(),s(5,"p"),c(6," The country is endowed with huge resources of many metallic and non-metallic minerals. Mining sector is an important segment of the Indian economy. Since independence, there has been a pronounced growth in the mineral production both in terms of quantity and value. India produces as many as 95 minerals, which includes fuel, metallic, non-metallic, atomic and minor minerals (including building and other materials). "),a(),s(7,"h5",2),c(8,"Mineral Production"),a(),s(9,"p"),c(10," The base year for the Index of Industrial Production (IIP) covering the mining sector is currently set to 2011-12. Based on the prevailing trends, the Index of Mineral Production (with 2011-12 as the base year) for the year 2023-24 is projected at 128.9, compared to 119.9 in the previous year. This reflects a positive growth rate of 7.51%, indicating a steady improvement in the mineral production performance during the period under review. The trend of index of mineral production is depicted in Figure 3.1. "),a(),s(11,"div",3)(12,"p",4)(13,"strong"),c(14," Figure 3.1 "),a()(),s(15,"p")(16,"strong"),c(17,"Index of mineral production (Base 2011-12 = 100) "),a()(),Me(18,"img",5),a(),s(19,"p"),c(20,"The provisional total value of mineral production (excluding atomic, fuel, and minor minerals) for 2023-24 is estimated to be \u20b9 1,41,239 crore, representing a growth of approximately 14.83% over the previous year\u2019s figure of 2022-23. "),a(),s(21,"p"),c(22,"The provisional value of metallic minerals during 2023-24 is estimated at \u20b9 1,27,599 crore, constituting 90.3% of the total value of mineral production. In comparison, the production of non-metallic minerals is valued at \u20b9 13,640 crore, accounting for 9.7% of the total value. These figures underscore the predominance of metallic minerals in the overall mineral production value for the year. "),a(),s(23,"p"),c(24,"Detailed mineral production data is provided in Annexure 3.1, while the details of mineral exports and imports for the period 2019-20 to 2023-24 (P) are given in Annexure 3.2 and Annexure 3.3. The trends in the value of mineral production, export, and import over the last five years are depicted in Figure 2.2. The value of minerals by group for the last five years is shown in Figure 3.3."),a(),s(25,"div",6)(26,"div",7)(27,"p",4)(28,"strong"),c(29," Figure 3.2 "),a()(),s(30,"p")(31,"strong"),c(32,"Value (in Rs\u2019Crore) of Minerals Production (by groups) (excluding atomic, fuel & minor minerals)"),a()(),Me(33,"img",8),a(),s(34,"div",9)(35,"p",4)(36,"strong"),c(37," Figure 3.3 "),a()(),s(38,"p")(39,"strong"),c(40,"Value of Mineral Export and Import "),a()(),Me(41,"img",10),a()(),Me(42,"div",11)(43,"div",3),s(44,"h5",2),c(45,"PRICE TREND "),a(),s(46,"p"),c(47,"The base year for the Wholesale Price Index (WPI) covering minerals is currently set as 2011-12. For the fiscal year 2023-24, the WPI for minerals (base year 2011-12 = 100) is reported at 217.7, an increase from 203.5 in the preceding year, 2022-23."),a(),s(48,"p"),c(49,"The minerals included in the Wholesale Price Index encompass bauxite, chromite, iron ore, copper concentrate, lead concentrate, garnet, zinc concentrate, manganese ore, limestone, phosphorite, and sillimanite. "),a(),s(50,"p"),c(51,"In the fiscal year 2023-24, the WPI for metallic minerals was recorded at 204.2, an increase from 191.7 in 2022-23. Conversely, the WPI for other minerals rose to 265.0 in 2023-24, up from 245.2 in 2022-23. For further details, please visit www.eaindustry.nic.in. "),a(),s(52,"h5",2),c(53,"GROSS VALUE ADDED FROM MINING & QUARRYING SECTOR"),a(),s(54,"p"),c(55,"The Gross Value Added (GVA) from the mining and quarrying sector is estimated by the National Accounts Division of the National Statistical Office under the Ministry of Statistics & Programme Implementation. According to the provisional estimates of National Income for 2023-24, the GVA for the mining and quarrying sector at 2011-12 prices is provisionally estimated at \u20b93,37,623 crore for the fiscal year 2023-24, reflecting a 7.1% increase compared to the First Revised Estimate (FRE) of \u20b93,15,256 crore for 2022-23. Similarly, the contribution of the mining and quarrying sector (at current prices) for 2023-24 is \u20b95,25,881 crore, which accounts for 1.97% of the total GVA.\xa0 "),a(),s(56,"h5",2),c(57,"MINING"),a(),s(58,"p"),c(59," The Indian mining industry is characterized by a significant number of small operational mines. In the fiscal year 2023-24, a provisional total of 2,036 mines reported Mineral Conservation and Development Rules (MCDR) returns for mineral production, which excludes atomic, fuel, and minor minerals. This figure marks a decrease from the provisional total of 2,070 mines reported in the previous fiscal year, 2022-23. In 2023-24, among the 2,036 reporting mines, the distribution across states was as follows: Madhya Pradesh accounted for the highest number with 394 mines, followed by Gujarat with 291 mines, Andhra Pradesh with 182 mines, Tamil Nadu with 222 mines, Karnataka with 177 mines, Odisha with 147 mines, Chhattisgarh with 139 mines, Rajasthan with 113 mines, Maharashtra with 110 mines, and Jharkhand with 67 mines. The numbers of mines reported MCDR Returns are given in Table 3.1. "),a(),s(60,"div",3)(61,"p",4)(62,"strong"),c(63," Table 3.1"),a()(),s(64,"p")(65,"strong"),c(66,"Number of Mines Reported MCDR Returns"),a()()(),s(67,"div",12)(68,"table",13),Me(69,"caption"),s(70,"thead")(71,"tr",14)(72,"th",15),c(73,"Mineral Type"),a(),s(74,"th",16),c(75,"Number of Mines reported"),a()(),s(76,"tr")(77,"th"),c(78,"2023-24(P)"),a(),s(79,"th"),c(80,"2022-23(P)"),a()()(),s(81,"tbody")(82,"tr")(83,"td"),c(84,"All MCDR Minerals"),a(),s(85,"td"),c(86,"2036 "),a(),s(87,"td"),c(88,"2070"),a()(),s(89,"tr")(90,"td"),c(91,"All MCDR Minerals"),a(),s(92,"td"),c(93,"795 "),a(),s(94,"td"),c(95,"817"),a()(),s(96,"tr")(97,"td"),c(98,"Non-Metallic Minerals"),a(),s(99,"td"),c(100,"1241 "),a(),s(101,"td"),c(102,"1253"),a()()()()(),s(103,"small",17),c(104,"Source: MCDR Returns; Data is Provisional"),a(),s(105,"div",18)(106,"p",4)(107,"strong"),c(108,"Table - 3.2"),a()(),s(109,"p")(110,"b"),c(111,"Area wise Distribution of Mining Leases* (Frequency in Hect.) (Other than Atomic, Hydro Carbons Energy & Minor Minerals) As on 31.03.2023 (P) (All India) "),a()()(),s(112,"div",12)(113,"table",13),Me(114,"caption"),s(115,"thead")(116,"tr",14)(117,"th",19),c(118," Frequency Group Area in Hects. "),a(),s(119,"th",19),c(120," Number of Mining Leases "),a(),s(121,"th",19),c(122," Percentage of total leases "),a(),s(123,"th",19),c(124,' Area in "000 Hects. '),a(),s(125,"th",19),c(126," Percentage of total area "),a()()(),s(127,"tbody")(128,"tr")(129,"td"),c(130," 0 to 2 "),a(),s(131,"td",20),c(132," 368 "),a(),s(133,"td",20),c(134," 12 "),a(),s(135,"td",20),c(136," 477.95 "),a(),s(137,"td",20),c(138," ++ "),a()(),s(139,"tr")(140,"td"),c(141," > 2 to 5 "),a(),s(142,"td",20),c(143," 809 "),a(),s(144,"td",20),c(145," 27 "),a(),s(146,"td",20),c(147," 3135.74 "),a(),s(148,"td",20),c(149," 1 "),a()(),s(150,"tr")(151,"td"),c(152," > 5 to 10 "),a(),s(153,"td",20),c(154," 353 "),a(),s(155,"td",20),c(156," 12 "),a(),s(157,"td",20),c(158," 2594.36 "),a(),s(159,"td",20),c(160," 1 "),a()(),s(161,"tr")(162,"td"),c(163," >10 to 20 "),a(),s(164,"td",20),c(165," 319 "),a(),s(166,"td",20),c(167," 11 "),a(),s(168,"td",20),c(169," 4661.15 "),a(),s(170,"td",20),c(171," 2 "),a()(),s(172,"tr")(173,"td"),c(174," >20 to 50 "),a(),s(175,"td",20),c(176," 388 "),a(),s(177,"td",20),c(178," 13 "),a(),s(179,"td",20),c(180," 12680.12 "),a(),s(181,"td",20),c(182," 4 "),a()(),s(183,"tr")(184,"td"),c(185," >50 to 100 "),a(),s(186,"td",20),c(187," 231 "),a(),s(188,"td",20),c(189," 7 "),a(),s(190,"td",20),c(191," 16707.48 "),a(),s(192,"td",20),c(193," 6 "),a()(),s(194,"tr")(195,"td"),c(196," >100 to 200 "),a(),s(197,"td",20),c(198," 182 "),a(),s(199,"td",20),c(200," 6 "),a(),s(201,"td",20),c(202," 26016.43 "),a(),s(203,"td",20),c(204," 9 "),a()(),s(205,"tr")(206,"td"),c(207," >200 to 500 "),a(),s(208,"td",20),c(209," 197 "),a(),s(210,"td",20),c(211," 7 "),a(),s(212,"td",20),c(213," 64146.87 "),a(),s(214,"td",20),c(215," 23 "),a()(),s(216,"tr")(217,"td"),c(218," Above 500 "),a(),s(219,"td",20),c(220," 160 "),a(),s(221,"td",20),c(222," 5 "),a(),s(223,"td",20),c(224," 151936.44 "),a(),s(225,"td",20),c(226," 54 "),a()()(),s(227,"tfoot")(228,"tr")(229,"th",19),c(230," Total "),a(),s(231,"th",21),c(232," 3007 "),a(),s(233,"th",21),c(234," 100 "),a(),s(235,"th",21),c(236," 282356.54 "),a(),s(237,"th",21),c(238," 100 "),a()()()()(),s(239,"small",22)(240,"p"),c(241,"Sources: Respective State Governments (DGMs/DMGs etc). "),a(),s(242,"p"),c(243,"Note: Data received from respective regional offices of IBM have also been taken in account wherever necessary. (P): Provisional ++: Negligible *: Other than Atomic, Hydro Carbons Energy & Minor Minerals"),a()(),s(244,"p"),c(245," The number of working/operational underground mines during the fiscal year 2023-24 is 34. Detailed mineral-wise information regarding these underground mines is presented in Table 2.3 below. "),a(),s(246,"div",18)(247,"p",4)(248,"strong"),c(249,"Table 3.3"),a()(),s(250,"p")(251,"b"),c(252,"Number of Underground Mines 2023-24(P) (By Principal Minerals) "),a()()(),s(253,"div",12)(254,"table",13),Me(255,"caption"),s(256,"thead")(257,"tr",14)(258,"th",19),c(259," Primary Mineral "),a(),s(260,"th",19),c(261," Category A "),a(),s(262,"th",19),c(263," Category B "),a(),s(264,"th",19),c(265," Total "),a()()(),s(266,"tbody")(267,"tr")(268,"td"),c(269," Chromite "),a(),s(270,"td",20),c(271," 1 "),a(),Me(272,"td",20),s(273,"td",20),c(274," 1 "),a()(),s(275,"tr")(276,"td"),c(277," Copper Ore "),a(),s(278,"td",20),c(279," 4 "),a(),Me(280,"td",20),s(281,"td",20),c(282," 4 "),a()(),s(283,"tr")(284,"td"),c(285," Gold Ore "),a(),s(286,"td",20),c(287," 4 "),a(),Me(288,"td",20),s(289,"td",20),c(290," 4 "),a()(),s(291,"tr")(292,"td"),c(293," Lead Zinc Ore "),a(),s(294,"td",20),c(295," 8 "),a(),Me(296,"td",20),s(297,"td",20),c(298," 8 "),a()(),s(299,"tr")(300,"td"),c(301," Manganese Ore "),a(),s(302,"td",20),c(303," 13 "),a(),s(304,"td",20),c(305," 1 "),a(),s(306,"td",20),c(307," 14 "),a()(),s(308,"tr")(309,"td"),c(310," Rock Salt "),a(),s(311,"td",20),c(312," 1 "),a(),Me(313,"td",20),s(314,"td",20),c(315," 1 "),a()(),s(316,"tr")(317,"td"),c(318," Vermiculite "),a(),Me(319,"td",20),s(320,"td",20),c(321," 2 "),a(),s(322,"td",20),c(323," 2 "),a()()(),s(324,"tfoot")(325,"tr")(326,"th",19),c(327," Total "),a(),Me(328,"th",21),s(329,"th",21),c(330," 2 "),a(),s(331,"th",21),c(332," 2 "),a()()()()(),s(333,"p"),c(334,"This data is based on the \u201cList of Mines as of 01.04.24\u201d, provided by the Office of the Chief Controller of Mines (CCoM). \u2018A\u2019 Category: Mechanized Mines: >150 labour in all or >75 labour in workings below ground; \u2018B\u2019 Category: Other than \u2018A\u2019 category"),a(),s(335,"p"),c(336," In the fiscal year 2023-24, mineral production under the Mineral Conservation and Development Rules (MCDR) revealed significant contributions from various states in India, demonstrating the nation\u2019s extensive mineral resources. Odisha led the production, reporting a total value of \u20b963,588 crores, which constitutes approximately 44.9% of the national output in terms of value. This prominent figure highlights Odisha's strategic position in the mining sector, reflecting its rich deposits of key minerals. "),a(),s(337,"p"),c(338,"Chhattisgarh has also played a significant role in mineral production, with a production value of \u20b919,598 crores, accounting for approximately 13.9% of the total national output. This underscores the state's importance in the mineral economy, particularly in the extraction of essential minerals. Rajasthan and Karnataka also contributed significantly, with production values of \u20b921,922 crores (15.5%) and \u20b916,073 crores (11.4%), respectively, highlighting their active roles in the mineral sector."),a(),s(339,"p"),c(340,"Further contributions to mineral production came from Jharkhand and Maharashtra, with reported values of \u20b95,820 crores (4.1%) and \u20b95,520 crores (3.9%), respectively, highlighting their significant involvement in extraction activities. Andhra Pradesh contributed \u20b91,537 crores (1.1%), while Gujarat accounted for \u20b9748 crores (0.5%), reflecting their respective roles in the sector."),a(),s(341,"p"),c(342,"States contributed differently to the overall mineral output, highlighting the diversity of mineral resources across the nation. Tamil Nadu led with \u20b9917 crores (0.6%), followed by Telangana with \u20b9577 crores (0.4%), and Himachal Pradesh with \u20b9301 crores (0.2%)."),a(),s(343,"p"),c(344,"On the other hand, several states reported much lower production values. Bihar contributed \u20b941 crores (0.03%), Kerala \u20b931 crores (0.02%), Uttarakhand \u20b911 crores (0.01%), and Goa recorded a negligible \u20b90.01 crore, reflecting an insignificant percentage."),a(),s(345,"p"),c(346,"These figures underscore the disparities in mineral resource availability and the scale of mining activities across different regions."),a(),s(347,"p"),c(348,"In summary, India\u2019s total MCDR mineral production value for the fiscal year 2023-24 amounted to \u20b91,41,239 crores. This comprehensive figure not only underscores the nation's considerable mineral wealth but also highlights the necessity for sustainable mining practices and effective mineral conservation strategies as critical components of India\u2019s economic development framework."),a(),s(349,"p"),c(350,"The provisional contribution figures of the states to the value of mineral production for the year 2023-24 are depicted in Figure 3.4."),a(),s(351,"div",18)(352,"p",4)(353,"strong"),c(354,"Table 3.4"),a()(),s(355,"p")(356,"b"),c(357,"Percentage Share (Provisional) of States in terms Value of MCDR Mineral Production in 2023-24"),a()(),Me(358,"img",23),a(),s(359,"p"),c(360," In the fiscal year 2023-24, mineral production values across key states in India showcased significant fluctuations, reflecting the dynamic nature of the mining sector. Odisha maintained its leading position, registering a robust production value of \u20b96359 crores, which represents an increase of 17.2% compared to the previous year. Maharashtra demonstrated exceptional growth, with a remarkable surge of 64.3%, elevating its production from \u20b933597 crores to \u20b955198 crores, indicating substantial advancements and investments in its mining sector."),a(),s(361,"p"),c(362,"Karnataka also experienced noteworthy progress, with production rising by 20.4% to \u20b916073 crores, while Jharkhand reported a production increase of 12.8%, reaching \u20b958199 crores. Madhya Pradesh and Meghalaya recorded increases of 12.8% and 15.2%, respectively, with production values of \u20b939116 crores and \u20b94756 crores."),a(),s(363,"p"),c(364,"Conversely, Kerala faced a decline of 3.9%, resulting in a production value of \u20b93056 crores. Notably, Rajasthan experienced a slight increase of 4.2%, achieving a production value of \u20b921922 crores. In contrast, Chhattisgarh, despite its substantial contribution of \u20b919598 crores, saw a modest increase of 9.0%."),a(),s(365,"p"),c(366,"Overall, this data highlights a multifaceted landscape of mineral production among India\u2019s key states, emphasizing the importance of strategic resource management and development as they navigate the complexities inherent in the mining industry."),a(),s(367,"p"),c(368,"The all India Reserves and Resources of various minerals as on 1st April, 2020, as per UNFC System, is given in at Annexure 3.4."),a(),s(369,"p"),c(370,"As per World Mineral Production, 2017-21, British Geological Survey, India\u2019s ranking in 2021 in world production in term of quantity was 2nd in Steel (crude/liquid) and aluminium (primary) followed by 3rd in Zinc (slabs) and Chromite; 4th in iron ore; 5th in Bauxite; 7th in Manganese ore; 11th in copper (refined); 12th in lead (refined); 17th in mangnesite and 19th in apatite & rock phosphate. The statistics on indigenous and world production of principal minerals and metals are as follows:"),a(),s(371,"div",18)(372,"p")(373,"strong"),c(374," Contribution and Rank of India in World Production of Principal Minerals & Metals, 2021"),a()()(),s(375,"table",13),Me(376,"caption"),s(377,"thead")(378,"tr",14)(379,"th",24),c(380," Sector "),a(),s(381,"th",24),c(382," Unit of Commodity "),a(),s(383,"th",25),c(384," Production quantity "),a(),s(385,"th",26),c(386," Contribution (Percentage) "),a(),s(387,"th",26),c(388," India\u2019s rank in World order $ "),a()(),s(389,"tr",14)(390,"th",27),c(391," World "),a(),s(392,"th",28),c(393," India* "),a()()(),s(394,"tbody")(395,"tr")(396,"th",29),c(397," Metallic Minerals "),a()(),s(398,"tr")(399,"td"),c(400," Bauxite "),a(),s(401,"td"),c(402," 000 tonnes "),a(),s(403,"td",20),c(404," 342600 "),a(),s(405,"td",20),c(406," 22495 "),a(),s(407,"td",20),c(408," 6.56 "),a(),s(409,"td",20),c(410," 5"),s(411,"sup"),c(412,"th"),a()()(),s(413,"tr")(414,"td"),c(415," Chromite "),a(),s(416,"td"),c(417," 000 tonnes "),a(),s(418,"td",20),c(419," 35100 "),a(),s(420,"td",20),c(421," 3785 "),a(),s(422,"td",20),c(423," 10.78 "),a(),s(424,"td",20),c(425," 3 "),s(426,"sup"),c(427,"rd"),a()()(),s(428,"tr")(429,"td"),c(430," Iron ore "),a(),s(431,"td"),c(432," million tonnes "),a(),s(433,"td",20),c(434," 3108 "),a(),s(435,"td",20),c(436," 254 "),a(),s(437,"td",20),c(438," 8.17 "),a(),s(439,"td",20),c(440," 4 "),s(441,"sup"),c(442,"th"),a()()(),s(443,"tr")(444,"td"),c(445," Manganese ore "),a(),s(446,"td"),c(447," 000 tonnes "),a(),s(448,"td",20),c(449," 56200 "),a(),s(450,"td",20),c(451," 2347 "),a(),s(452,"td",20),c(453," 4.17 "),a(),s(454,"td",20),c(455," 7 "),s(456,"sup"),c(457,"th"),a()()(),s(458,"tr")(459,"th",30),c(460," Industrial Minerals** "),a()(),s(461,"tr")(462,"td"),c(463," Magnesite "),a(),s(464,"td"),c(465," 000 tonnes "),a(),s(466,"td",20),c(467," 34300"),a(),s(468,"td",20),c(469," 113 "),a(),s(470,"td",20),c(471," 0.32 "),a(),s(472,"td",20),c(473," 17 "),s(474,"sup"),c(475,"th"),a()()(),s(476,"tr")(477,"td"),c(478," Apatite&Rock phosphate "),a(),s(479,"td"),c(480," 000 tonnes "),a(),s(481,"td",20),c(482," 67000 "),a(),s(483,"td",20),c(484," 4016 "),a(),s(485,"td",20),c(486," 5.60 "),a(),s(487,"td",20),c(488," 2 "),s(489,"sup"),c(490,"nd"),a()()(),s(491,"tr")(492,"th",30),c(493," Metals "),a()(),s(494,"tr")(495,"td"),c(496," Aluminium (primary) "),a(),s(497,"td"),c(498," 000 tonnes "),a(),s(499,"td",20),c(500," 67000 "),a(),s(501,"td",20),c(502," 4016 "),a(),s(503,"td",20),c(504," 5.99 "),a(),s(505,"td",20),c(506," 2 "),s(507,"sup"),c(508,"nd"),a()()(),s(509,"tr")(510,"td"),c(511," Copper (refined) "),a(),s(512,"td"),c(513," 000 tonnes "),a(),s(514,"td",20),c(515," 24800"),s(516,"sup"),c(517,"1/"),a()(),s(518,"td",20),c(519," 484"),s(520,"sup"),c(521,"#"),a()(),s(522,"td",20),c(523," 1.95 "),a(),s(524,"td",20),c(525," 11"),s(526,"sup"),c(527,"th"),a()()(),s(528,"tr")(529,"td"),c(530," Steel (crude/liquid) "),a(),s(531,"td"),c(532," million tonnes "),a(),s(533,"td",20),c(534," 1915 "),a(),s(535,"td",20),c(536," 120.007 "),a(),s(537,"td",20),c(538," 5.60 "),a(),s(539,"td",20),c(540," 2 "),s(541,"sup"),c(542,"nd"),a()()(),s(543,"tr")(544,"td"),c(545," Lead (refined) "),a(),s(546,"td"),c(547," 000 tonnes "),a(),s(548,"td",20),c(549," 14400"),s(550,"sup"),c(551,"2/"),a()(),s(552,"td",20),c(553," 191"),s(554,"sup"),c(555,"#@"),a()(),s(556,"td",20),c(557," 1.32 "),a(),s(558,"td",20),c(559," 12 "),s(560,"sup"),c(561,"th"),a()()(),s(562,"tr")(563,"td"),c(564," Zinc(slab) "),a(),s(565,"td"),c(566," 000 tonnes "),a(),s(567,"td",20),c(568," 14000 "),a(),s(569,"td",20),c(570," 775 "),a(),s(571,"td",20),c(572," 5.53 "),a(),s(573,"td",20),c(574," 3 "),s(575,"sup"),c(576,"rd"),a()()()()(),s(577,"small",22)(578,"p"),c(579,"Source: World mineral production data compiled from World Mineral Production, 2017-2021; British Geological Survey."),Me(580,"br"),c(581," * Figures relate to financial year 2021-22 and MCDR returns for production data."),Me(582,"br"),c(583," ** Minerals declared as minor minerals vide Government of India Notification S.O. 423(E) dated 10th February, 2015 are not included due to non-availability of production with respect to India."),Me(584,"br"),c(585," $: India\u2019s rank based on production mentioned in World Mineral Production 2017-21; British Geological Survey."),Me(586,"br"),c(587," 1/ Figures relate to both primary and secondary refined copper, whether electrolytic or fire refined. Metal recovered from secondary materials by remelting alone is excluded."),Me(588,"br"),c(589," 2/ Figures relate to both primary and secondary refined lead and include the lead content of antimonial lead."),Me(590,"br"),c(591," # : production of copper (refined) and lead refined during 2021 was 491 and 893 thousand tonnes, respectively, as per World Mineral Production, 2017-2021 which includes both primary and secondary production."),Me(592,"br"),c(593," @: Production of lead (primary)."),Me(594,"br"),c(595," Note: Data in respect of World Mineral Production is on calendar year basis, however, the data on India\u2019s production is based on financial year."),a()(),s(596,"h5",2),c(597,"Self-Reliance in Minerals & Mineral Based Products"),a(),s(598,"p"),c(599,"India continued to be wholly or largely self sufficient in minerals which constitute primary mineral raw materials that are supplied to industries, such as, iron & steel, cement, etc. India is self-sufficient in iron ore, kyanite, sillimanite, aluminium (primary), lead (primary) and zinc. India is deficient in bauxite, chromite, limestone, magnesite, manganese ore, rock phosphate, etc. which were imported to meet the demand for either blending with locally available mineral raw materials and/or for manufacturing special qualities of mineral-based products. To meet the increasing demand of uncut diamonds, emerald and other precious & semi-precious stones by the domestic Cutting and Polishing Industry, India is dependent on imports of raw uncut stones for their value-added re-exports. The degree of self-sufficiency in respect of various principal minerals and metals in 2021-22 is furnished below:"),a(),s(600,"div",3)(601,"p")(602,"b"),c(603,"Degree of Self-sufficiency in Principal Minerals & Metals, 2021-22 (P) "),a()()(),s(604,"div",12)(605,"table",31),Me(606,"caption"),s(607,"thead")(608,"tr",32)(609,"th",19),c(610," Sl#. "),a(),s(611,"th",19),c(612," Commodity "),a(),s(613,"th",19),c(614," Apparent Consumption('000 tonnes) "),a(),s(615,"th",19),c(616," Supply/Domestic supply ('000 tonnes) "),a(),s(617,"th",19),c(618," Order of self- sufficiency(%) "),a()()(),s(619,"tbody")(620,"tr")(621,"th",33),c(622," Minerals* "),a()(),s(623,"tr")(624,"td"),c(625," 1 "),a(),s(626,"td"),c(627," Bauxite "),a(),s(628,"td",20),c(629," 25124 "),a(),s(630,"td",20),c(631," 22495 "),a(),s(632,"td",20),c(633," 90 "),a()(),s(634,"tr")(635,"td"),c(636," 2 "),a(),s(637,"td"),c(638," Chromite "),a(),s(639,"td",20),c(640," 4028 "),a(),s(641,"td",20),c(642," 3785 "),a(),s(643,"td",20),c(644," 94 "),a()(),s(645,"tr")(646,"td"),c(647," 3 "),a(),s(648,"td"),c(649," Iron ore "),a(),s(650,"td",20),c(651," 234000 "),a(),s(652,"td",20),c(653," 254000 "),a(),s(654,"td",20),c(655," 100 "),a()(),s(656,"tr")(657,"td"),c(658," 4 "),a(),s(659,"td"),c(660," Kyanite "),a(),s(661,"td",20),c(662," 9 "),a(),s(663,"td",20),c(664," 10 "),a(),s(665,"td",20),c(666," 100 "),a()(),s(667,"tr")(668,"td"),c(669," 5 "),a(),s(670,"td"),c(671," Limestone "),a(),s(672,"td",20),c(673," 408182 "),a(),s(674,"td",20),c(675," 392760 "),s(676,"sup"),c(677,"a/"),a()(),s(678,"td",20),c(679," 96 "),a()(),s(680,"tr")(681,"td"),c(682," 6 "),a(),s(683,"td"),c(684," Magnesite "),a(),s(685,"td",20),c(686," 618 "),a(),s(687,"td",20),c(688," 113 "),a(),s(689,"td",20),c(690," 18 "),a()(),s(691,"tr")(692,"td"),c(693," 7 "),a(),s(694,"td"),c(695," Manganese ore "),a(),s(696,"td",20),c(697," 8734 "),a(),s(698,"td",20),c(699," 2347 "),a(),s(700,"td",20),c(701," 27 "),a()(),s(702,"tr")(703,"td"),c(704," 8 "),a(),s(705,"td"),c(706," Rockphosphate (includingapatite) "),a(),s(707,"td",20),c(708," 11053 "),a(),s(709,"td",20),c(710," 1395 "),a(),s(711,"td",20),c(712," 13 "),a()(),s(713,"tr")(714,"td"),c(715," 9 "),a(),s(716,"td"),c(717," Sillimanite "),a(),s(718,"td",20),c(719," 3 "),a(),s(720,"td",20),c(721," 5 "),a(),s(722,"td",20),c(723," 100 "),a()(),s(724,"tr")(725,"th",33),c(726," Metals "),a()(),s(727,"tr")(728,"td"),c(729," 10 "),a(),s(730,"td"),c(731," Aluminium(primary) "),a(),s(732,"td",20),c(733," 2896 "),a(),s(734,"td",20),c(735," 4016 "),a(),s(736,"td",20),c(737," 100 "),a()(),s(738,"tr")(739,"td"),c(740," 11 "),a(),s(741,"td"),c(742," Copper (refined) "),a(),s(743,"td",20),c(744," 868 "),s(745,"sup"),c(746,"b/"),a()(),s(747,"td",20),c(748," 484 "),a(),s(749,"td",20),c(750," 56 "),a()(),s(751,"tr")(752,"td"),c(753," 12 "),a(),s(754,"td"),c(755," Lead (primary) "),a(),s(756,"td",20),c(757," 186 "),s(758,"sup"),c(759,"c/"),a()(),s(760,"td",20),c(761," 191 "),a(),s(762,"td",20),c(763," 100 "),a()(),s(764,"tr")(765,"td"),c(766," 13 "),a(),s(767,"td"),c(768," Zinc "),a(),s(769,"td",20),c(770," 640 "),s(771,"sup"),c(772,"d/"),a()(),s(773,"td",20),c(774," 775 "),a(),s(775,"td",20),c(776," 100 "),a()()()()(),s(777,"small",22)(778,"p"),c(779,"Source: Production: MCDR Returns for production data and DGCI&S for export & import. Apparent demand (production+ import-export) Note: Minerals declared as minor mineral vide Government of India Notification S.O. 423(E) dated 10th February, 2015, are not included due to non-availability of production for the year 2020-21. Even in cases where almost entire domestic demand is satisfied by domestic supplies, some quantities of certain special quality/ types of minerals and metals/ferroalloys are imported to meet the requirement in certain specific end-uses. a/ Excludes production of limestone as a minor mineral, calcite & chalk and includes limeshell, limekankar & marl. b/ Based on production of copper cathode and imports & exports of copper & alloys. c/ Based on production of lead (primary), and imports & exports of lead & alloys. d/ Based on production of zinc (ingots) and imports & exports of zinc & alloys."),a()(),s(780,"h4",2),c(781,"Production Trends"),a(),s(782,"h5",2),c(783,"Metallic Minerals"),a(),s(784,"p"),c(785," The provisional value of metallic minerals in 2023-24, at \u20b91,27,599 crore, increased by approximately 15.5% compared to the previous year. Among the principal metallic minerals, iron ore contributed \u20b998,946 crore or 77.5%, zinc concentrate contributed \u20b98,565 crore or 6.7%, silver accounted for \u20b95,356 crore or 4.2%, and chromite contributed \u20b94,850 crore or 3.8%. The provisional production of bauxite in 2023-24 was 23.72 million tonnes, reflecting a decrease of 0.5% compared to the previous year. Four major companies\u2014NALCO, Utkal Alumina International Limited, Odisha Mining Corporation, and HINDALCO\u2014dominated the total bauxite mining activities in the country during 2023-24. Odisha was the leading state in bauxite production, accounting for a 74.2% share. "),a(),s(786,"p"),c(787,"The provisional production of chromite in 2023-24 was 3.14 million tonnes, which represents an increase of 3.1% compared to the previous year. Odisha accounted for 100% of the country's chromite output. The major producers of chromite included Odisha Mining Corporation (OMC), Tata Steel Mining Ltd., and Indian Metals & Ferro Alloys Ltd."),a(),s(788,"p"),c(789,"The provisional production of copper concentrate in 2023-24 was 125 thousand tonnes, an increase of approximately 11.1% compared to the previous year. Rajasthan and Madhya Pradesh were the sole producers of copper in the country."),a(),s(790,"p"),c(791,"The provisional production of primary gold in 2023-24 was 1,552 kg, registering an increase of about 8.3% compared to the previous year. Karnataka was the leading producer of gold, accounting for more than 93% of the total production, while the remaining output came from Andhra Pradesh and Jharkhand."),a(),s(792,"p"),c(793," The provisional production of iron ore in 2023-24 was about 275 million tonnes, reflecting a 7.5% increase over the previous year. The major producers of iron ore during this period were NMDC, SAIL, Odisha Mining Corporation, and Tata Steel Limited. Odisha was the largest producer of iron ore, holding a 54% share in the country, followed by Karnataka with a 16% share and Chhattisgarh with a 15% share."),a(),s(794,"p"),c(795," For the year 2023-24, the estimated production of lead concentrates was 381 thousand tonnes, marking an increase of 1%. In contrast, the production of zinc concentrate was 1,710 thousand tonnes, showing a decrease of 2.4% compared to the previous year. Rajasthan accounted for the entire production of both lead and zinc concentrates during 2023-24."),a(),s(796,"p"),c(797," The provisional production of manganese ore in 2023-24 was 3.4 million tonnes, representing an increase of about 21.7% compared to the previous year. The largest producers of manganese ore included MOIL, Tata Steel, Sandur Manganese & Iron Ores Ltd., and RBSSD & FN Das. Madhya Pradesh and Maharashtra each held a 30% share in manganese ore production, while Odisha contributed 19%."),a(),s(798,"h5",2),c(799," Non-Metallic Minerals"),a(),s(800,"p"),c(801,"The provisional value of production of non-metallic minerals in 2023-24 was \u20b913,640 crore, reflecting a 9.3% increase compared to the previous year. Limestone maintained its leading position by contributing 90.5% of the total estimated value of non-metallic minerals in 2023-24, followed by phosphorite, which accounted for 8.4%."),a(),s(802,"p"),c(803,"The production of limestone in 2023-24 reached 451 million tonnes, marking an 11% increase compared to the previous year. Limestone is widely produced in India, with major producers including UltraTech Cement Limited, Shree Cement Limited, and Ambuja Cement Limited. Rajasthan, Madhya Pradesh, and Andhra Pradesh together account for 50% of limestone production in the country."),a(),s(804,"p"),c(805,"The production of magnesite in 2023-24 was 132 thousand tonnes, reflecting a 23% increase compared to the previous year. Tamil Nadu and Uttarakhand, which together account for over 94% of magnesite production in the country, are the major producers, while the remaining magnesite is sourced from Karnataka."),a(),s(806,"p"),c(807," The production of phosphorite in 2023-24 was 1,558 thousand tonnes, representing a decrease of 21% compared to the previous year. Rajasthan contributed approximately 85%, with the remainder sourced from Madhya Pradesh."),a(),s(808,"p"),c(809,"The month-wise monthly returns received online in the new MTS Portal are given in Table "),a(),s(810,"div",3)(811,"p")(812,"b"),c(813,"Table Month-wise Returns Received online"),a()(),Me(814,"img",34),a(),Me(815,"img",35)(816,"img",36)(817,"img",37)(818,"img",38),a()())},dependencies:[en],styles:["h5[_ngcontent-%COMP%]{font-weight:600}h4[_ngcontent-%COMP%]{color:#e97a42}"]}),t})(),lB=(()=>{class t{constructor(){}ngOnInit(){}}return t.\u0275fac=function(e){return new(e||t)},t.\u0275cmp=wt({type:t,selectors:[["app-international-mineral-scenario"]],decls:639,vars:0,consts:[[1,"inner-section"],[1,"container","screen-reader"],[1,"mt-4","text-center"],[1,"table-responsive"],[1,"table","table-bordered","mb-0"],["rowspan","7"],["rowspan","4"],[1,"text-center"],[1,"mt-4"],[1,"table","table-bordered","table-striped","table-striped","mb-0"],[1,"table","table-bordered","table-striped","mb-0"],["valign","top"],["rowspan","2"],["colspan","2"],[1,"alert","alert-warning","p-3","mb-4","mt-3"]],template:function(e,i){1&e&&(Me(0,"app-navigation"),s(1,"div",0)(2,"div",1)(3,"h4"),c(4,"1. Aluminium"),a(),s(5,"p"),c(6,"The aluminium industry in India is strategically well placed and is one of the largest producers in the world with discernible growth plans and prospects for the future. India's rich bauxite mineral base renders a competitive edge to the industry as compared to its counterparts globally. As per available information, four major primary producers, National Aluminium Co. Ltd, Hindalco Industries Ltd, Bharat Aluminium Co. Ltd and Vedanta Aluminium Ltd (VAL) are at the forefront in aluminium production. NALCO is one of the largest integrated Bauxite-Alumina-Aluminium complexes in the Country. The installed capacity of alumina and aluminium plants in the country during 2021-22(P) was 7.475 million tpy and 4.145 million tpy, respectively "),a(),s(7,"h5",2),c(8,"Plant wise Installed Capacity of Alumina and Aluminium during 2021-22 (P)"),a(),s(9,"div",3)(10,"table",4),Me(11,"caption"),s(12,"thead")(13,"tr")(14,"th"),c(15," Commodity "),a(),s(16,"th"),c(17," Producer "),a(),s(18,"th"),c(19," Plant "),a(),s(20,"th"),c(21," 2019-20(P) "),a()()(),s(22,"tbody")(23,"tr")(24,"td",5),c(25," Alumina "),a(),s(26,"td"),c(27," Nalco "),a(),s(28,"td"),c(29," Damanjodi "),a(),s(30,"td"),c(31," 2275 "),a()(),s(32,"tr")(33,"td",6),c(34," Hindalco "),a(),s(35,"td"),c(36," Belagavi "),a(),s(37,"td"),c(38," 350 "),a()(),s(39,"tr")(40,"td"),c(41," Muri "),a(),s(42,"td"),c(43," 450 "),a()(),s(44,"tr")(45,"td"),c(46," Renukoot "),a(),s(47,"td"),c(48," 700 "),a()(),s(49,"tr")(50,"td"),c(51," Utkal Alumina "),a(),s(52,"td"),c(53," 1500 "),a()(),s(54,"tr")(55,"td"),c(56," Vedanta "),a(),s(57,"td"),c(58," Lanjigarh "),a(),s(59,"td"),c(60," 2000 "),a()(),s(61,"tr")(62,"td"),c(63," Balco "),a(),s(64,"td"),c(65," Korba "),a(),s(66,"td"),c(67," 200 "),a()(),s(68,"tr"),Me(69,"th"),s(70,"th"),c(71," Total "),a(),s(72,"th"),c(73," All India "),a(),s(74,"th"),c(75," 7475 "),a()(),s(76,"tr")(77,"td",5),c(78," Aluminium "),a(),s(79,"td"),c(80," Nalco "),a(),s(81,"td"),c(82," Angul "),a(),s(83,"td"),c(84," 460 "),a()(),s(85,"tr")(86,"td",6),c(87," Hindalco "),a(),s(88,"td"),c(89," Aditya "),a(),s(90,"td"),c(91," 360 "),a()(),s(92,"tr")(93,"td"),c(94," Hirakund "),a(),s(95,"td"),c(96," 216 "),a()(),s(97,"tr")(98,"td"),c(99," Mahan "),a(),s(100,"td"),c(101," 359 "),a()(),s(102,"tr")(103,"td"),c(104," Renukoot "),a(),s(105,"td"),c(106," 410 "),a()(),s(107,"tr")(108,"td"),c(109," Balco "),a(),s(110,"td"),c(111," Korba "),a(),s(112,"td"),c(113," 590 "),a()(),s(114,"tr")(115,"td"),c(116," Vedanta "),a(),s(117,"td"),c(118," Jharsuguda "),a(),s(119,"td"),c(120," 1750 "),a()(),s(121,"tr"),Me(122,"th"),s(123,"th"),c(124," Total "),a(),s(125,"th"),c(126," All India "),a(),s(127,"th"),c(128," 4145 "),a()()()()(),s(129,"p",7),c(130," Source: Information received from the companies/Annual Reports."),Me(131,"br"),c(132," (P): Provisional "),Me(133,"br"),c(134," #: Plants remained non-operational during the year "),a(),s(135,"h5",8),c(136,"Production of Aluminium"),a(),s(137,"p"),c(138,"The production of aluminium by primary aluminium producers in the years 2022-23 and 2023-24 is given in the following table-"),a(),s(139,"h5",2),c(140,"Provisional Production (in Tonne) of Aluminium during 2022-23 and 2023-24"),a(),s(141,"div",3)(142,"table",9),Me(143,"caption"),s(144,"thead")(145,"tr")(146,"th"),c(147," Name of the company "),a(),s(148,"th"),c(149," 2022-23 "),a(),s(150,"th"),c(151," 2023-24 "),a()()(),s(152,"tbody")(153,"tr")(154,"td"),c(155," Bharat Aluminium Co. Ltd. "),a(),s(156,"td"),c(157," 568549 "),a(),s(158,"td"),c(159," 582987 "),a()(),s(160,"tr")(161,"td"),c(162," Hindalco Industries Ltd. "),a(),s(163,"td"),c(164," 1321579 "),a(),s(165,"td"),c(166," 1331427 "),a()(),s(167,"tr")(168,"td"),c(169," National Aluminium Co. Ltd. "),a(),s(170,"td"),c(171," 459564 "),a(),s(172,"td"),c(173," 463427 "),a()(),s(174,"tr")(175,"td"),c(176," Vedanta Ltd. "),a(),s(177,"td"),c(178," 1716767 "),a(),s(179,"td"),c(180," 1781003 "),a()()()()(),s(181,"p",7),c(182," Source: Information received from respective plants. "),a(),s(183,"h5",8),c(184,"Uses"),a(),s(185,"p"),c(186,"Aluminium is more environment-friendly than steel, plastic and other materials. Aluminium has widespread uses throughout the economy and is equally important to both the industrial and consumer sectors. Aluminium is used in the Aerospace Industry as well as other industries requiring light metal. On the industrial side, aluminium is heavily used in electrical power transmission, machinery & equipment and construction. Aluminium usage in automobiles is rising and is expected to increase internationally. Over the past five years considerable progress has been made in aluminium-intensive vehicle production."),a(),s(187,"p"),c(188,"Housing, in particular, make heavy use of the lightweight material as a substitute for steel and wood in doors, windows and sidings. Aluminium is also used in a variety of retail products including cans, packaging, air conditioners, furniture and automobile. In addition, India has pioneered the replacement of copper by aluminium in power transmission & distribution which has enhanced the demand for aluminium. There are nearly 600 cable and conductor manufacturing units in the country, having a total capacity of about 4,00,000 tpy. The major end-use of aluminium is as rolled sheets, extrusions and foils. India Foils, Pennar Aluminium and Century Extrusions are the major players in the extrusion & foil market."),a(),s(189,"h5",8),c(190,"Consumption"),a(),s(191,"p"),c(192,"Key sectors to drive aluminium consumption in India are Auto, Power, Electronics, Railways, Aerospace & Defence Construction, Solar Energy and Aluminium packaging."),a(),s(193,"p"),c(194,"In India, the power, packaging, transport, construction, machinery and equipment sectors are key demand drivers of aluminium. The domestic imports of aluminium products including scrap, are growing significantly, which is a major concern for the domestic aluminium producers. In advanced economies, aluminium is increasingly replacing wood and steel in Building Sector. Aluminium cans and containers are used extensively, world over. Aluminium is also the ideal packaging material for pharmaceuticals and processed foods."),a(),s(195,"p"),c(196,"In India, aluminium was consumed mainly in the Electrical sector (48%), followed by Automobile & Transport sector (15%), Construction (13%), Consumer Durables (7%), Machinery & Equipment (7%), Packaging (4%) and others (6%). In the Electrical sector, aluminium usage is in overhead conductor, and power cable used in generation, transmission, and distribution of electricity. Aluminium is also used in switchboards, coil windings, capacitors, etc."),a(),s(197,"p"),c(198,"As per Technology Vision Document 2035, the per capita consumption of aluminium in India is among the lowest in the world with only 2.2 kg as compared to world average roughly of 8 kg with 22-25 kg in developed nations."),a(),s(199,"p"),c(200,"Alumina is produced from bauxite. About one tonne of alumina is produced from 3 to 3.5 tonnes of bauxite and about one tonne of aluminium is produced from about two tonnes of alumina."),a(),s(201,"h5",8),c(202,"Reserve/Resources"),a(),s(203,"p"),c(204,"The total resources of bauxite in the country as on 1.4.2020(P) are estimated at 4,958 million tonnes. These resources include about 646 million tonnes (13%) reserves and 4,312 million tonnes (87%) remaining resources. Out of the total resources, about 74% are in freehold areas and remaining 26% in leasehold areas. The country is endowed with huge quantities of metallurgical grade bauxite with resources of 3,931 million tonnes, about 79% of the total resources. Out of the total metallurgical grade, about 80% is metallurgical- I, 16% metallurgical - II and remaining 4% is metallurgical mixed grade."),a(),s(205,"h5",8),c(206,"World Review"),a(),s(207,"p"),c(208,"As per World Mineral Production, 2018-22, British Geological Survey, World production of alumina was 141 million tonnes in 2022. China continued to be the leading producer with a share of about 58% which is followed by Australia (14%), Brazil (8%), India (5%), Russia (2%), UAE (1.7%) & Ireland (1.34%). World production of aluminium was at 67 million tonnes in 2022. China continued to be the leading producer with a share of about 60% which is followed by Russia (6%), Canada (4.47%), UAE (4%), India (3.46%) and Bahrin (2.39%)."),a(),s(209,"h4",8),c(210,"2. Copper"),a(),s(211,"p"),c(212,"Hindustan Copper Limited (HCL), a public sector undertaking, is the only integrated producer of primary copper in India. HCL has two primary smelting & refining plants at Khetri Copper Complex (KCC) and Indian Copper Complex (ICC). Due to economic considerations, HCL has suspended KCC's smelting and refinery operation. Hindustan copper Ltd (formerly Jhagadia Copper Ltd) has a plant with a capacity of 50 thousand tonnes per annum copper cathodes through secondary route. Presently, total smelting capacity of HCL is about 68.5 thousand tonnes per annum during 2021-22. Apart from HCL, two other major players dominate the Indian Copper Industry, namely, Hindalco (Birla Copper) and Sterlite Industries which are under the Private Sector. M/s Hindalco at Dahej in Gujarat and M/s Sterlite Industries in Thoothukudi in Tamil Nadu have set up smelting and refining plants which depend on imported copper concentrates either from their own mines abroad or other overseas sources with annual production capacity of 500 thousand tonnes and 460 thousand tonnes, respectively. But, as per available information, Sterlite Copper Plant at Thoothukudi has been closed since May, 2018 on State Government order. Further, Sterlite copper has units in Silvassa in the Union Territory of Dadra & Nagar Haveli where Anodes are refined at Silvassa for domestic market. Thus, total installed capacity of copper smelter in the country during 2021-22(P) was around one million tonnes per annum with operational smelting capacity at 785 thousand tonnes per annum. Besides, there are few small companies which produce Electrowon copper but their capacities are very low and production is inconsistent. Hindustan Copper Ltd produces copper metal from the ore produced at their captive mines. Sterlite Industries (India) Ltd and Hindalco Industries Ltd produce copper metal mainly from imported copper ore & concentrates. "),a(),s(213,"p"),c(214,"The details of production of major players in copper industry during 2022-23 and 2023-24 are given in the following table"),a(),s(215,"h5",2),c(216,"Provisional Production (in Tonne) of Copper Cathode during 2022-23 and 2023-24"),a(),s(217,"div",3)(218,"table",9),Me(219,"caption"),s(220,"thead")(221,"tr")(222,"th"),c(223," Name of the company "),a(),s(224,"th"),c(225," 2022-23 "),a(),s(226,"th"),c(227," 2023-24 "),a()()(),s(228,"tbody")(229,"tr")(230,"td"),c(231," Hindalco Industries Ltd. "),a(),s(232,"td"),c(233," 407056 "),a(),s(234,"td"),c(235," 368103 "),a()(),s(236,"tr")(237,"td"),c(238," Vedanta Ltd. "),a(),s(239,"td"),c(240," 147185 "),a(),s(241,"td"),c(242," 141326 "),a()()()()(),s(243,"p",7),c(244," Source: Information received from respective plants. "),a(),s(245,"h5",8),c(246,"Uses"),a(),s(247,"p"),c(248,"The per capita consumption of copper in India during the year 2019-20 is at 0.5 kg which is very low in comparison to countries like Russia 3.3 kg, China 5.4 kg, USA 5.5 kg, Italy 8.9 kg and Germany 13.6 kg. The average per capita consumption of copper in developed nation works out to be 10 kg. India's per capita consumption is likely to be moderate and has many strides to cover so as to match that of China. Electrical/Electronic Industry is by far the largest consumer of copper, where it is used in the form of cables, winding wires as it is the best non-precious metal conductor of electricity as it encounters much less resistance and is safe for electrical distribution system from high voltage transmission cables to micro- circuits. Copper also has relatively high creep strength as compared to other commonly used materials. In Electronic Industry, semi-conductor manufacturers have launched a revolutionary 'copper chip'. By using copper for circuitry in silicon chips, microprocessors are able to operate at higher speeds using less energy. Copper heatsinks help remove heat from transistors and enable computer speeds using less energy, and processors operate at peak efficiency. Copper is used in Construction Industry as plumbing, taps, valves and fittings components. In Transportation Industry, copper is used in various components. According to the world Copper Fact book 2023, ICSG, the conventional cars contain an average of 23 kg copper and hybrid electric vehicles contain about 40 kg copper. Copper is extensively used in industrial machinery and equipment. It is used in a number of consumer products, such as, coinage, utensils, fixtures, etc. Large quantities of copper are consumed in making copper-based alloys, such as, brass and bronze."),a(),s(249,"h5",8),c(250,"Consumption"),a(),s(251,"p"),c(252,"As per the estimate of ICSG, the share of Electrical and Telecommunication Industry in total consumption is 56%, followed by Transport (8%), Consumer Durables (7%), Building & Construction (7%), General Engineering goods (6%) and other industries including Process Industries (16%). The apparent availability of copper for internal consumption in various industries has been computed on the basis of production of refined copper (cathodes) and from the imports and exports data of copper (refined)."),a(),s(253,"h5",8),c(254,"Reserve/Resources"),a(),s(255,"p"),c(256,"The total reserves/resources of copper ore as on 1.4.2020(P) as per NMI database based on UNFC system are estimated at 1.66 billion tonnes. Of these, 163.89 million tonnes (9.87%) fall under 'Reserves category' while the balance 1.50 billion tonnes (90.13%) are placed under 'Remaining resources' category. Gradewise there are no reserves with 1.85% or more copper grade, (+)0.5% to below 1% Cu and (-)0.5% Cu grade. However, 163.89 million tonnes reserves fall under 1% to below 1.85% Cu grade. Of the total ore resources, 8.28 million tonnes (0.50%) comprise ore containing 1.85% Cu or more, 586.79 million tonnes (35.33%) resources fall under 1% to below 1.85% Cu grade, 797.91 million tonnes (48.04%) resources fall under (+)0.5% to below 1% Cu grade and 267.89 million tonnes (16.13%) resources fall under (-)0.5% Cu grade."),a(),s(257,"h5",8),c(258,"World Review"),a(),s(259,"p"),c(260,"As per Mineral Commodity Summaries, 2024, published by USGS, the world reserves of copper are assessed at 1000 million tonnes of copper content. Chile has the largest share, accounting for about 19% of world reserves, followed by Peru (12%), Australia (10%), Russia & Congo (8% each), Mexico & USA (5% each), China (4%), Poland (3%), Indonesia, Zambia & Kazakhstan (2% each)."),a(),s(261,"p"),c(262,"As per World Mineral Production, 2018-22, British Geological Survey, the world mine production of copper increased slightly at 22.2 million tonnes of metal content in 2022 as compared to 21.8 million tonnes of metal content during previous year. Chile continued to be the largest single producer of copper in 2022 with 24% share followed by Peru & Dem. Rep. of Congo (11% each), China (9%), and USA (5%). The world refined copper production was 25.8 million tonnes in the year 2022 which showed slight increase of 3% from 25 million tonnes in the previous year. China was the largest producer of refined copper with 11.12 million tonnes in the year 2022 (43% of world production) followed by Chile (8%), Dem. Rep. of Congo (7%), Japan (6%), and Russia & USA (4% each), etc."),a(),s(263,"p"),c(264,"The world consumption of refined copper was 23.3 million tonnes in the year 2017. China is the largest refined copper consuming country with 11.8 million tonnes (51% of world consumption) followed by USA (8%), Germany (5%), Japan (4%) and Republic of Korea (3%)."),a(),s(265,"p"),c(266,"International Copper Study Group (ICSG) estimated that world refined copper production would increase up to 24.8 million tonnes in 2019 and may further increase to 26.2 million tonnes in 2020. The ICSG expects world apparent demand to increase by 2% in 2019 and 1.5% in 2020. Sustained growth in copper demand to continue because copper is essential to economic activity and even more so to the modern technological society. Infrastructure development in major countries, such as, China and India and the global trend towards cleaner energy will continue to support copper demand."),a(),s(267,"h4",8),c(268,"3. Lead & Zinc"),a(),s(269,"p"),c(270,"Primary lead was produced entirely by HZL which operated smelter at Chanderiya and Dariba having capacity of 90,000 tonnes and 1,20,000 tonnes per annum of lead metal, respectively. Thus, the smelting capacity for lead (primary) in the country during 2021-22(P) is 2,10,000 tonnes per annum."),a(),s(271,"p"),c(272,"The smelting capacity of HZL for zinc is distributed between three smelters at Debari (88,000 tonnes), Chanderiya (5,85,000 tonnes) and Dariba (2,40,000 tonnes). Edayar Zinc Ltd's plant at Binanipuram (Aluva), Kerala has capacity of 38,000 tonnes per annum and has produced zinc from imported concentrates but since the Company has been declared as sick unit, it did not operate its plant. Thus, the smelting capacity for zinc in the country is 9,51,000 tonnes per annum with operational capacity at 913 tonnes per annum during 2021-22(P). "),a(),s(273,"p"),c(274,"The data regarding apparent production of lead (primary) and zinc (ingots) for the years 2022-23 and 2023-24 is shown in the following table."),a(),s(275,"h5",2),c(276,"Provisional Production (in Tonne) of Lead (Primary) and Zinc (ingots)during 2022-23 and 2023-24"),a(),s(277,"div",3)(278,"table",9),Me(279,"caption"),s(280,"thead")(281,"tr")(282,"th"),c(283," Item "),a(),s(284,"th"),c(285," Name of the company "),a(),s(286,"th"),c(287," 2022-23 "),a(),s(288,"th"),c(289," 2023-24 "),a()()(),s(290,"tbody")(291,"tr")(292,"td"),c(293,"Lead Primary"),a(),s(294,"td"),c(295," Hindustan Zinc Ltd. "),a(),s(296,"td"),c(297," 210690 "),a(),s(298,"td"),c(299," 215983 "),a()(),s(300,"tr")(301,"td"),c(302," Zinc Ingot "),a(),s(303,"td"),c(304," Hindustan Zinc Ltd. "),a(),s(305,"td"),c(306," 820899 "),a(),s(307,"td"),c(308," 817058 "),a()()()()(),s(309,"p",7),c(310," Source: Information received from respective plants. "),a(),s(311,"h5",8),c(312,"Uses"),a(),s(313,"p"),c(314,"The largest single use of lead worldwide today is in the manufacture of lead-acid storage batteries which is about 74%, while the single largest use for zinc is in the Galvanising Industry which is about 50%."),a(),s(315,"p"),c(316,"Zinc is the forth most widely used metal across the globe, trailing only steel, aluminium and copper. The country has the self-sufficiency in respect of zinc. In contrast, there is short supply of lead vis- avis the demand in the country."),a(),s(317,"h5",8),c(318,"Consumption"),a(),s(319,"p"),c(320,"The Battery Industry consumes about 80% of lead and remaining 20% is consumed in pigments & compounds, rolled & extruded products, alloys, cable sheathing and other industries. The apparent consumption of lead during the year 2020-21 and 2021-22(P) was calculated on the basis of production of lead (primary) and imports & exports of refined lead (unwrought). The apparent consumption thus arrived at was 179135 tonnes in 2020-21 and 83012 tonnes in 2021-22(P). In addition to this, it is understood that large quantities of recycled lead were also consumed in certain other industries."),a(),s(321,"p"),c(322,"Owing to its corrosion resistance in varied types of environment, zinc is used for protecting steel by way of galvanising. The Galvanising Industry alone consumes about 57% of zinc, followed by coatings (16%), die-casting alloys (14%), oxides & chemicals (7%) and extruded products (6%). The apparent consumption of zinc during the year 2020-21 and 2021-22(P) was calculated on the basis of production of zinc, import & export of zinc (not alloyed). The apparent consumption, thus arrived at was 519008 tonnes in 2020-21 and 594809 tonnes in 2021- 22(P). In addition to this, some quantities of recycled zinc are also consumed in certain other industries. "),a(),s(323,"h5",8),c(324,"Reserve/Resources"),a(),s(325,"p"),c(326,"The total resreves/resources of lead and zinc ore as on 1.4.2020 as per NMI data base based on UNFC system have been estimated at 766.50 million tonnes. Of these, 103.27 million tonnes (13.47%) fall under 'Reserves' category while balance 663.22 million tonnes (86.53%) are classified as 'Remaining Resources'."),a(),s(327,"p"),c(328,"The total metal content in reserves/ resources of lead is 12.87 million tonnes and that of zinc is 33.17 million tonnes and for lead & zinc metal is 0.14 million tonnes. In terms of reserves, 1.90 million tonnes of lead metal and 7.44 million tonnes of zinc metal have been estimated. Rajasthan is endowed with the largest reserves/ resources of lead-zinc ore amounting to 684.66 million tonnes (89.32%), followed by Andhra Pradesh 22.69 million tonnes (2.96%), Madhya Pradesh 19.07 million tonnes (2.49%), Bihar 11.43 million tonnes (1.49%) and Maharashtra 9.27 million tonnes (1.21%). Resources are also established in Gujarat, Meghalaya, Odisha, Sikkim, Tamil Nadu, Uttarakhand and West Bengal."),a(),s(329,"h5",8),c(330,"World Review"),a(),s(331,"p"),c(332,"As per Mineral Commodity Summaries, 2024, published by USGS, the world's reserves of lead were estimated at 95 million tonnes in terms of lead content. Australia possesses 37% of the world's reserves followed by China (21%), Russia (9%), Mexico (6%), and Peru & USA (5% each). Further, the world's reserves of zinc were estimated at 220 million tonnes of zinc content. Australia accounts for 29% of world's zinc reserves, followed by China (20%), Russia (11%), Peru (10%), Mexico (6%), India, Kazakhstan &USA (3% each), etc."),a(),s(333,"h4",8),c(334,"4. Rare Earths"),a(),s(335,"p"),c(336,"IREL has a plant at Udyogamandal, Aluva, located in Ernakulam district, Kerala, wherein the monazite obtained from Manavalakurichi is chemically treated to separate rare earths in its composite chloride form and thorium as hydroxide upgrade."),a(),s(337,"p"),c(338,"IREL has set up a Rare-Earth Extraction plant (REEP) producing mixed Rare-earth chloride (MRCL) Tri-sodium phosphate etc., at its unit in OSCOM Odisha. MRCL produced from the above plant is processed at IREL\u2019s plant at Rare Earth Division (RED) in Aluva, Kerala, for producing separated High Pure Rare Earth (HPRE) Oxides/Compounds. "),a(),s(339,"p"),c(340,"IREL implemented flow sheet developed by BARC and has produced 50 kg Nuclear Grade Gadolinium Oxide (99.99%). Same can be converted into Gadolinium Nitrate which is used by NPCIL. The Company invited research projects pertaining to products in the value chain of Ilmenite, zircon and rare-earth compounds, improvement in recovery energy efficiency, etc."),a(),s(341,"p"),c(342,"IREL is actively pursuing setting up of greenfield operations in Kanyakumari district of Tamil Nadu and Bramhagiri district of Odisha. The proposal for harnessing the beach sand mineral deposits in Tamil Nadu by constituting a Joint Venture Company with the nominated State Government Agency, TAMIN, is under active consideration by the State Government."),a(),s(343,"p"),c(344,"Ambadungar RE Project has been initiated to harness the carbonatite deposit explored by AMD in the state of Gujarat. Initially, about 1.55 Ha of the deposit is proposed to be harnessed, which will be further extended based on the exploratory results of AMD. Action has been initiated to establish the technical feasibility and financial viability of the project."),a(),s(345,"h5",8),c(346,"Use & Consumption"),a(),s(347,"p"),c(348,"Rare earth materials are utilised in a wide range of critical products enabling many emerging green energy technologies, high-tech applications and defence systems, such as, hybrid cars, plug-inhybrid electric-vehicles (PHEVs), the latest generation of efficient windpower turbines, computer disc drives, missile guidance systems, etc. The lanthanide elements as a group have magnetic, chemical and spectroscopic properties that have led to their application in a wide range of end-uses. Cerium finds application in polishing of glass items like lenses & display screens of cathode-ray tubes, liquid-crystal displays & plasma-display panels, in petrol & diesel fuels as fuel additive and along with lanthanum for replacement of cadmium in red pigments. Mixed salts of the cerium group of elements, other than fluorides are used in medicine, non-irritating antiseptic dressings, waterproofing agents and fungicides in textile manufacture. The principal uses of commercially pure cerium compounds that are in the form of nitrate is in the manufacture of incandescent gas mantles and cerium compounds as oxide. It also finds usage as a polishing agent of glass. Cerium compounds are also used in ceramic and glass as colouring pigments and also as catalysts in Chemical Industry."),a(),s(349,"p"),c(350,"Cerium, lanthanum and neodymium are used as glass additives in optical lenses and display screens, as catalysts in automobiles to reduce sulphur dioxide emission, in multilayer capacitors and along with yttrium in magnesium, aluminium and hydrogen storage alloys. Mischmetal which is an alloy of cerium with small amounts of other rare earth metals is used in lighter flints, for desulphurisation in steel and foundry, and with lanthanum alloys, in batteries and hydrogen storage systems meant for electronics and hybrid cars. Cerium oxide is used in glass polishing industries."),a(),s(351,"p"),c(352,"Lanthanum oxide and neodymium compounds are used in special glass manufacture. Lanthanum finds application in X-ray films as phosphors; yttrium in advanced ceramics like nitrides,Y-stabilised ceramics, etc., and gadolinium in magnet alloys. Yttrium, europium and terbium are used as phosphors in displays of computers, TV, etc. and with lanthanum, cerium & gadolinium as phosphors in fluorescent and halogen lamps. Neodymium,samarium, dysprosium, praseodymium and terbium have application as high intensity magnets in electronics, electric motors and audio equipment. Lanthanum, erbium and ytterbium have application in fibre optics and lasers. Lanthanum and yttrium find application in solid oxide fuel cells. Scandium is used mainly in aluminium alloys for sporting goods. Scandium in minor amounts is used in semiconductors and special lighting, including halogen bulbs. Mixed rare earth products are used as catalysts in petroleum refining and fluid cracking. Neodymium is used in welding in heavy industries and also in MRI scanners. Praseodymium is not a primary element for any specific use, but finds use as a substitute for neodymium in magnets."),a(),s(353,"p"),c(354,"Samarium is used essentially for the Sm-Co magnets. Europium is a primary component of phosphorus and is responsible for white light in compact fluoroscent lamps when used with terbium compounds."),a(),s(355,"p"),c(356,"Erbium used as fibre optic and has emerged in the nineties as a remarkable tool for communication technology through which high quality rapid data in tight pulses can be transferred in speed unthinkable in the past."),a(),s(357,"p"),c(358,"The main application for neodymium-iron-boron (Nd-Fe-B) magnets are in automobiles for anti- lock brakes, and in computer hard disk drives, videos, CD-ROMs used in many small-size electronic consumer products, such as, digital cameras, where major advantage is their small sizes. Nickel metal hydride (Ni MH) batteries, containing mischmetal, a mixture of rare earth compounds, are used mainly in portable electronic equipment, such as, laptops, camcorders and mobile phones. Though, the market for batteries for portable electronic equipment is growing strongly, the Ni MH batteries are increasingly replaced by lithium-ion batteries."),a(),s(359,"p"),c(360,"Monazite contains about 25.28% P2O5 which can be recovered as a by-product for manufacture of fertilizers and production of elemental phosphorus or its salts. Beside, rare earths, thorium is also recovered from monazite. It is a source of atomic energy. An important use of thorium is for addition to tungsten in minute quantity (about 0.75%) to increase the ductility of tungsten wire and thus to facilitate its drawing into filaments used in electric lamps. Metallic thorium is also used in photoelectric cells and X-ray tubes and in certain alloys. Thorium is used as catalytic agent for various processes. Amongst thorium salts, thorium nitrate is used largely in the manufacture of incandescent gas mantles. Mesothorium, the chief radioactive element recovered as a by-product in the chemical treatment of monazite, is marketed usually in the form of its bromide and used in self-luminous paints or enamels. Mesothorium is also used in the treatment of certain types of cancer and skin diseases. "),a(),s(361,"h5",8),c(362,"Reserve/Resources"),a(),s(363,"p"),c(364,"The mineral monazite is a prescribed substance as per the Notification under the Atomic Energy Act, 1962. AMD has been carrying out its resource evaluation for over six decades. It occurs in association with other heavy minerals, such as, ilmenite, rutile, zircon, etc. in concentrations of 0.4 \u2013 4.3% of total heavies in the beach and inland placer deposits of the country. The resource estimates of monazite in the beach and inland placer deposits is 12.73 million tonnes as on March, 2021."),a(),s(365,"h5",8),c(366,"World Review"),a(),s(367,"p"),c(368,"As per Mineral Commodity Summaries, 2024, published by USGS, the total world reserves are estimated at 110 million tonnes of rare earth oxides equivalent content (REO) of which China alone accounts for 44 million tonnes (40%) followed by Vietnam (20%), Brazil (19%) and Russia (9%)."),a(),s(369,"p"),c(370,"As per World Mineral Production, 2018-22, British Geological Survey, China holds the leading position among producers of rare earth oxides with 210 thousand tonnes. The other major producers are USA, Myanmar, Australia, India, Russia, Madagascar, Vietnam and Malaysia. Concentrates/partially- processed intermediate products are further processed at many locations in Europe, USA, Japan and China. In China, the principal production centres of rare earths are located at Baotou, Inner Mongolia and in Jiangxi & Sichuan provinces. At Baotou, bastnaesite is recovered as a by-product of iron ore mining while in Sichuan and in Gansu, bastnaesite occurs as primary mineral. In Jiangxi, Guangdong, Hunan and Jiangsu provinces, the ion adsorption clays are the source of the greater proportion of world yttrium production."),a(),s(371,"p"),c(372,"The Russian Rare Earths Industry is based on loparite, a titanium-tantalum niobate mined from Lovozero massif in the Murmansk region. Rare earth minerals have been recovered as by-products from titanium-bearing heavy sands, particularly in Australia and from tin dredging in Malaysia."),a(),s(373,"h5",8),c(374,"Rank of India in World Production"),a(),s(375,"p"),c(376,"As per World Mineral Production, 2017-21, British Geological Survey, India\u2019s ranking in 2021 in world production in term of quantity was 2nd in Steel (crude/liquid) and aluminium (primary) followed by 3rd in Zinc (slabs) and Chromite; 4th in iron ore; 5th in Bauxite; 7th in Manganese ore; 11th in copper (refined); 12th in lead (refined); 17th in mangnesite and 19th in apatite & rock phosphate. The statistics on indigenous and world production of principal minerals and metals are as follows:"),a(),s(377,"h5",2),c(378,"Contribution and Rank of India in World Production of Principal Minerals & Metals, 2021"),a(),s(379,"div",3)(380,"table",10),Me(381,"caption"),s(382,"thead")(383,"tr",11)(384,"th",12),c(385," Sector "),a(),s(386,"th",12),c(387," Unity of Commodity "),a(),s(388,"th",13),c(389," Production quantity "),a(),s(390,"th",12),c(391," Contribution"),Me(392,"br"),c(393,"(Percentage) "),a(),s(394,"th",12),c(395," India\u2019s rank in World order"),s(396,"sup"),c(397,"$"),a()()(),s(398,"tr")(399,"th"),c(400," World "),a(),s(401,"th"),c(402," India* "),a()()(),s(403,"tbody")(404,"tr")(405,"td")(406,"strong"),c(407," Metallic\xa0Minerals"),a()(),s(408,"td"),c(409," \xa0 "),a(),s(410,"td"),c(411," \xa0 "),a(),s(412,"td"),c(413," \xa0 "),a(),s(414,"td"),c(415," \xa0 "),a(),s(416,"td"),c(417," \xa0 "),a()(),s(418,"tr")(419,"td"),c(420," Bauxite "),a(),s(421,"td"),c(422," '000 tonnes "),a(),s(423,"td"),c(424," 342600 "),a(),s(425,"td"),c(426," 22495 "),a(),s(427,"td"),c(428," 6.56 "),a(),s(429,"td")(430,"sub"),c(431,"5"),a(),c(432,"th "),a()(),s(433,"tr")(434,"td"),c(435," Chromite "),a(),s(436,"td"),c(437," '000 tonnes "),a(),s(438,"td"),c(439," 35100 "),a(),s(440,"td"),c(441," 3785 "),a(),s(442,"td"),c(443," 10.78 "),a(),s(444,"td")(445,"sub"),c(446,"3"),a(),c(447,"rd "),a()(),s(448,"tr")(449,"td"),c(450," Iron ore "),a(),s(451,"td"),c(452," million tonnes "),a(),s(453,"td"),c(454," 3108 "),a(),s(455,"td"),c(456," 254 "),a(),s(457,"td"),c(458," 8.17 "),a(),s(459,"td")(460,"sub"),c(461,"4"),a(),c(462,"th "),a()(),s(463,"tr")(464,"td"),c(465," Manganese ore "),a(),s(466,"td"),c(467," '000 tonnes "),a(),s(468,"td"),c(469," 56200 "),a(),s(470,"td"),c(471," 2347 "),a(),s(472,"td"),c(473," 4.17 "),a(),s(474,"td")(475,"sub"),c(476,"7"),a(),c(477,"th "),a()(),s(478,"tr")(479,"td")(480,"strong"),c(481,"Industrial Minerals**"),a()(),s(482,"td"),c(483," \xa0 "),a(),s(484,"td"),c(485," \xa0 "),a(),s(486,"td"),c(487," \xa0 "),a(),s(488,"td"),c(489," \xa0 "),a(),s(490,"td"),c(491," \xa0 "),a()(),s(492,"tr")(493,"td"),c(494," Magnesite "),a(),s(495,"td"),c(496," '000 tonnes "),a(),s(497,"td"),c(498," 34300 "),a(),s(499,"td"),c(500," 113 "),a(),s(501,"td"),c(502," 0.32 "),a(),s(503,"td")(504,"sub"),c(505,"17"),a(),c(506,"th "),a()(),s(507,"tr")(508,"td"),c(509," Apatite&Rock"),Me(510,"br"),c(511," phosphate "),a(),s(512,"td"),c(513," '000 tonnes "),a(),s(514,"td"),c(515," 222000 "),a(),s(516,"td"),c(517," 1395 "),a(),s(518,"td"),c(519," 0.62 "),a(),s(520,"td")(521,"sub"),c(522,"19"),a(),c(523,"th "),a()(),s(524,"tr")(525,"td")(526,"strong"),c(527," Metals"),a()(),s(528,"td"),c(529," \xa0 "),a(),s(530,"td"),c(531," \xa0 "),a(),s(532,"td"),c(533," \xa0 "),a(),s(534,"td"),c(535," \xa0 "),a(),s(536,"td"),c(537," \xa0 "),a()(),s(538,"tr")(539,"td"),c(540," Aluminium(primary) "),a(),s(541,"td"),c(542," '000tonnes "),a(),s(543,"td"),c(544," 67000 "),a(),s(545,"td"),c(546," 4016 "),a(),s(547,"td"),c(548," 5.99 "),a(),s(549,"td")(550,"sub"),c(551,"2"),a(),c(552,"nd "),a()(),s(553,"tr")(554,"td"),c(555," Copper(refined) "),a(),s(556,"td"),c(557," '000tonnes "),a(),s(558,"td"),c(559," 24800"),s(560,"sup"),c(561,"1/"),a()(),s(562,"td"),c(563," 484"),s(564,"sup"),c(565,"#"),a()(),s(566,"td"),c(567," 1.95 "),a(),s(568,"td")(569,"sub"),c(570,"11"),a(),c(571,"th "),a()(),s(572,"tr")(573,"td"),c(574," Steel(crude/liquid) "),a(),s(575,"td"),c(576," million tonnes "),a(),s(577,"td"),c(578," 1915 "),a(),s(579,"td"),c(580," 120.007 "),a(),s(581,"td"),c(582," 5.60 "),a(),s(583,"td")(584,"sub"),c(585,"2"),a(),c(586,"nd "),a()(),s(587,"tr")(588,"td"),c(589," Lead(refined) "),a(),s(590,"td"),c(591," '000 tonnes "),a(),s(592,"td"),c(593," 14400"),s(594,"sup"),c(595,"2/"),a()(),s(596,"td"),c(597," 191"),s(598,"sup"),c(599,"#@"),a()(),s(600,"td"),c(601," 1.32 "),a(),s(602,"td")(603,"sub"),c(604,"12"),a(),c(605,"rd "),a()(),s(606,"tr")(607,"td"),c(608," Zinc(slab) "),a(),s(609,"td"),c(610," '000tonnes "),a(),s(611,"td"),c(612," 14000 "),a(),s(613,"td"),c(614," 775 "),a(),s(615,"td"),c(616," 5.53 "),a(),s(617,"td")(618,"sub"),c(619,"3"),a(),c(620,"rd "),a()()()()(),s(621,"div",14),c(622," Source: World mineral production data compiled from World Mineral Production, 2017-2021; British Geological Survey."),Me(623,"br"),c(624," * Figures relate to financial year 2021-22 and MCDR returns for production data."),Me(625,"br"),c(626," ** Minerals declared as minor minerals vide Government of India Notification S.O. 423(E) dated 10th February, 2015 are not included due to non-availability of production with respect to India."),Me(627,"br"),c(628," $: India\u2019s rank based on production mentioned in World Mineral Production 2017-21; British Geological Survey."),Me(629,"br"),c(630," 1/ Figures relate to both primary and secondary refined copper, whether electrolytic or fire refined. Metal recovered from secondary materials by remelting alone is excluded."),Me(631,"br"),c(632," 2/ Figures relate to both primary and secondary refined lead and include the lead content of antimonial lead."),Me(633,"br"),c(634," # : production of copper (refined) and lead refined during 2021 was 491 and 893 thousand tonnes, respectively, as per World Mineral Production, 2017-2021 which includes both primary and secondary production."),Me(635,"br"),c(636," @: Production of lead (primary)."),Me(637,"br"),c(638," Note: Data in respect of World Mineral Production is on calendar year basis, however, the data on India\u2019s production is based on financial year. "),a()()())},dependencies:[en],styles:["h4[_ngcontent-%COMP%]{color:#e97a42}h5[_ngcontent-%COMP%]{font-weight:600}"]}),t})(),cB=(()=>{class t{constructor(e,i){this.translate=e,this.cdRef=i}ngOnInit(){this.language=localStorage.getItem("locale")||"English",this.translate.use(this.language),this.setBodyFont(this.language),this.translate.onLangChange.subscribe(e=>{this.language=e.lang,this.setBodyFont(this.language),this.cdRef.detectChanges()})}setBodyFont(e){"Hindi"===e?document.body.classList.add("hindi-font"):document.body.classList.remove("hindi-font")}}return t.\u0275fac=function(e){return new(e||t)(ke(Zt),ke(Cn))},t.\u0275cmp=wt({type:t,selectors:[["app-state-mineral-scenario"]],decls:1855,vars:0,consts:[[1,"inner-section"],[1,"container","screen-reader"],[1,"mt-4"],[1,"mt-4","text-center","mb-4"],[1,"table-responsive"],[1,"table","table-bordered","table-striped","mb-0"],["rowspan","2"],["colspan","3"],[1,"text-center"],[1,"alert","alert-warning","p-3","text-center"],[1,"mb-4"],["target","_blank","href","https://ibm.gov.in/IBMPortal/pages/Average_Sale_Price"],["target","_blank","href","https://ibm.gov.in/IBMPortal/pages/Indian_Minerals_Yearbook"],["target","_blank","href","https://ibm.gov.in/IBMPortal/pages/Monthly_Statistics_of_Mineral_Production___"]],template:function(e,i){1&e&&(Me(0,"app-navigation"),s(1,"div",0)(2,"div",1)(3,"h4"),c(4,"1. ANDHRA PRADESH"),a(),s(5,"h5",2),c(6,"Mineral Resources"),a(),s(7,"p"),c(8,"As per National Mineral Inventory as on 01.04.2020, Andhra Pradesh accounts for 30% kyanite, 31% garnet, 18% titanium minerals, 17% tungsten, 12% bauxite, 15% sillimanite, 8% vermiculite, 13% each limestone & Iron (magnetite), 6% each diamond & manganese ore resources of the country. Important minerals occurring in Andhra Pradesh are: apatite in Visakhapatnam district; asbestos in Anantapur district; garnet in East Godavari, Nellore & Srikakulam districts; iron ore (haematite) in Anantapur, Cuddapah, Guntur, Krishna, Kurnool & Nellore districts; iron ore (magnetite) in Prakasam district; lead- zinc in Cuddapah, Guntur & Prakasam districts; limestone in Anantapur, Cuddapah, East Godavari, West Godavari, Guntur, Krishna, Kurnool, Nellore, Visakhapatnam & Vizianagaram districts; manganese ore in Srikakulam & Vizianagaram districts; vermiculite in Nellore & Visakhapatnam districts."),a(),s(9,"p"),c(10,"Other minerals that occur in the State are bauxite in East Godavari & Visakhapatnam districts; chromite in Krishna district; copper in Guntur, Kurnool & Prakasam districts; diamond in Anantapur, Krishna & Kurnool districts; gold in Anantapur, Chittoor & Kurnool districts; graphite in East Godavari, West Godavari, Srikakulam, Visakhapatnam & Vizianagaram districts; kyanite in Nellore & Prakasam districts; magnesite in Cuddapah district; pyrite in Kurnool district; sillimanite in West Godavari & Srikakulam district; silver in Guntur district; titanium minerals in East Godavari, Krishna, Nellore, Srikakulam & Visakhapatnam districts; and tungsten in East Godavari district."),a(),s(11,"h5",2),c(12,"Production"),a(),s(13,"p"),c(14,"Many important minerals are produced in Andhra Pradesh.The principal minerals produced in the state are Gold Ore, Iron Ore, Limestone, Manganese Ore, Minor Mineral, and Vermiculite. Andhra Pradesh showed notable growth in several minerals during 2023-24. The state saw an increase in both quantity and value of gold ore production and a significant rise in primary gold. Iron ore production, however, declined by 32%, though its value still managed a modest increase of 10%. Limestone production remained robust, with a 14% growth in quantity and an 11% increase in value. Manganese ore production surged by 64%, significantly boosting its contribution to the national total. However, vermiculite production saw a sharp decline of 51%, while its value also dropped. The number of mines in Andhra Pradesh that submitted MCDR returns during 2023-24 is 182. "),a(),s(15,"h5",3),c(16,"Mineral (Excluding Atomic, Fuel & Minerals) Production in Andhra Pradesh during 2023-24"),a(),s(17,"div",4)(18,"table",5),Me(19,"caption"),s(20,"thead")(21,"tr")(22,"th",6),c(23," Mineral "),a(),s(24,"th",6),c(25," Unit "),a(),s(26,"th",7),c(27," Quantity "),a(),s(28,"th",7),c(29," Value(in Rs 000) "),a()(),s(30,"tr")(31,"th"),c(32," 2023-24 "),a(),s(33,"th"),c(34," % share in India "),a(),s(35,"th"),c(36," % change over Previous Year "),a(),s(37,"th"),c(38," 2023-24 "),a(),s(39,"th"),c(40," % share in India "),a(),s(41,"th"),c(42," % change over Previous Year "),a()()(),s(43,"tbody")(44,"tr")(45,"td"),c(46," Gold Ore "),a(),s(47,"td"),c(48," Tonne "),a(),s(49,"td"),c(50," 33687 "),a(),s(51,"td"),c(52," 4 "),a(),s(53,"td"),c(54," 9 "),a(),Me(55,"td"),s(56,"td"),c(57," \xa0 "),a(),s(58,"td"),c(59," \xa0 "),a()(),s(60,"tr")(61,"td"),c(62," Gold Primary "),a(),s(63,"td"),c(64," Kg "),a(),s(65,"td"),c(66," 82 "),a(),s(67,"td"),c(68," 5 "),a(),s(69,"td"),c(70," 673049 "),a(),s(71,"td"),c(72," 9439 "),a(),s(73,"td"),c(74," 0 "),a(),s(75,"td"),c(76," 29228 "),a()(),s(77,"tr")(78,"td"),c(79," Irone Ore "),a(),s(80,"td"),c(81," Tonne "),a(),s(82,"td"),c(83," 125203 "),a(),s(84,"td"),c(85," 0 "),a(),s(86,"td"),c(87," -32 "),a(),s(88,"td"),c(89," 107553 "),a(),s(90,"td"),c(91," 0 "),a(),s(92,"td"),c(93," 10 "),a()(),s(94,"tr")(95,"td"),c(96," Limestone "),a(),s(97,"td"),c(98," Tonne "),a(),s(99,"td"),c(100," 60015732 "),a(),s(101,"td"),c(102," 13 "),a(),s(103,"td"),c(104," 14 "),a(),s(105,"td"),c(106," 13299227 "),a(),s(107,"td"),c(108," 11 "),a(),s(109,"td"),c(110," 11 "),a()(),s(111,"tr")(112,"td"),c(113," Manganese Ore "),a(),s(114,"td"),c(115," Tonne "),a(),s(116,"td"),c(117," 351412 "),a(),s(118,"td"),c(119," 10 "),a(),s(120,"td"),c(121," 64 "),a(),s(122,"td"),c(123," 1952431 "),a(),s(124,"td"),c(125," 8 "),a(),s(126,"td"),c(127," 41 "),a()(),s(128,"tr")(129,"td"),c(130," Vermiculite "),a(),s(131,"td"),c(132," Tonne "),a(),s(133,"td"),c(134," 1127 "),a(),s(135,"td"),c(136," 100 "),a(),s(137,"td"),c(138," -51 "),a(),s(139,"td"),c(140," 724 "),a(),s(141,"td"),c(142," 99 "),a(),s(143,"td"),c(144," -55 "),a()()()()(),s(145,"p",8),c(146," Source: MCDR Returns Data is Provisional "),a(),s(147,"h4",2),c(148,"2. CHHATTISGARH"),a(),s(149,"h5",2),c(150,"Mineral Resources"),a(),s(151,"p"),c(152,"As per National Mineral Inventory as on 01.04.2020, the State accounts for about 36% tin ore, 20% bauxite, 19% iron ore (haematite), 6% limestone and 4% diamond resources of the country. Important mineral occurrences in the State are bauxite in Balarampur, Bilaspur, Dantewada, Jashpur, Kanker, Kawardha (Kabirdham), Korba, Raigarh & Sarguja districts; iron ore (haematite) in Bastar district, Bailadila deposit in Dantewada district, Chhote Dongar deposit in Kanker district, Rowghat, Chargaon, Metabodeli & Hahaladdi deposits in Rajnandgaon district and Boria Tibbu deposits in Dalli-Rajhara area, Durg district. Bailadila-Rowghat hill ranges in the State are considered to be one of the biggest iron ore fields in India. Limestone occurs in Baloda Bazar, Bastar, Bilaspur, Durg, Janjgir-Champa, Kawardha (Kabirdham), Raigarh, Raipur & Rajnandga on districts."),a(),s(153,"p"),c(154,"Other minerals found in the State are diamond in Raipur district; fluorite in Rajnandgaon district; garnet in Bastar district; gold in Raipur and Kanker district and tin in Bastar & Dantewada districts."),a(),s(155,"h5",2),c(156,"Production"),a(),s(157,"p"),c(158,"The principal minerals produced in the state are Bauxite, Limestone, Minor Mineral, Moulding Sand and Tin Concentrate Chhattisgarh continued to perform well in mineral production, particularly in iron ore, which saw a 9% rise in both quantity and value, cementing the state's role as a major contributor to the country's iron ore supply. Limestone production also grew steadily, with a 10% and 8% increase in volume and value respectively. While bauxite production experienced a slight decline, the value of production increased marginally. Conversely, tin concentrate production declined by over 50%, though Chhattisgarh remains the sole producer of this mineral in India. The number of mines in Chhattisgarh that submitted MCDR returns during 2023-24 is 139."),a(),s(159,"h5",3),c(160,"Mineral (Excluding Atomic, Fuel & Minerals) Production in Chhattisgarh during 2023-24"),a(),s(161,"div",4)(162,"table",5),Me(163,"caption"),s(164,"thead")(165,"tr")(166,"th",6),c(167," Mineral "),a(),s(168,"th",6),c(169," Unit "),a(),s(170,"th",7),c(171," Quantity "),a(),s(172,"th",7),c(173," Value(in Rs 000) "),a()(),s(174,"tr")(175,"th"),c(176," 2023-24 "),a(),s(177,"th"),c(178," % share in India "),a(),s(179,"th"),c(180," % change over Previous Year "),a(),s(181,"th"),c(182," 2023-24 "),a(),s(183,"th"),c(184," % share in India "),a(),s(185,"th"),c(186," % change over Previous Year "),a()()(),s(187,"tbody")(188,"tr")(189,"td"),c(190," Bauxite "),a(),s(191,"td"),c(192," Tonne "),a(),s(193,"td"),c(194," 1033176 "),a(),s(195,"td"),c(196," 4 "),a(),s(197,"td"),c(198," -2 "),a(),s(199,"td"),c(200," 1227841 "),a(),s(201,"td"),c(202," 5 "),a(),s(203,"td"),c(204," 1 "),a()(),s(205,"tr")(206,"td"),c(207," Graphite "),a(),s(208,"td"),c(209," Tonne "),a(),s(210,"td"),c(211," 1007 "),a(),s(212,"td"),c(213," 1 "),a(),s(214,"td"),c(215," 100 "),a(),s(216,"td"),c(217," 421 "),a(),s(218,"td"),c(219," 0 "),a(),s(220,"td"),c(221," 100 "),a()(),s(222,"tr")(223,"td"),c(224," Irone Ore "),a(),s(225,"td"),c(226," Tonne "),a(),s(227,"td"),c(228," 43747682 "),a(),s(229,"td"),c(230," 16 "),a(),s(231,"td"),c(232," 9 "),a(),s(233,"td"),c(234," 180538610 "),a(),s(235,"td"),c(236," 18 "),a(),s(237,"td"),c(238," 9 "),a()(),s(239,"tr")(240,"td"),c(241," Limestone "),a(),s(242,"td"),c(243," Tonne "),a(),s(244,"td"),c(245," 49278535 "),a(),s(246,"td"),c(247," 11 "),a(),s(248,"td"),c(249," 10 "),a(),s(250,"td"),c(251," 14188586 "),a(),s(252,"td"),c(253," 11 "),a(),s(254,"td"),c(255," 8 "),a()(),s(256,"tr")(257,"td"),c(258," Moulding Sand "),a(),s(259,"td"),c(260," Tonne "),a(),s(261,"td"),c(262," 20994 "),a(),s(263,"td"),c(264," 100 "),a(),s(265,"td"),c(266," 22 "),a(),s(267,"td"),c(268," 6497 "),a(),s(269,"td"),c(270," 100 "),a(),s(271,"td"),c(272," 21 "),a()(),s(273,"tr")(274,"td"),c(275," Tin Concentrate "),a(),s(276,"td"),c(277," Kg "),a(),s(278,"td"),c(279," 22335 "),a(),s(280,"td"),c(281," 100 "),a(),s(282,"td"),c(283," -51 "),a(),s(284,"td"),c(285," 17341 "),a(),s(286,"td"),c(287," 100 "),a(),s(288,"td"),c(289," -67 "),a()()()()(),s(290,"p",8),c(291," Source: MCDR Returns Data is Provisional "),a(),s(292,"h4",2),c(293,"3. GOA"),a(),s(294,"h5",2),c(295,"Mineral Resources"),a(),s(296,"p"),c(297,"Goa is well-known for its iron and manganese ores. Iron and manganese ore belts extend from south-east to north-west of the State. Manganese ores are associated with iron ores and occur as pockets of various sizes in the form of concretionary pebbles in shales. Important iron ore and manganese ore deposits are located at Bicholim, Sanguem and Satari talukas. Bauxite occurs in the North and South Goa districts."),a(),s(298,"h4",2),c(299,"4. GUJARAT"),a(),s(300,"h5",2),c(301,"Mineral Resources"),a(),s(302,"p"),c(303,"As per National Mineral Inventory as on 01.04.2020, the State is the sole holder of the country's marl and perlite resources and possesses 92% REE, 68 % fluorite, 28% diatomite, 10% limestone and 8% each bauxite & wollastonite resources. The important mineral occurrences in the State are: bauxite in Amreli, Bhavnagar, Devbhoomi Dwarka, Jamnagar, Junagadh, Kheda, Kachchh, Porbandar, Sabarkantha & Valsad districts; diatomite in Bhavnagar district; fluorite in Chhota Udaipur & Bharuch districts; limestone in Amreli, Banaskantha, Bharuch, Bhavnagar, Devbhoomi Dwarka, Gir Somnath, Jamnagar, Junagadh, Kheda, Kachchh, Panchmahals, Porbandar, Rajkot, Sabarkantha, Surat, Vadodara &Valsad districts; marl in Amreli, GirSomnath, Junagadh & Porbandar district; perlite in Rajkot district."),a(),s(304,"p"),c(305,"Other minerals that occur in the State are: apatite and rock phosphate in Panchmahal district; copper ore in Banaskantha district; graphite in Panchmahal district; lead-zinc and marble in Banaskantha & Vadodara districts; manganese ore in Panchmahal & Chhota Udaipur districts; vermiculite in Vadodara district; and wollastonite in Banaskantha district."),a(),s(306,"h5",2),c(307,"Production"),a(),s(308,"p"),c(309,"The principal minerals produced in the state are Bauxite, Limestone, Marl, Minor Mineral, and Sulphur. Gujarat\u2019s performance in the mineral sector was marked by moderate growth and some declines. Limestone production increased by 2%, while marl production surged by 24%, making it a key contributor to the national marl supply. However, the state saw a complete halt in fluorite production, with no reported output in 2023-24. Bauxite production saw a slight decline, while the value of production rose by 10%. Sulphur production in Gujarat also dipped by 7%. The number of mines in Gujarat that submitted MCDR returns during 2023-24 is 291."),a(),s(310,"h5",3),c(311,"Mineral (Excluding Atomic, Fuel & Minerals) Production in Gujarat during 2023-24 "),a(),s(312,"div",4)(313,"table",5),Me(314,"caption"),s(315,"thead")(316,"tr")(317,"th",6),c(318," Mineral "),a(),s(319,"th",6),c(320," Unit "),a(),s(321,"th",7),c(322," Quantity "),a(),s(323,"th",7),c(324," Value(in Rs 000) "),a()(),s(325,"tr")(326,"th"),c(327," 2023-24 "),a(),s(328,"th"),c(329," % share in India "),a(),s(330,"th"),c(331," % change over Previous Year "),a(),s(332,"th"),c(333," 2023-24 "),a(),s(334,"th"),c(335," % share in India "),a(),s(336,"th"),c(337," % change over Previous Year "),a()()(),s(338,"tbody")(339,"tr")(340,"td"),c(341," Bauxite "),a(),s(342,"td"),c(343," Tonne "),a(),s(344,"td"),c(345," 1616225 "),a(),s(346,"td"),c(347," 7 "),a(),s(348,"td"),c(349," -3 "),a(),s(350,"td"),c(351," 1622811 "),a(),s(352,"td"),c(353," 6 "),a(),s(354,"td"),c(355," 10 "),a()(),s(356,"tr")(357,"td"),c(358," Fluorite "),a(),s(359,"td"),c(360," Tonne "),a(),s(361,"td"),c(362," 0 "),a(),s(363,"td"),c(364," 0 "),a(),s(365,"td"),c(366," -100 "),a(),s(367,"td"),c(368," 0 "),a(),s(369,"td"),c(370," 0 "),a(),s(371,"td"),c(372," -100 "),a()(),s(373,"tr")(374,"td"),c(375," Limestone "),a(),s(376,"td"),c(377," Tonne "),a(),s(378,"td"),c(379," 23400469 "),a(),s(380,"td"),c(381," 5 "),a(),s(382,"td"),c(383," 2 "),a(),s(384,"td"),c(385," 5634977 "),a(),s(386,"td"),c(387," 5 "),a(),s(388,"td"),c(389," 3 "),a()(),s(390,"tr")(391,"td"),c(392," Marl "),a(),s(393,"td"),c(394," Tonne "),a(),s(395,"td"),c(396," 1081896 "),a(),s(397,"td"),c(398," 14 "),a(),s(399,"td"),c(400," -7 "),a(),Me(401,"td")(402,"td")(403,"td"),a(),s(404,"tr")(405,"td"),c(406," Sulphur "),a(),s(407,"td"),c(408," Tonne "),a(),s(409,"td"),c(410," 135697 "),a(),s(411,"td"),c(412," 14 "),a(),s(413,"td"),c(414," -7 "),a(),Me(415,"td")(416,"td")(417,"td"),a(),s(418,"tr")(419,"td"),c(420," Tin Concentrate "),a(),s(421,"td"),c(422," Kg "),a(),s(423,"td"),c(424," 22335 "),a(),s(425,"td"),c(426," 100 "),a(),s(427,"td"),c(428," -51 "),a(),s(429,"td"),c(430," 17341 "),a(),s(431,"td"),c(432," 100 "),a(),s(433,"td"),c(434," -67 "),a()()()()(),s(435,"p",8),c(436," Source: MCDR Returns Data is Provisional "),a(),s(437,"h4",2),c(438,"5. JHARKHAND"),a(),s(439,"h5",2),c(440,"Mineral Resources"),a(),s(441,"p"),c(442,"As per National Mineral Inventory as on 01.04.2020, Jharkhand has the sole resources of emerald mineral. It accounts for about 35% rock phosphate, 20% iron ore (haematite), 34% apatite, 9% andalusite, 20% cobalt ore, 15% copper ore, 9% graphite, 8% kyanite, 6% each bauxite & titanium minerals, 5% nickel ore and 4% silver ore resources of the country. Important minerals that occur in the State are bauxite in Dumka, Gumla, Latehar, Lohardaga & Palamu districts; copper in Hazaribagh & East Singhbhum districts; gold in Ranchi and East Singhbhum districts; graphite in Palamu and Latehar districts; iron ore (haematite) in West Singhbhum district; iron ore (magnetite) in Gumla, Hazaribagh, Latehar, Palamu & East Singhbhum districts; kyanite in Saraikela-Kharsawan, East Singhbhum & West Singhbhum districts; limestone in Bokaro, Dhanbad, Garhwa, Giridih, Hazaribagh, Palamu, Ranchi, East & West Singhbhum districts; manganese ore in West Singhbhum district."),a(),s(443,"p"),c(444,"Other minerals that occur in the State are andalusite and rock phosphate in Garwah district; apatite, chromite, cobalt, nickel, silver in East Singhbhum district; asbestos in East & West Singhbhum districts; garnet in Hazaribagh district;sillimanite in Hazaribagh district; titanium minerals in Gumla, Latehar Ranchi and East Singhbhum districts; and vermiculite in Giridih & Hazaribagh districts."),a(),s(445,"h5",2),c(446,"Production"),a(),s(447,"p"),c(448,"The principal minerals produced in the state are Bauxite, Copper Ore, Gold Ore, Gold Primary, Graphite, Iron Ore, Kyanite, Limestone and Minor Mineral. Jharkhand witnessed mixed trends across its minerals. Gold ore production increased by 14%, while the value of primary gold rose by 39%, indicating growing potential in the sector. Iron ore production remained stable with a slight decline in quantity, though its value increased by 14%. Bauxite production declined by 8%, but graphite production surged by 71%, contributing significantly to the national output. Kyanite production dropped dramatically by 90%, while the production of limestone and other minerals remained largely unchanged. The number of mines in Jharkhand that submitted MCDR returns during 2023-24 is 67."),a(),s(449,"h5",3),c(450,"Mineral (Excluding Atomic, Fuel & Minerals) Production in Jharkhand during 2023-24 "),a(),s(451,"div",4)(452,"table",5),Me(453,"caption"),s(454,"thead")(455,"tr")(456,"th",6),c(457,"Mineral"),a(),s(458,"th",6),c(459,"Unit"),a(),s(460,"th",7),c(461,"Quantity "),a(),s(462,"th",7),c(463,"Value(in Rs 000)"),a()(),s(464,"tr")(465,"th"),c(466,"2023-24"),a(),s(467,"th"),c(468,"% share in India"),a(),s(469,"th"),c(470,"% change over Previous Year"),a(),s(471,"th"),c(472,"2023-24"),a(),s(473,"th"),c(474,"% share in India"),a(),s(475,"th"),c(476,"% change over Previous Year"),a()()(),s(477,"tbody")(478,"tr")(479,"td"),c(480,"Bauxite"),a(),s(481,"td"),c(482,"Tonne"),a(),s(483,"td"),c(484,"2047706"),a(),s(485,"td"),c(486,"9"),a(),s(487,"td"),c(488,"-8"),a(),s(489,"td"),c(490,"3087455"),a(),s(491,"td"),c(492,"12"),a(),s(493,"td"),c(494,"-1"),a()(),s(495,"tr")(496,"td"),c(497,"Copper Ore"),a(),s(498,"td"),c(499,"Tonne"),a(),s(500,"td"),c(501,"4936"),a(),s(502,"td"),c(503,"0"),a(),s(504,"td"),c(505,"91"),a(),Me(506,"td")(507,"td")(508,"td"),a(),s(509,"tr")(510,"td"),c(511,"Gold Ore"),a(),s(512,"td"),c(513,"Tonne"),a(),s(514,"td"),c(515,"10079"),a(),s(516,"td"),c(517,"1"),a(),s(518,"td"),c(519,"14"),a(),Me(520,"td")(521,"td")(522,"td"),a(),s(523,"tr")(524,"td"),c(525,"Gold Primary"),a(),s(526,"td"),c(527,"Kg"),a(),s(528,"td"),c(529,"28"),a(),s(530,"td"),c(531,"2"),a(),s(532,"td"),c(533,"30 "),a(),s(534,"td"),c(535,"166140"),a(),s(536,"td"),c(537,"2"),a(),s(538,"td"),c(539,"39"),a()(),s(540,"tr")(541,"td"),c(542,"Graphite"),a(),s(543,"td"),c(544,"Tonne"),a(),s(545,"td"),c(546,"20756"),a(),s(547,"td"),c(548,"12"),a(),s(549,"td"),c(550,"71"),a(),s(551,"td"),c(552,"19635"),a(),s(553,"td"),c(554,"9"),a(),s(555,"td"),c(556,"85"),a()(),s(557,"tr")(558,"td"),c(559,"Iron Ore"),a(),s(560,"td"),c(561,"Tonne"),a(),s(562,"td"),c(563,"22896543"),a(),s(564,"td"),c(565,"8"),a(),s(566,"td"),c(567,"-1"),a(),s(568,"td"),c(569,"54925292"),a(),s(570,"td"),c(571,"6"),a(),s(572,"td"),c(573,"14"),a()(),s(574,"tr")(575,"td"),c(576,"Kyanite"),a(),s(577,"td"),c(578,"Tonne"),a(),s(579,"td"),c(580,"210"),a(),s(581,"td"),c(582,"6"),a(),s(583,"td"),c(584,"-90"),a(),s(585,"td"),c(586,"389"),a(),s(587,"td"),c(588,"5"),a(),s(589,"td"),c(590,"-90"),a()(),s(591,"tr")(592,"td"),c(593,"Limestone"),a(),s(594,"td"),c(595,"Tonne"),a(),s(596,"td"),c(597,"2861"),a(),s(598,"td"),c(599,"0"),a(),s(600,"td"),c(601,"5"),a(),s(602,"td"),c(603,"998"),a(),s(604,"td"),c(605,"0"),a(),s(606,"td"),c(607,"5"),a()()()()(),s(608,"p",8),c(609," Source: MCDR Returns Data is Provisional "),a(),s(610,"h4",2),c(611,"6. KARNATAKA"),a(),s(612,"h5",2),c(613,"Mineral Resources"),a(),s(614,"p"),c(615,"As per National Mineral Inventory as on 01.04.2020, Karnataka hosts the country's 79% vanadium ore, 69% iron ore (magnetite), 41% tungsten ore, 36% asbestos, 25% limestone, 19% gold ore (primary), 25% manganese ore, 12% kyanite and 7% PGM (metal) resources. The important mineral-occurrence found in the State are bauxite in Belagavi, Chikkamagaluru, Uttara & Dakshina Kannada and Udupi districts; chromite in Chikkamagaluru, Hassan &Mysuru districts; gold in Chitradurga, Dharwad, Kalaburagi, Hassan, Haveri, Hubli, Kolar, Raichur& Tumakuru districts; iron ore(haematite) in Bagalkot, Bellary, Chikkamagaluru, Chitradurga, Dharwad, Dawangare, Gadag, Uttara Kannada, Shivamogga & Tumakuru districts; iron ore (magnetite) in Chikkamagaluru, Hassan, Uttara & Dakshina Kannada and Shivamogga districts; kyanite in Chikkamagaluru, Chitradurga, Coorg, Mandya, Mysuru, Shivamogga & Dakshina Kannada districts; limestone in Bagalkot, Belagavi, Bellary, Chikkamagaluru, Chitradurga, Davangere, Gadag, Kalaburagi, Hassan, Mysuru, Uttara & Dakshina Kannada, Shivamogga, Tumakuru & Udupi districts; magnesite in Coorg, Mandya & Mysuru districts; manganese ore in Belagavi, Bellary Chikkamagaluru, Chitradurga, Davangere, Uttara Kannada, Shivamogga & Tumakuru districts."),a(),s(616,"p"),c(617,"Other minerals that occur in the State are asbestos in Chikkamagaluru, Hassan, Mandya, Mysuru and Shivamogga districts; pyrite in Chitradurga district; copper in Chikkamagaluru, Chitradurga, Kalaburagi, Hassan, Uttara Kannada, Raichur & Shivamogga districts; graphite in Kolar & Mysuru districts; molybdenum in Kolar & Raichur districts; nickel in Uttara Kannada district; Platinum Group of Metals in Davangere district; sillimanite in Hassan, Mysuru & Dakshina Kannada districts; silver in Chitradurga & Raichur districts; titanium minerals in Hassan, Uttara Kannada & Shivamogga districts; tungsten in Gadag, Kolar & Raichur districts; vanadium in Hassan, Uttara Kannada & Shivamogga districts; and vermiculite in Hassan, Mandya & Mysuru districts."),a(),s(618,"h5",2),c(619,"Production"),a(),s(620,"p"),c(621,"The principal minerals produced in the state are Gold Ore, Gold Primary, Iron Ore, Kyanite, Limestone Limeshell, Magnesite, Manganese Ore, Minor Mineral and Silver. Karnataka continues to dominate the gold sector, producing 94% of the country's gold ore and 93% of primary gold. The state saw steady growth in iron ore, with a 3% rise in production and a 21% increase in its value. Limestone production grew by 5%, while magnesite and manganese ore production saw more moderate changes. Karnataka also saw a remarkable surge in limeshell production, which increased by 256%, along with a significant rise in its value. The number of mines in Karnataka that submitted MCDR returns during 2023-24 is 177."),a(),s(622,"h5",3),c(623,"Mineral (Excluding Atomic, Fuel & Minerals) Production in Karnataka during 2023-24"),a(),s(624,"div",4)(625,"table",5),Me(626,"caption"),s(627,"thead")(628,"tr")(629,"th",6),c(630,"Mineral"),a(),s(631,"th",6),c(632,"Unit"),a(),s(633,"th",7),c(634,"Quantity "),a(),s(635,"th",7),c(636,"Value(in Rs 000)"),a()(),s(637,"tr")(638,"th"),c(639,"2023-24"),a(),s(640,"th"),c(641,"% share in India"),a(),s(642,"th"),c(643,"% change over Previous Year"),a(),s(644,"th"),c(645,"2023-24"),a(),s(646,"th"),c(647,"% share in India"),a(),s(648,"th"),c(649,"% change over Previous Year"),a()()(),s(650,"tbody")(651,"tr")(652,"td"),c(653,"Gold Ore"),a(),s(654,"td"),c(655,"Tonne"),a(),s(656,"td"),c(657,"716486"),a(),s(658,"td"),c(659,"94"),a(),s(660,"td"),c(661,"21"),a(),Me(662,"td")(663,"td")(664,"td"),a(),s(665,"tr")(666,"td"),c(667,"Gold Primary"),a(),s(668,"td"),c(669,"Kg"),a(),s(670,"td"),c(671,"1442"),a(),s(672,"td"),c(673,"93"),a(),s(674,"td"),c(675,"2"),a(),s(676,"td"),c(677,"9478723"),a(),s(678,"td"),c(679,"98"),a(),s(680,"td"),c(681,"26"),a()(),s(682,"tr")(683,"td"),c(684,"Irone Ore"),a(),s(685,"td"),c(686,"Tonne"),a(),s(687,"td"),c(688,"40884478"),a(),s(689,"td"),c(690,"15"),a(),s(691,"td"),c(692,"3"),a(),s(693,"td"),c(694,"139877356"),a(),s(695,"td"),c(696,"14"),a(),s(697,"td"),c(698,"21"),a()(),s(699,"tr")(700,"td"),c(701,"Kyanite"),a(),s(702,"td"),c(703,"Tonne"),a(),s(704,"td"),c(705,"0"),a(),s(706,"td"),c(707,"0"),a(),s(708,"td"),c(709,"-100"),a(),s(710,"td"),c(711,"0"),a(),s(712,"td"),c(713,"0"),a(),s(714,"td"),c(715,"-100"),a()(),s(716,"tr")(717,"td"),c(718,"Limeshell"),a(),s(719,"td"),c(720,"Tonne"),a(),s(721,"td"),c(722,"891"),a(),s(723,"td"),c(724,"100"),a(),s(725,"td"),c(726,"256"),a(),s(727,"td"),c(728,"2639"),a(),s(729,"td"),c(730,"100"),a(),s(731,"td"),c(732,"302"),a()(),s(733,"tr")(734,"td"),c(735,"Limestone"),a(),s(736,"td"),c(737,"Tonne"),a(),s(738,"td"),c(739,"40831626"),a(),s(740,"td"),c(741,"9"),a(),s(742,"td"),c(743,"5"),a(),s(744,"td"),c(745,"8333555"),a(),s(746,"td"),c(747,"7"),a(),s(748,"td"),c(749,"3"),a()(),s(750,"tr")(751,"td"),c(752,"Magnesite"),a(),s(753,"td"),c(754,"Tonne"),a(),s(755,"td"),c(756,"6816"),a(),s(757,"td"),c(758,"5"),a(),s(759,"td"),c(760,"-17"),a(),s(761,"td"),c(762,"45417"),a(),s(763,"td"),c(764,"7"),a(),s(765,"td"),c(766,"-31"),a()(),s(767,"tr")(768,"td"),c(769,"Manganese Ore"),a(),s(770,"td"),c(771,"Tonne"),a(),s(772,"td"),c(773,"355058"),a(),s(774,"td"),c(775,"10"),a(),s(776,"td"),c(777,"3"),a(),s(778,"td"),c(779,"2981744"),a(),s(780,"td"),c(781,"12"),a(),s(782,"td"),c(783,"15"),a()(),s(784,"tr")(785,"td"),c(786,"Silver"),a(),s(787,"td"),c(788,"Kg"),a(),s(789,"td"),c(790,"150"),a(),s(791,"td"),c(792,"0"),a(),s(793,"td"),c(794,"1"),a(),s(795,"td"),c(796,"10841"),a(),s(797,"td"),c(798,"0"),a(),s(799,"td"),c(800,"17"),a()()()()(),s(801,"p",8),c(802," Source: MCDR Returns Data is Provisional "),a(),s(803,"h4",2),c(804,"7. MADHYAPRADESH"),a(),s(805,"h5",2),c(806,"Mineral Resources"),a(),s(807,"p"),c(808,"As per National Mineral Inventory as on 01.04.2020, the State hosts the country's 90% diamond, 29% molybdenum, 23% copper ore, 12% manganese and 19% rock phosphate ore resources. Important mineral occurrences in the State are: bauxite in Annuppur, Balaghat, Guna, Jabalpur, Katni, Mandla, Rewa, Satna, Shahdol, Shivpuri, Sidhi & Vidisha districts; copper in Balaghat, Betul & Jabalpur districts; diamond in Chhatarpur and Panna district; ironore (haematite) in Betul, Gwalior, Jabalpur & Katni districts; limestone in Balaghat, Chhindwara, Damoh, Dhar, Hoshangabad, Jabalpur, Jhabua, Khargone, Katni, Mandsaur, Morena, Narsinghpur, Neemach, Rewa, Sagar, Satna, Sehore, Shahdol & Sidhi districts; manganese ore in Balaghat, Jabalpur and Jhabua districts; and vermiculite in Jhabua district."),a(),s(809,"p"),c(810,"Other minerals that occur in the State are: gold in Jabalpur, Katni & Sidhi districts; graphite in Betul & Sidhi districts; lead-zinc in Betul and Chindwara district; molybdenum in Balaghat district; potash in Panna district rock phosphate in Chhatarpur, Jhabua & Sagar districts; and sillimanite in Sidhi district."),a(),s(811,"h5",2),c(812,"Production"),a(),s(813,"p"),c(814,"Theprincipal minerals produced in the state are Bauxite, Copper Concentrate, Copper Ore, Diamond, Iron Ore, Limestone, Manganese Ore, Minor Mineral, and Phosphorite. Madhya Pradesh saw strong growth in key minerals during 2023-24. Limestone production increased by 24%, contributing significantly to both the national quantity and value. Iron ore production surged by 39%, and manganese ore production grew by 22%, further solidifying the state's position as a major mineral producer. However, phosphorite production declined by nearly half, reflecting a downward trend in this mineral. The number of mines in Madhya Pradesh that submitted MCDR returns during 2023-24 is 394."),a(),s(815,"h5",3),c(816,"Mineral (Excluding Atomic, Fuel & Minerals) Production in Madhya Pradesh during 2023-24"),a(),s(817,"div",4)(818,"table",5),Me(819,"caption"),s(820,"thead")(821,"tr")(822,"th",6),c(823,"Mineral"),a(),s(824,"th",6),c(825,"Unit"),a(),s(826,"th",7),c(827,"Quantity "),a(),s(828,"th",7),c(829,"Value(in Rs 000)"),a()(),s(830,"tr")(831,"th"),c(832,"2023-24"),a(),s(833,"th"),c(834,"% share in India"),a(),s(835,"th"),c(836,"% change over Previous Year"),a(),s(837,"th"),c(838,"2023-24"),a(),s(839,"th"),c(840,"% share in India"),a(),s(841,"th"),c(842,"% change over Previous Year"),a()()(),s(843,"tbody")(844,"tr")(845,"td"),c(846,"Bauxite"),a(),s(847,"td"),c(848,"Tonne"),a(),s(849,"td"),c(850,"581827"),a(),s(851,"td"),c(852,"2"),a(),s(853,"td"),c(854,"-3"),a(),s(855,"td"),c(856,"582347"),a(),s(857,"td"),c(858,"2"),a(),s(859,"td"),c(860,"5"),a()(),s(861,"tr")(862,"td"),c(863,"Copper Concentrate"),a(),s(864,"td"),c(865,"Tonne"),a(),s(866,"td"),c(867,"69873"),a(),s(868,"td"),c(869,"56"),a(),s(870,"td"),c(871,"9"),a(),s(872,"td"),c(873,"7151077"),a(),s(874,"td"),c(875,"54"),a(),s(876,"td"),c(877,"11"),a()(),s(878,"tr")(879,"td"),c(880,"Copper Ore"),a(),s(881,"td"),c(882,"Tonne"),a(),s(883,"td"),c(884,"2545820"),a(),s(885,"td"),c(886,"67"),a(),s(887,"td"),c(888,"18"),a(),Me(889,"td")(890,"td")(891,"td"),a(),s(892,"tr")(893,"td"),c(894,"Diamond"),a(),s(895,"td"),c(896,"Carat"),a(),s(897,"td"),c(898,"388"),a(),s(899,"td"),c(900,"100"),a(),s(901,"td"),c(902,"12"),a(),s(903,"td"),c(904,"61473"),a(),s(905,"td"),c(906,"100"),a(),s(907,"td"),c(908,"159"),a()(),s(909,"tr")(910,"td"),c(911,"Iron Ore"),a(),s(912,"td"),c(913,"Tonne"),a(),s(914,"td"),c(915,"6047463"),a(),s(916,"td"),c(917,"2"),a(),s(918,"td"),c(919,"39"),a(),s(920,"td"),c(921,"3816697"),a(),s(922,"td"),c(923,"0"),a(),s(924,"td"),c(925,"54"),a()(),s(926,"tr")(927,"td"),c(928,"Lime Stone"),a(),s(929,"td"),c(930,"Tonne"),a(),s(931,"td"),c(932,"62573297"),a(),s(933,"td"),c(934,"14"),a(),s(935,"td"),c(936,"24"),a(),s(937,"td"),c(938,"19532579"),a(),s(939,"td"),c(940,"16"),a(),s(941,"td"),c(942,"13"),a()(),s(943,"tr")(944,"td"),c(945,"Manganese Ore"),a(),s(946,"td"),c(947,"Tonne"),a(),s(948,"td"),c(949,"1040158"),a(),s(950,"td"),c(951,"30"),a(),s(952,"td"),c(953,"22"),a(),s(954,"td"),c(955,"7644522"),a(),s(956,"td"),c(957,"31"),a(),s(958,"td"),c(959,"3"),a()(),s(960,"tr")(961,"td"),c(962,"Phosphorite"),a(),s(963,"td"),c(964,"Tonne"),a(),s(965,"td"),c(966,"236964"),a(),s(967,"td"),c(968,"15"),a(),s(969,"td"),c(970,"-47"),a(),s(971,"td"),c(972,"327680"),a(),s(973,"td"),c(974,"3"),a(),s(975,"td"),c(976,"-32"),a()()()()(),s(977,"p",8),c(978," Source: MCDR Returns Data is Provisional "),a(),s(979,"h4",2),c(980,"8. MAHARASTRA"),a(),s(981,"h5",2),c(982,"Mineral Resources"),a(),s(983,"p"),c(984,"The principal mineral-bearing belts in Maharashtra are Vidarbha area in the east and Konkan area in the west. Important mineral occurrences are: bauxite in Kolhapur, Raigad, Ratnagiri, Satara, Sindhudurg & Thane districts; chromite in Bhandara, Chandrapur, Nagpur & Sindhudurg districts; fluorite in Chandrapur district; iron ore (haematite) in Chandrapur, Gadchiroli & Sindhudurg districts; iron ore (magnetite) in Gondia district; kyanite in Bhandara district; limestone in Ahmednagar, Chandrapur, Dhule, Gadchiroli, Nagpur, Nanded, Pune, Sangli & Yavatmal districts; manganese ore in Bhandara & Nagpur districts and sillimanite in Bhandaraand Chandrapur district."),a(),s(985,"p"),c(986,"Other minerals that occur in the State are: copper in Bhandara, Chandrapur, Gadchiroli & Nagpur districts; gold in Bhandara, Gadchiroli & Nagpur districts; graphite in Sindhudurg district; lead-zinc & tungsten in Nagpur district; silver in Bhandara, vanadium in gondia district; and titanium minerals in Gondia & Ratnagiri districts."),a(),s(987,"h5",2),c(988,"Production"),a(),s(989,"p"),c(990,"Theprincipal minerals producedinthe state are Bauxite,Fluorite(Graded),Iron Ore,Kyanite, Limestone, Manganese Ore, Minor Mineral, Sillimanite and Sulphur. Maharashtra demonstrated growth in the iron ore and manganese sectors, with production increasing significantly in both minerals. Iron ore production jumped by 76%, while manganese ore production increased by 38%. Bauxite production, however, experienced a slight decline, and the state also saw a reduction in the production of other minerals like fluorite and sulphur. Kyanite production surged dramatically by 832%, reflecting a sharp rise in its contribution to the national total. The number of mines in Maharashtra that submitted MCDR returns during 2023-24 is 110."),a(),s(991,"h5",3),c(992,"Mineral (Excluding Atomic, Fuel & Minerals) Production in Maharashtra during 2023-24"),a(),s(993,"div",4)(994,"table",5),Me(995,"caption"),s(996,"thead")(997,"tr")(998,"th",6),c(999,"Mineral"),a(),s(1e3,"th",6),c(1001,"Unit"),a(),s(1002,"th",7),c(1003,"Quantity "),a(),s(1004,"th",7),c(1005,"Value(in Rs 000)"),a()(),s(1006,"tr")(1007,"th"),c(1008,"2023-24"),a(),s(1009,"th"),c(1010,"% share in India"),a(),s(1011,"th"),c(1012,"% change over Previous Year"),a(),s(1013,"th"),c(1014,"2023-24"),a(),s(1015,"th"),c(1016,"% share in India"),a(),s(1017,"th"),c(1018,"% change over Previous Year"),a()()(),s(1019,"tbody")(1020,"tr")(1021,"td"),c(1022,"Bauxite"),a(),s(1023,"td"),c(1024,"Tonne"),a(),s(1025,"td"),c(1026,"849657"),a(),s(1027,"td"),c(1028,"4"),a(),s(1029,"td"),c(1030,"-6"),a(),s(1031,"td"),c(1032,"525488"),a(),s(1033,"td"),c(1034,"2"),a(),s(1035,"td"),c(1036,"-11"),a()(),s(1037,"tr")(1038,"td"),c(1039,"Fluorite"),a(),s(1040,"td"),c(1041,"Tonne"),a(),s(1042,"td"),c(1043,"783"),a(),s(1044,"td"),c(1045,"13"),a(),s(1046,"td"),c(1047,"-14"),a(),s(1048,"td"),c(1049,"4565"),a(),s(1050,"td"),c(1051,"74"),a(),s(1052,"td"),c(1053,"-22"),a()(),s(1054,"tr")(1055,"td"),c(1056,"Iron Ore"),a(),s(1057,"td"),c(1058,"Tonne"),a(),s(1059,"td"),c(1060,"10727273"),a(),s(1061,"td"),c(1062,"4"),a(),s(1063,"td"),c(1064,"76"),a(),s(1065,"td"),c(1066,"40921818"),a(),s(1067,"td"),c(1068,"4"),a(),s(1069,"td"),c(1070,"98"),a()(),s(1071,"tr")(1072,"td"),c(1073,"Kyanite"),a(),s(1074,"td"),c(1075,"Tonne"),a(),s(1076,"td"),c(1077,"3114"),a(),s(1078,"td"),c(1079,"94"),a(),s(1080,"td"),c(1081,"832"),a(),s(1082,"td"),c(1083,"7647"),a(),s(1084,"td"),c(1085,"95"),a(),s(1086,"td"),c(1087,"806"),a()(),s(1088,"tr")(1089,"td"),c(1090,"Limestone"),a(),s(1091,"td"),c(1092,"Tonne"),a(),s(1093,"td"),c(1094,"19330641"),a(),s(1095,"td"),c(1096,"4"),a(),s(1097,"td"),c(1098,"16"),a(),s(1099,"td"),c(1100,"4606724"),a(),s(1101,"td"),c(1102,"4"),a(),s(1103,"td"),c(1104,"15"),a()(),s(1105,"tr")(1106,"td"),c(1107,"Manganese Ore"),a(),s(1108,"td"),c(1109,"Tonne"),a(),s(1110,"td"),c(1111,"1032992"),a(),s(1112,"td"),c(1113,"30"),a(),s(1114,"td"),c(1115,"38"),a(),s(1116,"td"),c(1117,"9129169"),a(),s(1118,"td"),c(1119,"37"),a(),s(1120,"td"),c(1121,"10"),a()(),s(1122,"tr")(1123,"td"),c(1124,"Sillimanite"),a(),s(1125,"td"),c(1126,"Tonne"),a(),s(1127,"td"),c(1128,"771"),a(),s(1129,"td"),c(1130,"100"),a(),s(1131,"td"),c(1132,"-46"),a(),s(1133,"td"),c(1134,"2307"),a(),s(1135,"td"),c(1136,"100"),a(),s(1137,"td"),c(1138,"-39"),a()(),s(1139,"tr")(1140,"td"),c(1141,"Sulphur"),a(),s(1142,"td"),c(1143,"Tonne"),a(),s(1144,"td"),c(1145,"50577"),a(),s(1146,"td"),c(1147,"5"),a(),s(1148,"td"),c(1149,"9"),a(),Me(1150,"td")(1151,"td")(1152,"td"),a()()()(),s(1153,"p",8),c(1154," Source: MCDR Returns Data is Provisional "),a(),s(1155,"h4",2),c(1156,"9. ODISHA"),a(),s(1157,"h5",2),c(1158,"Mineral Resources"),a(),s(1159,"p"),c(1160,"As per National Mineral Inventory as on 01.04.2020, the State hosts the country's sole resources of ruby. It accounts for the country's 96% chromite, 93% nickel ore, 68% PGM metal, 69% cobalt ore, 41% bauxite, 34% manganese, 39% iron ore (haematite), 24% sillimanite, 20% vanadium ore, 37% zircon, 17% garnet, 15% titanium, 9% graphite and 6% REE. Important minerals that occur in the State are: bauxite in Bargarh, Balangir, Kalahandi, Kandhamal, Kendujhar, Koraput, Malkangiri, Rayagada & Sundargarh districts; chromite in Balasore, Dhenkanal, Jajpur & Kendujhar districts. Chromite deposits of Sukinda and Nuasahi ultramafic belt constitute 95% of the country's chromite resources. Besides, garnet in Ganjam, Kalahandi & Sambalpur districts; graphite in Bargarh, Boudh, Balangir, Kalahandi, Kandhamal, Koraput, Nuapada & Rayagada districts; iron ore (haematite) in Dhenkanal, Jajpur, Kendujhar, Mayurbhanj, Sambalpur & Sundargarh districts; iron ore (magnetite) in Kendujhar & Mayurbhanj district; limestone in Bargarh, Koraput, Malkangiri, Nuapada, Sambalpur & Sundargarh districts; manganese ore in Balangir, Kendujhar, Koraput, Rayagada, Sambalpur & Sundargarh districts; sillimanite in Ganjam & Deogarh districts; titanium minerals in Dhenkanal, Ganjam, Jajpur, Mayurbhanj & Puri districts; and zircon in Ganjam & Puri district."),a(),s(1161,"p"),c(1162,"Other minerals that occur in the State are asbestos in Kendujhar district; cobalt in Jajpur districts; copper in Mayurbhanj & Sambalpur districts; lead in Sargipalli area, Sundargarh district; and nickel in Jajpur Kendujhar & Mayurbhanj districts. Occurrences of ruby and emerald are reported from Balangir and Kalahandi districts, respectively. Platinum Group of Metals occur in Kendujhar district; silver in Sundargarh district; tin in Malkangiri districts; and vanadiferous magnetite occurs in Balasore & Mayurbhanj districts. "),a(),s(1163,"h5",2),c(1164,"Production"),a(),s(1165,"p"),c(1166,"The principal minerals produced in the state are Bauxite, Chromite, Graphite, Iolite, Iron Ore, Limestone, Manganese Ore, Minor Mineral and Sulphur. Odisha continued to lead in bauxite, chromite, and iron ore production, contributing a substantial share to the national total. Iron ore production grew by 6%, while its value increased by 20%, cementing Odisha\u2019s role as the largest producer of iron ore in the country. Chromite production declined slightly by 12%, while graphite production surged by 140%, contributing significantly to the national output. However, the state saw a slight decline in the value of bauxite production. The number of mines in Odisha that submitted MCDR returns during 2023-24 is 147."),a(),s(1167,"h5",3),c(1168,"Mineral (Excluding Atomic, Fuel & Minerals) Production in Odisha during 2023-24 "),a(),s(1169,"div",4)(1170,"table",5),Me(1171,"caption"),s(1172,"thead")(1173,"tr")(1174,"th",6),c(1175,"Mineral"),a(),s(1176,"th",6),c(1177,"Unit"),a(),s(1178,"th",7),c(1179,"Quantity "),a(),s(1180,"th",7),c(1181,"Value(in Rs 000)"),a()(),s(1182,"tr")(1183,"th"),c(1184,"2023-24"),a(),s(1185,"th"),c(1186,"% share in India"),a(),s(1187,"th"),c(1188,"% change over Previous Year"),a(),s(1189,"th"),c(1190,"2023-24"),a(),s(1191,"th"),c(1192,"% share in India"),a(),s(1193,"th"),c(1194,"% change over Previous Year"),a()()(),s(1195,"tbody")(1196,"tr")(1197,"td"),c(1198,"Bauxite"),a(),s(1199,"td"),c(1200,"Tonne"),a(),s(1201,"td"),c(1202,"17591967"),a(),s(1203,"td"),c(1204,"74"),a(),s(1205,"td"),c(1206,"1"),a(),s(1207,"td"),c(1208,"18498452"),a(),s(1209,"td"),c(1210,"72"),a(),s(1211,"td"),c(1212,"-9"),a()(),s(1213,"tr")(1214,"td"),c(1215,"Chromite"),a(),s(1216,"td"),c(1217,"Tonne"),a(),s(1218,"td"),c(1219,"3147954"),a(),s(1220,"td"),c(1221,"100"),a(),s(1222,"td"),c(1223,"-12"),a(),s(1224,"td"),c(1225,"48499212"),a(),s(1226,"td"),c(1227,"100"),a(),s(1228,"td"),c(1229,"4"),a()(),s(1230,"tr")(1231,"td"),c(1232,"Garnet"),a(),s(1233,"td"),c(1234,"Tonne"),a(),s(1235,"td"),c(1236,"0"),a(),s(1237,"td"),c(1238,"0"),a(),Me(1239,"td"),s(1240,"td"),c(1241,"0"),a(),s(1242,"td"),c(1243,"0"),a(),Me(1244,"td"),a(),s(1245,"tr")(1246,"td"),c(1247,"Graphite"),a(),s(1248,"td"),c(1249,"Tonne"),a(),s(1250,"td"),c(1251,"68054"),a(),s(1252,"td"),c(1253,"40"),a(),s(1254,"td"),c(1255,"140"),a(),s(1256,"td"),c(1257,"145401"),a(),s(1258,"td"),c(1259,"67"),a(),s(1260,"td"),c(1261,"41"),a()(),s(1262,"tr")(1263,"td"),c(1264,"Iron Ore"),a(),s(1265,"td"),c(1266,"Tonne"),a(),s(1267,"td"),c(1268,"148965636"),a(),s(1269,"td"),c(1270,"54"),a(),s(1271,"td"),c(1272,"6"),a(),s(1273,"td"),c(1274,"561982109"),a(),s(1275,"td"),c(1276,"57"),a(),s(1277,"td"),c(1278,"20"),a()(),s(1279,"tr")(1280,"td"),c(1281,"Limestone"),a(),s(1282,"td"),c(1283,"Tonne"),a(),s(1284,"td"),c(1285,"7923665"),a(),s(1286,"td"),c(1287,"2"),a(),s(1288,"td"),c(1289,"21"),a(),s(1290,"td"),c(1291,"3530967"),a(),s(1292,"td"),c(1293,"3"),a(),s(1294,"td"),c(1295,"39"),a()(),s(1296,"tr")(1297,"td"),c(1298,"Manganese Ore"),a(),s(1299,"td"),c(1300,"Tonne"),a(),s(1301,"td"),c(1302,"650855"),a(),s(1303,"td"),c(1304,"19"),a(),s(1305,"td"),c(1306,"1"),a(),s(1307,"td"),c(1308,"3223897"),a(),s(1309,"td"),c(1310,"13"),a(),s(1311,"td"),c(1312,"6"),a()(),s(1313,"tr")(1314,"td"),c(1315,"Sulphur"),a(),s(1316,"td"),c(1317,"Tonne"),a(),s(1318,"td"),c(1319,"257338"),a(),s(1320,"td"),c(1321,"26"),a(),s(1322,"td"),c(1323,"13"),a(),Me(1324,"td")(1325,"td")(1326,"td"),a()()()(),s(1327,"p",8),c(1328," Source: MCDR Returns Data is Provisional "),a(),s(1329,"h4",2),c(1330,"10. RAJASTHAN"),a(),s(1331,"h5",2),c(1332,"Mineral Resources"),a(),s(1333,"p"),c(1334,"Rajasthan is the richest state in terms of availability and variety of minerals in the country and produces different minerals along with Minor Minerals. As per National Mineral Inventory as on 01.04.2020, the State possesses substantial share of the total resources of potash (89%), lead & zinc ore (89%), wollastonite (92%), silver ore (86%), diatomite (72%), asbestos (59%), copper ore (52%), rock phosphate (30%), fluorite (27%), and tungsten (27%), gold (24%), limestone (13%), magnesite (12%), iron (magnetite) (7%) and 5% each apatite & pyrite. Important minerals that are found to occur in the State are: asbestos (amphibole) in Ajmer, Bhilwara, Dungarpur, Pali, Rajsamand & Udaipur districts; copper in Khetri belt in Jhunjhunu district & Dariba in Alwar district. Deposits of copper are also reported at Ajmer, Bharatpur, Bhilwara, Bundi, Chittorgarh, Dausa, Dungarpur, Jaipur, Jhunjhunu, Pali, Rajsamand, Sikar, Sirohi and Udaipur districts. Occurrence of other minerals, namely, garnet in Ajmer, Bhilwara, Jhunjhunu, Rajsamand, Sikar & Tonk districts; iron ore (haematite) in Alwar, Dausa, Jaipur, Jhunjhunu, Sikar & Udaipur districts; iron ore (magnetite) in Bhilwara, Jhunjhunu & Sikar districts and lead-zinc in Zawar in Udaipur district, Bamnia Kalan, Rajpura - Dariba in Rajsamand & Rampura/Agucha in Bhilwara district. Lead-zinc occurrences have also been reported from Ajmer, Chittorgarh, Pali, Sirohi and Udaipur districts. limestone occurs in Ajmer, Alwar, Banswara, Bhilwara, Bikaner, Bundi, Chittorgarh, Churu, Dungarpur, Jaipur, Jaisalmer, Jodhpur, Jhunjhunu, Kota, Nagaur, Pali,Sawai Madhopur, Sikar, Sirohi and Udaipur districts. Magnesite in Ajmer, Dungarpur, Pali & Udaipur districts; pyrite in Sikar district; rock phosphate in Alwar, Banswara, Jaipur, Jaisalmer & Udaipur districts; vermiculite in Ajmer & Barmer districts; and wollastonite in Ajmer, Dungarpur, Pali, Sirohi & Udaipur districts."),a(),s(1335,"p"),c(1336,"Other important minerals that occur in the State are: apatite in Udaipur & Sikar districts; bauxite in Kota district diatomite in Barmer & Jaisalmer districts; gold in Alwar, Banswara, Bhilwara, Dausa, Dungarpur, Sirohi & Udaipur districts; graphite in Ajmer, Alwar & Banswara districts; kyanite & sillimanite in Udaipur district; manganese ore in Banswara, & Udaipur districts; potash in Jaisalmer & Nagaur districts; silver in Ajmer, Bhilwara, Jhunjhunu, Rajsamand, Sikar & Udaipur districts and tungsten in Nagaur & Sirohi districts. "),a(),s(1337,"h5",2),c(1338,"Production"),a(),s(1339,"p"),c(1340,"The principal minerals produced in the state are Copper Concentrate, Copper Ore, Garnet, Iron Ore, Lead & Zinc Ore, Lead Concentrate, Limestone, Manganese Ore, Fluorite, Phosphorite, Selenite, Siliceous Earth, Silver, Wollastonite and Zinc Concentrate. Rajasthan remained a key player in copper, zinc, and lead production, with steady performance across these minerals. Limestone production grew by 10%, contributing 23% to the national output, while zinc concentrate and silver production remained stable. The state witnessed a significant rise in Garnet,Selenite and fluorite production, both of which saw dramatic percentage increases. However, phosphorite production fell by 14%, and there was a decline in manganese ore production as well. The number of mines in Rajasthan that submitted MCDR returns during 2023-24 is 110."),a(),s(1341,"h5",3),c(1342,"Mineral (Excluding Atomic, Fuel & Minerals) Production in Rajasthan during 2023-24 "),a(),s(1343,"div",4)(1344,"table",5)(1345,"thead")(1346,"tr")(1347,"th",6),c(1348,"Minerals"),a(),s(1349,"th",6),c(1350,"Unit"),a(),s(1351,"th",7),c(1352,"Quantity"),a(),s(1353,"th",7),c(1354,"Value (in Rs 000)"),a()(),s(1355,"tr")(1356,"th"),c(1357,"2023-24"),a(),s(1358,"th"),c(1359,"% Share"),Me(1360,"br"),c(1361,"in India"),a(),s(1362,"th"),c(1363,"% Change over"),Me(1364,"br"),c(1365,"Previous Year"),a(),s(1366,"th"),c(1367,"2023-24"),a(),s(1368,"th"),c(1369,"% Share"),Me(1370,"br"),c(1371,"in India"),a(),s(1372,"th"),c(1373,"% Change over"),Me(1374,"br"),c(1375,"Previous Year"),a()()(),s(1376,"tbody")(1377,"tr")(1378,"td"),c(1379,"Copper Concentrate"),a(),s(1380,"td"),c(1381,"tonne"),a(),s(1382,"td"),c(1383,"55357"),a(),s(1384,"td"),c(1385,"44"),a(),s(1386,"td"),c(1387,"13"),a(),s(1388,"td"),c(1389,"5990401"),a(),s(1390,"td"),c(1391,"46"),a(),s(1392,"td"),c(1393,"19"),a()(),s(1394,"tr")(1395,"td"),c(1396,"Copper Ore"),a(),s(1397,"td"),c(1398,"tonne"),a(),s(1399,"td"),c(1400,"1231500"),a(),s(1401,"td"),c(1402,"33"),a(),s(1403,"td"),c(1404,"11"),a(),Me(1405,"td")(1406,"td")(1407,"td"),a(),s(1408,"tr")(1409,"td"),c(1410,"Fluorite"),a(),s(1411,"td"),c(1412,"tonne"),a(),s(1413,"td"),c(1414,"5260"),a(),s(1415,"td"),c(1416,"87"),a(),s(1417,"td"),c(1418,"3528"),a(),s(1419,"td"),c(1420,"1578"),a(),s(1421,"td"),c(1422,"26"),a(),s(1423,"td"),c(1424,"3486"),a()(),s(1425,"tr")(1426,"td"),c(1427,"Garnet"),a(),s(1428,"td"),c(1429,"tonne"),a(),s(1430,"td"),c(1431,"23835"),a(),s(1432,"td"),c(1433,"100"),a(),s(1434,"td"),c(1435,"142"),a(),s(1436,"td"),c(1437,"94901"),a(),s(1438,"td"),c(1439,"100"),a(),s(1440,"td"),c(1441,"162"),a()(),s(1442,"tr")(1443,"td"),c(1444,"Iron Ore"),a(),s(1445,"td"),c(1446,"000t"),a(),s(1447,"td"),c(1448,"1527"),a(),s(1449,"td"),c(1450,"1"),a(),s(1451,"td"),c(1452,"16"),a(),s(1453,"td"),c(1454,"7304611"),a(),s(1455,"td"),c(1456,"1"),a(),s(1457,"td"),c(1458,"16"),a()(),s(1459,"tr")(1460,"td"),c(1461,"Lead & Zinc Ore"),a(),s(1462,"td"),c(1463,"tonne"),a(),s(1464,"td"),c(1465,"16521320"),a(),s(1466,"td"),c(1467,"100"),a(),s(1468,"td"),c(1469,"-1"),a(),Me(1470,"td")(1471,"td")(1472,"td"),a(),s(1473,"tr")(1474,"td"),c(1475,"Lead Concentrate"),a(),s(1476,"td"),c(1477,"tonne"),a(),s(1478,"td"),c(1479,"380795"),a(),s(1480,"td"),c(1481,"100"),a(),s(1482,"td"),c(1483,"1"),a(),s(1484,"td"),c(1485,"25473578"),a(),s(1486,"td"),c(1487,"100"),a(),s(1488,"td"),c(1489,"4"),a()(),s(1490,"tr")(1491,"td"),c(1492,"Zinc Concentrate"),a(),s(1493,"td"),c(1494,"tonne"),a(),s(1495,"td"),c(1496,"1710141"),a(),s(1497,"td"),c(1498,"100"),a(),s(1499,"td"),c(1500,"2"),a(),s(1501,"td"),c(1502,"85654289"),a(),s(1503,"td"),c(1504,"100"),a(),s(1505,"td"),c(1506,"-6"),a()(),s(1507,"tr")(1508,"td"),c(1509,"Limestone"),a(),s(1510,"td"),c(1511,"000t"),a(),s(1512,"td"),c(1513,"103113"),a(),s(1514,"td"),c(1515,"23"),a(),s(1516,"td"),c(1517,"10"),a(),s(1518,"td"),c(1519,"30012790"),a(),s(1520,"td"),c(1521,"24"),a(),s(1522,"td"),c(1523,"15"),a()(),s(1524,"tr")(1525,"td"),c(1526,"Manganese Ore"),a(),s(1527,"td"),c(1528,"tonne"),a(),s(1529,"td"),c(1530,"4968"),a(),s(1531,"td"),c(1532,"0"),a(),s(1533,"td"),c(1534,"-23"),a(),s(1535,"td"),c(1536,"17387"),a(),s(1537,"td"),c(1538,"0"),a(),s(1539,"td"),c(1540,"-23"),a()(),s(1541,"tr")(1542,"td"),c(1543,"Phosphorite"),a(),s(1544,"td"),c(1545,"tonne"),a(),s(1546,"td"),c(1547,"1320819"),a(),s(1548,"td"),c(1549,"85"),a(),s(1550,"td"),c(1551,"-14"),a(),s(1552,"td"),c(1553,"11108422"),a(),s(1554,"td"),c(1555,"97"),a(),s(1556,"td"),c(1557,"-6"),a()(),s(1558,"tr")(1559,"td"),c(1560,"Selenite"),a(),s(1561,"td"),c(1562,"tonne"),a(),s(1563,"td"),c(1564,"9353"),a(),s(1565,"td"),c(1566,"100"),a(),s(1567,"td"),c(1568,"2760"),a(),s(1569,"td"),c(1570,"13810"),a(),s(1571,"td"),c(1572,"100"),a(),s(1573,"td"),c(1574,"3024"),a()(),s(1575,"tr")(1576,"td"),c(1577,"Siliceous Earth"),a(),s(1578,"td"),c(1579,"tonne"),a(),s(1580,"td"),c(1581,"58047"),a(),s(1582,"td"),c(1583,"100"),a(),s(1584,"td"),c(1585,"81"),a(),s(1586,"td"),c(1587,"33390"),a(),s(1588,"td"),c(1589,"100"),a(),s(1590,"td"),c(1591,"92"),a()(),s(1592,"tr")(1593,"td"),c(1594,"Silver"),a(),s(1595,"td"),c(1596,"Kg"),a(),s(1597,"td"),c(1598,"745830"),a(),s(1599,"td"),c(1600,"100"),a(),s(1601,"td"),c(1602,"5"),a(),s(1603,"td"),c(1604,"53548545"),a(),s(1605,"td"),c(1606,"100"),a(),s(1607,"td"),c(1608,"22"),a()(),s(1609,"tr")(1610,"td"),c(1611,"Wollastonite"),a(),s(1612,"td"),c(1613,"tonne"),a(),s(1614,"td"),c(1615,"110637"),a(),s(1616,"td"),c(1617,"100"),a(),s(1618,"td"),c(1619,"0"),a(),s(1620,"td"),c(1621,"156133"),a(),s(1622,"td"),c(1623,"100"),a(),s(1624,"td"),c(1625,"3"),a()()()()(),s(1626,"p",8),c(1627," Source: MCDR Returns Data is Provisional "),a(),s(1628,"h4",2),c(1629,"11. TAMILNADU"),a(),s(1630,"h5",2),c(1631,"Mineral Resources"),a(),s(1632,"p"),c(1633,"As per National Mineral Inventory as on 01.04.2020, Tamil Nadu is the leading holder of country's resources of vermiculite, molybdenum, rutile, garnet, and ilmenite. The State accounts for the country's 79% vermiculite, 46% garnet, 66% molybdenum, 34% magnesite, 27% titanium minerals, 24% sillimanite, 8% PGM and 5% each graphite & iron (magnetite) resources. Important minerals that are found to occur in the State are: bauxite in Dindigul, Namakkal, Nilgiris & Salem districts; garnet in Ramanathapuram, Tiruchirapalli, Tiruvarur, Kanyakumari, Thanjavur & Tirunelveli districts; graphite in Madurai, Ramnathapuram, Sivaganga & Vellore districts; Similarly, occurrences of minerals, such as, limestone in Ariyalur, Coimbatore, Cuddalore, Dindigul, Kanchipuram, Karur, Madurai, Nagapattinam, Namakkal, Perambalur, Ramnathapuram, Salem, Thiruvallur, Tiruchirapalli, Tirunelveli, Vellore, Villupuram & Virudhunagar districts; magnesite in Coimbatore, Dharmapuri, Karur, Namakkal, Nilgiri, Salem, Tiruchirapalli, Tirunelveli & Vellore districts; titanium minerals in Kanyakumari, Nagapattinam, Ramanathapuram, Thiruvallur, Tirunelveli & Thoothukudi districts; vermiculite in Dharmapuri, Tiruchirapalli & Vellore districts; and zircon in Kanyakumari district have been established."),a(),s(1634,"p"),c(1635,"Other minerals that occur in the State are: apatite in Dharmapuri & Vellore districts; chromite in Coimbatore & Salem districts; copper, lead-zinc & silver in Villupuram district; gold in Dharmapuri district; iron ore (magnetite) in Dharmapuri, Erode, Nilgiris, Salem, Thiruvannamalai, Tiruchirapalli & Villupuram districts; kyanite in Kanyakumari & Tirunelveli districts; molybdenum in Dharmapuri, Dindigul & Vellore districts; pyrite in vellore district; sillimanite in Kanyakumari, Karur & Tirunelveli districts; tungsten in Madurai districts and wollastonite in Dharmapuri & Tirunelveli districts. "),a(),s(1636,"h5",2),c(1637,"Production"),a(),s(1638,"p"),c(1639,"The principal minerals produced in the state are Graphite, Limestone, Magnesite, Marl, Minor Mineraland Vermiculite. Tamil Nadu saw mixed results across its minerals. Limestone production increased by 9%, contributing 6% to the national total. Graphite production grew by 46%, while vermiculite production experienced a 100% increase from the previous year. On the other hand, marl production fell by 11%, and the state\u2019s magnesite production, despite a 26% rise in quantity, showed only modest growth in value. The number of mines in Tamil Nadu that submitted MCDR returns during 2023-24 is 222."),a(),s(1640,"h5",3),c(1641,"Mineral (Excluding Atomic, Fuel & Minerals) Production in Tamil Nadu during 2023-24 "),a(),s(1642,"div",4)(1643,"table",5),Me(1644,"caption"),s(1645,"thead")(1646,"tr")(1647,"th",6),c(1648,"Mineral"),a(),s(1649,"th",6),c(1650,"Unit"),a(),s(1651,"th",7),c(1652,"Quantity "),a(),s(1653,"th",7),c(1654,"Value(in Rs 000)"),a()(),s(1655,"tr")(1656,"th"),c(1657,"2023-24"),a(),s(1658,"th"),c(1659,"% share in India"),a(),s(1660,"th"),c(1661,"% change over Previous Year"),a(),s(1662,"th"),c(1663,"2023-24"),a(),s(1664,"th"),c(1665,"% share in India"),a(),s(1666,"th"),c(1667,"% change over Previous Year"),a()()(),s(1668,"tbody")(1669,"tr")(1670,"td"),c(1671,"Graphite"),a(),s(1672,"td"),c(1673,"Tonne"),a(),s(1674,"td"),c(1675,"79263"),a(),s(1676,"td"),c(1677,"47"),a(),s(1678,"td"),c(1679,"46"),a(),s(1680,"td"),c(1681,"52945"),a(),s(1682,"td"),c(1683,"24"),a(),s(1684,"td"),c(1685,"-20"),a()(),s(1686,"tr")(1687,"td"),c(1688,"Limestone"),a(),s(1689,"td"),c(1690,"Tonne"),a(),s(1691,"td"),c(1692,"26647327"),a(),s(1693,"td"),c(1694,"6"),a(),s(1695,"td"),c(1696,"9"),a(),s(1697,"td"),c(1698,"8554218"),a(),s(1699,"td"),c(1700,"7"),a(),s(1701,"td"),c(1702,"12"),a()(),s(1703,"tr")(1704,"td"),c(1705,"Magnesite"),a(),s(1706,"td"),c(1707,"Tonne"),a(),s(1708,"td"),c(1709,"78085"),a(),s(1710,"td"),c(1711,"59"),a(),s(1712,"td"),c(1713,"26"),a(),s(1714,"td"),c(1715,"452696"),a(),s(1716,"td"),c(1717,"74"),a(),s(1718,"td"),c(1719,"25"),a()(),s(1720,"tr")(1721,"td"),c(1722,"Marl"),a(),s(1723,"td"),c(1724,"Tonne"),a(),s(1725,"td"),c(1726,"524484"),a(),s(1727,"td"),c(1728,"33"),a(),s(1729,"td"),c(1730,"-11"),a(),s(1731,"td"),c(1732,"117350"),a(),s(1733,"td"),c(1734,"35"),a(),s(1735,"td"),c(1736,"-11"),a()(),s(1737,"tr")(1738,"td"),c(1739,"Vermiculite"),a(),s(1740,"td"),c(1741,"Tonne"),a(),s(1742,"td"),c(1743,"2"),a(),s(1744,"td"),c(1745,"0"),a(),s(1746,"td"),c(1747,"100"),a(),s(1748,"td"),c(1749,"7"),a(),s(1750,"td"),c(1751,"1"),a(),s(1752,"td"),c(1753,"100"),a()()()()(),s(1754,"p",8),c(1755," Source: MCDR Returns Data is Provisional "),a(),s(1756,"h4",2),c(1757,"12. TELANGANA"),a(),s(1758,"h5",2),c(1759,"Mineral Resources"),a(),s(1760,"p"),c(1761,"As per National Mineral Inventory as on 01.04.2020, Telangana accounts for 46% kyanite and 8% limestone resources of the country. Important minerals occurring in Telangana are corundum in Khammam district; garnet in Khammam district; iron ore (hematite) in Karimnagar and Khammam district; iron ore (magnetite) in Adilabad, Mahabubnagar and Warangal districts; limestone in Adilabad, Hyderabad, Karimnagar, Mahabubnagar, Nalgonda, Rangareddy, districts; manganese ore in Adilabad district; Other minerals that occur in the State are chromite, copper, graphite and kyanite in Khammam district."),a(),s(1762,"p"),c(1763,"Other minerals that occur in the State are: apatite in Dharmapuri & Vellore districts; chromite in Coimbatore & Salem districts; copper, lead-zinc & silver in Villupuram district; gold in Dharmapuri district; iron ore (magnetite) in Dharmapuri, Erode, Nilgiris, Salem, Thiruvannamala