<script>

    var postVal = $("#post").val().toUpperCase();


    if (postVal === "MATE (MINES)" || postVal === "BLASTER (MINES)" || postVal === "FRONT OFFICE ASSISTANT") {
        $('#tbllistofplantMachinery tr[id="hideTr3"]').hide();
		$('#tbllistofplantMachinery tr[id="aboutITIDesc"]').hide();
    }
    else {
        $('#tbllistofplantMachinery tr[id="hideTr3"]').show();
		$('#tbllistofplantMachinery tr[id="aboutITIDesc"]').show();
    }

    //debugger;
    //let itiyear, gender;
    $('#Str_passingyear2').on('change', function () {
        itiyear = this.value;
        var arr = [];
        arr = itiyear.split('-');
        //var YYYY = itiyear.getFullYear();
        //alert('Year : ' + arr[2]);
        $('#str_ItiPassingYear1').val(arr[2]);
        if ($('#str_ItiPassingYear1').val() <= "2023" && $('#str_ItiPassingYear1').val() != "") {
            $('#ItiAffidavitDiv').css('display', 'block');
        }
        else {
            $('#ItiAffidavitDiv').css('display', 'none');
        }
        //  if (itiyear && gender) $('#showOption').css('display', 'block');
        // else $('#showOption').css('display', 'none');

    });



    $("select").change(function () {
        var element = $(this);
        if (element.val() != "") {
            $(this).next("span").remove();
        }
    });

    $("input:visible:not([readonly],[type=hidden])").keyup(function () {
        var element = $(this);
        if (element.val() != "") {
            $(this).next("span").remove();
        }
    });

    $("#Str_passingyear,#Str_passingyear2").change(function () {
        //var d2 = new Date(date2.split("-").reverse().join("/"));
        //var dd2 = d2.getDate();
        //var mm2 = d2.getMonth() + 1;
        //var yy2 = d2.getFullYear();
        //var newdate2 = yy2 + "/" + mm2 + "/" + dd2;
        var dt1 = this.value.split('-').reverse().join('-');
        var dt2 = '01-08-2025'.split('-').reverse().join('-');
        if (new Date(dt1) > new Date(dt2)) {
            alert('The date of passing of qualifying exam like (ITI & 10th) should not be later than the cut-off date as advertised .');
            this.value = "";
        }

    });


    $("#StrRemarks").change(function () {
        $("#Str_TotalMarks").removeAttr('readonly');
        if (this.value == "CGPA") {
            $("#Str_TotalMarks").val('10')
            $("#Str_TotalMarks").attr('readonly', true);
            $("#Str_MarksObtained").val('');
            $("#Str_Marks").val('');
        }
    });

    $("#StrRemarks1").change(function () {
        $("#Str_TotalMarks1").removeAttr('readonly');
        if (this.value == "CGPA") {
            $("#Str_TotalMarks1").val('10')
            $("#Str_TotalMarks1").attr('readonly', true);
            $("#Str_MarksObtained1").val('');
            $("#Str_Marks1").val('');
        }
    });

    $("#StrRemarks2").change(function () {
        $("#Str_TotalMarks2").removeAttr('readonly');
        if (this.value == "CGPA") {
            $("#Str_TotalMarks2").val('10')
            $("#Str_TotalMarks2").attr('readonly', true);
            $("#Str_MarksObtained2").val('');
            $("#Str_Marks2").val('');
        }
    });


    $("#Str_TotalMarks,#Str_MarksObtained,#Str_TotalMarks1,#Str_MarksObtained1,#Str_TotalMarks2,#Str_MarksObtained2").change(function () {

        if (this.value == 0) {
            alert('The marks field should not accept ‘0’ (Zero) values.');
            this.value = "";
        }

        var Str_TotalMarks = $("#Str_TotalMarks").val();
        var Str_MarksObtained = $("#Str_MarksObtained").val();

        var Str_TotalMarks1 = $("#Str_TotalMarks1").val();
        var Str_MarksObtained1 = $("#Str_MarksObtained1").val();

        var Str_TotalMarks2 = $("#Str_TotalMarks2").val();
        var Str_MarksObtained2 = $("#Str_MarksObtained2").val();

        var StrRemarks = $("#StrRemarks").val();
        var StrRemarks1 = $("#StrRemarks1").val();
        var StrRemarks2 = $("#StrRemarks2").val();

        if (StrRemarks == "CGPA" && parseInt(Str_TotalMarks) > 10) {
            alert('If selected CGPA, maximum marks should be 10');
            $("#Str_TotalMarks").val('')
        }

        if (StrRemarks1 == "CGPA" && parseInt(Str_TotalMarks1) > 10) {
            alert('If selected CGPA, maximum marks should be 10');
            $("#Str_TotalMarks1").val('')
        }

        if (StrRemarks2 == "CGPA" && parseInt(Str_TotalMarks2) > 10) {
            alert('If selected CGPA, maximum marks should be 10');
            $("#Str_TotalMarks2").val('')
        }

        var Marks = 0;
        var Marks1 = 0;
        var Marks2 = 0;

        if (StrRemarks == "CGPA") {
            Marks = (parseFloat(Str_MarksObtained) * parseFloat(9.5));
        }
        else {
            Marks = (parseFloat(Str_MarksObtained) / parseFloat(Str_TotalMarks) * 100);
        }

        if (StrRemarks1 == "CGPA") {
            Marks1 = (parseFloat(Str_MarksObtained1) * parseFloat(9.5));
        }
        else {
            Marks1 = (parseFloat(Str_MarksObtained1) / parseFloat(Str_TotalMarks1) * 100);
        }

        if (StrRemarks2 == "CGPA") {
            Marks2 = (parseFloat(Str_MarksObtained2) * parseFloat(9.5));
        }
        else {
            Marks2 = (parseFloat(Str_MarksObtained2) / parseFloat(Str_TotalMarks2) * 100);
        }




        if (!isNaN(Marks)) {
            if (parseInt(Str_MarksObtained) <= parseInt(Str_TotalMarks)) {


                if (Marks.toFixed(2) >= 33) {
                    $("#Str_Marks").val(Marks.toFixed(2));
                }
                else {
                    alert('The obtained marks should not be greater than or equal to 33%');
                    $("#Str_Marks,#Str_MarksObtained").val('');
                }

            }
            else {
                alert('The obtained marks should not be greater than the total marks');
                $("#Str_Marks,#Str_MarksObtained").val('');
            }
        }

        if (!isNaN(Marks1)) {
            if (parseInt(Str_MarksObtained1) <= parseInt(Str_TotalMarks1)) {
                $("#Str_Marks1").val(Marks1.toFixed(2));
            }
            else {
                alert('The obtained marks should not be greater than the total marks');
                $("#Str_Marks1,#Str_MarksObtained1").val('');
            }
        }

        if (!isNaN(Marks2)) {
            if (parseInt(Str_MarksObtained2) <= parseInt(Str_TotalMarks2)) {
                if (Marks2.toFixed(2) >= 33) {
                    $("#Str_Marks2").val(Marks2.toFixed(2));
                }
                else {
                    alert('The obtained marks should not be greater than or equal to 33%');
                    $("#Str_Marks2,#Str_MarksObtained2").val('');
                }
            }
            else {
                alert('The obtained marks should not be greater than the total marks');
                $("#Str_Marks2,#Str_MarksObtained2").val('');
            }
        }
    });




    function error() {

        //debugger;
        var isValid = true;
        var noerror = 1;

        $("input").each(function () {
            $(this).next("span").remove();
        });

        if ($("#post").val() == "Mate (Mines)" || $("#post").val() == "Blaster (Mines)" || $("#post").val() == "Front Office Assistant") {
            $("input:visible:not([readonly],[type=hidden],#Str_course2,#file-upload,#Str_board2,#Str_Affiliation2,#Str_passingdetails2,#Str_passingyear2,#Str_duration2,#Str_TotalMarks2,#Str_MarksObtained2,#Str_Marks2,#Str_division2,#StrRemarks2,#Str_course1,#Str_board1,#Str_Affiliation1,#Str_passingdetails1,#Str_passingyear1,#Str_duration1,#Str_TotalMarks1,#Str_MarksObtained1,#Str_Marks1,#Str_division1,#StrRemarks1)").each(function () {
                var element = $(this);
                if (element.val() == "") {
                    isValid = false;
                    $(this).next("span").remove();
                    $(this).after("<span style='color:Red'> This field is required</span>");
                }
            });
        }
        else {
            $("input:visible:not([readonly],[type=hidden],#Str_course1,#file-upload,#Str_board1,#Str_Affiliation1,#Str_passingdetails1,#Str_passingyear1,#Str_duration1,#Str_TotalMarks1,#Str_MarksObtained1,#Str_Marks1,#Str_division1,#StrRemarks1)").each(function () {
                var element = $(this);
                if (element.val() == "") {
                    isValid = false;
                    $(this).next("span").remove();
                    $(this).after("<span style='color:Red'> This field is required</span>");
                }
            });
            //Akshat Code For DropDown List
            //if ($("#Str_Affiliation2").val() != "") {
            //    return true;
            //}
            //else {
            //    alert('Please select Affiliation Type')
            //    return false;
            //}

        }




        if ($("#post").val() != "Mate (Mines)" && $("#post").val() != "Blaster (Mines)" && $("#post").val() != "Front Office Assistant") {
            $("select").each(function () {
                var element = $(this);
                if (element.val() == "") {
                    isValid = false;
                    $(this).next("span").remove();
                    $(this).after("<span style='color:Red'> This field is required</span>");
                }
            });
        }

        if ($("#post").val() != "Mate (Mines)" || $("#post").val() != "Blaster (Mines)" || $("#post").val() != "Front Office Assistant") {
            debugger;
            var x = $('#str_ItiPassingYear1').val();
            var urlloc = $('#straffidavitUrl').attr('href');;
            if (parseFloat(x) <= 2023 && $("#file-upload")[0].files.length === 0) {

                isValid = false;
                $(this).next("span").remove();
                $("#file-upload").after("<span style='color:Red'> This field is required</span>");
            }
            if (parseFloat(x) <= 2023 && $('#str_ItiPassingYear1').val() != "") {
            }

            if (parseFloat(x) <= 2023 && $("#file-upload")[0].files.length != 0) {
                $(this).next("span").remove();
                isValid = true;
            }
            if (parseFloat(x) <= 2023 && $("#file-upload")[0].files.length == 0 && urlloc) {
    $("#file-upload").next("span").remove();
    isValid = true;
 }
            if (parseFloat(x) > 2023 && $("#file-upload")[0].files.length == 0) {
                isValid = true;
                $("#file-upload").next("span").remove();
            }

        }

        let input = $("#Str_passingyear").val(); // DD-MM-YYYY
        let [day, month, year] = input.split("-");
        let Str_passingyear = new Date(`${year}-${month}-${day}`);


        let input1 = $("#Str_passingyear2").val(); // DD-MM-YYYY
        let [day1, month1, year1] = input1.split("-");
        let Str_passingyear2 = new Date(`${year1}-${month1}-${day1}`);

        // var Str_passingyear = $("#Str_passingyear").val();
        var Str_passingyear1 = $("#Str_passingyear1").val();
        //var Str_passingyear2 = $("#Str_passingyear2").val();

        //if (Date.parse(Str_passingyear) >= Date.parse(Str_passingyear1)) {
        //    isValid = false;
        //    $("#Str_passingyear1").next("span").remove();
        //    $("#Str_passingyear1").after("<span style='color:Red'> Invalid Date Range</span>");
        //}

        //if (Date.parse(Str_passingyear1) >= Date.parse(Str_passingyear2)) {
        //    isValid = false;
        //    $("#Str_passingyear2").next("span").remove();
        //    $("#Str_passingyear2").after("<span style='color:Red'> Invalid Date Range</span>");
        //}

        if (Str_passingyear >= Str_passingyear2) {
            isValid = false;
            $("#Str_passingyear2").next("span").remove();
            $("#Str_passingyear2").after("<span style='color:Red'> Invalid Date Range</span>");
        }


        if (isValid == false) {
            noerror = 0;

        }

        if (noerror == 1) {
            if (confirm("Are you sure ?")) {
                return true;
            }
            else {
                return false;
            }
        }
        if (noerror == 0) {
            return false;
        }
    }
    $("#file-upload").on("change", function () {
        //debugger;
        /* current this object refer to input element */
        var $input = $(this);

        /* collect list of files choosen */
        var files = $input[0].files;

        var filename = files[0].name;

        /* getting file extenstion eg- .jpg,.png, etc */
        var extension = filename.substr(filename.lastIndexOf("."));

        /* define allowed file types */
        var allowedExtensionsRegx = /(\.pdf|\.PDF)$/i;

        /* testing extension with regular expression */
        var isAllowed = allowedExtensionsRegx.test(extension);
        //var file_size = $('#file-upload')[0].files[0].size;
        var file_size = $('#file-upload')[0].files[0].size;
        // if (file_size > 2097152) { if (file_size > 1048576)
        if (file_size > 1048576 || file_size < 20480) {
            //$("#file_error").html("File size is greater than 2MB");
            //$(".demoInputBox").css("border-color", "#FF0000");
            alert("File size must be between 20KB and 1MB");
            $(this).val("");
            isValid = false;
            $('#file-upload').next("span").remove();
            $('#file-upload').after("<span style='color:Red'> This field is required</span>");
            return false;
        }
        if (isAllowed) {
            // alert("File type is valid for the upload");
            /* file upload logic goes here... */
        } else {
            alert("Invalid File Type.");
            $(this).val("");
            return false;
        }
    });
</script>

