                                                        @*<td>@Html.TextBox("Str_passingdetails2", null, new { @class = "form-control", @readonly = "readonly" })</td>*@
                                                        <td>@Html.TextBox("Str_passingyear2", null, new { @class = "form-control input-append date", @placeholder = "dd-mm-yyyy" })</td>
                                                        <td>@Html.TextBox("Str_duration2", null, new { @class = "form-control", @type = "number", @min = "0", @max = "100" })</td>
