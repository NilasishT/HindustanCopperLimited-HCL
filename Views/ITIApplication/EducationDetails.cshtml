                                                        <td>@Html.TextBox("Str_MarksObtained2", null, new { @class = "form-control allownumericwithdecimal" })</td>
                                                        <td>@Html.TextBox("Str_Marks2", null, new { @class = "form-control allownumericwithdecimal", @readonly = "readonly" })</td>
