                                                        <td>@Html.TextBox("Str_board1", null, new { @class = "form-control" })</td>
                                                        <td>@Html.TextBox("Str_Affiliation1", null, new { @class = "form-control", @readonly = "readonly" })</td>
                                                        @*<td>@Html.TextBox("Str_passingdetails1", null, new { @class = "form-control" })</td>*@
                                                        <td>@Html.TextBox("Str_passingyear1", null, new { @class = "form-control input-append date", @placeholder = "dd-mm-yyyy" })</td>
                                                        <td>@Html.TextBox("Str_duration1", null, new { @class = "form-control", @type = "number", @min = "0", @max = "100" })</td>
                                                        <td>@Html.DropDownList("StrRemarks1", new List<SelectListItem> { new SelectListItem { Text = "%", Value = "%" }, new SelectListItem { Text = "CGPA", Value = "CGPA" } }, new { @class = "form-control" })</td>
                                                        <td>@Html.TextBox("Str_TotalMarks1", null, new { @class = "form-control allownumericwithdecimal" })</td>
                                                        <td>@Html.TextBox("Str_MarksObtained1", null, new { @class = "form-control allownumericwithdecimal" })</td>
                                                        <td>@Html.TextBox("Str_Marks1", null, new { @class = "form-control allownumericwithdecimal", @readonly = "readonly" })</td>
                                                        @*<td>@Html.TextBox("Str_division1", null, new { @class = "form-control" })</td>*@
                                                        @* <td>@Html.DropDownList("StrRemarks1", new List<SelectListItem> {
                                                            new SelectListItem {Text="Passed",Value="Passed"}
                                                                                     },"Select", new { @class = "form-control" })</td>*@
