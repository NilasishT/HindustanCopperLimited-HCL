                                                </table>

                                                @*@if (@ViewBag.IsGATERequired == false || @ViewBag.IsGATERequired == null)
                                                    {*@

                                                <div id="ItiAffidavitDiv" style="display:none;">
                                                    <h3 style="margin-top:80px;">Affidavit Details</h3>
                                                    <table border="2" style="text-align:center">
                                                        <tr>
                                                            <td><b class="margin20"> ITI Passing Year</b></td>

                                                        </tr>
                                                        <tr class="trGATEResult1">
                                                            @*<td>@Html.TextBox("str_GatePassingYear1", null, new { @class = "form-control", @Value = "2021", @readonly = "readonly" })</td>*@
                                                            @*<td>@Html.TextBox("str_ItiPassingYear1", null, new { @class = "form-control", @readonly = "readonly" })</td>*@
                                                            <td>@Html.TextBox("str_ItiPassingYear1", null, new { @class = "form-control" })</td>
                                                            <td><input type="file" id="file-upload" name="fileupload" value="@ViewBag.str_Itiaffidavit" accept="application/pdf" /></td>
                                                            <td>
