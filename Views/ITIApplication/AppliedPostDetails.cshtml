 @model Hindustancopperlimited.Models.tbl_mst_ITIAppliedPostDetails

@{
    ViewBag.Title = "Applied Post Details";
    Layout = "~/Views/Shared/ITIDashboard.cshtml";
}

<style>
    
.white
{
    color:#4d070f;
    padding-right:10px;
    padding-left:10px;
}
.white:hover
{
    color:White;
}

</style>

            
@using (Html.BeginForm("AppliedPostDetails", "ITIApplication", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
   
    @Html.AntiForgeryToken()   

    <div class="row" style="z-index:1; position:relative"> 
          <div class="col-md-12">          
            <div class="card">
            <div class="row">
             <div class="col-md-12" style="text-align:right">
             <span style="color:Red; font-size:14px; padding-left:65%"> (*) Fields are Mandatory </span>
             </div>

             <div class="col-lg-12">
                  <div class="well bs-component" style="text-align:center; padding:4px;  color:#6f3706; margin:8px; border:solid 1px #6f3706">
                   <div class="form-horizontal">
                    <fieldset>
                          <label style="font-size:medium"><b>Applied Post Details</b></label>
                        </fieldset>
                   </div>
                  </div>
                </div>   

           <div class="col-lg-12">
           <div class="well bs-component" style="text-align:center">
                    <div class="form-horizontal">
                    <fieldset>
                          <label class="col-lg-5 control-label">Unit<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-4">                       
                                  @Html.DropDownList("fk_unitId", null, new { @class = "form-control" })
                                 </div>
                                 </div>
                            </fieldset>
                          </div>

                   <div class="form-horizontal">
                    <fieldset>
                          <label class="col-lg-5 control-label">Application for Apprenticeship Training in the Trade<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-4"> 
                                 @Html.DropDownList("strTradeName", new List<SelectListItem> {
                                new SelectListItem {Text="Mate (Mines)",Value="Mate (Mines)"},
 new SelectListItem {Text="Blaster (Mines)",Value="Blaster (Mines)"},
 new SelectListItem {Text="Diesel Mechanic",Value="Diesel Mechanic"},
 new SelectListItem {Text="Fitter",Value="Fitter"},
 new SelectListItem {Text="Turner/Mechanist",Value="Turner/Mechanist"},
    new SelectListItem {Text="Welder (Gas & Electric)",Value="Welder (Gas & Electric)"},
  new SelectListItem {Text="Electrician",Value="Electrician"},
 new SelectListItem {Text="Draughtsman (Civil)",Value="Draughtsman (Civil)"},
 new SelectListItem {Text="Draughtsman (Mechanical)",Value="Draughtsman (Mechanical)"},
 new SelectListItem {Text="Computer Operator & Programming Assistant(COPA)",Value="Computer Operator & Programming Assistant(COPA)"},
 new SelectListItem {Text="Surveyor",Value="Surveyor"},
  new SelectListItem {Text="AC & Refrigeration Machine",Value="AC & Refrigeration Machine"},
   new SelectListItem {Text="Mason (Building Constructor)",Value="Mason (Building Constructor)"},
    new SelectListItem {Text="Carpenter",Value="Carpenter"},
    new SelectListItem {Text="Plumber",Value="Plumber"},
    new SelectListItem {Text="Horticulture Assistant",Value="Horticulture Assistant"},
    new SelectListItem {Text="Instrument Mechanics",Value="Instrument Mechanics"},
    new SelectListItem {Text="Solar Technician (Electrician)",Value="Solar Technician (Electrician)"},



                            }, "Select", new { @class = "form-control" })
                                 </div>
                                 </div>
                            </fieldset>
                          </div>

                    
                        </div>
                        </div>  


              

                 <div class="col-lg-12" style="border-top:1px solid #6f3706">                 
                </div>    

                 <div class="col-lg-12" style="padding-top:10px">
       <div class="form-group">
                          <div class="col-lg-10 col-lg-offset-5">                    
                            <button type="submit" class="btn btn-primary" onclick="return error()" value="Submit" name="strSubmit" id="Submit">Save & Next</button>
                            <button type="button" class="btn btn-primary" onclick="location.href = '../Dashboard/@Url.RequestContext.RouteData.Values["id"]';" value="Submit" name="strSubmit">Dashboard</button>
                          </div>
                        </div>

</div>

                 </div>
            </div>
          </div>
        </div>
   
}

@if (ViewBag.Message != null)
{
        <script type="text/javascript">
            window.onload = function () {
                var aa = "@ViewBag.Message";
                alert(aa);
            };
        </script>
}

<script>

    //ERROR
    function error() {
        var noerror = 1;

        if ($("#fk_untId").val() == "") {
            $("#fk_untId").next("span").remove();
            $("#fk_untId").after("<span style='color:Red'> This field is required</span>");
            noerror = 0;
        }

        if ($("#fk_postid").val() == "") {
            $("#fk_postid").next("span").remove();
            $("#fk_postid").after("<span style='color:Red'> This field is required</span>");
            noerror = 0;
        }

        if (noerror == 1) {
            if (confirm("Are you sure ?")) {

                if ($('#tbl_mst_Order')[0].checkValidity()) {
                    return true;
                }
            }
            else {
                return false;
            }

        }


        if (noerror == 0) {
            return false;



        }
    }

</script>