@{
    ViewBag.Title = "Upload Details";
    Layout = "~/Views/Shared/ITIDashboard.cshtml";
}

@using (Html.BeginForm("UploadDetails", "ITIApplication", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
   
    @Html.AntiForgeryToken()  

<div class="row" style="z-index:1; position:relative"> 
          <div class="col-md-12">          
            <div class="card">
            <div class="row">

            

             <div class="col-lg-12">
                  <div class="well bs-component" style="text-align:center; padding:4px;  color:#6f3706; margin:8px; border:solid 1px #6f3706">
                   <div class="form-horizontal">
                    <fieldset>
                          <label style="font-size:medium"><b>View Upload Details </b></label>
                        </fieldset>
                   </div>
                  </div>
                </div>   


<div class="col-lg-12" >
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>

                 <div class="form-group">
                    <label></label>
                          <div class="col-lg-12">
                          <center>
                           <table id="tbllistofplantMachinery" border="2"  style="text-align:center; width:80%">
           <tr>
          <td class="col-lg-4"><b>Type</b></td>
           <td class="col-lg-4"><b>View Upload</b></td>
	    </tr>

		<tr>		
        <td style="text-align:left; font-weight:bold">Photo <span style="color:Red"> (*)</span></td>
        <td><img id="blah" src="@ViewBag.Photo" width="100px"; height="100px";/></td>      
		</tr>
        <tr>		
        <td style="text-align:left; font-weight:bold">Signature <span style="color:Red"> (*)</span></td>
        <td><img id="blah1" src="@ViewBag.Signature" width="100px"; height="100px";/></td>
		</tr>
        
        <tr>		
        <td style="text-align:left; font-weight:bold">Matric/10th Certificate <span style="color:Red"> (*)</span></td>
        <td><img id="blah2" src="@ViewBag.Upload10" width="100px"; height="100px";/></td>
		</tr>
        
        <tr>		
        <td style="text-align:left; font-weight:bold">Higher Secondary/12th Certificate</td>
        <td><img id="blah3" src="@ViewBag.Upload12" width="100px"; height="100px";/></td>
		</tr>
        
        <tr>		
        <td style="text-align:left; font-weight:bold">Apprenticeship Registration Certificate <span style="color:Red"> (*)</span></td>
        <td><img id="blah4" src="@ViewBag.UploadRegistrationITI" width="100px"; height="100px";/></td>
		</tr>
               
        <tr>		
        <td style="text-align:left; font-weight:bold">ITI Certificate <span style="color:Red"> (*)</span></td>
        <td><img id="blah5" src="@ViewBag.UploadITI" width="100px"; height="100px";/></td>
		</tr>
             
         <tr id="Caste">		
        <td style="text-align:left; font-weight:bold">Category Certificate</td>
        <td><img id="blah6" src="@ViewBag.UploadCast" width="100px"; height="100px";/></td>
		</tr>
       

        <tr id="Affidavit">		
        <td style="text-align:left; font-weight:bold">Affidavit Certificate</td>
        <td><img id="blah7" src="@ViewBag.UploadAffidavit" width="100px"; height="100px";/></td>
		</tr>
        
        
        <tr id="Reference">		
        <td style="text-align:left; font-weight:bold">Reference Certificate</td>
        <td><img id="blah8" src="@ViewBag.UploadReference" width="100px"; height="100px";/></td>
		</tr>
	    </table>
           </center>
          </div>
          </div>
          </fieldset>
          </div>
          </div>
          </div>

          <div class="col-lg-12" style="border-top:1px solid #6f3706">                 
                </div>  

          <div class="col-lg-12" style="padding-top:10px">
       

</div>


</div>
</div>
</div>
</div>
}


