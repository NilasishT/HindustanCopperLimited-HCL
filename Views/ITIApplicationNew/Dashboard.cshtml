@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/ITIDashboard.cshtml";
}

<style>
    


table{margin-top:50px; width:60%}

table, th, td {
  border: 1px solid black;
  text-align:center;
}
.tableHead
{
    background-color:#ac8446;
    font-size:24px;
    font-family:Monotype Corsiva;
    font-weight:bold;    
}

.tableSubHead
{
    font-size:20px;
    font-family:Monotype Corsiva;
    font-weight:bold;  
    color:Green;
}

@@keyframes blinking {
        0%{
          color: #0000ff;
        }
        
        40%{
          color: #00fcff;
        }
        
        70%{
          color: #01b91b;
        }
        
        100%{
          color: #f6ff00;
        }
      }
      #demo{
        font-size: 1.3em;
        font-weight: bold;
        animation: blinking 1s infinite;
      }
      
      
      
</style>

<center>
<table>
  <thead>
  <tr><th colspan="2">
  @if (ViewBag.finalSubmit != "Yes")
  {
      <label style="color:Red; font-size:20px;">Pending for final submission</label> 
  }
  </th></tr>
    <tr>
        <th colspan="2" class="tableHead">@ViewBag.Name.ToString().ToUpper()</th>
    </tr>
  </thead>
  <tbody>
  <tr>
  @if (ViewBag.finalSubmit != "Yes" && ViewBag.dateEnd=="No")
  {
      <td colspan="2" class="tableSubHead"><a href="../AppliedPostDetails/@ViewBag.noticeId"> Applying Post Details </a></td>
  }
    </tr>
    <tr>      
      @if (ViewBag.checkPostDetails >= 1 && ViewBag.finalSubmit != "Yes" && ViewBag.dateEnd == "No")
      {
           <td colspan="2" class="tableSubHead"><a href="../PersonalDetails/@ViewBag.noticeId"> Personal Details </a></td> 
      }
      
    </tr>   
    <tr>    

       @if (ViewBag.checkPersonalDetails >= 1 && ViewBag.finalSubmit != "Yes" && ViewBag.dateEnd == "No")
      {
            <td colspan="2" class="tableSubHead"><a href="../EducationDetails/@ViewBag.noticeId"> Education Details </a></td>
      }      

    </tr>
    @*<tr>
     
       @if (ViewBag.checkQualificationDetails >= 1 && ViewBag.finalSubmit != "Yes" && ViewBag.dateEnd == "No")
       {
            <td colspan="2" class="tableSubHead"><a href="../ReferencesDetails/@ViewBag.noticeId"> References Details </a></td>
            
      }
      
    </tr>*@
     <tr>
     
        @*@if (ViewBag.checkRefDetails >= 1 && ViewBag.finalSubmit != "Yes" && ViewBag.dateEnd == "No")*@
        @if (ViewBag.checkQualificationDetails >= 1 && ViewBag.finalSubmit != "Yes" && ViewBag.dateEnd == "No")
        {
        <td colspan="2" class="tableSubHead"><a href="../UploadDetails/@ViewBag.noticeId"> Upload Details </a></td>
        }
      
    </tr>

    <tr>
     
        @if (ViewBag.shownewupload== "Yes")
        {
        <td colspan="2" class="tableSubHead" ><a style="color:Blue;" href="../UploadExtraDetails/@ViewBag.noticeId"> Upload New File </a></td>
        }
        @if (ViewBag.shownewupload == "Done")
        {
        <td colspan="2" class="tableSubHead"  ><a style="color:Blue;" href="../ViewUploadExtraDetails/@ViewBag.noticeId"> View Uploaded File </a></td>
        }
      
    </tr>

    <tr>
      
      
        @if (ViewBag.checkPostDetails != 0 && ViewBag.checkPersonalDetails != 0 && ViewBag.checkQualificationDetails != 0 && ViewBag.checkRefDetails != 0 && ViewBag.checkDocumentDetails != 0)
        {
            <td colspan="2" class="tableSubHead"><a href="../PrintApplication/@ViewBag.noticeId"> Print Application </a></td>
            
        }        

    </tr>

     <tr>
     
        @if (ViewBag.finalSubmit == "Yes")
        {
        <td colspan="2" class="tableSubHead"><a href="../Acknowledgement/@ViewBag.noticeId"> Acknowledgement Report </a></td>
        }
      
    </tr>

    <tr>
     
        @if (ViewBag.OfferLetter != 0)
        {
        <td colspan="2" class="tableSubHead"><a href="../OfferLetter/@ViewBag.noticeId" target="_blank" style="color:Blue"><span id="demo">Download Your Offer Letter</span> </a> </td>
        }
      
    </tr>

    <tr>
      <td colspan="2" class="tableSubHead"><a href="../ChangePassword"> Change Password </a></td>
    </tr><tr>
      <td colspan="2" class="tableSubHead"><a href="../Logout"> Logout </a></td>
    </tr>
    <tr>
      <td><img src="@ViewBag.Photo" width="100px" /></td>
      <td><img src="@ViewBag.Signature" width="100px" /></td>
    </tr>
  </tbody>
  
</table>
</center>