        @*<td>@Html.TextBox("Str_passingdetails1", null, new { @class = "form-control" })</td>*@
        <td>@Html.TextBox("Str_passingyear1", null, new { @class = "form-control input-append date", @placeholder = "dd-mm-yyyy" })</td>
        <td>@Html.TextBox("Str_duration1", null, new { @class = "form-control", @type = "number", @min = "0", @max = "100" })</td>
        <td>@Html.DropDownList("StrRemarks1", new List<SelectListItem> { new SelectListItem { Text = "%", Value = "%" }, new SelectListItem { Text = "CGPA", Value = "CGPA" } }, new { @class = "form-control" })</td>
