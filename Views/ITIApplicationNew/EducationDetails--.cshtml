}


<script>

    if ($("#post").val() == "Mate (Mines)" || $("#post").val() == "Blaster (Mines)") {
        $('#tbllistofplantMachinery tr[id="hideTr"]').show();
    }

    $("select").change(function () {
        var element = $(this);
        if (element.val() != "") {
            $(this).next("span").remove();
        }
    });

    $("input:not([readonly],[type=hidden])").keyup(function () {
        var element = $(this);
        if (element.val() != "") {
            $(this).next("span").remove();
        }
    });

    $("#Str_passingyear,#Str_passingyear2").change(function () {
        if (Date.parse(this.value) > Date.parse('10/07/2020')) {
            alert('The date of passing of qualifying exam like (ITI & 10th) should not be later than the cut-off date as advertised .');
            this.value = "";
        }

    });


    $("#StrRemarks").change(function () {
        $("#Str_TotalMarks").removeAttr('readonly');
        if (this.value == "CGPA") {
            $("#Str_TotalMarks").val('10')
            $("#Str_TotalMarks").attr('readonly', true);                                  
            $("#Str_MarksObtained").val('');
            $("#Str_Marks").val('');
        }
    });

    $("#StrRemarks1").change(function () {
        $("#Str_TotalMarks1").removeAttr('readonly');
        if (this.value == "CGPA") {
            $("#Str_TotalMarks1").val('10')
            $("#Str_TotalMarks1").attr('readonly', true);  
            $("#Str_MarksObtained1").val('');
            $("#Str_Marks1").val('');
        }
    });

    $("#StrRemarks2").change(function () {
        $("#Str_TotalMarks2").removeAttr('readonly');
        if (this.value == "CGPA") {
            $("#Str_TotalMarks2").val('10')
            $("#Str_TotalMarks2").attr('readonly', true);  
            $("#Str_MarksObtained2").val('');
            $("#Str_Marks2").val('');
        }
    });


    $("#Str_TotalMarks,#Str_MarksObtained,#Str_TotalMarks1,#Str_MarksObtained1,#Str_TotalMarks2,#Str_MarksObtained2").change(function () {

        if (this.value == 0) {
            alert('The marks field should not accept ‘0’ (Zero) values.');
            this.value = "";
        }

        var Str_TotalMarks = $("#Str_TotalMarks").val();
        var Str_MarksObtained = $("#Str_MarksObtained").val();

        var Str_TotalMarks1 = $("#Str_TotalMarks1").val();
        var Str_MarksObtained1 = $("#Str_MarksObtained1").val();

        var Str_TotalMarks2 = $("#Str_TotalMarks2").val();
        var Str_MarksObtained2 = $("#Str_MarksObtained2").val();

        var StrRemarks = $("#StrRemarks").val();
        var StrRemarks1 = $("#StrRemarks1").val();
        var StrRemarks2 = $("#StrRemarks2").val();

        if (StrRemarks == "CGPA" && parseInt(Str_TotalMarks) > 10) {
            alert('If selected CGPA, maximum marks should be 10');
            $("#Str_TotalMarks").val('')
        }

        if (StrRemarks1 == "CGPA" && parseInt(Str_TotalMarks1) > 10) {
            alert('If selected CGPA, maximum marks should be 10');
            $("#Str_TotalMarks1").val('')
        }

        if (StrRemarks2 == "CGPA" && parseInt(Str_TotalMarks2) > 10) {
            alert('If selected CGPA, maximum marks should be 10');
            $("#Str_TotalMarks2").val('')
        }

        var Marks = 0;
        var Marks1 = 0;
        var Marks2 = 0;

        if (StrRemarks == "CGPA") {
            Marks = (parseFloat(Str_MarksObtained) * parseFloat(9.5));
        }
        else {
            Marks = (parseFloat(Str_MarksObtained) / parseFloat(Str_TotalMarks) * 100);
        }

        if (StrRemarks1 == "CGPA") {
            Marks1 = (parseFloat(Str_MarksObtained1) * parseFloat(9.5));
        }
        else {
            Marks1 = (parseFloat(Str_MarksObtained1) / parseFloat(Str_TotalMarks1) * 100);
        }

        if (StrRemarks2 == "CGPA") {
            Marks2 = (parseFloat(Str_MarksObtained2) * parseFloat(9.5));
        }
        else {
            Marks2 = (parseFloat(Str_MarksObtained2) / parseFloat(Str_TotalMarks2) * 100);
        }




        if (!isNaN(Marks)) {
            if (parseInt(Str_MarksObtained) <= parseInt(Str_TotalMarks)) {
                $("#Str_Marks").val(Marks.toFixed(2));
            }
            else {
                alert('The obtained marks should not be greater than the total marks');
                $("#Str_Marks,#Str_MarksObtained").val('');
            }
        }

        if (!isNaN(Marks1)) {
            if (parseInt(Str_MarksObtained1) <= parseInt(Str_TotalMarks1)) {
                $("#Str_Marks1").val(Marks1.toFixed(2));
            }
            else {
                alert('The obtained marks should not be greater than the total marks');
                $("#Str_Marks1,#Str_MarksObtained1").val('');
            }
        }

        if (!isNaN(Marks2)) {
            if (parseInt(Str_MarksObtained2) <= parseInt(Str_TotalMarks2)) {
                $("#Str_Marks2").val(Marks2.toFixed(2));
            }
            else {
                alert('The obtained marks should not be greater than the total marks');
                $("#Str_Marks2,#Str_MarksObtained2").val('');
            }
        }
    });




    function error() {


        var isValid = true;
        var noerror = 1;

        $("input").each(function () {
            $(this).next("span").remove();
        });

        if ($("#post").val() == "Mate (Mines)" || $("#post").val() == "Blaster (Mines)") {
            $("input:not([readonly],[type=hidden],#Str_course2,#Str_board2,#Str_Affiliation2,#Str_passingdetails2,#Str_passingyear2,#Str_duration2,#Str_TotalMarks2,#Str_MarksObtained2,#Str_Marks2,#Str_division2,#StrRemarks2,#Str_course1,#Str_board1,#Str_Affiliation1,#Str_passingdetails1,#Str_passingyear1,#Str_duration1,#Str_TotalMarks1,#Str_MarksObtained1,#Str_Marks1,#Str_division1,#StrRemarks1)").each(function () {
                var element = $(this);
                if (element.val() == "") {
                    isValid = false;
                    $(this).next("span").remove();
                    $(this).after("<span style='color:Red'> This field is required</span>");
                }
            });
        }
        else {
            $("input:not([readonly],[type=hidden],#Str_course1,#Str_board1,#Str_Affiliation1,#Str_passingdetails1,#Str_passingyear1,#Str_duration1,#Str_TotalMarks1,#Str_MarksObtained1,#Str_Marks1,#Str_division1,#StrRemarks1)").each(function () {
                var element = $(this);
                if (element.val() == "") {
                    isValid = false;
                    $(this).next("span").remove();
                    $(this).after("<span style='color:Red'> This field is required</span>");
                }
            });

        }



        if ($("#post").val() != "Mate (Mines)" && $("#post").val() != "Blaster (Mines)") {
            $("select").each(function () {
                var element = $(this);
                if (element.val() == "") {
                    isValid = false;
                    $(this).next("span").remove();
                    $(this).after("<span style='color:Red'> This field is required</span>");
                }
            });
        }
        var Str_passingyear = $("#Str_passingyear").val();
        var Str_passingyear1 = $("#Str_passingyear1").val();
        var Str_passingyear2 = $("#Str_passingyear2").val();

        if (Date.parse(Str_passingyear) >= Date.parse(Str_passingyear1)) {
            isValid = false;
            $("#Str_passingyear1").next("span").remove();
            $("#Str_passingyear1").after("<span style='color:Red'> Invalid Date Range</span>");
        }

        if (Date.parse(Str_passingyear1) >= Date.parse(Str_passingyear2)) {
            isValid = false;
            $("#Str_passingyear2").next("span").remove();
            $("#Str_passingyear2").after("<span style='color:Red'> Invalid Date Range</span>");
        }

        if (Date.parse(Str_passingyear) >= Date.parse(Str_passingyear2)) {
            isValid = false;
            $("#Str_passingyear2").next("span").remove();
            $("#Str_passingyear2").after("<span style='color:Red'> Invalid Date Range</span>");
        }


        if (isValid == false) {
            noerror = 0;

        }

        if (noerror == 1) {
            if (confirm("Are you sure ?")) {
                return true;
            }
            else {
                return false;
            }
        }
        if (noerror == 0) {
            return false;
        }
    }

</script>

