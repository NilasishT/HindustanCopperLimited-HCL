    <script type="text/javascript">

        function PrintDiv() {
            var divToPrint = document.getElementById('printarea');
            var popupWin = window.open('', '_blank', 'width=1500,height=900,location=no,left=200px');
            popupWin.document.open();
            popupWin.document.write('<html lang="en"><body onload="window.print()" style="font-size: smaller;" >' + divToPrint.innerHTML + '</html>');
            popupWin.document.close();
        }
    </script>
