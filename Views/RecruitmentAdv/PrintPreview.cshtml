



@model Hindustancopperlimited.Models.Vw_Applicationdetails




@{
    ViewBag.Title = "Print Preview";
    Layout = "~/Views/Shared/ITIDashboard.cshtml";
}

<style>




    /* existing styles... */

    @@media print {
        /* Hide URL that browsers append after links when printing */
        a[href]:after {
            content: none !important;
        }
        /* Match font to screen preview */
        body, * {
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
            font-size: 13px !important;
            color: #333 !important;
        }
        /* Ensure tables print with borders */
        table, td, th {
            border: 1px solid #000 !important;
        }
    }

    .white {
        color: #4d070f;
        padding-right: 10px;
        padding-left: 10px;
    }

        .white:hover {
            color: White;
        }

    .col-lg-6 {
        padding-top: 9px;
    }
</style>

@using (Html.BeginForm("PrintPreview", "RecruitmentAdv", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()

    <div class="row" style="z-index:1; position:relative">
