                    @{



                        List<dynamic>
                            pvtExp = new List<dynamic>
                                ();
                        if (ViewBag.expAll != null)
                        {
                            foreach (var item in ViewBag.expAll)
                            {
                                try
                                {
                                    string orgType = "";
                                    string pvtEmployer = "";
                                    string pvtDesignation = "";
                                    string pvtSalary = "";

                                    try { orgType = Convert.ToString(item.str_organisationType ?? "").Trim(); } catch { }
                                    try { pvtEmployer = Convert.ToString(item.str_PvtEmployerName ?? "").Trim(); } catch { }
                                    try { pvtDesignation = Convert.ToString(item.str_PvtJobDesignation ?? "").Trim(); } catch { }
                                    try { pvtSalary = Convert.ToString(item.str_MonthlyGrossSalary ?? "").Trim(); } catch { }

                                    bool isPrivateOrgType = orgType.Equals("Private", StringComparison.OrdinalIgnoreCase) ||
                                    orgType.Equals("Other", StringComparison.OrdinalIgnoreCase);

                                    bool hasPvtFields = !string.IsNullOrEmpty(pvtEmployer) ||
                                    !string.IsNullOrEmpty(pvtDesignation) ||
                                    !string.IsNullOrEmpty(pvtSalary);

                                    if (isPrivateOrgType || hasPvtFields)
                                    {
                                        pvtExp.Add(item);
                                    }
                                }
                                catch { }
                            }
                        }
                    }



                    @if (pvtExp.Count > 0)
