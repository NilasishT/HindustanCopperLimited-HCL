                                            <input type="checkbox" id="CandidateAgree" name="CandidateMsg" required />
                                            I hereby declare that all the statement made in this application is True, Complete and Correct to the best of my knowledge and belief.
                                            I understand that in the event of any information being found untrue or incorrect at any stage or I am not satisfying any of the eligibility criteria stipulated,
                                            and also in case of creating influence/undue pressure regarding recruitment shall tantamount to cancellation of my candidature.
                                            <br />
                                        <p>
                                            <input type="checkbox" id="CandidateAgree" name="CandidateMsg" required />
                                            All the documents uploaded are viewed and checked in print-preview option and found correct. These documents are clearly visible and legible. I understand that any shortfall or upload of wrong document or illegible document may result in rejection of my application / my candidature to the applied post.
                                        </p>
                                        </p>
                                    </fieldset>
                                </div>
                            </div>
                        </div>
                    }

                    @*{{!-- Action Buttons --}}*@
                    <div class="col-lg-12" style="border-top:1px solid #6f3706"></div>
                    <div class="col-lg-12" style="padding-top:10px">
                        <div class="form-group">
                            <div class="col-lg-10 col-lg-offset-5">
                                @if (ViewBag.finalSubmit == "No")
                                {
                                    <button type="button" class="btn btn-primary" onclick="location.href = '../CandidatePersonalDetails/@Url.RequestContext.RouteData.Values["id"]';" name="strSubmit" id="Submit1">Edit</button>
                                    <button type="submit" class="btn btn-primary" value="Final Submit" name="strSubmit" id="Submit">Final Submit</button>
                                }
                                @if (ViewBag.finalSubmit == "Yes")
                                {
                                    <button type="button" class="btn btn-primary" onclick="location.href = '../ApplicationPrint/@Url.RequestContext.RouteData.Values["id"]';" name="strSubmit" id="Submit2">Print Application</button>
                                }
                                <button id="dashboard" type="button" class="btn btn-primary" onclick="location.href = '../Dashboard/@Url.RequestContext.RouteData.Values["id"]';" name="strSubmit">Dashboard</button>
                            </div>
                        </div>
                    </div>

                </div> @*{{!-- end .row --}}*@
            </div> @*{{!-- end .card --}}*@
        </div> @*{{!-- end .col-md-12 --}}*@
    </div>
}

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        var msg = "@ViewBag.Message";
        if (msg == "You have not applicable to this post!") {
            alert('Candidate Do Not Meet the Eligibility Criteria Due To Experience and Education.');
        }
    </script>
}

<script type="text/javascript">
    $("#dashboard").show();

    var aa = "@ViewBag.finalSubmit";
    if (aa == "Yes") {
        $("#dashboard").hide();
        $(".container").hide();
        window.print();
    }

    var afterPrint = function () {
        $("#dashboard").show();
        $(".container").show();
    };
    window.onafterprint = afterPrint;

    $("#CandidateAgree").change(function () {
        if ($(this).prop('checked')) {
            $("#Submit").removeAttr('disabled', 'disabled');
        } else {
            $("#Submit").attr('disabled', 'disabled');
        }
    });
</script>
