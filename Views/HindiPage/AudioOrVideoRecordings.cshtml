@{
    ViewBag.Title = "ऑडियो और वीडियो रिकॉर्डिंग्स | हिंदुस्तान कॉपर लिमिटेड";
    ViewBag.MetaDescription = "हिंदुस्तान कॉपर लिमिटेड (एचसीएल) भारत की अग्रणी तांबा उत्पादक कंपनी है, जो तांबे के खनन, संकेंद्रण, प्रगलन, परिशोधन और डाउनस्ट्रीम उत्पादों के क्षेत्र में कार्यरत है।";
    ViewBag.MetaKeywords = "हिंदुस्तान कॉपर लिमिटेड, एचसीएल, तांबा उत्पादक, तांबा खनन, तांबा संकेंद्रण, तांबा प्रगलन, तांबा परिशोधन, तांबा उत्पाद, तांबा कैथोड, तांबा सांद्रण, तांबा छड़ें, खान मंत्रालय, एचसीएल भारत, Hindustan Copper Limited, HCL, Copper Producer, Copper Mining, Copper Beneficiation, Copper Smelting, Copper Refining, Copper Products, Copper Cathodes, Copper Concentrates, Copper Rods, Ministry of Mines, HCL India.";

    Layout = "~/Views/Shared/HindiWebsitePage.cshtml";
}

<style>
    div#viewTable a:hover {
        text-decoration: underline;
    }

    div#viewTable a {
        font-size: 14px !important;
    }
</style>

<div id="totalCol">
    <div class="wrap">
        @Html.Partial("~\\Views\\Shared\\SideBarMenu_InvestorRelations_Hindi.cshtml")
        <div class="colmidl">
            <h1 class="titile">ऑडियो और वीडियो रिकॉर्डिंग्स एँड ट्रांसक्रिप्ट्स आँफ पोस्ट अर्निंग्स / क्वार्टरली कॉल्स</h1>

            <div id="viewTable">
                <table width="100%" cellpadding="0" cellspacing="0">
                    <tr>
                        <th colspan="2" style="padding-top:6px; padding-bottom:6px;">ऑडियो और वीडियो रिकॉर्डिंग्स एँड ट्रांसक्रिप्ट्स आँफ इन्वेस्टरस मीट </th>
                    </tr>
                    @foreach (var item in Model)
                    {
                    if (item.strEnglishFileUpload != null)
                    {
                    <tr>  <td class="tblcol2t" height="24"><a href=@item.strEnglishFileUpload.Replace("~", "../.." ) target="_blank">  @item.strEnglishText</a></td></tr>
                    }
                    else
                    {
                    <tr> <td class="tblcol2t" height="24"><a href="#">  @item.strEnglishText</a></td></tr>
                    }
                    }

                    <tr>
                        <td class="tblcol2t" height="24"><a href="@Url.Content(" ~ /Content/PDF/Transcript-of-Investor-Meet-to-Exchanges-18.09.2025.pdf")" target="_blank">ट्रांसक्रिप्ट आँफ इन्वेस्टर मीट टू एक्सचेंजस - 18.09.2025</a></td>
                    </tr>

                    <tr>
                        <td class="tblcol2t" height="24"><a href="@Url.Content(" ~ /Content/PDF/Audio-Recording-to-Exchanges-18.09.2025.pdf")" target="_blank">ऑडियो रिकॉर्डिंग टू एक्सचेंजस - 18.09.2025</a></td>
                    </tr>

                    <tr>
                        <td class="tblcol2t" height="24"><a href="@Url.Content(" ~ /Content/HCL-Audio-Transcript.mp3")" target="_blank">ऑडियो रिकॉर्डिंग आँफ इन्वेस्टरस मीट - 18.09.2025</a></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>