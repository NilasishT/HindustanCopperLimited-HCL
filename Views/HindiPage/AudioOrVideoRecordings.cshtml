@{
    ViewBag.Title = "AudioOrVideoRecordings";
    Layout = "~/Views/Shared/HindiWebsitePage.cshtml";
}

<div id="totalCol">
    <div class="wrap">
        @Html.Partial("~\\Views\\Shared\\SideBarMenu_InvestorRelations_Hindi.cshtml")
        <div class="colmidl">
            <h2 class="titile">ऑडियो और वीडियो रिकॉर्डिंग्स एँड ट्रांसक्रिप्ट्स आँफ पोस्ट अर्निंग्स / क्वार्टरली कॉल्स</h2>

            <div id="viewTable">
                <table width="100%" cellpadding="0" cellspacing="0">
                    <tr>
                        <th colspan="2" style="padding-top:6px; padding-bottom:6px;">ऑडियो और वीडियो रिकॉर्डिंग्स एँड ट्रांसक्रिप्ट्स आँफ इन्वेस्टरस मीट </th>
                    </tr>
                    @foreach (var item in Model)
                    {
                    if (item.strEnglishFileUpload != null)
                    {
                    <tr>  <td class="tblcol2t" height="24"><a href=@item.strEnglishFileUpload.Replace("~", "../.." ) target="_blank">  @item.strEnglishText</a></td></tr>
                    }
                    else
                    {
                    <tr> <td class="tblcol2t" height="24"><a href="#">  @item.strEnglishText</a></td></tr>
                    }
                    }

                    <tr>
                        <td class="tblcol2t" height="24"><a href="@Url.Content(" ~ /Content/PDF/Transcript-of-Investor-Meet-to-Exchanges-18.09.2025.pdf")" target="_blank">ट्रांसक्रिप्ट आँफ इन्वेस्टर मीट टू एक्सचेंजस - 18.09.2025</a></td>
                    </tr>

                    <tr>
                        <td class="tblcol2t" height="24"><a href="@Url.Content(" ~ /Content/PDF/Audio-Recording-to-Exchanges-18.09.2025.pdf")" target="_blank">ऑडियो रिकॉर्डिंग टू एक्सचेंजस - 18.09.2025</a></td>
                    </tr>

                    <tr>
                        <td class="tblcol2t" height="24"><a href="@Url.Content(" ~ /Content/HCL-Audio-Transcript.mp3")" target="_blank">ऑडियो रिकॉर्डिंग आँफ इन्वेस्टरस मीट - 18.09.2025</a></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>