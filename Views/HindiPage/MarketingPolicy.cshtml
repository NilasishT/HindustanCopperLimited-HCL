@{
    ViewBag.Title = "MarketingPolicy";
   Layout = "~/Views/Shared/HindiWebsitePage.cshtml";
   }
<div class="wrap">
     @Html.Partial("~/Views/Shared/HindiPage/Business.cshtml")
     <div class="colmidl">
    <h2 class="titile">विपणन नीति</h2>
    
        <div id="viewTable">
        
         <ul>
		 
		 @foreach (var item in Model)
        {
            if (item.strHindiFileUpload != null)
            {
                <li><span class="colmidlli"><a href=@item.strHindiFileUpload.Replace("~", "../..") target="_blank" style="color:#a34500; font-weight:600;">@item.strHindiText</a></span></li>
            }
            else
            {
                <li><span class="colmidlli"><a href="#">@item.strHindiText</a></span></li>
            }
        }
		
        <li><span class="colmidlli"><a href="@Url.Content("~/Content/PDF/MP%20By-Products.pdf")" target="_blank" style="color:#a34500; font-weight:600;">बाय-प्रोडक्ट्स के लिए मार्केटिंग पॉलिसी</a></span></li>
        <li><span class="colmidlli"><a href="#" target="_blank" style="color:#a34500; font-weight:600;">कॉपर उत्पाद के लिए विपणन नीति</a></span></li>
       
        </ul>
        
      
        </div>
        

        
        
    </div>