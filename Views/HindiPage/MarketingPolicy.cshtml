@{
    ViewBag.Title = "विपणन नीति | हिंदुस्तान कॉपर लिमिटेड";
    ViewBag.MetaDescription = "हिंदुस्तान कॉपर लिमिटेड (एचसीएल) भारत की अग्रणी तांबा उत्पादक कंपनी है, जो तांबे के खनन, संकेंद्रण, प्रगलन, परिशोधन और डाउनस्ट्रीम उत्पादों के क्षेत्र में कार्यरत है।";
    ViewBag.MetaKeywords = "हिंदुस्तान कॉपर लिमिटेड, एचसीएल, तांबा उत्पादक, तांबा खनन, तांबा संकेंद्रण, तांबा प्रगलन, तांबा परिशोधन, तांबा उत्पाद, तांबा कैथोड, तांबा सांद्रण, तांबा छड़ें, खान मंत्रालय, एचसीएल भारत, Hindustan Copper Limited, HCL, Copper Producer, Copper Mining, Copper Beneficiation, Copper Smelting, Copper Refining, Copper Products, Copper Cathodes, Copper Concentrates, Copper Rods, Ministry of Mines, HCL India.";

    Layout = "~/Views/Shared/HindiWebsitePage.cshtml";
}
<div class="wrap">
    @Html.Partial("~/Views/Shared/HindiPage/Business.cshtml")
    <div class="colmidl">
        <h1 class="titile">विपणन नीति</h1>

        <div id="viewTable">

            <ul>

                @foreach (var item in Model)
                {
                    if (item.strHindiFileUpload != null)
                    {
                        <li><span class="colmidlli"><a href=@item.strHindiFileUpload.Replace("~", "../..") target="_blank" style="color:#916100; font-weight:600;">@item.strHindiText</a></span></li>
                    }
                    else
                    {
                        <li><span class="colmidlli"><a href="#">@item.strHindiText</a></span></li>
                    }
                }

                <li><span class="colmidlli"><a href="@Url.Content("~/Content/PDF/MP%20By-Products.pdf")" target="_blank" style="color:#916100; font-weight:600;">बाय-प्रोडक्ट्स के लिए मार्केटिंग पॉलिसी</a></span></li>
                <li><span class="colmidlli"><a href="#" target="_blank" style="color:#916100; font-weight:600;">कॉपर उत्पाद के लिए विपणन नीति</a></span></li>

            </ul>


        </div>


    </div>

</div>