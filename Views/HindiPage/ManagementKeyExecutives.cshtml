@model IEnumerable<Hindustancopperlimited.Models.tbl_ManagementKeyExecutives>
@{
    ViewBag.Title = "मुख्य अधिकारी | हिंदुस्तान कॉपर लिमिटेड";
    ViewBag.MetaDescription = "हिंदुस्तान कॉपर लिमिटेड (एचसीएल) भारत की अग्रणी तांबा उत्पादक कंपनी है, जो तांबे के खनन, संकेंद्रण, प्रगलन, परिशोधन और डाउनस्ट्रीम उत्पादों के क्षेत्र में कार्यरत है।";
    ViewBag.MetaKeywords = "हिंदुस्तान कॉपर लिमिटेड, एचसीएल, तांबा उत्पादक, तांबा खनन, तांबा संकेंद्रण, तांबा प्रगलन, तांबा परिशोधन, तांबा उत्पाद, तांबा कैथोड, तांबा सांद्रण, तांबा छड़ें, खान मंत्रालय, एचसीएल भारत, Hindustan Copper Limited, HCL, Copper Producer, Copper Mining, Copper Beneficiation, Copper Smelting, Copper Refining, Copper Products, Copper Cathodes, Copper Concentrates, Copper Rods, Ministry of Mines, HCL India.";

    Layout = "~/Views/Shared/HindiWebsitePage.cshtml";
}


@Html.Partial("~/Views/Shared/HindiPage/About.cshtml")

<div class="colmidl">
    <h1 class="titile">मुख्य अधिकारी</h1>
    <!-- Page description -->
    <div style="text-align:center;">
        <strong>
            हमारे मुख्य अधिकारी और उनकी जिम्मेदारी क्षेत्र
            <br />
            (बोर्ड स्तर से नीचे)
        </strong>
    </div>

    <div id="viewTable" style="margin-top:4%;">
        <!-- प्रधान कार्यालय -->
        <table width="100%" cellspacing="0" cellpadding="0" border="0">
            <tbody>
                <tr>
                    <td style="background-color:#916100;" colspan="5" class="link55" height="30">
                        <strong class="blacksub" style="color:#ffffff;">
                            प्रधान कार्यालय
                        </strong>
                    </td>
                </tr>

                <tr class="tablebg">
                    <th>नाम</th>
                    <th>पद</th>
                    <th>उत्तरदायित्व क्षेत्र</th>
                    <th>फ़ोन</th>
                    <th>ईमेल आईडी</th>
                </tr>

                @foreach (var item in Model
                    .Where(x => x.strOfficeType == "Head Office")
                    .OrderBy(x => x.intSlNo))
                {
                    <tr>
                        <td>@item.strname_Hindi</td>
                        <td>@item.strDesignation_Hindi</td>
                        <td>@item.strReaponsibilityArea_Hindi</td>
                        <td>@item.strPhone</td>
                        <td>@item.strEmailId</td>
                    </tr>
                }
            </tbody>
        </table>


        <!-- यूनिट कार्यालय -->
        <table width="100%" cellspacing="0" cellpadding="0" border="0">
            <tbody>
                <tr>
                    <td style="background-color:#916100;" colspan="5" class="link55" height="30">
                        <strong class="blacksub" style="color:#ffffff;">
                            यूनिट कार्यालय
                        </strong>
                    </td>
                </tr>

                <tr class="tablebg">
                    <th>नाम</th>
                    <th>पद</th>
                    <th>उत्तरदायित्व क्षेत्र</th>
                    <th>फ़ोन</th>
                    <th>ईमेल आईडी</th>
                </tr>

                @foreach (var item in Model
                    .Where(x => x.strOfficeType == "Unit Offices")
                    .OrderBy(x => x.intSlNo))
                {
                    <tr>
                        <td>@item.strname_Hindi</td>
                        <td>@item.strDesignation_Hindi</td>
                        <td>@item.strReaponsibilityArea_Hindi</td>
                        <td>@item.strPhone</td>
                        <td>@item.strEmailId</td>
                    </tr>
                }
            </tbody>
        </table>


        <!-- बिक्री एवं अन्य कार्यालय -->
        <table width="100%" cellspacing="0" cellpadding="0" border="0" style="display:none;">
            <tbody>
                <tr>
                    <td bgcolor="#916100" colspan="5" class="link55" height="30">
                        <strong class="blacksub">
                            बिक्री &amp; अन्य कार्यालय
                        </strong>
                    </td>
                </tr>

                <tr bgcolor="#AC8446">
                    <th>नाम</th>
                    <th>पद</th>
                    <th>उत्तरदायित्व क्षेत्र</th>
                    <th>फ़ोन</th>
                    <th>ईमेल आईडी</th>
                </tr>

                @foreach (var item in Model
                    .Where(x => x.strOfficeType == "Sales & Other Offices")
                    .OrderBy(x => x.intSlNo))
                {
                    <tr>
                        <td>@item.strname_Hindi</td>
                        <td>@item.strDesignation_Hindi</td>
                        <td>@item.strReaponsibilityArea_Hindi</td>
                        <td>@item.strPhone</td>
                        <td>@item.strEmailId</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



