@{
    ViewBag.Title = "CorporatePresentation";
    Layout = "~/Views/Shared/HindiWebsitePage.cshtml";
}

 <div id="totalCol">
<div class="wrap">
    @Html.Partial("~\\Views\\Shared\\SideBarMenu_InvestorRelations_Hindi.cshtml")

     <div class="colmidl">
    <h2 class="titile">कॉर्पोरेट / निवेशक प्रस्तुति</h2>
    
        <div id="viewTable">
        <table width="100%" cellpadding="0" cellspacing="0">
        
        <tr>
        <th colspan="2" style="padding-top:6px; padding-bottom:6px;">कॉर्पोरेट / निवेशक प्रस्तुति </th>
        </tr>
        
        @foreach (var item in Model)
       {
           if (item.strHindiFileUpload != null)
           {           
             <tr><td class="tblcol2t" height="24"><a href=@item.strHindiFileUpload.Replace("~", "../..") target="_blank">  @item.strHindiText</a></td> </tr>
           }
           else
           {
                   <tr> <td class="tblcol2t" height="24"><a href="#" >  @item.strHindiText</a></td> </tr>
           }
       }
        <tr>
        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/CP_Aug_2021.pdf")"target="_blank">कॉर्पोरेट प्रस्तुति - अगस्त 2021</a></td>
        </tr>
        </table>

       
        
        </div>
        
        </div></div></div>

