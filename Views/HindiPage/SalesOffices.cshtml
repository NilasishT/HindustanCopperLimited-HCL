<script>
    function filterOfficesTable() {
        var input = document.getElementById("officeSearch");
        var filter = input.value.toUpperCase();
        var table = document.getElementById("officesDataTable");
        var rows = table.getElementsByClassName("office-row");

        for (var i = 0; i < rows.length; i += 3) {
            if (rows[i]) {
                var officeNameText = rows[i].getElementsByTagName("td")[0].textContent || rows[i].getElementsByTagName("td")[0].innerText;
                var addressText = rows[i].getElementsByTagName("td")[2].textContent || rows[i].getElementsByTagName("td")[2].innerText;

                var combinedText = (officeNameText + " " + addressText).toUpperCase();

                if (combinedText.indexOf(filter) > -1) {
                    rows[i].style.display = "";
                    if (rows[i + 1]) rows[i + 1].style.display = "";
                    if (rows[i + 2]) rows[i + 2].style.display = "";
                } else {
                    rows[i].style.display = "none";
                    if (rows[i + 1]) rows[i + 1].style.display = "none";
                    if (rows[i + 2]) rows[i + 2].style.display = "none";
                }
            }
        }
    }
</script>


<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    (function () {
        "use strict";

        // कार्यालयों का विवरण। Production में coordinates की जाँच करें।
        var offices = [
            {
                name: "कॉर्पोरेट कार्यालय — कोलकाता",
                address: "हिंदुस्तान कॉपर लिमिटेड, ताम्र भवन, 1, आशुतोष चौधरी एवेन्यू, कोलकाता - 700 019",
                lat: 22.5360,
                lng: 88.3650
            },
            {
                name: "समन्वय कार्यालय — नई दिल्ली",
                address: "हिंदुस्तान कॉपर लिमिटेड, स्कोप मिनार, दूसरी मंजिल, नॉर्थ टावर, लक्ष्मी नगर, दिल्ली - 110 092",
                lat: 28.6270,
                lng: 77.3040
            }
        ];

        var statusElement =
            document.getElementById("nearestOfficeStatus");

        var findButton =
            document.getElementById("findNearestOfficeBtn");

        var mapStatus =
            document.getElementById("nearestOfficeMapStatus");

        var mapContainer =
            document.getElementById("nearestOfficeMap");

        var officeMarkers = [];
        var userMarker = null;
        var map = null;
        var mapInitialized = false;
        var mapTilesLoaded = false;

        // --------------------------------------------------
        // मैप उपलब्ध न होने पर संदेश और Google Maps लिंक दिखाएँ।
        // --------------------------------------------------
        function showMapFallback(message) {
            if (!mapStatus) {
                return;
            }

            mapStatus.style.display = "block";
            mapStatus.textContent = "";

            var messageElement = document.createElement("strong");
            messageElement.textContent = message;
            mapStatus.appendChild(messageElement);

            mapStatus.appendChild(
                document.createElement("br")
            );

            var description = document.createElement("span");
            description.textContent =
                "आप नीचे दिए गए लिंक से दोनों कार्यालयों का स्थान देख सकते हैं:";
            mapStatus.appendChild(description);

            mapStatus.appendChild(
                document.createElement("br")
            );

            var kolkataLink = document.createElement("a");

            kolkataLink.href =
                "https://www.google.com/maps/search/?api=1&query=" +
                encodeURIComponent(
                    "Hindustan Copper Limited Tamra Bhavan Kolkata 700019"
                );

            kolkataLink.target = "_blank";
            kolkataLink.rel = "noopener noreferrer";
            kolkataLink.textContent =
                "Google Maps पर कोलकाता कॉर्पोरेट कार्यालय देखें";

            mapStatus.appendChild(kolkataLink);

            mapStatus.appendChild(
                document.createElement("br")
            );

            var delhiLink = document.createElement("a");

            delhiLink.href =
                "https://www.google.com/maps/search/?api=1&query=" +
                encodeURIComponent(
                    "Hindustan Copper Limited Scope Minar Laxmi Nagar Delhi 110092"
                );

            delhiLink.target = "_blank";
            delhiLink.rel = "noopener noreferrer";
            delhiLink.textContent =
                "Google Maps पर नई दिल्ली समन्वय कार्यालय देखें";

            mapStatus.appendChild(delhiLink);
        }

        // --------------------------------------------------
        // दो स्थानों के बीच सीधी दूरी किलोमीटर में निकालें।
        // --------------------------------------------------
        function calculateDistance(lat1, lng1, lat2, lng2) {

            function toRadians(degrees) {
                return degrees * Math.PI / 180;
            }

            var earthRadiusKm = 6371;

            var dLat = toRadians(lat2 - lat1);
            var dLng = toRadians(lng2 - lng1);

            var a =
                Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(toRadians(lat1)) *
                Math.cos(toRadians(lat2)) *
                Math.sin(dLng / 2) * Math.sin(dLng / 2);

            // Floating-point गणना में छोटी त्रुटियों से बचाव।
            a = Math.max(0, Math.min(1, a));

            return 2 * earthRadiusKm *
                Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        }

        // --------------------------------------------------
        // मैप शुरू करें और दोनों कार्यालयों के markers जोड़ें।
        // --------------------------------------------------
        function initializeOfficeMap() {

            try {
                if (typeof L === "undefined") {
                    throw new Error(
                        "Leaflet JavaScript लाइब्रेरी लोड नहीं हुई।"
                    );
                }

                if (!mapContainer) {
                    throw new Error(
                        "कार्यालय का मैप कंटेनर नहीं मिला।"
                    );
                }

                if (mapContainer.offsetWidth === 0 ||
                    mapContainer.offsetHeight === 0) {

                    throw new Error(
                        "मैप कंटेनर की चौड़ाई या ऊँचाई उपलब्ध नहीं है।"
                    );
                }

                // मैप बनाएँ।
                map = L.map(mapContainer).setView(
                    [23.5, 82.5],
                    5
                );

                // OpenStreetMap की tiles जोड़ें।
                var tileLayer = L.tileLayer(
                    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                    {
                        attribution:
                            '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap योगदानकर्ता</a>',
                        maxZoom: 19
                    }
                );

                // मैप की tiles लोड न होने पर fallback दिखाएँ।
                tileLayer.on("tileerror", function () {

                    console.error(
                        "OpenStreetMap की एक या अधिक tiles लोड नहीं हुईं।"
                    );

                    showMapFallback(
                        "मैप की कुछ tiles लोड नहीं हो सकीं। कृपया नीचे दिए गए कार्यालय लिंक का उपयोग करें।"
                    );
                });

                // Tiles लोड होने पर loading संदेश हटाएँ।
                tileLayer.on("load", function () {

                    mapTilesLoaded = true;

                    if (mapStatus) {
                        mapStatus.style.display = "none";
                    }
                });

                tileLayer.addTo(map);

                // दोनों कार्यालयों के markers जोड़ें।
                offices.forEach(function (office) {

                    var marker = L.marker([
                        office.lat,
                        office.lng
                    ]).addTo(map);

                    // Popup का content सुरक्षित तरीके से बनाएँ।
                    var popupContent =
                        document.createElement("div");

                    var officeName =
                        document.createElement("strong");

                    officeName.textContent = office.name;
                    popupContent.appendChild(officeName);

                    popupContent.appendChild(
                        document.createElement("br")
                    );

                    var officeAddress =
                        document.createElement("span");

                    officeAddress.textContent = office.address;
                    popupContent.appendChild(officeAddress);

                    marker.bindPopup(popupContent);

                    officeMarkers.push({
                        office: office,
                        marker: marker
                    });
                });

                // मैप में दोनों कार्यालयों को दिखाएँ।
                var officeBounds = L.latLngBounds(
                    offices.map(function (office) {
                        return [office.lat, office.lng];
                    })
                );

                map.fitBounds(officeBounds, {
                    padding: [30, 30]
                });

                mapInitialized = true;

                // 10 सेकंड तक tiles लोड न होने पर fallback दिखाएँ।
                if (!mapTilesLoaded) {

                    setTimeout(function () {

                        if (!mapTilesLoaded) {

                            showMapFallback(
                                "कार्यालय का मैप लोड होने में अधिक समय लग रहा है। कृपया नीचे दिए गए कार्यालय लिंक का उपयोग करें।"
                            );
                        }

                    }, 10000);
                }

            } catch (error) {

                console.error(
                    "कार्यालय का मैप शुरू नहीं हो सका:",
                    error
                );

                mapInitialized = false;

                showMapFallback(
                    "इंटरैक्टिव कार्यालय मैप लोड नहीं हो सका।"
                );
            }
        }

        // --------------------------------------------------
        // ब्राउज़र की लोकेशन से निकटतम कार्यालय खोजें।
        // --------------------------------------------------
        if (findButton) {

            findButton.addEventListener("click", function () {

                if (!navigator.geolocation) {

                    if (statusElement) {
                        statusElement.textContent =
                            "आपका ब्राउज़र लोकेशन सुविधा का समर्थन नहीं करता है।";
                    }

                    return;
                }

                if (!mapInitialized || !map) {

                    if (statusElement) {
                        statusElement.textContent =
                            "इंटरैक्टिव मैप उपलब्ध नहीं है। कार्यालय तक पहुँचने के लिए ऊपर दिए गए Google Maps लिंक का उपयोग करें।";
                    }

                    return;
                }

                findButton.disabled = true;

                if (statusElement) {
                    statusElement.textContent =
                        "आपकी वर्तमान लोकेशन प्राप्त की जा रही है...";
                }

                // उपयोगकर्ता के बटन क्लिक करने पर ही लोकेशन माँगें।
                navigator.geolocation.getCurrentPosition(

                    function (position) {

                        try {

                            var userLat =
                                position.coords.latitude;

                            var userLng =
                                position.coords.longitude;

                            var nearestOffice = null;
                            var nearestDistance = Infinity;

                            // सबसे नजदीकी कार्यालय खोजें।
                            offices.forEach(function (office) {

                                var distance = calculateDistance(
                                    userLat,
                                    userLng,
                                    office.lat,
                                    office.lng
                                );

                                if (distance < nearestDistance) {
                                    nearestDistance = distance;
                                    nearestOffice = office;
                                }
                            });

                            if (!nearestOffice) {
                                throw new Error(
                                    "कार्यालय की लोकेशन उपलब्ध नहीं है।"
                                );
                            }

                            // निकटतम कार्यालय का विवरण दिखाएँ।
                            document.getElementById(
                                "nearestOfficeName"
                            ).textContent = nearestOffice.name;

                            document.getElementById(
                                "nearestOfficeAddress"
                            ).textContent = nearestOffice.address;

                            document.getElementById(
                                "nearestOfficeDistance"
                            ).textContent =
                                nearestDistance.toFixed(1) +
                                " किमी (सीधी दूरी)";

                            // Google Maps पर ड्राइविंग दिशा-निर्देश बनाएँ।
                            var directionsUrl =
                                "https://www.google.com/maps/dir/?api=1" +
                                "&origin=" +
                                encodeURIComponent(
                                    userLat + "," + userLng
                                ) +
                                "&destination=" +
                                encodeURIComponent(
                                    nearestOffice.lat + "," +
                                    nearestOffice.lng
                                ) +
                                "&travelmode=driving";

                            document.getElementById(
                                "nearestOfficeDirections"
                            ).href = directionsUrl;

                            document.getElementById(
                                "nearestOfficeResult"
                            ).style.display = "block";

                            // पिछला user marker हटाएँ।
                            if (userMarker) {
                                map.removeLayer(userMarker);
                            }

                            // वर्तमान लोकेशन का marker जोड़ें।
                            userMarker = L.marker([
                                userLat,
                                userLng
                            ])
                                .addTo(map)
                                .bindPopup("आपकी वर्तमान लोकेशन");

                            // वर्तमान लोकेशन और दोनों कार्यालय दिखाएँ।
                            var allPoints = [
                                [userLat, userLng]
                            ];

                            offices.forEach(function (office) {
                                allPoints.push([
                                    office.lat,
                                    office.lng
                                ]);
                            });

                            map.fitBounds(
                                L.latLngBounds(allPoints),
                                {
                                    padding: [30, 30]
                                }
                            );

                            // निकटतम कार्यालय का popup खोलें।
                            officeMarkers.forEach(function (item) {

                                if (item.office === nearestOffice) {
                                    item.marker.openPopup();
                                } else {
                                    item.marker.closePopup();
                                }
                            });

                            if (statusElement) {
                                statusElement.textContent =
                                    "आपके निकटतम कार्यालय की जानकारी मिल गई है।";
                            }

                        } catch (error) {

                            console.error(
                                "निकटतम कार्यालय खोजने में समस्या:",
                                error
                            );

                            if (statusElement) {
                                statusElement.textContent =
                                    "निकटतम कार्यालय की जानकारी नहीं दिखाई जा सकी। कृपया कार्यालय के लिंक का उपयोग करें।";
                            }

                        } finally {
                            findButton.disabled = false;
                        }
                    },

                    // लोकेशन प्राप्त करने में आने वाली समस्याएँ।
                    function (error) {

                        var message;

                        switch (error.code) {

                            case error.PERMISSION_DENIED:
                                message =
                                    "लोकेशन की अनुमति नहीं मिली। कृपया ब्राउज़र सेटिंग्स में लोकेशन की अनुमति देकर दोबारा प्रयास करें।";
                                break;

                            case error.POSITION_UNAVAILABLE:
                                message =
                                    "आपकी लोकेशन उपलब्ध नहीं है। कृपया दोबारा प्रयास करें।";
                                break;

                            case error.TIMEOUT:
                                message =
                                    "लोकेशन प्राप्त करने का समय समाप्त हो गया। कृपया दोबारा प्रयास करें।";
                                break;

                            default:
                                message =
                                    "आपकी लोकेशन प्राप्त नहीं की जा सकी।";
                                break;
                        }

                        if (statusElement) {
                            statusElement.textContent = message;
                        }

                        findButton.disabled = false;
                    },

                    {
                        enableHighAccuracy: true,
                        timeout: 15000,
                        maximumAge: 60000
                    }
                );
            });
        }

        // --------------------------------------------------
        // पेज लोड होने के बाद मैप का आकार सही करें।
        // --------------------------------------------------
        function resizeOfficeMap() {

            if (map) {

                setTimeout(function () {

                    map.invalidateSize();

                    // दोनों कार्यालयों को मैप में दिखाएँ।
                    if (mapInitialized && offices.length > 0) {

                        var bounds = L.latLngBounds(
                            offices.map(function (office) {
                                return [office.lat, office.lng];
                            })
                        );

                        map.fitBounds(bounds, {
                            padding: [30, 30]
                        });
                    }

                }, 200);
            }
        }

        // मैप कंटेनर उपलब्ध होने के बाद initialization करें।
        if (document.readyState === "complete") {

            initializeOfficeMap();
            resizeOfficeMap();

        } else {

            window.addEventListener("load", function () {

                initializeOfficeMap();
                resizeOfficeMap();

            });
        }

        // ब्राउज़र विंडो का आकार बदलने पर मैप अपडेट करें।
        window.addEventListener("resize", function () {

            if (map) {
                map.invalidateSize();
            }
        });

    })();
</script>

