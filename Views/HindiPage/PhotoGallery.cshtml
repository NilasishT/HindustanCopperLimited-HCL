@model IEnumerable<Hindustancopperlimited.Models.UploadPhotoGallery>
@{
    ViewBag.Title = "PhotoGallery";
    Layout = "~/Views/Shared/HindiWebsitePage.cshtml";
}

<style>
    .gtabimg {
        width: 100%;
        height: 130px;
        object-fit: fill;
        border-radius: 6px;
        cursor: pointer;
        transition: transform 0.3s;
        background-color: transparent;
    }

    .gtabimg:hover {
        transform: scale(1.05);
    }

    .gtabimgcap {
        font-size: 13px;
        color: #b30000;
        padding: 8px;
        text-align: justify;
    }

    td.gallery-cell {
        padding: 10px;
        vertical-align: top;
    }

    #imgModal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.95);
    }

    #modalImg {
        margin: auto;
        display: block;
        max-width: 100%;
        max-height: 100%;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        border-radius: 8px;
    }

    



    @*@keyframes fadeIn {
        from {opacity:0}
        to {opacity:1}
    }*@

  /*  #modalImg {
        margin:auto;
        display:block;
        max-width:90%;
        max-height:90%;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.6);
    }*/

    #caption {
        margin:auto;
        display:block;
        text-align:center;
        color:#ccc;
        padding:10px;
        font-size:16px;
    }

    #closeModal {
        position:absolute;
        top:20px;
        right:35px;
        color:#fff;
        font-size:40px;
        font-weight:bold;
        cursor:pointer;
    }
</style>

