    }*/

    #caption {
        margin:auto;
        display:block;
        text-align:center;
        color:#ccc;
        padding:10px;
        font-size:16px;
    }

    #closeModal {
        position:absolute;
        top:20px;
        right:35px;
        color:#fff;
        font-size:40px;
        font-weight:bold;
        cursor:pointer;
    }
</style>

<style>
    /* NEW: Image chipte jay na. Aspect ratio thik thake, sudhu edge-er ongsho crop hoy.
       (Purono .gtabimg rule-e object-fit: fill chhilo, tai image chipte jachchhilo.
        Eita muchhe dile aager moto chipte jabe.) */
    .gtabimg {
        object-fit: cover;
    }

    /* NEW: Thumbnail-er link (<a>) layout-e kono poriborton ante dibe na */
    .gallery-link {
        display: block;
        border: 0;
        text-decoration: none;
    }

        .gallery-link img {
            border: 0;
        }
</style>

