<script>
    $(document).ready(function () {
        $(".gtabimg").on("click", function () {
            var src = $(this).attr("src");
            $("#modalImg").attr("src", src);
            $("#imgModal").fadeIn();
        });

        $("#closeModal").on("click", function () {
            $("#imgModal").fadeOut();
        });

        $(document).on("keydown", function (e) {
            if (e.key === "Escape") {
                $("#imgModal").fadeOut();
            }
        });

        $("#imgModal").on("click", function (e) {
            if (e.target.id === "imgModal") {
                $(this).fadeOut();
            }
        });
    });
</script>


@Html.Partial("~/Views/Shared/HindiPage/Newsroom.cshtml")

<div class="colmidl">
    <h1 class="titile">चित्र प्रदर्शनी</h1>
    <table cellspacing="0" cellpadding="0" border="0" width="100%">
        <tbody>
            <tr>
                @{
                    int count = 0;
                }
                @foreach (var photo in Model)
                {
                    if (count > 0 && count % 4 == 0)
                    {
                    @:</tr><tr>
                    }

                    <td align="center" width="25%" class="gallery-cell">
                        <img src="@Url.Content(photo.PhotoGallery)" class="gtabimg" alt="@photo.strPhotoContent"/>
                        <div class="gtabimgcap">@photo.strPhotoHindiContent</div>
                    </td>

                    count++;
                }
            </tr>
        </tbody>
    </table>
</div>

<div id="imgModal">
    <span id="closeModal">&times;</span>
    <img id="modalImg" alt="modalImg">
</div>
