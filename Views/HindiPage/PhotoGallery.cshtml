<script>
        $(document).ready(function () {
            $(".gtabimg").on("click", function () {
                var src = $(this).attr("src");
                $("#modalImg").attr("src", src);
                $("#imgModal").fadeIn();
            });

            $("#closeModal").on("click", function () {
                $("#imgModal").fadeOut();
            });

            $(document).on("keydown", function (e) {
                if (e.key === "Escape") {
                    $("#imgModal").fadeOut();
                }
            });

            $("#imgModal").on("click", function (e) {
                if (e.target.id === "imgModal") {
                    $(this).fadeOut();
                }
            });
        });
</script>


<script>
        // NEW: Thumbnail e click korle modal e FULL-SIZE image dekhabe.
        // (Upor-er purono click handler age cholbe, ei handler tarpor full image set kore dey.)
        $(document).ready(function () {
            $(".gallery-link").on("click", function (e) {
                // Ctrl/Shift/Cmd + click hole browser-er normal new-tab behaviour cholbe
                if (e.ctrlKey || e.shiftKey || e.metaKey) {
                    return;
                }
                e.preventDefault();
                $("#modalImg").attr("src", $(this).attr("href"));
                $("#imgModal").fadeIn();
            });
        });
</script>

@Html.Partial("~/Views/Shared/HindiPage/Newsroom.cshtml")

<div class="colmidl">
    <h1 class="titile">चित्र प्रदर्शनी</h1>
    <table cellspacing="0" cellpadding="0" border="0" width="100%">
        <tbody>
            <tr>
                @{
                    int count = 0;
                }
                @foreach (var photo in Model)
                {
                    if (count > 0 && count % 4 == 0)
                    {
                    @:</tr><tr>
                    }

                    <td align="center" width="25%" class="gallery-cell">
                        @* Old code (original full-size image directly):
                            <img src="@Url.Content(photo.PhotoGallery)" class="gtabimg" alt="@photo.strPhotoContent"/>
                        *@
                        @* New: thumbnail dekhay. Click korle full image khole (JS off thakle new tab e khole). *@
                        <a href="@Url.Content(photo.PhotoGallery)" class="gallery-link" target="_blank" rel="noopener">
                            <img src="@GetThumbnailUrl(photo.PhotoGallery)" class="gtabimg" alt="@photo.strPhotoContent" />
                        </a>
                        <div class="gtabimgcap">@photo.strPhotoHindiContent</div>
                    </td>

                    count++;
                }
            </tr>
        </tbody>
    </table>
</div>

<div id="imgModal">
    <span id="closeModal">&times;</span>
    <img id="modalImg" alt="modalImg">
</div>
