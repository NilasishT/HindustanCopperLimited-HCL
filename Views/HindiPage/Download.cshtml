        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/Hindi-Email_Registration_Form.pdf")" target="_blank"> ईमेल पंजीकरण फॉर्म</a></td>
        </tr>
        <tr>
        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/Memorandum%20and%20Articles%20of%20Association_HCL.pdf")" target="_blank"> ज्ञापन&amp; संस्था के लेख</a></td>
        </tr>
