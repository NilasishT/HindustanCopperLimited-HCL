<script>
    // संपर्क तालिका में कार्यालयों को खोजने का फ़ंक्शन
    function filterContacts() {
        var input = document.getElementById("contactSearchInput");
        var filter = input.value.toUpperCase();
        var table = document.getElementById("contactDataTable");
        var rows = table.getElementsByClassName("contact-data-row");
        var headers = table.getElementsByClassName("header-group-row");

        for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            var cells = row.getElementsByTagName("td");

            if (cells.length >= 2) {
                var cityName = cells[0].textContent || cells[0].innerText;
                var detailsText = cells[1].textContent || cells[1].innerText;
                var combinedText = (cityName + " " + detailsText).toUpperCase();

                if (combinedText.indexOf(filter) > -1) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            }
        }

        for (var j = 0; j < headers.length; j++) {
            var header = headers[j];
            var nextElement = header.nextElementSibling;
            var hasVisibleRow = false;

            while (
                nextElement &&
                !nextElement.classList.contains("header-group-row")
            ) {
                if (
                    nextElement.classList.contains("contact-data-row") &&
                    nextElement.style.display !== "none"
                ) {
                    hasVisibleRow = true;
                    break;
                }

                nextElement = nextElement.nextElementSibling;
            }

            if (hasVisibleRow || filter === "") {
                header.style.display = "";
            } else {
                header.style.display = "none";
            }
        }
    }


