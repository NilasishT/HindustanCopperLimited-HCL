    // चुने गए शहर के कार्यालय का विवरण दिखाना
    function showRecommendedOffice() {
        var select = document.getElementById("officeCitySelect");
        var result = document.getElementById("recommendedOfficeResult");
        var city = select.value;

        if (!city || !hclOffices[city]) {
            result.textContent =
                "कार्यालय का विवरण देखने के लिए कृपया शहर चुनें।";
            return;
        }

        displayOffice(city, hclOffices[city]);
    }


    // कार्यालय का विवरण सुरक्षित तरीके से दिखाना
    function displayOffice(city, office, distanceKm) {
        var result = document.getElementById("recommendedOfficeResult");

        // HTML स्ट्रिंग डालने के बजाय DOM एलिमेंट बनाएँ
        result.replaceChildren();

        var heading = document.createElement("h3");
        heading.textContent = office.name;
        result.appendChild(heading);

        var address = document.createElement("p");
        address.textContent = "पता: " + office.address;
        result.appendChild(address);

        if (office.phone) {
            var phone = document.createElement("p");
            phone.appendChild(
                document.createTextNode("दूरभाष: ")
            );

            var phoneLink = document.createElement("a");
            phoneLink.href =
                "tel:" + office.phone.replace(/[^\d+]/g, "");
            phoneLink.textContent = office.phone;

            phone.appendChild(phoneLink);
            result.appendChild(phone);
        }

        if (typeof distanceKm === "number") {
            var distance = document.createElement("p");
            distance.textContent =
                "अनुमानित सीधी दूरी: " +
                Math.round(distanceKm) + " किलोमीटर।";

            result.appendChild(distance);
        }
    }


    // लोकप्रिय कार्यालय स्थान चुनना
    function selectOfficeCity(city) {
        var select = document.getElementById("officeCitySelect");

        select.value = city;
        showRecommendedOffice();
    }


    // GPS की सहायता से निकटतम सूचीबद्ध कार्यालय खोजना
    function findNearestOffice() {
        var result = document.getElementById("recommendedOfficeResult");
        var button = document.getElementById("findNearestOfficeBtn");

        if (!navigator.geolocation) {
            result.textContent =
                "आपका ब्राउज़र स्थान की जानकारी प्राप्त करने की सुविधा का समर्थन नहीं करता। " +
                "कृपया सूची से शहर चुनें।";
            return;
        }

        button.disabled = true;
        result.textContent =
            "निकटतम सूचीबद्ध कार्यालय खोजने के लिए कृपया अपने स्थान की अनुमति दें।";

        navigator.geolocation.getCurrentPosition(
            function (position) {
                var userLat = position.coords.latitude;
                var userLon = position.coords.longitude;

                // दो भौगोलिक स्थानों के बीच सीधी दूरी की गणना
                function calculateDistance(lat1, lon1, lat2, lon2) {
                    var radians = Math.PI / 180;
                    var dLat = (lat2 - lat1) * radians;
                    var dLon = (lon2 - lon1) * radians;

                    var a =
                        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                        Math.cos(lat1 * radians) *
                        Math.cos(lat2 * radians) *
                        Math.sin(dLon / 2) *
                        Math.sin(dLon / 2);

                    return 6371 * 2 *
                        Math.atan2(
                            Math.sqrt(a),
                            Math.sqrt(1 - a)
                        );
                }

                var nearestCity = null;
                var nearestOffice = null;
                var shortestDistance = Infinity;

                for (var city in hclOffices) {
                    if (
                        Object.prototype.hasOwnProperty.call(
                            hclOffices,
                            city
                        )
                    ) {
                        var office = hclOffices[city];

                        var distance = calculateDistance(
                            userLat,
                            userLon,
                            office.lat,
                            office.lon
                        );

                        if (distance < shortestDistance) {
                            shortestDistance = distance;
                            nearestCity = city;
                            nearestOffice = office;
                        }
                    }
                }

                if (nearestOffice) {
                    document.getElementById("officeCitySelect").value =
                        nearestCity;

                    displayOffice(
                        nearestCity,
                        nearestOffice,
                        shortestDistance
                    );
                } else {
                    result.textContent =
                        "फिलहाल किसी कार्यालय की जानकारी उपलब्ध नहीं है।";
                }

                button.disabled = false;
            },

            function (error) {
                button.disabled = false;

                if (error.code === 1) {
                    result.textContent =
                        "स्थान की अनुमति नहीं मिली। कृपया सूची से शहर चुनें।";
                } else if (error.code === 3) {
                    result.textContent =
                        "स्थान की जानकारी प्राप्त करने में समय समाप्त हो गया। " +
                        "कृपया दोबारा प्रयास करें या शहर चुनें।";
                } else {
                    result.textContent =
                        "आपके स्थान की जानकारी प्राप्त नहीं हो सकी। " +
                        "कृपया सूची से शहर चुनें।";
                }
            },

            {
                enableHighAccuracy: false,
                timeout: 10000,
                maximumAge: 300000
            }
        );
    }
</script>


<script>
    function filterContactsList() {
        var input = document.getElementById("contactSearchInput");
        var filter = input.value.toUpperCase();
        var table = document.getElementById("contactDataTable");
        var rows = table.getElementsByClassName("contact-data-row");
        var headers = table.getElementsByClassName("header-group-row");

        for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            var cells = row.getElementsByTagName("td");
            if (cells.length >= 2) {
                var cityName = cells[0].textContent || cells[0].innerText;
                var detailsText = cells[1].textContent || cells[1].innerText;
                var combinedText = (cityName + " " + detailsText).toUpperCase();

                if (combinedText.indexOf(filter) > -1) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            }
        }

        for (var j = 0; j < headers.length; j++) {
            var header = headers[j];
            var nextElement = header.nextElementSibling;
            var hasVisibleRow = false;

            while (nextElement && !nextElement.classList.contains("header-group-row")) {
                if (nextElement.classList.contains("contact-data-row") && nextElement.style.display !== "none") {
                    hasVisibleRow = true;
                    break;
                }
                nextElement = nextElement.nextElementSibling;
            }

            if (hasVisibleRow || filter === "") {
                header.style.display = "";
            } else {
                header.style.display = "none";
            }
        }
    }
</script>
