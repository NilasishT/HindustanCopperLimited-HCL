            color: #111111;
            border-bottom: 2px solid #dcdcdc;
            padding-bottom: 10px;
            margin-bottom: 25px;
            font-weight: bold;
        }

    .sidebar-menu {
        list-style: none;
        padding: 0;
        margin: 0;
    }

