@{
    ViewBag.Title = "निविदा सूची | हिंदुस्तान कॉपर लिमिटेड";

    ViewBag.MetaDescription = "हिंदुस्तान कॉपर लिमिटेड (एचसीएल) भारत की अग्रणी तांबा उत्पादक कंपनी है, जो तांबे के खनन, संकेंद्रण, प्रगलन, परिशोधन और डाउनस्ट्रीम उत्पादों के क्षेत्र में कार्यरत है।";

    ViewBag.MetaKeywords = "हिंदुस्तान कॉपर लिमिटेड, एचसीएल, तांबा उत्पादक, तांबा खनन, तांबा संकेंद्रण, तांबा प्रगलन, तांबा परिशोधन, तांबा उत्पाद, तांबा कैथोड, तांबा सांद्रण, तांबा छड़ें, खान मंत्रालय, एचसीएल भारत, Hindustan Copper Limited, HCL, Copper Producer, Copper Mining, Copper Beneficiation, Copper Smelting, Copper Refining, Copper Products, Copper Cathodes, Copper Concentrates, Copper Rods, Ministry of Mines, HCL India.";

    Layout = "~/Views/Shared/HindiWebsitePage.cshtml";
}

<style>

    /* Tender button styling */
    .btn-primary {
        color: #ffffff;
        background-color: #916100;
        border-color: #916100;
    }

        .btn-primary:hover,
        .btn-primary:focus {
            color: #ffffff;
            background-color: #765000;
            border-color: #765000;
        }

    /* Tender table header styling */
    #sampleTable thead th {
        background-color: #916100;
        color: #ffffff;
        font-size: 14px;
        vertical-align: middle;
        text-align: center;
        padding: 8px 5px;
    }

    /* Tender table cell styling */
    #sampleTable tbody td {
        vertical-align: middle;
    }

        /* Accessible tender links */
        #sampleTable tbody td a {
            color: #0D6EFD;
            text-decoration: underline;
        }

            #sampleTable tbody td a:hover {
                text-decoration: none;
            }

            /* Visible keyboard focus for table links */
            #sampleTable tbody td a:focus {
                outline: 2px solid #0D6EFD;
                outline-offset: 3px;
            }

    /* Keyboard-accessible horizontal scrolling */
    .table-responsive:focus {
        outline: 3px solid #0D6EFD;
        outline-offset: 3px;
    }

    /* Screen-reader-only content */
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
    .pagination li a:hover, .pagination li a:focus {
        color: var(--dbim-bg-page);
        background: var(--dbim-primary-dark);
    }
</style>

<div class="col-lg-12">

    <h1>निविदा सूची</h1>

    <div class="well bs-component" style="min-width:100%;">

        @using (Html.BeginForm())
        {

            <!-- External e-Procurement portal link -->
            <p style="font-weight:bold; text-align:right;">

                निविदाएं निम्नलिखित ई-प्रोक्योरमेंट पोर्टल पर भी उपलब्ध हैं:

                <a href="https://eprocure.gov.in/cppp/"
                   style="color:#0D6EFD;"
                   target="_blank"
                   rel="noopener noreferrer">

                    केंद्रीय सार्वजनिक खरीद पोर्टल (नई विंडो में खुलेगा)

                </a>

            </p>

            <!-- Archived tender list link -->
            <p>

                @Html.ActionLink(
                    "पुरानी निविदाओं की सूची",
                    "ArcrivedTenderListHindi",
                    null,
                    new { @class = "btn btn-primary" }
                )

            </p>

            <fieldset>

                <div>

                    <div class="row">

                        <div class="col-md-12">

                            <div class="card">

                                <div class="card-body">

                                    <!-- Accessible responsive table container -->
                                    <div class="table-responsive"
                                         role="region"
                                         aria-label="निविदा सूची"
                                         tabindex="0">

                                        <table id="sampleTable"
                                               class="table table-hover table-bordered">

                                            <!-- Table caption -->
                                            <caption class="sr-only">
                                                हिंदुस्तान कॉपर लिमिटेड की निविदा सूची
                                            </caption>

                                            <!-- Table header -->
                                            <thead>

                                                <tr>

                                                    <th scope="col" style="width:10%;">

                                                        इकाई का नाम

                                                    </th>

                                                    <th scope="col" style="width:10%;">

                                                        जांच संख्या

                                                    </th>

                                                    <th scope="col" style="width:10%;">

                                                        पूछताछ की तारीख

                                                    </th>

                                                    <th scope="col" style="width:20%;">

                                                        छोटा शीर्षक

                                                    </th>

                                                    <th scope="col" style="width:10%;">

                                                        समाप्ति दिनांक / समय

                                                    </th>

                                                    <th scope="col" style="width:15%;">

                                                        निविदा दस्तावेज की लागत (रु.)

                                                    </th>

                                                    <th scope="col" style="width:5%;">

                                                        ईएमडी (रु.)

                                                    </th>

                                                    <th scope="col" style="width:5%;">

                                                        रद्द / निरस्त

                                                    </th>

                                                    <th scope="col" style="width:5%;">

                                                        टिप्पणियां

                                                    </th>

                                                </tr>

                                            </thead>

                                            <!-- Table body -->
                                            <tbody>

                                                @if (Model != null)
                                                {

                                                    foreach (var item in Model)
                                                    {

                                                        <tr>

                                                            <!-- Unit name -->
                                                            <td>

                                                                @if (!string.IsNullOrEmpty(item.strUnitCode))
                                                                {
                                                                    <span lang="en">
                                                                        @item.strUnitCode
                                                                    </span>
                                                                }

                                                            </td>

                                                            <!-- Enquiry number and accessible details link -->
                                                            <td>

                                                                <a style="color:#0D6EFD;"
                                                                   href="@Url.Content("~/Page/TenderListforDetails/" + item.pk_intTenderId)"
                                                                   target="_blank"
                                                                   rel="noopener noreferrer"
                                                                   aria-label="निविदा विवरण देखें, जांच संख्या @item.strEnquiryNo">

                                                                    @item.strEnquiryNo

                                                                    <span class="sr-only">
                                                                        - निविदा विवरण देखें
                                                                    </span>

                                                                </a>

                                                            </td>

                                                            <!-- Enquiry date -->
                                                            <td>

                                                                @(item.dtEnquiryDate.HasValue
                                                                    ? item.dtEnquiryDate.Value.ToString(
                                                                        "dd-MMM-yyyy",
                                                                        System.Globalization.CultureInfo.InvariantCulture)
                                                                    : "")

                                                            </td>

                                                            <!-- Tender title -->
                                                            <td>

                                                                @item.strEnquiryTitleHindi

                                                            </td>

                                                            <!-- Closing date and time -->
                                                            <td>

                                                                @item.dtClosingDate.ToString(
                                                                    "dd-MMM-yyyy h:mm tt",
                                                                    System.Globalization.CultureInfo.InvariantCulture)

                                                            </td>

                                                            <!-- Tender document cost -->
                                                            <td style="text-align:right;">

                                                                @item.numCostofTender

                                                            </td>

                                                            <!-- Earnest money deposit -->
                                                            <td style="text-align:right;">

                                                                @item.numEarnestMoney

                                                            </td>

                                                            <!-- Cancellation status -->
                                                            <td>

                                                                @if (item.IsCancel != null)
                                                                {
                                                                    <span lang="en">
                                                                        @item.IsCancel
                                                                    </span>
                                                                }

                                                            </td>

                                                            <!-- Remarks -->
                                                            <td>

                                                                @item.strRemarksHindi

                                                            </td>

                                                        </tr>

                                                    }

                                                }

                                            </tbody>

                                        </table>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </fieldset>

        }

    </div>

</div>

<!-- Popup dialog container retained for existing page compatibility -->
<div id="dialog" style="display:none;">
</div>

<!-- jQuery -->
<script type="text/javascript"
        src="https://ajax.googleapis.com/ajax/libs/jquery/1.7.2/jquery.min.js"></script>

<!-- jQuery UI -->
<script src="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.8.9/jquery-ui.js"
        type="text/javascript"></script>

<link href="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.8.9/themes/blitzer/jquery-ui.css"
      rel="stylesheet"
      type="text/css" />

<script type="text/javascript">

    // Opens the tender details in a separate browser window.
    function newPopup(url) {

        var h = 700;
        var w = 900;

        var y = window.outerHeight / 2 +
            window.screenY - (h / 2);

        var x = window.outerWidth / 2 +
            window.screenX - (w / 2);

        var popupWindow = window.open(
            url,
            "TenderDetails",
            'scrollbars=yes,resizable=yes,width=' + w +
            ',height=' + h +
            ',top=' + y +
            ',left=' + x
        );

        // Fallback when the browser blocks the popup.
        if (!popupWindow) {

            window.location.href = url;

        }

    }

</script>
