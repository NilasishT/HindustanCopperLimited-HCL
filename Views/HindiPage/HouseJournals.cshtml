@{
    ViewBag.Title = "HouseJournals";
    Layout = "~/Views/Shared/HindiWebsitePage.cshtml";
}

@Html.Partial("~/Views/Shared/HindiPage/Newsroom.cshtml")

    <div class="colmidl">
        <h1 class="titile">आंतरिक जर्नल</h1>
    <p><b>  ताम्रलिपि-  आंतरिक जर्नल </b></p>
    
        <div id="viewTable">
        <ul>
		
		@foreach (var item in Model)
        {
            if (item.strHindiFileUpload != null)
            {
                <li><span class="colmidlli"><a href=@item.strHindiFileUpload.Replace("~", "../..") target="_blank" style="color:#a34500; font-weight: bold;">@item.strHindiText</a></span></li>
            }
            else
            {
                <li><span class="colmidlli"><a href="#">@item.strHindiText</a></span></li>
            }
        }
		
