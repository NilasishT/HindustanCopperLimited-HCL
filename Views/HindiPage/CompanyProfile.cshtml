    /* Citizen services: labelled submit / track / outcome links */
    .journey-note {
        text-align: left;
        font-size: 14px;
        color: #333333;
        background-color: #fdfaf7;
        border-left: 4px solid #a34500;
        border-radius: 0 4px 4px 0;
        padding: 10px 12px;
        margin: 12px 0 0;
        line-height: 1.6;
    }

    .journey-group-label {
        text-align: left;
        font-weight: bold;
        font-size: 14px;
        color: #222222;
        margin: 16px 0 6px !important;
    }

    .journey-service-links {
        list-style: none;
        padding: 0 !important;
        margin: 0 0 6px 0;
    }

        .journey-service-links li {
            margin: 0 0 8px 0;
            font-size: 14px;
        }

    .journey-service-link {
        display: flex;
        align-items: center;
        min-height: 44px;
        padding: 8px 12px;
        background-color: #ffffff;
        border: 1px solid #a34500;
        border-radius: 4px;
        color: #a34500 !important;
        font-weight: bold;
        font-size: 14px;
        line-height: 1.4;
        text-decoration: none !important;
        box-sizing: border-box;
    }

        .journey-service-link:hover {
            background-color: #f5eae1;
            color: #873900 !important;
        }

        .journey-service-link:focus-visible {
            outline: 2px solid #005fcc;
            outline-offset: 3px;
        }

    .journey-sr {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* Mobile: left-aligned text, comfortable spacing */
    @@media (max-width: 768px) {
        .colmidl .card p,
        .colmidl .card li {
            text-align: left;
            line-height: 1.8;
        }

        .colmidl .card p {
            margin-bottom: 18px;
        }

        .colmidl .card ul {
            padding-left: 20px;
        }

        .journey-service-link {
            width: 100%;
        }
    }
</style>

