    <!-- नागरिक सेवाएँ एवं ऑनलाइन संसाधन -->
    <section class="citizen-service-journey"
             aria-labelledby="citizenJourneyTitle">

        <h1 id="citizenJourneyTitle">
            नागरिक सेवाएँ एवं ऑनलाइन संसाधन
        </h1>

        <p class="journey-intro">
            निम्नलिखित लिंक के माध्यम से महत्वपूर्ण सेवाओं तक पहुँचें,
            प्रतिक्रिया दें और आवश्यक जानकारी प्राप्त करें।
        </p>

        <p class="journey-note">
            ये सेवाएँ एक-दूसरे से अलग हैं। जो सेवा आपको चाहिए, उसे चुनें। जहाँ ये सुविधाएँ
            उपलब्ध हैं, वहाँ हर सेवा में अनुरोध जमा करने, उसकी स्थिति देखने और उत्तर देखने
            के लिंक दिए गए हैं।
        </p>

        <div class="journey-steps">

            <!-- Step 1: Public Grievance -->
            <div class="journey-step">
                @* <span class="journey-step-number"
                    aria-hidden="true">1</span> *@

                <h2>जन शिकायत</h2>

                <p>
                    शिकायत दर्ज करने और उसकी स्थिति के बारे में
                    जानकारी प्राप्त करने के लिए जन शिकायत पोर्टल पर जाएँ।
                </p>

                <button type="button"
                        class="journey-action"
                        onclick="window.open('https://pgportal.gov.in/', '_blank', 'noopener,noreferrer')">
                    शिकायत पोर्टल पर जाएँ
                </button>

                <p class="journey-group-label">जमा करें, स्थिति देखें और परिणाम देखें</p>
                <ul class="journey-service-links">
                    <li><a class="journey-service-link" href="https://pgportal.gov.in/" target="_blank" rel="noopener noreferrer">शिकायत दर्ज करें<span class="journey-sr"> (नए टैब में CPGRAMS पोर्टल खुलेगा)</span></a></li>
                    <li><a class="journey-service-link" href="https://pgportal.gov.in/" target="_blank" rel="noopener noreferrer">शिकायत की स्थिति देखें<span class="journey-sr"> (नए टैब में CPGRAMS पोर्टल खुलेगा)</span></a></li>
                    <li><a class="journey-service-link" href="https://pgportal.gov.in/" target="_blank" rel="noopener noreferrer">अपनी शिकायत का उत्तर देखें<span class="journey-sr"> (नए टैब में CPGRAMS पोर्टल खुलेगा)</span></a></li>
                </ul>
                <p class="journey-note">
                    पोर्टल पर पंजीकरण करना और साइन इन करना आवश्यक है। शिकायत दर्ज करने के बाद
                    पोर्टल आपको एक शिकायत पंजीकरण संख्या देता है। इसे संभालकर रखें। इसी संख्या से
                    पोर्टल पर स्थिति देखें और उत्तर पढ़ें।
                </p>

            </div>

            <!-- Step 2: Right to Information -->
            <div class="journey-step">
                @* <span class="journey-step-number"
                    aria-hidden="true">2</span> *@

                <h2>सूचना का अधिकार</h2>

                <p>
                    सूचना का अधिकार (RTI) प्रक्रिया और संबंधित
                    जानकारी के लिए HCL की वेबसाइट देखें।
                </p>

                <button type="button"
                        class="journey-action"
                        onclick="window.open('@Url.Action("RIAct", "HindiPage")', '_blank')">
                    RTI की जानकारी देखें
                </button>

                <p class="journey-group-label">आवेदन करें, स्थिति देखें और उत्तर देखें</p>
                <ul class="journey-service-links">
                    <li><a class="journey-service-link" href="https://rtionline.gov.in/" target="_blank" rel="noopener noreferrer">ऑनलाइन RTI आवेदन करें<span class="journey-sr"> (नए टैब में RTI ऑनलाइन पोर्टल खुलेगा)</span></a></li>
                    <li><a class="journey-service-link" href="https://rtionline.gov.in/" target="_blank" rel="noopener noreferrer">RTI आवेदन की स्थिति देखें<span class="journey-sr"> (नए टैब में RTI ऑनलाइन पोर्टल खुलेगा)</span></a></li>
                    <li><a class="journey-service-link" href="https://rtionline.gov.in/" target="_blank" rel="noopener noreferrer">RTI आवेदन का उत्तर देखें<span class="journey-sr"> (नए टैब में RTI ऑनलाइन पोर्टल खुलेगा)</span></a></li>
                </ul>
