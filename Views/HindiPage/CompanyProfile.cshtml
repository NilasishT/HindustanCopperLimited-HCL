@{
    ViewBag.Title = "Company Profile";
    Layout = "~/Views/Shared/HindiWebsitePage.cshtml";
}

@Html.Partial("~/Views/Shared/HindiPage/About.cshtml")

<style>
    .colmidl {
        color: #2b2b2b;
        padding: 0 15px;
        line-height: 1.8;
    }

    .card {
        background: #ffffff;
        margin-bottom: 30px;
        padding: 20px;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
    }

    .colmidl h1.titile, .colmidl h2.titile, .colmidl h3.titile {
        color: #111111;
        border-bottom: 2px solid #dcdcdc;
        padding-bottom: 10px;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .colmidl h1.titile {
        font-size: 28px;
    }

    .colmidl h2.titile {
        font-size: 22px;
        margin-top: 15px;
    }

    .colmidl h3.titile {
        font-size: 18px;
        border-bottom: 1px dashed #dcdcdc;
    }

    .profile-utility-bar {
        background-color: #f5eae1;
        border: 1px solid #e2d2c5;
        border-radius: 4px;
        padding: 15px;
        margin-bottom: 25px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .utility-group {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 15px;
    }

    .search-box-input, .lang-select {
        padding: 8px 12px;
        font-size: 15px;
        border: 1px solid #a1a1a1;
        border-radius: 4px;
        min-height: 44px;
        background-color: #ffffff;
        box-sizing: border-box;
        color: #111111;
    }

    .search-box-input {
        min-width: 240px;
    }

    .lang-select {
        min-width: 150px;
        font-weight: 500;
    }

    .btn-share {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        margin: 4px;
        background-color: #ffffff;
        color: #2b2b2b !important;
        text-decoration: none !important;
        border: 1px solid #a1a1a1;
        border-radius: 4px;
        font-size: 14px;
        min-height: 44px;
        min-width: 44px;
        box-sizing: border-box;
        transition: all 0.2s;
        font-weight: 500;
    }

        .btn-share:hover {
            background-color: #f5eae1;
            border-color: #a92323;
        }

    .colmidl p {
        font-size: 15.5px;
        color: #2b2b2b;
        margin-bottom: 15px;
        text-align: justify;
    }

    .colmidl ul {
        padding-left: 20px;
        margin-bottom: 20px;
    }

    .colmidl li {
        margin-bottom: 10px;
        font-size: 15px;
    }

    .profile-data-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
        margin-bottom: 15px;
    }

        .profile-data-table td {
            padding: 14px 12px;
            border-bottom: 1px solid #dddddd;
            vertical-align: top;
            font-size: 15px;
            color: #2b2b2b;
            line-height: 1.7;
        }

        .profile-data-table tr:last-child td {
            border-bottom: 2px solid #cccccc;
        }

    .profile-direct-link {
        color: #a34500 !important;
        text-decoration: none !important;
        font-weight: bold;
        font-size: 15px;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        box-sizing: border-box;
    }

        .profile-direct-link:hover, .profile-direct-link:focus {
            color: #003366 !important;
            outline: 2px solid #0066cc;
        }

    .citizen-summary-box {
        background-color: #f0f7f4;
        border-left: 5px solid #2e7d32;
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 0 4px 4px 0;
    }

    @@media (max-width: 768px) {
        .profile-utility-bar {
            flex-direction: column;
            align-items: stretch;
            gap: 20px;
        }

        .utility-group {
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
        }

        .profile-utility-bar label, .profile-utility-bar span {
            display: block;
            margin-bottom: 4px;
        }

        .search-box-input, .lang-select {
            width: 100%;
        }

        .btn-share {
            display: block;
            width: 100%;
            text-align: center;
            margin: 6px 0;
        }

        .profile-data-table, .profile-data-table tbody, .profile-data-table tr, .profile-data-table td {
            display: block !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }

            .profile-data-table tr {
                background-color: #ffffff !important;
                border: 1px solid #e2d2c5 !important;
                border-radius: 6px;
                margin-bottom: 20px;
                padding: 14px;
                box-shadow: 0 2px 5px rgba(0,0,0,0.04);
            }

            .profile-data-table td {
                border: none !important;
                padding: 4px 6px !important;
            }

                .profile-data-table td:first-child {
                    font-size: 16px;
                    color: #a34500;
                    font-weight: bold;
                    border-bottom: 1px dashed #e2d2c5 !important;
                    padding-bottom: 8px !important;
                    margin-bottom: 8px;
                }

        .profile-direct-link {
            width: 100%;
            background-color: #fdfaf7;
            border: 1px solid #eddcd0;
            border-radius: 4px;
        }
    }
</style>
<style>
    /* Citizen Service Journey */
    .citizen-service-journey {
        margin: 20px 0;
        padding: 22px;
        background: #f8f9fa;
        border: 1px solid #dedede;
        border-radius: 5px;
    }

        /* Section heading */
        .citizen-service-journey h1,
        .citizen-service-journey h2 {
            margin: 0 0 8px;
            color: #a34500;
            font-size: 22px;
            line-height: 1.5;
        }

    /* Introduction text */
    .journey-intro {
        margin: 0 0 18px;
        color: #333;
        line-height: 1.6;
    }

    /* Journey steps layout */
    .journey-steps {
        display: flex;
        gap: 16px;
    }

    /* Individual step card */
    .journey-step {
        flex: 1;
        min-width: 0;
        padding: 18px;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 5px;
        box-sizing: border-box;
    }

    /* Numbered circle */
    .journey-step-number {
        display: inline-flex;
        width: 34px;
        height: 34px;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #a34500;
        color: #fff;
        font-weight: bold;
        font-size: 16px;
    }

    /* Step heading */
    .journey-step h3 {
        margin: 12px 0 8px;
        color: #222;
        font-size: 17px;
        line-height: 1.5;
    }

    /* Step description */
    .journey-step p {
        margin: 0 0 10px;
        color: #444;
        line-height: 1.6;
    }

    /* Journey buttons */
    button.journey-action {
        display: inline-block;
        margin-top: 8px;
        padding: 10px 16px;
        background-color: #a34500;
        border: 1px solid #a34500;
        border-radius: 4px;
        color: #fff;
        font-family: inherit;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
        line-height: 1.5;
        text-align: center;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        box-sizing: border-box;
    }

        /* Button hover */
        button.journey-action:hover {
            background-color: #873900;
            border-color: #873900;
            color: #fff;
        }

        /* Keyboard accessibility */
        button.journey-action:focus-visible {
            outline: 2px solid #005fcc;
            outline-offset: 3px;
        }

        /* Button active state */
        button.journey-action:active {
            background-color: #6f2f00;
            border-color: #6f2f00;
        }

    /* Responsive layout for tablets and mobile */
    @@media (max-width: 768px) {
        .citizen-service-journey {
            padding: 15px;
        }

        .journey-steps {
            flex-direction: column;
            gap: 12px;
        }

        .journey-step {
            width: 100%;
        }

            .journey-step h3 {
                font-size: 16px;
            }

        button.journey-action {
            min-height: 44px;
            padding: 10px 16px;
        }
    }
</style>



<div class="colmidl">

    <nav aria-label="ब्रेडक्रंब" style="margin-bottom: 15px; font-size: 14px; padding: 5px 0;">
        <a href="/" style="color: #a34500; text-decoration: none; font-weight: bold; min-height: 44px; padding: 4px 8px; display: inline-flex; align-items: center;">मुखपृष्ठ</a> &gt;
        <span aria-current="page" style="color: #2b2b2b; padding: 4px 0; display: inline-flex; align-items: center;">कंपनी प्रोफ़ाइल</span>
    </nav>

    <div class="profile-utility-bar" role="region" aria-label="फ़िल्टर, भाषा और साझा करें">
        <div class="utility-group">
            <div>
                <label for="profileSearchInput" style="font-weight: bold; margin-right: 5px; font-size: 13px; display: block; margin-bottom: 5px;">प्रोफ़ाइल सामग्री खोजें:</label>
                <input type="text" id="profileSearchInput" class="search-box-input" placeholder="कीवर्ड या वर्ष दर्ज करें..." onkeyup="filterProfileData()" aria-label="प्रोफ़ाइल सामग्री या टाइमलाइन की घटनाएँ खोजें" />
            </div>
        </div>
        <div>
            <span style="font-weight: bold; margin-right: 5px; font-size: 13px; display: block; margin-bottom: 5px;">पेज साझा करें:</span>
            <a href="https://facebook.com" target="_blank" class="btn-share" rel="noopener" aria-label="इस प्रोफ़ाइल पेज को फेसबुक पर साझा करें">फेसबुक</a>
            <a href="https://twitter.com" target="_blank" class="btn-share" rel="noopener" aria-label="इस प्रोफ़ाइल पेज को ट्विटर पर साझा करें">ट्विटर</a>
            <button onclick="navigator.clipboard.writeText(window.location.href); alert('प्रोफ़ाइल पेज का लिंक कॉपी हो गया!');" class="btn-share" style="cursor:pointer;" aria-label="पेज का लिंक कॉपी करें">लिंक कॉपी करें</button>
        </div>
    </div>

    <!-- नागरिक सेवा प्रक्रिया -->
    <section class="citizen-service-journey"
             aria-labelledby="citizenJourneyTitle">

        <h1 id="citizenJourneyTitle">नागरिक सेवा प्रक्रिया</h1>

        <p class="journey-intro">
            इन सरल चरणों के माध्यम से सेवाओं का लाभ उठाएँ।
        </p>

        <div class="journey-steps">

            <div class="journey-step">
                <span class="journey-step-number"
                      aria-hidden="true">1</span>

                <h3>सेवा के लिए आवेदन करें</h3>

                <p>
                    संबंधित सेवा का चयन करें और अपना आवेदन जमा करें।
                </p>

                <button type="button"
                        class="journey-action"
                        aria-label="सेवा के लिए आवेदन करें">
                    सेवा के लिए आवेदन करें
                </button>
            </div>

            <div class="journey-step">
                <span class="journey-step-number"
                      aria-hidden="true">2</span>

                <h3>आवेदन की स्थिति जानें</h3>

                <p>
                    अपने जमा किए गए आवेदन की प्रगति की जाँच करें।
                </p>

                <button type="button"
                        class="journey-action"
                        aria-label="आवेदन की स्थिति देखें">
                    स्थिति देखें
                </button>
            </div>

            <div class="journey-step">
                <span class="journey-step-number"
                      aria-hidden="true">3</span>

                <h3>परिणाम देखें</h3>

                <p>
                    आवेदन पर अंतिम निर्णय देखें और उपलब्ध दस्तावेज़ डाउनलोड करें।
                </p>

                <button type="button"
                        class="journey-action"
                        aria-label="आवेदन का परिणाम देखें">
                    परिणाम देखें
                </button>
            </div>

        </div>
    </section>

    <div class="card searchable-section">
        <h1 class="titile">कंपनी की रूपरेखा</h1>

        <div class="citizen-summary-box">
            <strong style="color: #1b5e20; font-size: 16px;">संक्षिप्त जानकारी:</strong>
            <p style="margin-top: 5px; margin-bottom: 0; font-size: 14.5px; text-align: left; color: #2e7d32;">
                हिंदुस्तान कॉपर लिमिटेड (HCL) भारत सरकार के स्वामित्व वाली कंपनी है। इसकी स्थापना 1967 में हुई थी। यह भारत की एकमात्र सरकारी कंपनी है जो ताम्र अयस्क का खनन करती है और पाँच अलग-अलग राज्यों में शुद्ध परिष्कृत तांबे का उत्पादन करती है।
            </p>
        </div>

        <p>
            <span class="redheader" style="color:#a92323;">
                <b>हिंदुस्तान कॉपर लिमिटेड (HCL)</b>,
            </span>
            खान मंत्रालय के प्रशासनिक नियंत्रण में भारत सरकार (GoI) का एक मिनीरत्न श्रेणी-I उपक्रम है। इसे कंपनी अधिनियम, 1956 के तहत 9 नवंबर 1967 को निगमित किया गया था। इसकी स्थापना राष्ट्रीय खनिज विकास निगम लिमिटेड से तांबे के भंडारों की खोज और दोहन से संबंधित सभी संयंत्रों, परियोजनाओं, योजनाओं और अध्ययनों को अपने अधीन लेने के लिए भारत सरकार के उद्यम के रूप में की गई थी। यह भारत में ताम्र अयस्क के खनन में संलग्न एकमात्र कंपनी है। इसके पास ताम्र अयस्क के सभी परिचालन खनन पट्टे हैं और यह परिष्कृत तांबे की एकमात्र एकीकृत उत्पादक कंपनी भी है।
        </p>

        <p>
            कंपनी की तांबा सांद्र (कॉपर कॉन्संट्रेट) के उत्पादन और विपणन की सुविधाएँ पाँच परिचालन इकाइयों में फैली हुई हैं। ये इकाइयाँ राजस्थान, मध्य प्रदेश, झारखंड, महाराष्ट्र और गुजरात में स्थित हैं।
        </p>

        <p>
            कंपनी कॉपर कॉन्संट्रेट, कॉपर कैथोड और कंटीन्यूअस कास्ट कॉपर रॉड का उत्पादन एवं विपणन करती है। इसके साथ ही सोना और चाँदी जैसे मूल्यवान उप-उत्पाद भी प्राप्त होते हैं। वर्तमान में, HCL मुख्य रूप से ताम्र अयस्क के खनन और कॉपर कॉन्संट्रेट की बिक्री पर ध्यान केंद्रित कर रही है।
        </p>

        <div style="background-color: #f8f9fa; padding: 15px; border-radius: 4px; margin-bottom: 20px;">
            <strong style="font-size: 15px; color: #111111;">प्रमुख वित्तीय उपलब्धियाँ (वित्तीय वर्ष 2022-23):</strong>
            <ul style="margin-top: 5px; margin-bottom: 0; padding-left: 20px;">
                <li><strong>बिक्री कारोबार:</strong> 1,660.63 करोड़ रुपये</li>
                <li><strong>शुद्ध लाभ (PAT):</strong> 295.31 करोड़ रुपये</li>
            </ul>
        </div>

        <p><strong>भारत में स्थित परिचालन इकाइयाँ:</strong></p>
        <ul>
            <li><span class="colmidlli"><b>मलांजखण्ड कॉपर प्रोजेक्ट (MCP)</b>, मलांजखण्ड, मध्य प्रदेश</span></li>
            <li><span class="colmidlli"><b>खेतड़ी कॉपर कॉम्प्लेक्स (KCC)</b>, खेतड़ीनगर, राजस्थान</span></li>
            <li><span class="colmidlli"><b>इंडियन कॉपर कॉम्प्लेक्स (ICC)</b>, घाटशिला, झारखंड</span></li>
            <li><span class="colmidlli"><b>तलोजा कॉपर प्रोजेक्ट (TCP)</b>, तलोजा, महाराष्ट्र</span></li>
            <li><span class="colmidlli"><b>गुजरात कॉपर प्रोजेक्ट (GCP)</b>, झगड़िया, गुजरात</span></li>
        </ul>

        <div style="background-color: #f1f3f5; padding: 12px; border-radius: 4px; margin-top: 15px; margin-bottom: 15px;">
            <strong style="font-size: 14px; color: #333;">ऊपर उपयोग किए गए तकनीकी शब्दों की परिभाषाएँ:</strong>
            <ul style="margin: 5px 0 0 0; padding-left: 20px; font-size: 13.5px; color: #555;">
                <li><strong>मिनीरत्न:</strong> भारत सरकार द्वारा बेहतर प्रदर्शन करने वाले सार्वजनिक क्षेत्र के उपक्रमों को दिया जाने वाला विशेष दर्जा।</li>
                <li><strong>एकीकृत उत्पादक:</strong> ऐसी कंपनी जो कच्चे माल के खनन से लेकर अंतिम उत्पाद के निर्माण तक की प्रक्रियाएँ स्वयं संचालित करती है।</li>
            </ul>
        </div>

        <h2 class="titile" style="margin-top: 30px;">कंपनी की समयरेखा एवं इतिहास</h2>

        <div id="viewTable">
            <table class="profile-data-table">
                <tbody>
                    <tr class="timeline-row">
                        <td width="20%"><strong>नवंबर 1967</strong></td>
                        <td width="80%">राष्ट्रीय खनिज विकास निगम लिमिटेड से संबंधित संयंत्रों, परियोजनाओं और गतिविधियों को अपने अधीन लेने के उद्देश्य से कंपनी का गठन किया गया।</td>
                    </tr>

                    <tr class="timeline-row">
                        <td width="20%"><strong>मार्च 1972</strong></td>
                        <td width="80%">घाटशिला, झारखंड स्थित निजी क्षेत्र की कंपनी मेसर्स इंडियन कॉपर कॉर्पोरेशन लिमिटेड का राष्ट्रीयकरण किया गया। इस कंपनी में स्मेल्टर और रिफाइनरी की सुविधाएँ थीं, जिन्हें HCL का हिस्सा बनाया गया।</td>
                    </tr>

                    <tr class="timeline-row">
                        <td width="20%"><strong>फरवरी 1975</strong></td>
                        <td width="80%">खेतड़ी में खनन से लेकर शोधन तक की सुविधाओं वाला पूर्णतः एकीकृत कॉपर कॉम्प्लेक्स चालू हुआ। इसकी परिष्कृत तांबे की उत्पादन क्षमता 31,000 टन थी।</td>
                    </tr>

                    <tr class="timeline-row">
                        <td width="20%"><strong>नवंबर 1982</strong></td>
