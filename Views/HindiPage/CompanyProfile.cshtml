<script>
    function filterProfileData() {
        var input = document.getElementById("profileSearchInput");
        var filter = input.value.toUpperCase();

        var timelineRows = document.getElementsByClassName("timeline-row");
        for (var i = 0; i < timelineRows.length; i++) {
            var row = timelineRows[i];
            var text = row.textContent || row.innerText;
            if (text.toUpperCase().indexOf(filter) > -1) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        }

        var cards = document.getElementsByClassName("searchable-section");
        for (var j = 0; j < cards.length; j++) {
            var card = cards[j];
            var cardText = card.textContent || card.innerText;
            if (filter === "") {
                card.style.display = "";
            } else if (cardText.toUpperCase().indexOf(filter) > -1) {
                card.style.display = "";
            } else {
                var visibleRows = card.querySelectorAll("tr:not([style*='display: none'])");
                if (visibleRows.length > 0 && card.querySelector("table")) {
                    card.style.display = "";
                } else {
                    card.style.display = "none";
                }
            }
        }
    }
</script>

