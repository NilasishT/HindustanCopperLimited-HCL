                    <li><a href="@Url.Action("AnnualReport", "HindiPage")"><img class="dbim--icon" src="/Content/icon/Draft.svg" alt="Annual Report">&nbsp;वार्षिक विवरण</a></li>
                </ul>
            </li>

            <li>
                <a href="#"><img class="dbim--icon" src="/Content/icon/Draft.svg" alt="Financial Report"> <span>&nbsp;बिक्री रिपोर्ट</span> <span class="chevron pull-right">&rsaquo;</span></a>
                <ul class="sidebar-submenu">
                    <li><a href="@Url.Action("SalesVolume", "HindiPage")"> <img class="dbim--icon" src="/Content/icon/Timeline.svg" alt="Sales Volume">&nbsp;बिक्री की मात्रा</a></li>
                    <li><a href="@Url.Action("SalesRevenue", "HindiPage")"><img class="dbim--icon" src="/Content/icon/Timeline.svg" alt="Sales Revenue">&nbsp;बिक्री राजस्व</a></li>
                </ul>
            </li>

            <li><a href="@Url.Action("productionReport", "HindiPage")"><img class="dbim--icon" src="/Content/icon/Result.svg" alt="Production Report"><span>&nbsp;उत्पादन रिपोर्ट</span></a></li>

            <li class="sidebar-header">अन्य सूचना</li>
            <li><a href="https://www.pgportal.gov.in/" target="_blank"><img class="dbim--icon" src="/Content/icon/Checklist.svg" alt="Public Grievance"><span>&nbsp;लोक शिकायत</span></a></li>
            <li><a href="@Url.Action("RelatedLink", "HindiPage")"><img class="dbim--icon" src="/Content/icon/Attachment.svg" alt="Related Links"><span>&nbsp;सम्बंधित लिंक्स</span></a></li>
            <li><a href="@Url.Action("RIAct", "HindiPage")"><img class="dbim--icon" src="/Content/icon/Pending_Actions.svg" alt="Right to Information Act"><span>&nbsp;सूचना का अधिकार कानून</span></a></li>
