    Layout = "~/Views/Shared/HindiWebsitePage.cshtml";
    }
<nav class="colleft" aria-label="HCL Sidebar">
    <div class="sliderw">

        <ul class="sidebar-menu">
            <li class="sidebar-header">वित्तीय</li>
