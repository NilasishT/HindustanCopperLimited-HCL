                                    <div class="row">
                                        <div class="col-lg-4 col-md-4 col-sm-4">
                                            <div class="single_whyus_top wow fadeInUp">
                                                <h2>विज़न एवं मिशन</h2>
                                                <p>
                                                    एक अग्रणी धातु खनन कंपनी बनने का प्रयास करना और तांबा अयस्क तथा उससे भौगोलिक रूप से जुड़े अन्य खनिजों की सतत खोज, विकास और खनन द्वारा कुल शेयरधारक प्रतिफल को अधिकतम करना।
                                                </p>

                                                @*<a href="@Url.Action("VisionandMission", "HindiPage")" class=" btn btn-default text-center">अधिक पढ़ें</a>*@

                                                <button type="button"
                                                        class="btn btn-default read-more-default"
                                                        onclick="window.location.href='@Url.Action("VisionandMission", "HindiPage")'">
                                                    विज़न एवं मिशन
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 col-md-4 col-sm-4">
                                            <div class="single_whyus_top wow fadeInDown">
                                                <h2>संयंत्र और सुविधाएं</h2>
                                                <p>हमारी घाटशिला (झारखंड) इकाइयाँ सिंहभूम कॉपर बेल्ट (एससीबी) से तांबे का अयस्क निकालती और संसाधित करती हैं, जो भारत के सबसे पुराने तांबा-युक्त क्षेत्रों में से एक है। खदानें, अयस्क-संसाधन संयंत्र, स्मेल्टर और रिफाइनरी इस अयस्क को शुद्ध तांबे में बदलते हैं। भूविज्ञान का तकनीकी विवरण संयंत्र और सुविधाएं पृष्ठ पर उपलब्ध है।</p>
                                                @*<a href="@Url.Action("PlantsandOffices", "HindiPage")" class=" btn btn-default text-center"> अधिक पढ़ें</a>*@
                                                <button type="button"
                                                        class="btn btn-default read-more-default"
                                                        onclick="window.location.href='@Url.Action("PlantsandOffices", "HindiPage")'">
                                                    संयंत्र और सुविधाएं
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 col-md-4 col-sm-4">
                                            <div class="single_whyus_top wow fadeInUp">
                                                <h2>प्रबंधन</h2>
                                                <p>
                                                    कंपनी अधिनियम, 1956 के प्रावधानों और सरकार द्वारा समय-समय पर जारी दिशानिर्देश / निर्देश और ज्ञापन और अंतर्नियम में निहित प्रावधानों के अधीन ...
                                                </p>
                                                @*<a href="@Url.Action("ManagementPhilosophy", "HindiPage")" class=" btn btn-default text-center"> अधिक पढ़ें</a>*@
