    <script>
            (function () {
                var splash = document.getElementById('splash-banner');
                if (!splash) return;

                document.body.appendChild(splash);

                var DELAY_MS = 3000;       // wait 10 seconds after page + loader finish
                var AUTO_CLOSE_MS = 8000;   // auto-close after 8 seconds (0 = never)
                var closeTimer;

                function openSplash() {
                    splash.style.display = 'flex';
                    void splash.offsetWidth;            // force reflow for the fade-in
                    splash.classList.remove('hide');
                    splash.classList.add('show');
                    document.body.style.overflow = 'hidden';

                    if (AUTO_CLOSE_MS > 0) closeTimer = setTimeout(closeSplash, AUTO_CLOSE_MS);
                }

                function closeSplash() {
                    clearTimeout(closeTimer);
                    splash.classList.remove('show');
                    splash.classList.add('hide');
                    document.body.style.overflow = '';
                    setTimeout(function () { splash.style.display = 'none'; }, 500);
                }

                document.getElementById('splash-close').addEventListener('click', closeSplash);
                splash.querySelector('a').addEventListener('click', closeSplash);

                splash.addEventListener('click', function (e) {
                    if (e.target === splash) closeSplash();
                });

                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') closeSplash();
                });

                @*Commented by BEAS*@
                //window.addEventListener('load', function () {
                //    setTimeout(openSplash, DELAY_MS);
                //});
            })();
    </script>


