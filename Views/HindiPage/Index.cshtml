    <script>
        /* Recalculate carousel dimensions on resize / zoom so no stale fixed heights clip content */
        (function () {
            function resetCarouselHeights() {
                var boxes = document.querySelectorAll('#awardedNew .carousel-inner, #eventsNew .carousel-inner');
                for (var i = 0; i < boxes.length; i++) {
                    if (window.matchMedia('(max-width: 767px)').matches) {
                        boxes[i].style.height = 'auto';
                        var items = boxes[i].querySelectorAll('.item');
                        for (var j = 0; j < items.length; j++) { items[j].style.height = 'auto'; }
                    } else {
                        boxes[i].style.height = '';
                        var items2 = boxes[i].querySelectorAll('.item');
                        for (var k = 0; k < items2.length; k++) { items2[k].style.height = ''; }
                    }
                }
            }
            var t;
            window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(resetCarouselHeights, 150); });
            window.addEventListener('orientationchange', resetCarouselHeights);
            window.addEventListener('load', resetCarouselHeights);
        })();
    </script>


