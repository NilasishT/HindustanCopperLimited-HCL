@model IEnumerable<Hindustancopperlimited.Models.vw_tenderEOI>

@{
    ViewBag.Title = "Hindustan Copper Limited";
    Layout = "~/Views/Shared/HindiIndexPage.cshtml";
    int count = 0;
    int countA = 0;
    int countEvent = 0;
    int countAwards = 0;
}

<style>
    .minImgDiv {
        width: 50%;
        margin: 0 auto;
    }

    .minImg {
        width: 100%;
        border: 1px solid #e3ecf3;
        border-radius: 90%;
    }

    .minImgPM {
        width: 80%;
        border: 1px solid #e3ecf3;
        border-radius: 90%;
    }


    .minDeg {
        text-align: center;
        font-size: 14px;
        font-weight: 600;
        margin-top: 2%;
    }

    .minName {
        text-align: center;
        /*font-size: 12px;*/
        font-size: 14px;
        font-weight: 400;
        margin-top: -2%;
        padding: 0;
    }

    #splash-banner.show {
        opacity: 1;
        display: flex !important
    }

    #splash-banner.hide {
        opacity: 0;
        pointer-events: none;
    }

    #splash-banner .splash-inner {
        position: relative;
        display: inline-block;
        line-height: 0;
        margin: auto;
    }

    #splash-banner a {
        display: block;
        cursor: pointer;
    }

    #splash-banner img {
        display: block;
        width: auto;
        height: auto;
        max-width: 90vw;
        max-height: 80vh;
        margin: 0 auto;
        border-radius: 4px;
    }

    #splash-banner {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        background: rgba(0, 0, 0, 0.85);
        z-index: 2147483647;
        display: flex;
        align-items: center; /* vertical centre */
        justify-content: center; /* horizontal centre */
        opacity: 0;
        transition: opacity 0.5s ease;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    #splash-close {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 50%;
        background: #C30;
        color: #fff;
        font-size: 20px;
        line-height: 34px;
        text-align: center;
        padding: 0;
        cursor: pointer;
        z-index: 5;
        box-shadow: 0 2px 6px rgba(0,0,0,.5);
    }
    /* #region MySection */
    .aboutus_area .blog_readmore {
        opacity: 1;
        background-color: rgb(255, 255, 255);
        color: #595959;
        text-decoration: none;
    }
    /* #endregion */
</style>

