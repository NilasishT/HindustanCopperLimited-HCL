@model IEnumerable<Hindustancopperlimited.Models.tbl_employmentnotice>

@{
    ViewBag.Title = "Career";
    Layout = "~/Views/Shared/HindiWebsitePage.cshtml";
    DateTime current = DateTime.UtcNow + TimeSpan.Parse("05:30:00");
}


@{Html.RenderAction("TopNews", "Page");}

