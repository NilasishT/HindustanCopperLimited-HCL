@model IEnumerable<Hindustancopperlimited.Models.tbl_mstDengue>

@{
    ViewBag.Title = "Send SMS";
    Layout = "~/Views/Shared/Dengue.cshtml";
}
@using (Html.BeginForm("SendSMS", "Dengue", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
      <legend style="text-align:center; font-weight:bold"> Send SMS - Dengue Detection Report</legend>
     <div class="col-lg-3">
     </div>
  <div class="col-lg-6">
                  <div class="well bs-component">
                   
                      <fieldset>
                      
                        <div class="form-group">
                          <label class="col-lg-3 control-label">Name</label>
                          <div class="col-lg-10">
                           @Html.TextBox("Name", null, new { @class = "form-control" })
                           
                            
                          </div>
                        </div>    
                       
                       <div class="form-group">
                          <label for="textArea" class="col-lg-3 control-label">Phone no.</label>
                          <div class="col-lg-10">
                          @Html.TextBox("Phoneno", null, new { @class = "form-control" })
                            
                          </div>
                        </div>

                         <div class="form-group">
                          <label  class="col-lg-3 control-label">Message</label>
                          <div class="col-lg-10">
                          @Html.TextArea("message", null, new { @class = "form-control" })
                           
                            
                          </div>

                        
                        <div class="form-group">
                          <div class="col-lg-10 col-lg-offset-5" style="padding-top:20px">
                           
                            <button type="submit" class="btn btn-primary">Submit</button>
                             <button type="reset" class="btn btn-default">Cancel</button>
                          </div>
                        </div>
                      </fieldset>
                   
                  </div>
                </div>
                
              
}
