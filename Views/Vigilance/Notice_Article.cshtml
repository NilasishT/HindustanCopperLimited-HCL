<div class="modal fade" id="leaveWebsiteModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h3>Exiting our website</h3>
            </div>
            <div class="modal-body">
                <p>You are now leaving hindustancopper.com. This website is an external website.</p>
            </div>
            <div class="modal-footer">
                <a href="#" class="btn btn-default" data-dismiss="modal">Return</a>
                <a href="#" class="btn btn-primary btn-continue">Continue</a>
            </div>
        </div>
    </div>
</div>

<script>
    $('#leaveWebsiteModal').on('show.bs.modal', function (e) {
        debugger;
        var link = $(e.relatedTarget).data('link');
        $('.btn-continue').attr('href', link);
    });

    $('.btn-continue').on('click', function (e) {
        debugger;
        var link = $(this).attr('href');
        window.open(link, '_blank');

        e.preventDefault();
        $('#leaveWebsiteModal').modal('hide');
    });
</script>


<style>
    body.modal-open {
        overflow: visible !important; 
        padding-right: 0 !important; 
    }

    .modal-content {
        background-color: rgba(255, 255, 255, .9);
        margin: 5% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
    }

    .modal-header {
        min-height: 16.43px;
        padding: 15px;
        border-bottom: 1px solid #e5e5e5;
    }

    * {
        box-sizing: border-box;
    }
</style>