@using Hindustancopperlimited.Controllers;
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/ITIDashboard.cshtml";
    bool IsShow = false;// RecruitmentNewController.CheckEmailExclude();
}

<style>

    table {
        margin-top: 50px;
        width: 60%
    }

    table, th, td {
        border: 1px solid black;
        text-align: center;
    }

    .tableHead {
        background-color: #ac8446;
        font-size: 24px;
        font-family: Monotype Corsiva;
        font-weight: bold;
    }

    .tableSubHead {
        font-size: 20px;
        font-family: Monotype Corsiva;
        font-weight: bold;
        color: Green;
    }
</style>
<input type="hidden" id="hdnAdvId" value="@ViewBag.noticeId" />
<center>
    <table>
        <thead>
            <tr>
                <th colspan="2">
                    @if (ViewBag.Photo != "/content/img/passport-photo1.png" && ViewBag.finalSubmit != "Yes")
                    {
                        <label style="color:Red; font-size:20px;">Pending for final submission</label>
                    }
                </th>
            </tr>
            <tr>
                <th colspan="2" class="tableHead" style="text-transform:uppercase">
                    @ViewBag.Name
                                <a href="../InterviewLetterNew120/@ViewBag.noticeId">.</a>
                                <a href="../InterviewLetterHindiNew120/@ViewBag.noticeId">.</a>
                                <a href="/Content/images/Advetise109/HCL_Various_Posts_IH_Eng_2025.pdf">.</a>
                                <a href="/Content/images/Advetise109/HCL_Various Posts_IH_Hindi_2025.pdf">.</a>
                            </th>
            </tr>
        </thead>
        <tbody>

            <tr>
                @if ((ViewBag.finalSubmit != "Yes" && ViewBag.dateEnd == "No") || IsShow)
                {
                    <td colspan="2" class="tableSubHead"><a href="../CandidatePersonalDetails/@ViewBag.noticeId"> Personal Details </a></td>
                }
            </tr>
            <tr>
                @if ((ViewBag.finalSubmit != "Yes" && ViewBag.checkPersonalDetails >= 1 && ViewBag.dateEnd == "No") || IsShow)
                {
                    <td colspan="2" class="tableSubHead"><a href="../EducationDetails/@ViewBag.noticeId"> Education Details </a></td>
                }
            </tr>

            <tr>
                @if (ViewBag.IsFresher == false && (ViewBag.checkQualificationDetails >= 1 && ViewBag.finalSubmit != "Yes" && ViewBag.dateEnd == "No") || IsShow)
                {
                    <td colspan="2" class="tableSubHead"><a href="../ExperienceDetails/@ViewBag.noticeId"> Experience Details </a></td>
                }
            </tr>
            <tr>

                @if ((ViewBag.checkQualificationDetails >= 1 && ViewBag.finalSubmit != "Yes" && ViewBag.dateEnd == "No") || IsShow)
                {
                    <td colspan="2" class="tableSubHead"><a href="../UploadDetails/@ViewBag.noticeId"> Upload Details </a></td>
                }
            </tr>
            <tr>
                @if (ViewBag.checkPersonalDetails != 0 && ViewBag.checkQualificationDetails != 0 && ViewBag.checkDocumentDetails != 0)
                {
                    <td colspan="2" class="tableSubHead"><a href="../PrintPreview/@ViewBag.noticeId"> Print Application </a></td>
                }
            </tr>

            <tr>
                @if (ViewBag.finalSubmit == "Yes")
                {
                    <td colspan="2" class="tableSubHead"><a href="../Acknowledgement/@ViewBag.noticeId"> Acknowledgement Report </a></td>
                }
            </tr>

            <tr>
                <td colspan="7" style="display:none">

                    @if (ViewBag.checkFeesDataCount == 1 && @ViewBag.noticeId == 51)
                    {
                        if (ViewBag.feeClaimDetailsCount == 0)
                        {
                            <div style="text-align:center"><a href="@("../FeeClaim/?AppNo=" + HttpUtility.UrlEncode(ViewBag.strApplication_No.ToString()))"
                               style="font-size:20px; font-weight:bold; color:red">
                                Application Fee Refund Bank Details Form
                            </a> </div>
                        }
                        else
                        {
                            <div style="text-align:center;font-size:20px; font-weight:bold; color:green">
                                Fee Refund  Bank Details Form Submitted Successfully
                            </div>
                        }
                    }
                </td>
            </tr>

            <tr>
                @if (ViewBag.finalSubmit == "Yes" && ViewBag.Admitflag == false) //Model.RollNo!=null && !string.IsNullOrEmpty(Model.ExamTime))
                {

                    <td colspan="2" class="tableSubHead"><a href="../AdmitCard/@ViewBag.noticeId" target="_blank">Admit Card</a></td>

                }
            </tr>
            @*<tr>
            @if (ViewBag.finalSubmit == "Yes" && ViewBag.Admitflag == false) //Model.RollNo!=null && !string.IsNullOrEmpty(Model.ExamTime))
            {

                <td colspan="2" class="tableSubHead"><a href="~/Content/PDF/InfoHandout/HCL Various Posts IH Eng 2023_2.pdf" target="_blank">Information Handout - English</a></td>

            }
        </tr>

        <tr>
            @if (ViewBag.finalSubmit == "Yes" && ViewBag.Admitflag == false) //Model.RollNo!=null && !string.IsNullOrEmpty(Model.ExamTime))
            {

                <td colspan="2" class="tableSubHead"><a href="~/Content/PDF/InfoHandout/HCL Various Posts IH Hindi 2023.pdf" target="_blank">Information Handout - Hindi</a></td>

            }
        </tr>*@

            @if (ViewBag.InterviewLetter != null && @ViewBag.noticeId == 129) //Model.RollNo!=null && !string.IsNullOrEmpty(Model.ExamTime))
            {
                <tr>
                    <td colspan="2" class="tableSubHead"><a href="../PersonalInterviewLetter129/@ViewBag.noticeId">Interview Call Letter</a></td>
                </tr>

            }


            @if (ViewBag.InterviewLetter != null && @ViewBag.noticeId == 113) //Model.RollNo!=null && !string.IsNullOrEmpty(Model.ExamTime))
            {
                <tr>
                    <td colspan="2" class="tableSubHead"><a href="../InterviewCallLetterNew129/@ViewBag.noticeId">Call Letter </a></td>
                </tr>
                @*<tr>
                <td colspan="2" class="tableSubHead"><a href="/Content/images/Advetise109/HCL_Various_Get_Posts_IH_Eng_2025.pdf">Examination information Handout - English </a></td>
            </tr>
            <tr>
                <td colspan="2" class="tableSubHead"><a href="/Content/images/Advetise109/HCL_Various_Get_Posts_IH_Eng_2025.pdf"> Examination information Handout - Hindi </a></td>
            </tr>*@
            }

            @if (ViewBag.InterviewLetter != null && @ViewBag.noticeId == 120) //Model.RollNo!=null && !string.IsNullOrEmpty(Model.ExamTime))
            {
                @*<tr>
                <td colspan="2" class="tableSubHead"><a href="../InterviewLetterNew120/@ViewBag.noticeId"> Call Letter </a></td>
            </tr>
            <tr>
                <td colspan="2" class="tableSubHead"><a href="/Content/images/Advetise109/HCL_Various_Posts_IH_Eng_2024.pdf"> Examination information Handout - English </a></td>
            </tr>
            <tr>
                <td colspan="2" class="tableSubHead"><a href="/Content/images/Advetise109/HCL_Various Posts_IH_Hindi_2024.pdf"> Examination information Handout - Hindi </a></td>
            </tr>*@

                <tr>
                    <a href="../InterviewLetterNew120/@ViewBag.noticeId">.</a>
                    <a href="/Content/images/Advetise109/HCL_Various_Posts_IH_Eng_2025.pdf">.</a>
                    <a href="/Content/images/Advetise109/HCL_Various Posts_IH_Hindi_2025.pdf">.</a>
                </tr>
            }

            <tr>
                <td colspan="2" class="tableSubHead"><a href="../ChangePassword"> Change Password </a></td>
            </tr>
            <tr>
                <td colspan="2" class="tableSubHead"><a href="../Logout"> Logout </a></td>
            </tr>
            @if (ViewBag.Photo != "/content/img/passport-photo1.png")
            {
                <tr>
                    <td><img src="@ViewBag.Photo" width="100px" /></td>
                    <td><img src="@ViewBag.Signature" width="100px" /></td>
                </tr>
            }
        </tbody>

    </table>
</center>