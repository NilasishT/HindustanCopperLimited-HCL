                                            @Html.DisplayFor(model => model.strAdress1, new { @class = "form-control" })
                                        </div>
                                    </div>
                                </fieldset>
                            </div>



                       
					
					
                        <div class="col-lg-12" style="border-top: 1px solid #6f3706">
                    </div>
