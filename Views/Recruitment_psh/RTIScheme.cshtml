@{
    ViewBag.Title = "RTI Scheme";
    Layout = "~/Views/Shared/WithoutHeaderandSidebar.cshtml";                   
  }                       

  @using (Html.BeginForm("RTIScheme", "Recruitment", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
  {
 <fieldset>
   <div>

    
        
        <div class="row" >
          <div class="col-md-12">
            <div class="card">
              <div class="card-body" style="padding-top:10%; padding-bottom:10%">

              <table class="table table-hover table-bordered" style="text-align:center; font-size:20px;font-weight:bold; border:2px solid #6f3706" >
              
              <tr><td colspan="2">आर टी आई के अंतग्रत अंको का प्रकटन  DISCLOSURE OF MARKS  UNDER RTI SCHEME</td></tr>
              <tr><td colspan="2">आर टी आई के अंतग्रत मेरे अंक सभी के लिए प्रकट किए जाए My marks may be disclosed under RTI Scheme for everyone(P)</td></tr>

              <tr><td><button type="submit" class="btn btn-primary" name="btnSubmit" value="Yes">Yes</button></td><td><button type="submit" class="btn btn-primary" name="btnSubmit" value="No">No</button></td></tr>

              </table>
                
        </div>
    </div>
    </div>
    </div>
    </div>
    </fieldset>
  }