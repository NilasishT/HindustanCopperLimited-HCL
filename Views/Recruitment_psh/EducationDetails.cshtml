                          <tr>
                              <td style="padding:3px">
                              @if (ViewBag.selectValue == eduItem.str_qualification)
                              {
                                  <input style="width:30px; height:30px" type="checkbox" checked="checked" name="str_qualification" value='@eduItem.str_qualification'/>
                              }
                              else
                              {
                              <input style="width:30px; height:30px" type="checkbox" name="str_qualification" value="@eduItem.str_qualification"/>
                              }
                              
                              </td>
                              <td style="padding:4px"> @eduItem.str_qualification</td>
                          </tr>
                          }
                          </table>

                        </fieldset>
                   </div>
                  </div>
                </div>  
                
               
