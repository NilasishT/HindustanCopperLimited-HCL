@{
    ViewBag.Title = "Add Unit";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}


  
                <div class="col-lg-6">
                  <div class="well bs-component">
                    <form class="form-horizontal" method="post">
                      <fieldset>
                        <legend>Unit</legend>
                        <div class="form-group">
                          <label for="inputEmail" class="col-lg-2 control-label">Unit Name</label>
                          <div class="col-lg-10">
                            <input id="inputEmail" type="text" placeholder="Unit Name" name="strUnitName" class="form-control">
                            
                          </div>
                        </div>

                        <div class="form-group">
                          <label for="inputEmail" class="col-lg-2 control-label">Unit Code</label>
                          <div class="col-lg-10">
                            <input id="inputEmail" type="text" placeholder="Unit Code" name="strUnitCode" class="form-control">
                            
                          </div>
                        </div>
                        
                        
                        <div class="form-group">
                          <label for="textArea" class="col-lg-2 control-label">Unit Address</label>
                          <div class="col-lg-10">
                            <textarea id="textArea" rows="3" placeholder="Unit Code" class="form-control" name="strUnitAddress"></textarea><span class="help-block">A longer block of help text that breaks onto a new line and may extend beyond one line.</span>
                          </div>
                        </div>
                       
                        
                        <div class="form-group">
                          <div class="col-lg-10 col-lg-offset-2">
                            <button type="reset" class="btn btn-default">Cancel</button>
                            <button type="submit" class="btn btn-primary">Submit</button>
                          </div>
                        </div>
                      </fieldset>
                    </form>
                  </div>
                </div>
                
              