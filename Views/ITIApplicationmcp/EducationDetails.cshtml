<script>
    var postVal = ($("#post").val() || "").trim().toUpperCase();
    var isSpecialTrade = ["MATE MINES (FRESHER)", "SHOTFIRER/ BLASTER (MINES)", "DRIVER-CUM-MECHANIC (LMV)"].indexOf(postVal) > -1;

    if (isSpecialTrade) {
        $('#hideTr2, #hideTr3, #aboutITIDesc').hide();
    } else {
        $('#hideTr3, #aboutITIDesc').show();
    }

    // ITI passing year -> show affidavit box
    $('#Str_passingyear2').on('change', function () {
        var arr = this.value.split('-');
        $('#str_ItiPassingYear1').val(arr[2]);
        var yr = parseInt(arr[2], 10);
        $('#ItiAffidavitDiv').css('display', (yr <= 2025) ? 'block' : 'none');
    });

    // remove "required" messages when user fixes the field
    $("select").change(function () { $(this).next("span").remove(); });
    $("input:visible:not([readonly],[type=hidden])").keyup(function () {
        if ($(this).val() != "") $(this).next("span").remove();
    });

    // cut-off date check
    $("#Str_passingyear,#Str_passingyear2").change(function () {
        var dt1 = this.value.split('-').reverse().join('-');
        var dt2 = '01-11-2026'.split('-').reverse().join('-');
        if (new Date(dt1) > new Date(dt2)) {
            alert('The date of passing of qualifying exam like (ITI & 10th) should not be later than the cut-off date as advertised.');
            this.value = "";
        }
    });

    // CGPA / % handling for the 3 rows ("", "1", "2")
    $.each(["", "1", "2"], function (_, s) {
        $("#StrRemarks" + s).change(function () {
            $("#Str_TotalMarks" + s).removeAttr('readonly');
            if (this.value == "CGPA") {
                $("#Str_TotalMarks" + s).val('10').attr('readonly', true);
            } else {
                $("#Str_TotalMarks" + s).val('');
            }
            $("#Str_MarksObtained" + s).val('');
            $("#Str_Marks" + s).val('');
        });

        $("#Str_TotalMarks" + s + ",#Str_MarksObtained" + s).change(function () {
            if (parseFloat(this.value) == 0) {
                alert("The marks field should not accept '0' (Zero) values.");
                this.value = "";
                return;
            }
            var total = parseFloat($("#Str_TotalMarks" + s).val());
            var obtained = parseFloat($("#Str_MarksObtained" + s).val());
            var isCgpa = $("#StrRemarks" + s).val() == "CGPA";

            if (isNaN(total) || isNaN(obtained)) return;

            if (isCgpa && total > 10) {
                alert('If selected CGPA, maximum marks should be 10');
                $("#Str_TotalMarks" + s).val('');
                return;
            }
            if (obtained > total) {
                alert('The obtained marks should not be greater than the total marks');
                $("#Str_MarksObtained" + s + ",#Str_Marks" + s).val('');
                return;
            }

            var pct = isCgpa ? obtained * 9.5 : (obtained / total * 100);

            // 33% minimum for 10th and ITI only
            if ((s === "" || s === "2") && pct < 33) {
                alert('The obtained marks should not be less than 33%');
                $("#Str_MarksObtained" + s + ",#Str_Marks" + s).val('');
                return;
            }
            $("#Str_Marks" + s).val(pct.toFixed(2));
        });
    });

    function toDate(v) {
        var p = (v || "").split("-");
        return new Date(p[2] + "-" + p[1] + "-" + p[0]);
    }

    function error() {
        var noerror = true;
        $("input, select").next("span").remove();

        var skip = isSpecialTrade
            ? "#Str_board1,#Str_passingyear1,#Str_duration1,#Str_TotalMarks1,#Str_MarksObtained1,#Str_Marks1,#Str_board2,#Str_passingyear2,#Str_duration2,#Str_TotalMarks2,#Str_MarksObtained2,#Str_Marks2,#file-upload"
            : "#Str_board1,#Str_passingyear1,#Str_duration1,#Str_TotalMarks1,#Str_MarksObtained1,#Str_Marks1";

        $("input:visible:not([readonly],[type=hidden])").not(skip).each(function () {
            if ($(this).val() == "") {
                noerror = false;
                $(this).after("<span style='color:Red'> This field is required</span>");
            }
        });

        if (!isSpecialTrade) {
            if ($("#Str_Affiliation2").val() == "") {
                noerror = false;
                $("#Str_Affiliation2").after("<span style='color:Red'> This field is required</span>");
            }
            var yr = parseInt($('#str_ItiPassingYear1').val(), 10);
            var hasOld = $('#straffidavitUrl').attr('href');
            if (yr <= 2025 && $("#file-upload")[0].files.length === 0 && !hasOld) {
                noerror = false;
                $("#file-upload").after("<span style='color:Red'> Affidavit is required</span>");
            }
            if (toDate($("#Str_passingyear").val()) >= toDate($("#Str_passingyear2").val())) {
                noerror = false;
                $("#Str_passingyear2").after("<span style='color:Red'> Invalid Date Range</span>");
            }
        }

        if (!noerror) return false;
        return confirm("Are you sure ?");
    }

    // affidavit file validation
    $("#file-upload").on("change", function () {
        var f = this.files[0];
        if (!f) return;
        if (!/\.pdf$/i.test(f.name)) { alert("Invalid File Type."); $(this).val(""); return; }
        if (f.size > 1048576 || f.size < 20480) {
            alert("File size must be between 20KB and 1MB");
            $(this).val("");
        }
    });
</script>

