                                                                                </tr>
                                                                                <tr>
                                                                                    <td style="border: 1px solid #a0a0a0;padding: 12px;">2</td>
                                                                                    <td style="border: 1px solid #a0a0a0;padding: 12px;">Deputy Manager [E2] Management Trainee / Graduate Engineer Trainee [E1] </td>
                                                                                    <td style="border: 1px solid #a0a0a0;padding: 12px;">Rail AC III Tier / ACC</td>
                                                                                </tr>
                                                                            </tbody>
                                                                        </table>
                                                                        <span>Bus fare for road journey from / to a place not connected by Rail shall be admissible, subject to production of proof of journey.</span>
