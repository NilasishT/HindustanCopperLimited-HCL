                                                                    @if (@edu.str_GATEResult != null && @edu.str_GATEResult != "")
                                                                    {
                                                                        <a href="@edu.str_GATEResult" target="_blank" style="color: blue;">View</a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <a>-</a>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }


                                                    </table>
                                                </center>
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>
                    }


                    @if (ViewBag.expAll != null)
                    {

                        <div class="col-lg-12">
                            <div class="well bs-component" style="text-align:center; padding:4px;  color:#6f3706; margin:8px; border:solid 1px #6f3706">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <label style="font-size:medium"><b>Experience Details </b> </label>
                                    </fieldset>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <div class="well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <div class="form-group">
                                            <label></label>
                                            <div class="col-lg-12">
                                                <center>
                                                    <table id="tblexprenceDetails" border="2" width="95%" style="text-align:center">
                                                        <tr>
                                                            <td><b>Organisation Type</b></td>
                                                            <td><b>Employment Status </b></td>
                                                            <td><b>Organisation Name</b></td>
                                                            <td><b>Last Designation/Post Held </b></td>
                                                            <td><b>CTC</b></td>
                                                            <td><b>Scale of Pay </b></td>
                                                            <td><b>From Date</b></td>
                                                            <td><b>To Date</b></td>
                                                            <td><b>Total Days of Experience</b></td>
                                                        </tr>

                                                        @foreach (var exp in ViewBag.expAll)
                                                        {
                                                            <tr>
                                                                <td>@exp.str_organisationType</td>
                                                                <td>@exp.StrEmploymentPresentStatus</td>
                                                                <td>@exp.str_organisation</td>
                                                                <td>@exp.Str_designation</td>
                                                                <td>@exp.str_CTC</td>
                                                                <td>@exp.str_PayScale</td>
                                                                <td>@Convert.ToDateTime(exp.dt_fromdate).ToString("dd-MM-yyyy")</td>
                                                                <td>@Convert.ToDateTime(exp.dt_todate).ToString("dd-MM-yyyy")</td>
                                                                <td>@exp.str_noyears</td>
                                                            </tr>
                                                        }
                                                        <tr>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td><b>Total Experience</b></td>
                                                            <td colspan="3">@ViewBag.totalYearproper</td>
                                                        </tr>
                                                    </table>
                                                </center>
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>

                    }


                    <div class="col-lg-12">
                        <div class="well bs-component" style="text-align:center; padding:4px;  color:#6f3706; margin:8px; border:solid 1px #6f3706">
                            <div class="form-horizontal">
                                <fieldset>
                                    <label style="font-size:medium"><b>Upload Details </b> </label>
                                </fieldset>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-12">
                        <div class="well bs-component">
                            <div class="form-horizontal">
                                <fieldset>
                                    <div class="form-group">
                                        <label></label>
                                        <div class="col-lg-12">
                                            <center>
                                                <table id="tbllistofplantMachinery" border="2" style="text-align:center; width:95%">
                                                    <tr>
                                                        <td class="col-lg-4"><b>Type</b></td>
                                                        <td class="col-lg-4"><b>View Upload</b></td>
                                                    </tr>
                                                    <tr>
                                                        <td style="text-align:left; font-weight:bold">Photo</td>
                                                        <td><img src="@ViewBag.Photo" width="100px" ; height="100px" ; /></td>
                                                    </tr>
                                                    <tr>
                                                        <td style="text-align:left; font-weight:bold">Signature</td>
                                                        <td><img src="@ViewBag.Signature" width="100px" ; height="100px" ; /></td>
                                                    </tr>
                                                </table>
                                            </center>
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                    </div>




                    <div class="col-lg-12">
                        <div class="well bs-component" style="text-align:center; padding:4px;  color:#6f3706; margin:8px; border:solid 1px #6f3706">
                            <div class="form-horizontal">
                                <fieldset>
                                    <p>
                                        <span> I hereby opt an option for disclosure scheme provided under of Right to Information Act, 2005 </span>
                                        <span style="padding-left:10%"> @Html.DropDownList("strAnswer", new List<SelectListItem> { new SelectListItem { Text = "Yes", Value = "Yes" }, new SelectListItem { Text = "No", Value = "No" } })</span>
                                    </p>
                                </fieldset>
                            </div>
                        </div>
                    </div>

                    @if (ViewBag.finalSubmit != "Yes")
                    {
                        <div class="col-lg-12">
                            <div class="well bs-component" style="text-align:center; padding:4px;  color:#6f3706; margin:8px; border:solid 1px #6f3706">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <label style="font-size:medium"><b>Declaration</b> </label>

                                    </fieldset>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-12">
                            <div class="well bs-component" style="text-align:center; padding:4px;  color:#6f3706; margin:8px; border:solid 1px #6f3706">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <p>
                                            <input type="checkbox" id="CandidateAgree" name="CandidateMsg" required />
                                            I hereby declare that all the statement made in this application is True, Complete and Correct to the best of my knowledge and belief. I understand that in the event of any information being found untrue or incorrect  at any stage or I am not satisfying any of the eligibility criteria stipulated, and also in case of creating influence/undue pressure regarding recruitment shall tantamount to cancellation of my candidature .
                                        </p>
                                    </fieldset>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="col-lg-12" style="border-top:1px solid #6f3706">
                    </div>

                    <div class="col-lg-12" style="padding-top:10px">
                        <div class="form-group">
                            <div class="col-lg-10 col-lg-offset-5">
                                @if (ViewBag.finalSubmit == "No")
                                {
                                <button type="button" class="btn btn-primary" onclick="location.href = '../CandidatePersonalDetails/@Url.RequestContext.RouteData.Values["id"]';" value="Submit" name="strSubmit" id="Submit1">Edit</button>
                                <button type="submit" class="btn btn-primary" value="Final Submit" name="strSubmit" id="Submit">Final Submit</button>
                                 } 
                                @if (ViewBag.finalSubmit == "Yes")
                                {
                                    <button type="button" class="btn btn-primary" onclick="location.href = '../ApplicationPrint/@Url.RequestContext.RouteData.Values["id"]';" value="Submit" name="strSubmit" id="Submit2">Print Application</button>
                                }
                                <button id="dashboard" type="button" class="btn btn-primary" onclick="location.href = '../Dashboard/@Url.RequestContext.RouteData.Values["id"]';" value="Submit" name="strSubmit" id="Submit3">Dashboard</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


}

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
            var msg = "@ViewBag.Message";
            if (msg == "You have not applicable to this post!") {
                alert('Candidate Do Not Meet the Eligibility Criteria Due To Experience and Education. ');
            }

    </script>
}



