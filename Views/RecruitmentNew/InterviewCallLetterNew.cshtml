                                    <b style="display: inline-block;">(a) Date</b> <p style="display: inline-block; padding: 0px 0px 5px 90px; ">: <b>@Html.DisplayFor(model => model.Date, null, new { @class = "form-control" })</b></p><br style="display: block;">
                                </td>
