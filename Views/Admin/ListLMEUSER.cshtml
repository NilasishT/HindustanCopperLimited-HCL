@model IEnumerable<Hindustancopperlimited.Models.tbl_mst_CCOregistrations>

@{
    ViewBag.Title = "List LME User";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{

       @Html.ActionLink("Add LME User", "CreateLMEUser", null, new { @class = "btn btn-primary" })
      <br />
    <br />
    
    <fieldset>
   <div>
        
        <div class="row">
          <div class="col-md-12">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered">
                  <thead>
                    <tr>
                      <th>Edit</th>
                      
                      <th>Name</th>
                       <th>Code</th>
                      <th>Email</th>
                       <th>Ph No.</th>
                        <th>Mobile No.</th>
                     
                    
                   
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                      <td>@Html.ActionLink("Edit", "EditLMEUser", new { id = item.Pk_CCOid })</td>
                     
                      <td> @item.str_fname  @item.str_lname</td>
                      <td>@item.str_code</td>
                      <td> @item.str_email</td>
                      <td> @item.str_phone</td>
                       <td>@item.str_mobile</td>
                      
                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
