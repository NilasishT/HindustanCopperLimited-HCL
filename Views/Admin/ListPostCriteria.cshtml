@model IEnumerable<Hindustancopperlimited.Models.Vw_Postdesiciplinedetails>

@{
    ViewBag.Title = "Post Criteria List";
    Layout = "~/Views/Shared/Dashboard.cshtml";
    //Layout = "~/Views/Shared/Datatable.cshtml";
}
                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{
       <div class="col-lg-12" style="text-align:right">
   
      @Html.ActionLink("Add Post criteria", "AddPostCriteria", null, new { @class = "btn btn-primary" })
    </div>
     <br />
    <br />
  
    
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered" >
                  <thead>
                   <tr>
                   <th>Delete</th>
                   <th>Edit</th>
                      <th>Adv No.</th>
                      
                      
                      <th>Post Name</th>
                      
                       <th>Discipline</th>
                       <th>Grade</th>
                        <th>CTC</th>
                      
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                       <td>@Html.ActionLink("Delete", "DeletePostCriteria", "Admin", new { id = item.Pk_criteriaid }, new { id = item.Pk_criteriaid, onclick = "return confirm('Are you sure for delete?')" })
                       </td>
                       <td>@Html.ActionLink("Edit", "EditPostCriteria", "Admin", new { id = item.Pk_criteriaid }, new { id = item.Pk_criteriaid })
                       </td>
                      <td> @item.Empnoticeno</td>
                     
                       <td> @item.Postname</td>
                       
                       <td> @item.DisciplineName</td>
                       <td> @item.str_postGrade</td>
                       <td> @item.str_postCTC</td>
                          
                    </tr>

            }
                    
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
  