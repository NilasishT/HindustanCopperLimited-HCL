@model Hindustancopperlimited.Models.tbl_mst_Postnew
@{
    ViewBag.Title = "Add Post";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}

 <style>
#topBarHclHedT {

    font-size: 27px;
    font-family: 'Open Sans',sans-serif;
    font-weight: 600;
    padding-left: 0%;
    margin: 9px 0;
    display: inline-block;
    color: #6f3706;

}
</style> 

<div class="col-lg-10">
                  <div class="well bs-component">
                 @using (Html.BeginForm("AddPostnew", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
                 {
                  @Html.AntiForgeryToken()
                      <fieldset>
                      <legend> <b>Add Post <span style="color:Red; font-size:14px; padding-left:60%"> ( * Fields are Mandatory )</span></b></legend>

           <div class="row">
          <div class="col-md-12">
            <div class="card">
             <div class="row">
              <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Discipline<span style="color:Red"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-10">
                            @Html.DropDownList("fk_discipline", null, "Select", new { @class = "form-control" })

                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>   

             <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Post<span style="color:Red"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-10">
                            @Html.TextBoxFor(model => model.Postname, null, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
             
                   <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Grade<span style="color:Red"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-10">                            
                            @Html.TextBoxFor(model => model.str_Grade, null, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>

                   <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label> Pay Scale<span style="color:Red"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-10">                          
                        @Html.TextBoxFor(model => model.Payscale, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>

                  <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>CTC(Per Year)<span style="color:Red"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-10">                          
                             @Html.TextBoxFor(model => model.str_ctc, new { @class = "form-control", @type = "number" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>                   
                                     
                 <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Minimum Experience<span style="color:Red"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-10">                          
                            @Html.TextBoxFor(model => model.str_minexp, new { @class = "form-control", @type = "number" })
                          </div>
                        </div>
                      </fieldset>
                   </div>
                  </div>
                </div>
                       
                
               @* <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Date of Reckoning<span style="color:Red"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                                                      
                             @Html.TextBoxFor(model => model.dtcompareDate, null, new { @class = "form-control input-append date" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>*@

                 <div class="col-lg-12"></div>
                <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Minimum Age<span style="color:Red"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-10">                          
                            @Html.TextBoxFor(model => model.str_minage, new { @class = "form-control", @Value = "18", @type = "number" })
                          </div>
                        </div>
                     </fieldset>
                   </div>
                  </div>
                </div>  

                <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Maximum Age<span style="color:Red"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-10">                          
                           @Html.TextBoxFor(model => model.str_maxage, new { @class = "form-control", @type = "number" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>  

                 <div class="col-lg-12"></div>

                

                @*<div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Maximum Experience<span style="color:Red"> (*)</span></label>                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                            @Html.TextBoxFor(model => model.str_maxexp, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>*@

             <div class="col-lg-6">
                  <div class="well bs-component">
                   <fieldset>
                         <label>Is Freshers Allowed?<span style="color:Red"> (*)</span></label>
                    <div class="form-group">
                          <div class="col-lg-10">  
                           @Html.DropDownListFor(model => model.strIsFreshersAllowed, new List<SelectListItem> {
                                              new SelectListItem {Text="Yes",Value="Yes"},
                                              new SelectListItem {Text="No",Value="No"}}, "Select", new { @class = "form-control" }) 
                  
                        </div>
                       </div>
                     </fieldset>
                   </div>
                  </div>
                </div>
                
                  
                </div>
                </div>
                </div>
                
               <div class="form-group">
                          <div class="col-lg-8 col-lg-offset-4">
                           
                            <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
                         @* <button type="reset" class="btn btn-default">Cancel</button>*@
                             @Html.ActionLink("Cancel", "ListPostnew", null, new { @class = "btn btn-default" })
                           
                          </div>
                        </div>
             </fieldset>


                 }
                
                  </div>
                </div>
@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        window.onload = function () {
            var aa = "@ViewBag.Message";
            alert(aa);
            if (aa == "Your data saved successfully") {
                window.location.href = '../Admin/ListPostnew';
            }
        };
    </script>
}


<script src="@Url.Content("~/Content/js/Validationpostnew.js?a=5")"></script>