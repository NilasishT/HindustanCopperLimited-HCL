@model IEnumerable<Hindustancopperlimited.Models.vw_PostwithDiscipline>

@{
    ViewBag.Title = "Post List";
    Layout = "~/Views/Shared/Dashboard.cshtml";
    //Layout = "~/Views/Shared/Datatable.cshtml";
}

 <style>
#topBarHclHedT {

    font-size: 27px;
    font-family: 'Open Sans',sans-serif;
    font-weight: 600;
    padding-left: 0%;
    margin: 9px 0;
    display: inline-block;
    color: #6f3706;

}
</style> 


<div class="col-lg-12">
<div class="well bs-component">
@using (Html.BeginForm())
{
    
    <div class="col-lg-12" style=" text-align:right">
     @Html.ActionLink("Application Report", "ApplicationDetails", null, new { @class = "btn btn-primary" })
    @*@Html.ActionLink("Manage Application", "ListCandidate", null, new { @class = "btn btn-primary" })*@
    @Html.ActionLink("Add Post", "AddPostnew", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("Manage Discipline", "DisciplineCreateList", null, new { @class = "btn btn-primary" })
  
    </div>
    <br />
    <br />
    <br /> 
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered" >
                  <thead>
                   <tr>
                      <th>Edit</th>
                      <th>Delete</th>
                      <th>Discipline</th>
                      <th>Post</th>
                      <th>Grade</th>
                      <th>Pay Scale</th>
                      <th>Minimum Experience</th>
                      <th>Maximum Age</th>
                      <th>Is Freshers Allowed?</th>

                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                      <td>@Html.ActionLink("Edit", "EditPostnew", new { id = item.Pk_Postid })</td>
                      <td>@Html.ActionLink("Delete", "DeletePostnew", "Admin", new { id = item.Pk_Postid }, new { id = item.Pk_Postid, onclick = "return confirm('Are you sure for delete?')" })</td>
                      <td>@item.DisciplineName</td>
                      <td>@item.Postname</td>
                      <td>@item.str_Grade</td>
                      <td>@item.Payscale</td>
                      <td>@item.str_minexp</td>
                      <td>@item.str_maxage</td>
                      <td>@item.strIsFreshersAllowed</td>
                    </tr>

            }
                    
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
  