<script type="text/javascript">

    $(document).ready(function () {

        function replaceData(sData) {
            if (sData == null) {
                return '#';
            }
            else {
                return sData.replace("~", "");
            }

        };

        $("#SelectedcandidateTable").DataTable({
            "processing": true, // for show progress bar
            "serverSide": true, // for process server side
            "filter": true, // this is for disable filter (search box)
            "orderMulti": false, // for disable multiple column at once


            "ajax": {
                "url": "/Admin/LoadSelectedCandidate",

                "type": "POST",
                "datatype": "json"
            },
            createdRow: function (row, data, index) {
                $('td', row).eq(0).addClass('hidden');
                $('td', row).eq(1).addClass('hidden');
            },

            "columns": [
                            { "data": "Pk_int_CandidateRegistrationID", "name": "Pk_int_CandidateRegistrationID" },
                             { "data": "strApplicationNo", "name": "strApplicationNo" },
                            { "data": "strApplicationNo", "fnCreatedCell": function (nTd, sData, oData, iRow, iCol) { $(nTd).html("<input class='clickMeAppeared' type='checkbox' dataId=" + oData.strApplicationNo + " id='chkAppeared_" + oData.Pk_int_CandidateRegistrationID + "'name='chkAppeared' />"); } },
                            { "data": "strApplicationNo", "name": "strApplicantName", "autoWidth": true },

                            { "data": "strApplicantName", "name": "strApplicantName", "autoWidth": true },

                            { "data": "strFatherName", "name": "strFatherName", "autoWidth": true },
                            { "data": "strCategory", "name": "strCategory", "autoWidth": true },
                            
                          
                ]

        });
    });

     </script>

      <script type="text/javascript">

          $("#btnSubmit").click(function () {

              var tblsampleTable = document.getElementById("SelectedcandidateTable");
              var TableData = [];
              var m = $("#SelectedcandidateTable > tbody > tr").length
              for (j = 1; j <= m; j++) {

                  var pkId = tblsampleTable.rows[j].cells[0].innerHTML;
                  var strAppNo = tblsampleTable.rows[j].cells[1].innerHTML;
                  if ($("#chkAppeared_" + pkId).prop("checked") == true) {                      
                      TableData.push({
                          strApplicationNo: strAppNo,
                         
                      });
                  }

              }
              var _data = JSON.stringify({
                  candidtelist: {
                      List: TableData
                  }

              });

              $.ajax({

                  url: '/Admin/InsertSelectcandidate/?Status=' + $("#str_mode").val(),
                  contentType: "application/json",
                  dataType: "json",
                  type: "POST",
                  data: _data,
                  success: function (response) {

                      if (response != null && response != undefined) {
                          window.location.href = '/Admin/ListCandidate';
                      } else {
                          window.location.href = '/Admin/ListCandidate';
                      }
                  },
                  error: function (jqxhr, settings, thrownError) {

                      console.log(jqxhr.status + '\n' + thrownError);
                  }
              });
          });
                         
  </script>

     
