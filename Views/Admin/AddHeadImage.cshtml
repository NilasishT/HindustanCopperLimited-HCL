@model Hindustancopperlimited.Models.tbl_mst_HeadImage
@{
    ViewBag.Title = "Add Head Image";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}
<div class="col-lg-12">
    <div class="well bs-component">
        <fieldset>
            @using (Html.BeginForm("AddHeadImage", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
            {
  
    
                @Html.AntiForgeryToken()
                <legend><b>Add Head Image </b><span style="color: Red; font-size: 14px; padding-left: 40%">( * ) Fields are Mandatory</span></legend>
                    
	
         <div class="form-group">
                    <label class="col-lg-4 control-label">
                      Image Title<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                      
                           @Html.TextBoxFor(m => m.strImageTitle, new { @class = "form-control", required = "required" })
                            @Html.HiddenFor(model => model.dtUpdatedate)    
                    </div>
                </div>
                
                
                <div class="form-group">
            <label class="col-lg-4 control-label"> Image Upload<span style="color:Red"> (*)</span></label>
            <div class="col-lg-8">
            <input type="file" name="strImagePath" id="strImagePath"   /> 
            </div>

        </div>
                
                
                
                
                
                 <div class="form-group">
                    <label class="col-lg-4 control-label">
                      Image Title(In Hindi-UNICODE)<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                      
                           @Html.TextBoxFor(m => m.strHindiImageTitle, new { @class = "form-control", required = "required" })
                          
                    </div>
                </div>
                
                
                <div class="form-group">
            <label class="col-lg-4 control-label"> Image Upload(In Hindi-UNICODE)<span style="color:Red"> (*)</span></label>
            <div class="col-lg-8">
            <input type="file" name="strHindiImagePath" id="strHindiImagePath"   /> 
            </div>

        </div>
                
                
                
	   <div class="form-group">
            <div class="col-lg-6 col-lg-offset-6">
                           
            <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
               @Html.ActionLink("Cancel", "ListHeadImage", null, new { @class = "btn btn-default" })
            </div>
        </div>
              
                
    
                
             
                      
                      
                  

            }
        </fieldset>
    </div>
</div>
@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        window.onload = function () {
            var aa = "@ViewBag.Message";
            alert(aa); window.location.href = '/Admin/ListHeadImage';
        };
    </script>
}



 <script type="text/javascript">

     function error() {
         $("#strImageTitle,#strImagePath,#strHindiImagePath").next("span").remove();

         var noerror = 1;


         if ($('#strImageTitle').val() == "") {
             $("#strImageTitle").after("<span style='color:Red'>This field is required</span>");
             noerror = 0;
         }
         if ($('#strImagePath').val() == "") {
             $("#strImagePath").after("<span style='color:Red'>This field is required</span>");
             noerror = 0;
         }

         if ($('#strHindiImagePath').val() == "") {
             $("#strHindiImagePath").after("<span style='color:Red'>This field is required</span>");
             noerror = 0;
         }


         if (noerror == 1) {
             if (confirm("Are you sure ?")) {
                 return true;

             }
             else {
                 return false;
             }
         }

         if (noerror == 0) {
             return false;
         }
     }

</script>



     <script type="text/javascript">


         $('input[type="file"]').change(function (e) {
             var extension = $(this).val().replace(/^.*\./, '');

             if (extension.toLowerCase() == 'pdf' || extension.toLowerCase() == 'jpeg' || extension.toLowerCase() == 'jpg' || extension.toLowerCase() == 'doc' || extension.toLowerCase() == 'docx' || extension.toLowerCase() == 'xls' || extension.toLowerCase() == 'xlsx') {
                 var size = this.files[0].size / 1048576;
                 if (parseFloat(size) <= 4) {
                 }
                 else {
                     alert('Please check file Size');
                     $(this).val('');
                 }

             }
             else {
                 alert('Please check file extension');
                 $(this).val('');
             }


         })

       

       
  </script>