@model Hindustancopperlimited.Models.tbl_AnnualReports

@{
    ViewBag.Title = "AddAnnualReport";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}

<div class="col-lg-8">
    <div class="well bs-component">
    @using (Html.BeginForm("AddAnnualReport", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
    {

        <fieldset>
        <legend> Add Annual Report <span style="color:Red; font-size:14px; padding-left:35%"> ( * Fields are Mandatory )</span></legend>
                <div class="form-group">
                <label class="col-lg-4 control-label">Headline in English<span style="color:#C00000"> (*)</span></label>
                <div class="col-lg-6">
                 @Html.TextBoxFor(model => model.strHeadline, null, new { @class = "form-control" })<span id="errmsg"></span>
                  </div>
                  </div>

                   <div class="form-group">
                        <label class="col-lg-4 control-label">Headline in Hindi<span style="color:#C00000"> (*)</span></label>
                         
                         
                         <div class="col-lg-6">
                         @Html.TextBoxFor(model => model.strHeadline_hindi, null, new { @class = "form-control" })<span id="errmsg1"></span>
                         
                          </div>
                        </div>     
                
                        <div class="form-group">
                        <label class="col-lg-4 control-label">Attach Report(English)<span style="color:#C00000"> (*)</span></label>
                         
                         
                         <div class="col-lg-6">
                         <input type="file" name="strReportUpload" class="form-control" id="strReportUpload"/><span id="errmsg6">
                         
                          </div>
                        </div>              
                         
                          <div class="form-group">
                        <label class="col-lg-4 control-label">Attach Report(Hindi)<span style="color:#C00000"> (*)</span></label>
                         
                         
                         <div class="col-lg-6">
                         <input type="file" name="strReportUpload_hindi" class="form-control" id="strReportUpload_hindi"/><span id="errmsg2"></span>
                         
                          </div>
                        </div>     

        
  <div class="form-group">
            <div class="col-lg-7 col-lg-offset-5">
                           
            <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
               @Html.ActionLink("Cancel", "ListAnnualReport", null, new { @class = "btn btn-default" })
            </div>
        </div>
      </fieldset>   
    }
               
    </div>
</div>
@if (ViewBag.Message != null)
 {
        <script type="text/javascript">
            window.onload = function () {
                var aa = "@ViewBag.Message";
                alert(aa);
                if (aa == "Your data saved successfully") {
                    window.location.href = '/Admin/ListAnnualReport';
                }
            };


        </script>
    }



    <script>

        $("#strHeadline").on("input", function () {
            LimtCharacters(this, 190, 'errmsg');
        });
        $("#strHeadline_hindi").on("input", function () {
            LimtCharacters(this, 190, 'errmsg1');
        });
        function LimtCharacters(txtMsg, CharLength, errmsg) {
            chars = txtMsg.value.length;
            if (chars > CharLength) {
                txtMsg.value = txtMsg.value.substring(0, CharLength);
                $("#" + errmsg).html("Max Length reached..").show().fadeOut("slow").css("color", "red");
            }
        }


        $("#strHeadline").keyup(function () {
            if (this.value.length == 0) {
                $("#errmsg").html('This field is required').show().css("color", "red");
                return false;

            } else {
                $("#errmsg").html('');

            }
        });

        $("#strHeadline_hindi").keyup(function () {
            if (this.value.length == 0) {
                $("#errmsg1").html('This field is required').show().css("color", "red");
                return false;

            } else {
                $("#errmsg1").html('');

            }
        });

        $("#strReportUpload").change(function () {
            if (this.value.length == 0) {
                $("#errmsg6").html('This field is required').show().css("color", "red");
                return false;

            } else {
                $("#errmsg6").html('');

            }
        });

        $("#strReportUpload_hindi").change(function () {
            if (this.value.length == 0) {
                $("#errmsg2").html('This field is required').show().css("color", "red");
                return false;

            } else {
                $("#errmsg2").html('');

            }
        });

        function error() {
            var noerror = 1;
            var names = $('#strHeadline').val();
            var names1 = $('#strReportUpload').val();
            var names2 = $('#strHeadline_hindi').val();
            var names3 = $('#strReportUpload_hindi').val();

            if (names == "") {
                $("#errmsg").html('This field is required').show().css("color", "red");
                noerror = 0;
            }
            if (names1 == "") {
                $("#errmsg6").html('This field is required').show().css("color", "red");
                noerror = 0;
            }
            if (names2 == "") {
                $("#errmsg1").html('This field is required').show().css("color", "red");
                noerror = 0;
            }
            if (names3 == "") {
                $("#errmsg2").html('This field is required').show().css("color", "red");
                noerror = 0;
            }

            if (noerror == 1) {
                if (confirm("Are you sure ?")) {
                    if ($('#tbl_AnnualReports')[0].checkValidity()) {


                    }

                }
                else {
                    return false;
                }
            }

            if (noerror == 0) {
                return false;
            }

        }


    </script>
