@model Hindustancopperlimited.Models.tbl_employmentnotice

@{
    ViewBag.Title = "Edit Employment Notice";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}

<div class="col-lg-8">
    <div class="well bs-component">
        @using (Html.BeginForm("EmploymentEdit", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
        {

            <fieldset>
                <legend> Edit Employment Notice <span style="color:Red; font-size:14px; padding-left:20%"> ( * Fields are Mandatory )</span></legend>

                <div class="form-group">
                    <label class="col-lg-6 control-label">Unit<span style="color:#C00000"> (*)</span></label>
                    <div class="col-lg-6">
                        @*@Html.DropDownListFor(m => m.Fk_unitid, ViewBag.UnitList as SelectList, "Select", new { @class = "form-control"})*@
                        @Html.DropDownList("Fk_unitid", null, "Select", new { @class = "form-control" })<span id="errmsg">
                            @Html.HiddenFor(m => m.Pk_employmentid)
                            @Html.HiddenFor(m => m.Strupload)
                            @Html.HiddenFor(m => m.StruploadHindi)
                            @Html.HiddenFor(m => m.dtEntryDate)
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-6 control-label">Employment Type<span style="color:#C00000"> (*)</span></label>
                    <div class="col-lg-6">
                        @Html.DropDownList("strEmploymentType", new List<SelectListItem> {
                                                         new SelectListItem {Text="Offline",Value="Offline"},
                                                         new SelectListItem {Text="Online",Value="Online"}
                                                                                  }, "Select", new { @class = "form-control", required = "required" }
                                            )<span id="errmsg100"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-6 control-label">Advisement Number<span style="color:#C00000"> (*)</span></label>
                    <div class="col-lg-6">
                        @Html.TextBoxFor(m => m.Empnoticeno, new { @class = "form-control" })<span id="errmsg3"></span>
                    </div>
                </div>

                @* <div class="form-group">
                        <label class="col-lg-6 control-label">Discipline<span style="color:#C00000"> (*)</span></label>
                        <div class="col-lg-6">
                        @Html.DropDownList("Fk_Disciplineid", null, "Select", new { @class = "form-control" })<span id="errmsg1">
                        </div>
                    </div>*@





                <div class="form-group">
                    <label class="col-lg-6 control-label">Employment Title<span style="color:#C00000"> (*)</span></label>
                    <div class="col-lg-6">
                        @Html.TextBoxFor(m => m.Emptitle, new { @class = "form-control" })<span id="errmsg4"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-6 control-label">Employment Title in Hindi<span style="color:#C00000"> (*)</span></label>
                    <div class="col-lg-6">
                        @Html.TextBoxFor(m => m.EmptitleHindi, new { @class = "form-control" })<span id="errmsg4"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-6 control-label">Employment Details<span style="color:#C00000"> (*)</span></label>
                    <div class="col-lg-6">
                        @Html.TextBoxFor(m => m.Empdetail, new { @class = "form-control" })<span id="errmsg33"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-6 control-label">Employment Details in Hindi<span style="color:#C00000"> (*)</span></label>
                    <div class="col-lg-6">
                        @Html.TextBoxFor(m => m.EmpdetailHindi, new { @class = "form-control" })<span id="errmsg34"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-6 control-label">Upload<span style="color:#C00000"> (*)</span></label>
                    <div class="col-lg-6">

                        <input type="file" name="strFile" class="form-control" id="strFile" /><span id="errmsg6"></span>

                        @if (ViewBag.Strupload != null)
                        {
                            <a href=@ViewBag.Strupload.Replace("~", "../..") target="_blank">View Upload Doc...</a>
                        }

                    </div>

                </div>


                <div class="form-group">
                    <label class="col-lg-6 control-label">Upload in Hindi<span style="color:#C00000"> (*)</span></label>
                    <div class="col-lg-6">

                        <input type="file" name="strFileHindi" class="form-control" id="strFileHindi" /><span id="errmsg35"></span>

                        @if (ViewBag.StruploadHindi != null)
                        {
                            <a href=@ViewBag.StruploadHindi.Replace("~", "../..") target="_blank">View Upload Doc...</a>
                        }

                    </div>

                </div>


                <div class="form-group">
                    <label class="col-lg-6 control-label">Apply Start Date<span style="color:#C00000"> (*)</span></label>
                    <div class="col-lg-6">
                        @Html.TextBoxFor(m => m.dtstartdate, new { @class = "form-control input-append MyDtPick" })<span id="errmsg7">


                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-6 control-label">Apply Closing Date<span style="color:#C00000"> (*)</span></label>
                    <div class="col-lg-6">
                        @Html.TextBoxFor(m => m.dtclosedate, new { @class = "form-control input-append MyDtPick" })<span id="errmsg8">

                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-6 control-label">Notice View Date<span style="color:#C00000"> (*)</span></label>
                    <div class="col-lg-6">
                        @Html.TextBoxFor(m => m.dtviewdate, new { @class = "form-control input-append MyDtPick" })<span id="errmsg9">

                    </div>
                </div>




                <div class="form-group">
                    <label class="col-lg-6 control-label">Notice Expiry Date<span style="color:#C00000"> (*)</span></label>
                    <div class="col-lg-6">
                        @Html.TextBoxFor(m => m.dtexpirydate, new { @class = "form-control input-append MyDtPick" })<span id="errmsg10">

                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-6 control-label">If ITI</label>
                    <div class="col-lg-6">
                        @Html.CheckBoxFor(m => m.ifITI, new { @class = "form-control input-append" })

                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-6 control-label">If Graduate Apprentice</label>
                    <div class="col-lg-6">
                        @Html.CheckBoxFor(m => m.ifGraduateApprentice, new { @class = "form-control input-append" })

                    </div>
                </div>


                <div class="form-group">
                    <div class="col-lg-5 col-lg-offset-7">
                        <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
                        @Html.ActionLink("Cancel", "EmployeeList", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </fieldset>
        }

    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.full.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.css" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
@if (ViewBag.Message != null)
{
    <script type="text/javascript">
            window.onload = function () {
                var aa = "@ViewBag.Message";
                alert(aa);
                if (aa == "Notice updated Successfully.") {
                    window.location.href = '/Admin/EmployeeList';
                }
            };


    </script>
}

<script>

    const aYearFromNow = new Date();
    aYearFromNow.setFullYear(aYearFromNow.getFullYear() + 2);
        $(".MyDtPick").datetimepicker(
            {
                
               // minDate: '1980-01-01',//yesterday is minimum date(for today use 0 or -1970/01/01)
               // maxDate: '2024-01-01',//tomorrow is maximum date calendar
               // mask: false,
                //format: 'd/m/Y H:i:s',
                // format: 'DD/MM/YYYY hh:mm a',
                //formatTime: "h:i a",
                //formatDate: 'DD-MM-YYYY',
                //step: 60,
                //lang: 'in',
               // value: new Date(),
               // startDate: new Date()

                //  showTodayButton: true,

                //  showClose: true,
                //  showClear: true,
                //  toolbarPlacement: 'top',
                //  stepping: 15

                minDate: new Date('1990-01-01'),
                maxDate: aYearFromNow,//tomorrow is maximum date calendar
                mask: false,
                format: 'd/m/Y H:i:s',
                pickDate: true,
                pickSeconds: false,
                pick12HourFormat: false,

                lang: 'in',

                value: new Date(),
                startDate: new Date(),
                showTodayButton: false,

                showClose: true
            });
  

    $("#Empnoticeno").on("input", function () {
        LimtCharacters(this, 195, 'errmsg3');
    });
    $("#Emptitle").on("input", function () {
        LimtCharacters(this, 195, 'errmsg4');
    });
    $("#Empdetail").on("input", function () {
        LimtCharacters(this, 500, 'errmsg5');
    });
    $("#EmptitleHindi").on("input", function () {
        LimtCharacters(this, 195, 'errmsg33');
    });
    $("#EmpdetailHindi").on("input", function () {
        LimtCharacters(this, 500, 'errmsg34');
    });

    function LimtCharacters(txtMsg, CharLength, errmsg) {
        chars = txtMsg.value.length;
        if (chars > CharLength) {
            txtMsg.value = txtMsg.value.substring(0, CharLength);
            $("#" + errmsg).html("Max Length reached..").show().fadeOut("slow").css("color", "red");
        }
    }
    $("#Empnoticeno").keyup(function () {
        if (this.value.length == 0) {
            $("#errmsg3").html('This field is required').show().css("color", "red");
            return false;

        } else {
            $("#errmsg3").html('');

        }
    });

    $("#Emptitle").keyup(function () {
        if (this.value.length == 0) {
            $("#errmsg4").html('This field is required').show().css("color", "red");
            return false;

        } else {
            $("#errmsg4").html('');

        }
    });
    $("#Empdetail").keyup(function () {
        if (this.value.length == 0) {
            $("#errmsg5").html('This field is required').show().css("color", "red");
            return false;

        } else {
            $("#errmsg5").html('');

        }
    });

    $("#EmptitleHindi").keyup(function () {
        if (this.value.length == 0) {
            $("#errmsg33").html('This field is required').show().css("color", "red");
            return false;

        } else {
            $("#errmsg33").html('');

        }
    });
    $("#EmpdetailHindi").keyup(function () {
        if (this.value.length == 0) {
            $("#errmsg34").html('This field is required').show().css("color", "red");
            return false;

        } else {
            $("#errmsg34").html('');

        }
    });


    $("#Fk_unitid").change(function () {
        if (this.value.length == 0) {
            $("#errmsg").html('This field is required').show().css("color", "red");
            return false;

        } else {
            $("#errmsg").html('');

        }
    });

    $("#strEmploymentType").change(function () {
        if (this.value.length == 0) {
            $("#errmsg100").html('This field is required').show().css("color", "red");
            return false;

        } else {
            $("#errmsg100").html('');

        }
    });


    $("#strFile").change(function () {
        if (this.value == 0) {
            $("#errmsg6").html('This field is required').show().css("color", "red");
            return false;

        } else {
            $("#errmsg6").html('');

        }
    });

    $("#strFileHindi").change(function () {
        if (this.value == 0) {
            $("#errmsg35").html('This field is required').show().css("color", "red");
            return false;

        } else {
            $("#errmsg35").html('');

        }
    });


    function error() {
        var noerror = 1;
        var names = $('#Empnoticeno').val();
        var names1 = $('#Emptitle').val();
        var names2 = $('#Empdetail').val();

        var titleHindi = $('#EmptitleHindi').val();
        var detailsHindi = $('#EmpdetailHindi').val();

        if (names == "") {
            $("#errmsg3").html('This field is required').show().css("color", "red");
            noerror = 0;
        }
        if (names1 == "") {
            $("#errmsg4").html('This field is required').show().css("color", "red");
            noerror = 0;
        }
        if (names2 == "") {
            $("#errmsg5").html('This field is required').show().css("color", "red");
            noerror = 0;
        }

        if (titleHindi == "") {
            $("#errmsg33").html('This field is required').show().css("color", "red");
            noerror = 0;
        }
        if (detailsHindi == "") {
            $("#errmsg34").html('This field is required').show().css("color", "red");
            noerror = 0;
        }


        if ($("#strEmploymentType").val() == "") {
            $("#errmsg100").html('This field is required').show().css("color", "red");
            noerror = 0;
        }

        if ($("#Fk_unitid").val() == "") {
            $("#errmsg").html('This field is required').show().css("color", "red");
            noerror = 0;
        }

        if ($("#dtstartdate").val() == "") {
            $("#errmsg7").html('This field is required').show().css("color", "red");
            noerror = 0;
        }
        if ($("#dtclosedate").val() == "") {
            $("#errmsg8").html('This field is required').show().css("color", "red");
            noerror = 0;
        }
        if ($("#dtviewdate").val() == "") {
            $("#errmsg9").html('This field is required').show().css("color", "red");
            noerror = 0;
        }
        if ($("#dtexpirydate").val() == "") {
            $("#errmsg10").html('This field is required').show().css("color", "red");
            noerror = 0;
        }
        if (noerror == 1) {
            if (confirm("Are you sure ?")) {
                if ($('#tbl_employmentnotice')[0].checkValidity()) {


                }

            }
            else {
                return false;
            }
        }

        if (noerror == 0) {
            return false;
        }
    }

</script>
