@model Hindustancopperlimited.Models.tbl_mstAddendum
@{
    ViewBag.Title = "Add Addendum";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}



<div class="col-lg-8">
    <div class="well bs-component">
    @using (Html.BeginForm("AddAddendum", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
    {
      @Html.ActionLink("Addendum List", "AddendumList", null, new { @class = "btn btn-primary" })<br /><br />
        <fieldset>
        <legend> Add Addendum</legend>

        <div class="form-group">
            <label class="col-lg-4 control-label">Enq. No.<span style="color:#C00000"> (*)</span></label>
            <div class="col-lg-8">
          @*  @Html.DropDownList("EnqNo", null, "Select", new { @class = "form-control input-append form_datetime", required = "required" })*@
            @*shoumya*@
            @Html.DropDownList("EnqNo", ViewData["EnqNolist"] as SelectList, "Select", new { @class = "form-control", required = "required" })
            
            </div>
        </div>   
        
        <div class="form-group">
            <label class="col-lg-4 control-label">Enquiry Title </label>
            <div class="col-lg-8">
            @Html.Label("Enquiry Title", null, new { @class = "form-control", id = "EnqTitle" })
            </div>
        </div>  
        
         <div class="form-group">
            <label class="col-lg-4 control-label">Enq. Closing Date & Time </label>
            <div class="col-lg-8">
            @Html.Label("Enq. Closing Date & Time", null, new { @class = "form-control", id = "EnqClosing" })
            </div>
        </div> 

        <div class="form-group">
            <label class="col-lg-4 control-label">Extended Date<span style="color:#C00000"> (*)</span></label>
            <div class="col-lg-8">
            @Html.TextBox("dtExtendedDate", null, new { @class = "form-control input-append form_datetime", required = "required" })
            
            </div>
        </div>

        <div class="form-group">
            <label class="col-lg-4 control-label">Cost of Tender Document </label>
            <div class="col-lg-8">
            @Html.Label("Cost of Tender Document", null, new { @class = "form-control", id = "EnqCost" })
            </div>
        </div>      

        <div class="form-group">
            <label class="col-lg-4 control-label">Earnest Money Deposit </label>
            <div class="col-lg-8">
            @Html.Label("Earnest Money Deposit", null, new { @class = "form-control", id = "EnqEarnest" })
            </div>
        </div>      

        <div class="form-group">
            <label class="col-lg-4 control-label">Document (In English) <span style="color:#C00000"> (*)</span></label>
            <div class="col-lg-8">
            <input type="file" name="strFile" class="form-control" required /> 
             <input type="hidden" id="hidText" name="hidText" />
            </div>

        </div>
         
              
              
                <div class="form-group">
            <label class="col-lg-4 control-label">Document (In Hindi-UNICODE)<span style="color:#C00000"> (*)</span></label>
            <div class="col-lg-8">
            <input type="file" name="strFileNameHindi" class="form-control" required /> 
             <input type="hidden" id="hidHindiText" name="hidHindiText" />
            </div>

        </div>
                    

                        
        <div class="form-group">
            <div class="col-lg-8 col-lg-offset-4">
                           
            <button type="submit" class="btn btn-primary">Submit</button>
                 @Html.ActionLink("Cancel", "AddendumList", null, new { @class = "btn btn-default" })
            </div>
        </div>
        </fieldset>
    }
                
    </div>
</div>
 @if (ViewBag.Message != null)
 {
        <script type="text/javascript">
            window.onload = function () {
                alert("@ViewBag.Message");
                window.location.href = '/Admin/AddendumList';

            };


        </script>
    }


     <script>
         $(document).ready(function () {
             $("#EnqNo").chosen({ allow_single_deselect: true });
         });

         $('input[type="file"]').change(function (e) {
             var extension = $(this).val().replace(/^.*\./, '');

             if (extension.toLowerCase() == 'pdf' || extension.toLowerCase() == 'jpeg' || extension.toLowerCase() == 'doc' || extension.toLowerCase() == 'docx' || extension.toLowerCase() == 'xls' || extension.toLowerCase() == 'xlsx') {
                 var size = this.files[0].size / 1048576;
                 if (parseFloat(size) <= 4) {
                 }
                 else {
                     alert('Please check file Size');
                     $(this).val('');
                 }

             }
             else {
                 alert('Please check file extension');
                 $(this).val('');
             }


         })

         $("#EnqNo").change(function () {

             var tenderId = $("#EnqNo").val();
             if (tenderId == "") {
                 $("#EnqClosing").html('');
                 $("#EnqTitle").html('');
                 $("#EnqCost").html('');
                 $("#EnqEarnest").html('');
             }
             else {
                 $.ajax({
                     type: 'POST',
                     dataType: 'json',
                     url: '/Admin/EnquiryDate',
                     data: { 'tenderId': tenderId },
                     success: function (result) {

                         if (result.enqDate != "") {
                             $("#EnqClosing").html(result.enqClosingValue);
                             $("#EnqTitle").html(result.enqTitleValue);
                             $("#EnqCost").html(result.enqCostValue);
                             $("#EnqEarnest").html(result.enqEarnestValue);
                         }
                     },
                     error: function () {

                         alert('Error');
                     }

                 });
             }
         });

        
   

         $(function () {
             $("form").submit(function () {
                 var selTypeText = $("#EnqNo option:selected").text();
                 $("#hidText").val(selTypeText);
             });
         });
         
  </script>
  <script>
  if($('#form_datetime').valid()){
       $('#form_datetime').removeClass('invalid').addClass('success');   
    }
 });
  </script>