    </script>
    <script type="text/javascript">

        $("#btnSubmit").click(function () {

            var tblsampleTable = document.getElementById("CandidateDataviewsampleTable");
            var TableData = [];
            var m = $("#CandidateDataviewsampleTable > tbody > tr").length
            for (j = 1; j <= m; j++) {

                var PId = tblsampleTable.rows[j].cells[0].innerHTML;

                if ($("#chkAppeared_" + PId).prop("checked") == true) {

                    TableData.push({
                        Pk_int_CandidateRegistrationID: PId

                    });
                }

            }
            var _data = JSON.stringify({
                candidtelist: {
                    List: TableData
                }

            });

            $.ajax({

                url: '/Admin/Insertcandidate',
                contentType: "application/json",
                dataType: "json",
                type: "POST",
                data: _data,
                success: function (response) {

                    if (response != null && response != undefined) {
                        window.location.href = '/Admin/ListCandidate';
                    } else {
                        window.location.href = '/Admin/ListCandidate';
                    }
                },
                error: function (jqxhr, settings, thrownError) {

                    console.log(jqxhr.status + '\n' + thrownError);
                }
            });
        });


        $("#Fk_Decipline").change(function () {

            var dicpline = $("#Fk_Decipline").val();

            if (dicpline == "") {
                alert("Please select discipline");

            }
            else {


                $.ajax({
                    type: 'POST',
                    dataType: 'json',
                    url: '/RecruitmentCareer/Postbydiscipline',
                    data: { 'fk_dicipline': dicpline },

                    success: function (result) {

                        $('#Fk_Post').empty();

                        if (result.PostMaster.length > 0) {
                            $('#Fk_Post').append($('<option/>').attr('value', "0").text("--- Select ---"));
                            $.each(result.PostMaster, function (result) {
                                $('#Fk_Post').append($('<option/>').attr('value', this.Postname).text(this.Postname));
                            });

                        }
                    },
                    error: function () {

                        alert('Error');
                    }

                });
            }
        });
        var table = $('#sampleTable_').DataTable({
            bDestroy: true
        });
        var len = $('#sampleTable_ thead tr th').length;
        function FilterCandidates() {
            var o = {};
            o.fk_advertisementid = $('#fk_advertisementid').val();
            o.fk_diciplineid = $('#Fk_Decipline').val();
            o.Fk_Post = $('#Fk_Post').val();
            o.strStatus = $('#strStatus').val();
            o.ApplicantNo = $.trim($('#ApplicantNo').val());
            o.strPWD = $.trim($('#strPWD').val());
            o.strInternalCandidate = $.trim($('#strInternalCandidate').val());
            table.destroy();
            var header = '';
            for (var i = 1; i < len; i++) {
                header += '<td style="display:none;"></td>';
            }
            var ele = $('#sampleTable_').find('tbody').empty().append('<td colspan="' + len + '">loading...wait</td>' + header);
            $.ajax({
                type: 'POST',
                dataType: 'json',
                url: '/Admin/FilterCandidates',
                data: JSON.stringify({ o: o }),
                contentType: 'application/json;charset=utf-8;',
                success: function (result) {
                    ele.empty();
                    $.each(result, function (i, v) {
                        v.strInternalCandidate = v.strInternalCandidate == null ? '' : v.strInternalCandidate;
                        v.strPayUMoneyId = v.strPayUMoneyId == null ? '' : v.strPayUMoneyId;
                        v.strFinalSubmit = v.strFinalSubmit == null ? '' : v.strFinalSubmit;
                        v.strStatus = v.strStatus == null ? '' : v.strStatus;
                        var jj = '<tr>';
                        jj += ' <td>' + v.strApplicationNo + '</td>';
                        jj += ' <td> ' + v.Postname + '</td>';
                        jj += ' <td> ' + v.strApplicantName + '</td>';
                        jj += ' <td>' + v.strEmail + '</td>';
                        jj += ' <td>' + v.strCategory + '</td>';
                        jj += ' <td>' + v.strPWD + '</td>';
                        jj += ' <td>' + v.strInternalCandidate + '</td>';
                        jj += ' <td>' + v.strFinalSubmit + '</td>';
                        jj += ' <td>' + v.strStatus + '</td>';
                        jj += ' <td>' + v.strPayUMoneyId + '</td>';
                        jj += '</tr>';
                        ele.append(jj);
                    });
                    if (result.length == 0) {
                        ele.empty().append('<tr><td colspan="6">No data found!</td>' + header + '</tr>');
                    }
                    table = $('#sampleTable_').DataTable({
                        bDestroy: true,
                          paging: false
                    });
                }
            });
            return false;
        }
        $('#fk_advertisementid').on('change', function () {
            FilterCandidates();
        });
        $('#search').on('click', function () {
            FilterCandidates();
        });

</script>

