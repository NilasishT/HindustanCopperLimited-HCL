                                                    </th>*@

                                                @* <th>
                                                      Nationality
                                                    </th>*@
                                                @* <th>
                                                      Category
                                                    </th>*@
                                                <th>
                                                    Email
                                                </th>
                                                @*<th>
                                                       Print
                                                    </th>*@

                                                <th>
                                                    Category
                                                </th>

                                                <th>
                                                    PWD
                                                </th>

                                                <th>
                                                    Internal
                                                </th>

                                                <th>
                                                    Final Submit
                                                </th>

                                                <th>
                                                    Payment Status
                                                </th>

                                                <th>
                                                    PayUId
                                                </th>
                                                @*<th>
                                                    PassingYear 
                                                    </th>*@
                                                @*<th>
                                                    RegistrationNo 
                                                    </th>*@
                                                <th>
                                                 Gate Marks 
                                                    </th>
                                                <th>
                                                    AcknowledgementNo
                                                </th>

                                            </tr>
                                        </thead>
                                        <tbody id="tbody">

                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>
                                                        @Html.ActionLink("Download", "PrintApplication", new { CandidateId = @item.fk_CandidateId, id = @item.fk_advertisementid }, new { target = "_blank" })

                                                    </td>
                                                    <td>
                                                        @item.Postname
                                                    </td>
                                                    <td>
                                                        @item.strApplicantName
                                                    </td>

                                                    <td>
                                                        @item.strEmail
                                                    </td>

                                                    <td>
                                                        @item.strCategory
                                                    </td>

                                                    <td>
                                                        @item.strPWD
                                                    </td>

                                                    <td>
                                                        @item.strInternalCandidate
                                                    </td>

                                                    <td>
