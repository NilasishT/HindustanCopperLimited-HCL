@model Hindustancopperlimited.Models.tbl_VendorBlackListed
@{
    ViewBag.Title = "Vendor Black Listed";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}
<div class="col-lg-8">
    <div class="well bs-component">
        @using (Html.BeginForm("VendorBlackListed", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            <fieldset>
                <legend>Vendor Black Listed</legend>
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="well bs-component">
                                        <div class="form-horizontal">
                                            <fieldset>
                                                <label>
                                                    From Date<span style="color: Red"> (*)</span></label>
                                                <div class="form-group">
                                                    <div class="col-lg-10">
                                                        @Html.TextBoxFor(model => model.dtFromDate, null, new { @class = "date form-control", required = "required" })<span id="errmsg"></span>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="well bs-component">
                                        <div class="form-horizontal">
                                            <fieldset>
                                                <label>
                                                    To Date<span style="color: Red"> (*)</span></label>
                                                <div class="form-group">
                                                    <div class="col-lg-10">
                                                        @Html.TextBoxFor(model => model.dtToDate, null, new { @class = "date form-control", required = "required" })<span id="errmsg1"></span>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="well bs-component">
                                        <div class="form-horizontal">
                                            <fieldset>
                                                <label>
                                                    Vendor Code<span style="color: Red"> (*)</span></label>
                                                <div class="form-group">
                                                    <div class="col-lg-10">
                                                        @Html.DropDownList("strVendorCode", null, "Select", new { @class = "form-control", required = "required" })<span id="errmsg2"></span>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="well bs-component">
                                        <div class="form-horizontal">
                                            <fieldset>
                                                <label>
                                                    Remarks<span style="color: Red"> (*)</span></label>
                                                <div class="form-group">
                                                    <div class="col-lg-10">
                                                          @Html.TextAreaFor(model => model.strRemarks, new { @class = "form-control", required = "required" })<span id="errmsg3"></span>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-lg-10 col-lg-offset-4">
                        <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
                        @Html.ActionLink("Cancel", "VendorBlackListedList", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </fieldset>


        }
    </div>
</div>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.Message");
            window.location.href = '/Admin/VendorBlackListedList';
            
        };


    </script>
}

<script src=" @Url.Content("~/Content/js/AdminVendorBlackListed.js")"></script>

