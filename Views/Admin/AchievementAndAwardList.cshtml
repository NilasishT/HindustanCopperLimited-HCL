@model IEnumerable<Hindustancopperlimited.Models.tbl_mst_AchievementAndAward>

@{
    ViewBag.Title = "Achievements And Awards List";
    Layout = "~/Views/Shared/Dashboard.cshtml";    
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{
    
    @Html.ActionLink("Add Achievement And Award", "AddAchievementAndAward", null, new { @class = "btn btn-primary" })
    <br />
    <br />
    
    
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered" >
                  <thead>
                    <tr>
                    <th>Edit</th>
                    <th>Delete</th>
                   <th>Subject in english</th>
                    <th>Subject in Hindi</th>
              
                   <th>Achievement / Award Date</th>
                   <th>Document</th>
                    </tr>
                  </thead>
                 <tbody>
                 
            @foreach (var item in Model)
            {
                    <tr>
                    <td>@Html.ActionLink("Edit", "EditAchievementAndAward", new { id = item.Pk_intAwardID })</td>                    
                     <td>@Html.ActionLink("Delete", "AchievementAndAwardDelete", "Admin", new { id = item.Pk_intAwardID }, new { id = item.Pk_intAwardID, onclick = "return confirm('Are you sure to delete?')" })</td>
                     <td> @item.strSubjectdfsEnglish</td>
                      <td> @item.strSubjectdfsHindi</td>
                     
                      <td> @item.dtAwardDate.Value.ToString("dd-MMM-yyyy")</td>
                      <td><a href=@item.strAwardFile.Replace("~", "../..") target="_blank">Download</a></td>
                       
                         
                     
                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
  