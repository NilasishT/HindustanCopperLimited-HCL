@{
    ViewBag.Title = "Add Unit";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}


  
  
                <div class="col-lg-6">
                  <div class="well bs-component">
                   @using (Html.BeginForm("UnitCreate", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", id = "VendorRegistration" }))
{
                      <fieldset>
                        <legend>Unit<span style="color:Red; font-size:14px; padding-left:40%"> ( * Fields are Mandatory )</span></legend>
                        <div class="form-group">
                          <label for="inputEmail" class="col-lg-4 control-label">Unit Name<span style="color:#C00000"> (*)</span></label>
                          <div class="col-lg-8">
                            <input id="strUnitName" type="text" placeholder="Unit Name" name="strUnitName" class="form-control" required><span id="errmsg"></span>
                            
                          </div>
                        </div>

                        <div class="form-group">
                          <label for="inputEmail" class="col-lg-4 control-label">Unit Code<span style="color:#C00000"> (*)</span></label>
                          <div class="col-lg-8">
                            <input id="strUnitCode" type="text" placeholder="Unit Code" name="strUnitCode" class="form-control" required ><span id="errmsg1"></span>
                            
                          </div>
                        </div>
                        
                        
                        <div class="form-group">
                          <label for="textArea" class="col-lg-4 control-label">Unit Address<span style="color:#C00000"> (*)</span></label>
                          <div class="col-lg-8">
                            <textarea id="strUnitAddress" rows="3" placeholder="Unit Address" class="form-control" name="strUnitAddress" required ></textarea><span class="help-block" id="errmsg2">A longer block of help text that breaks onto a new line and may extend beyond one line.</span>
                          </div>
                        </div>

                        <div class="form-group">
                          <label for="textArea" class="col-lg-4 control-label">Unit Contact Info<span style="color:#C00000"> (*)</span></label>
                          <div class="col-lg-8">
                            <textarea id="strContactInfo" rows="3" placeholder="Unit Contact Info" class="form-control" name="strContactInfo" required></textarea><span class="help-block" id="errmsg3" >A longer block of help text that breaks onto a new line and may extend beyond one line.</span>
                          </div>
                        </div>
                       
                        
                        <div class="form-group">
                          <div class="col-lg-8 col-lg-offset-4">
                           
                            <button type="submit" class="btn btn-primary"  onclick="return error()">Submit</button>
                             @Html.ActionLink("Cancel", "UnitList", null, new { @class = "btn btn-default" })
                          </div>
                        </div>
                      </fieldset>
                       }
                  </div>
                </div>

                
 @* Shoumya            *@
   @if (ViewBag.Message != null)
 {
        <script type="text/javascript">
            window.onload = function () {
                alert("@ViewBag.Message");
                window.location.href = '/Admin/UnitList';

            };
        </script>
    } 



   <script src=" @Url.Content("~/Content/js/ValidationAdminUnitCreate.js")"></script>
 
