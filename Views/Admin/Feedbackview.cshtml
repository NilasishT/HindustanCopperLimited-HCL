@model Hindustancopperlimited.Models.tbl_feedback

@{
    ViewBag.Title = "Feedback List";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}



            
<div class="col-lg-8">
    <div class="well bs-component">
    @using (Html.BeginForm("Feedback", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
    {

        <fieldset>
        <legend>Feedback View </legend>
                <div class="form-group">
                <label class="col-lg-4 control-label">Title</label>
                <div class="col-lg-2">
                  @Html.DropDownList("Fk_titleid", null, "Select", new { @class = "form-control" ,disabled = "disabled", aria_label = "Title" })
                  </div>
                  </div>
                
                        <div class="form-group">
                        <label class="col-lg-4 control-label">First Name</label>
                         
                         
                         <div class="col-lg-6" style="padding-top:1.5%">
                         @Html.DisplayFor(model => model.strf_name, null, new { @class = "form-control" })
                          </div>
                        </div>
                         
                        
                
                
                 
                  <div class="form-group">
                  <label class="col-lg-4 control-label">Middle Name</label>
                   <div class="col-lg-6" style="padding-top:1.5%"> 
                            @Html.DisplayFor(model => model.strm_name, null, new { @class = "form-control" })
                          </div>
                        </div>
                         
                          
                           

              <div class="form-group">
              <label class="col-lg-4 control-label">Last Name</label>
               <div class="col-lg-6" style="padding-top:1.5%">           
                        @* @Html.DropDownList("Fk_intGrade", null, "Select", new { @class = "form-control" })<span id="errmsg6"></span> *@
                           @Html.DisplayFor(model => model.strl_name, null, new { @class = "form-control" })    
                          </div>
                        </div>
                        


                 <div class="form-group">
              <label class="col-lg-4 control-label">Email</label>
                 <div class="col-lg-6" style="padding-top:1.5%">           
                          @Html.DisplayFor(model => model.str_email, new { @class = "form-control" })
                           </div>
                        </div>
                        


                <div class="form-group">
              <label class="col-lg-4 control-label">Telephone No</label>
                <div class="col-lg-6" style="padding-top:1.5%">           
                @Html.DisplayFor(model => model.str_ph, new { @class = "form-control" })
                        </div>
                      </div>
                        

                         

                  <div class="form-group">
              <label class="col-lg-4 control-label">Pin Code</label>
                         
                         
                         
                          <div class="col-lg-6" style="padding-top:1.5%">
                           
                             @Html.DisplayFor(model => model.str_zipcode, new { @class = "form-control" })
                         </div>
                        </div>
                       <div class="form-group">
                <label class="col-lg-4 control-label">Address</label>
                <div class="col-lg-6" style="padding-top:1.5%">
                 @Html.DisplayFor(model => model.str_address, new { @class = "form-control", required = "required" })
                  </div>
                  </div>
                     <div class="form-group">
              <label class="col-lg-4 control-label">City</label>
               <div class="col-lg-6" style="padding-top:1.5%">
                 @Html.DisplayFor(model => model.str_city, new { @class = "form-control" })
                         </div>
                        </div>  

                   <div class="form-group">
              <label class="col-lg-4 control-label">State</label>
               <div class="col-lg-6" style="padding-top:1.5%">          
                  @Html.DisplayFor(model => model.str_state, new { @class = "form-control" }) 
                        </div>
                        </div>
                        
                 <div class="form-group">
                <label class="col-lg-4 control-label">Country</label>
                <div class="col-lg-6" style="padding-top:1.5%">             
                           
                             @Html.DisplayFor(model => model.str_country, null, new { @class = "form-control" })
                                                                      
                         </div>
                        </div>
                       
                         

                 <div class="form-group">
                <label class="col-lg-4 control-label">Your Comments</label>
                         
                          <div class="col-lg-6" style="padding-top:1.5%">
                           
                             @Html.DisplayFor(model => model.str_comment, new { @class = "form-control" })
                                                                      
                         </div>
                        </div>
                <div class="form-group">
                <label class="col-lg-4 control-label">Contact person in HCL</label>
                <div class="col-lg-6" style="padding-top:1.5%">             
                           
                             @Html.DisplayFor(model => model.str_cntactp, null, new { @class = "form-control" })
                                                                      
                         </div>
                        </div>
  <div class="form-group">
            <div class="col-lg-7 col-lg-offset-5">
                           
            @*<button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>*@
               @Html.ActionLink("Back", "FeedbackList", null, new { @class = "btn btn-default" })
            </div>
        </div>
      </fieldset>   
    }
               
    </div>
</div>

 