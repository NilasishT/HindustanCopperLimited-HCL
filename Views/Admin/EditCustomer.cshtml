@model Hindustancopperlimited.Models.SpotbookingRegistrationdetails
@{
    ViewBag.Title = "Organizational Details";
    Layout = "~/Views/Shared/Dashboard.cshtml"; 
}
@using (Html.BeginForm("EditCustomer", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
   

@*<div class="row" style="z-index:1; position:relative">*@
    <div class="col-md-12" style="text-align: right">
        <span style="color: Red; font-size: 14px; padding-left: 65%">(*) Fields are Mandatory
        </span>
    </div>
    <div class="col-lg-12">
        @* <div class="card">*@ @*<div class="row">*@
        <div class="col-lg-6">
            <div class="well bs-component" >
                <div class="form-horizontal">
                    <fieldset>
                        <label class="col-lg-5 control-label">
                            Name of Firm/Company<span style="color: Red"> (*)</span></label>
                        <div class="form-group">
                            <div class="col-lg-6">
                        @Html.TextBoxFor(model => model.str_namefirm, null, new { @class = "form-control", @readonly = "readonly" })
                    </fieldset>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label class="col-lg-4 control-label">Region<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-6">
                          
                           @* @Html.TextBoxFor(model => model.fk_region, null, new { @class = "form-control" })*@
                           @* @Html.DropDownList("fk_region", null, "Select", new { @class = "form-control" })*@
                            @Html.TextBoxFor(model => model.fk_region, null, new { @class = "form-control", @readonly = "readonly" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
        <div class="col-lg-12">
            <div class="well bs-component" style="text-align: center; padding: 4px; color: #6f3706;
                margin: 8px; border: solid 1px #6f3706">
                <div class="form-horizontal">
                    <fieldset>
                        <label style="font-size: medium">
                            <b>Contact Person Details</b></label>
                    </fieldset>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="well bs-component">
                <div class="form-horizontal" style="border-right: 1px solid #6f3706">
                    <fieldset>
                        <label class="col-lg-4 control-label">
                            First Name<span style="color: Red"> (*)</span></label>
                        <div class="form-group">
                            <div class="col-lg-6">
                                @* <input id="txtFax1" type="text" name="strFax1" placeholder="Enter Fax Number" class="form-control">*@
                                @Html.TextBoxFor(model => model.str_fname, null, new { @class = "form-control", @readonly = "readonly" })
                                @Html.HiddenFor(model => model.Pk_Registrationid)
                                @Html.HiddenFor(model => model.str_code)
                                @Html.HiddenFor(model => model.dt_entrydate)
                                @Html.HiddenFor(model => model.Isactive)
                                @Html.HiddenFor(model => model.str_pw)
                            </div>
                        </div>
                        <label class="col-lg-4 control-label">
                            Middle Name</label>
                        <div class="form-group">
                            <div class="col-lg-6">
                                @Html.TextBoxFor(model => model.str_mname, null, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                        <label class="col-lg-4 control-label">
                            Last Name</label>
                        <div class="form-group">
                            <div class="col-lg-6">
                                @Html.TextBoxFor(model => model.str_lname, null, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                        <label class="col-lg-4 control-label">
                            Email ID<span style="color: Red"> (*)</span></label>
                        <div class="form-group">
                            <div class="col-lg-6">
                                @Html.TextBoxFor(model => model.str_email, null, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            @* <div class="well bs-component" style="border-right:1px solid #999">*@
            <div class="form-horizontal">
                <fieldset>
                    <label class="col-lg-4 control-label">
                        Phone No.(With STD Code)</label>
                    <div class="form-group">
                        <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.str_phno, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <label class="col-lg-4 control-label">
                        Office Landline (With STD Code) <span style="color: Red">(*)</span></label>
                    <div class="form-group">
                        <div class="col-lg-6" style="padding-top: 1%">
                            @Html.TextBoxFor(model => model.str_officeno, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <label class="col-lg-4 control-label">
                        Mobile No.</label>
                    <div class="form-group">
                        <div class="col-lg-6">
                            @* <input id="txtPhone1" type="text" name="strPhone1" placeholder="Enter Phone Number" class="form-control" required>*@
                            @Html.TextBoxFor(model => model.str_mobile, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <label class="col-lg-4 control-label">
                        Fax No.</label>
                    <div class="form-group">
                        <div class="col-lg-6">
                            @* <input id="txtPhone1" type="text" name="strPhone1" placeholder="Enter Phone Number" class="form-control" required>*@
                            @Html.TextBoxFor(model => model.str_fax, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <div class="col-lg-12">
            <div class="well bs-component" style="text-align: center; padding: 4px; color: #6f3706;
                margin: 8px; border: solid 1px #6f3706">
                <div class="form-horizontal">
                    <fieldset>
                        <label style="font-size: medium">
                            <b>Address Details</b>
                        </label>
                    </fieldset>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="well bs-component">
                <div class="form-horizontal" style="border-right: 1px solid #6f3706">
                    <!--<form class="form-horizontal" method="post">-->
                    <fieldset>
                        <label class="col-lg-4 control-label">
                            Address<span style="color: Red"> (*)</span></label>
                        <div class="form-group">
                            <div class="col-lg-6">
                                @* <input id="txtPhone1" type="text" name="strPhone1" placeholder="Enter Phone Number" class="form-control" required>*@
                                @Html.TextAreaFor(model => model.str_address, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                        <label class="col-lg-4 control-label">
                            City<span style="color: Red"> (*)</span></label>
                        <div class="form-group">
                            <div class="col-lg-6">
                                @* <input id="txtFax1" type="text" name="strFax1" placeholder="Enter Fax Number" class="form-control">*@
                                @Html.TextBoxFor(model => model.str_city, null, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                        <label class="col-lg-4 control-label">
                            District<span style="color: Red"> (*)</span></label>
                        <div class="form-group">
                            <div class="col-lg-6">
                                @Html.TextBoxFor(model => model.str_district, null, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                        <label class="col-lg-4 control-label">
                            Pin<span style="color: Red"> (*)</span></label>
                        <div class="form-group">
                            <div class="col-lg-6">
                                @* <input id="txtFax1" type="text" name="strFax1" placeholder="Enter Fax Number" class="form-control">*@
                                @Html.TextBoxFor(model => model.str_pin, null, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                    </fieldset>
                    <!-- </form>-->
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            @* <div class="well bs-component" style="border-right:1px solid #999">*@
            <div class="form-horizontal">
                <fieldset>
                    <label class="col-lg-4 control-label">
                        State<span style="color: Red"> (*)</span></label>
                    <div class="form-group">
                        <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.str_state, null, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <label class="col-lg-4 control-label">
                        Country<span style="color: Red"> (*)</span></label>
                    <div class="form-group">
                        <div class="col-lg-6">
                            @* <input id="txtFax1" type="text" name="strFax1" placeholder="Enter Fax Number" class="form-control">*@
                            @Html.TextBoxFor(model => model.str_country, null, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <label class="col-lg-4 control-label">
                        PAN No.</label>
                    <div class="form-group">
                        <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.str_panno, null, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <label class="col-lg-4 control-label">
                        GST No.<span style="color: Red"> (*)</span></label>
                    <div class="form-group">
                        <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.str_gstno, null, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        
       @* <div class="col-lg-12" style="border-top: 1px solid #6f3706">
            <div>
                &nbsp</div>
            <div class="col-lg-4">
                &nbsp</div>
            <form>
            <fieldset id="str_CustomerStatus">
                <input type="radio" value="Approved" name="str_CustomerStatus">
                Approved &nbsp &nbsp &nbsp &nbsp &nbsp &nbsp
                <input type="radio" value="Rejected" name="str_CustomerStatus">
                Rejected &nbsp &nbsp &nbsp &nbsp &nbsp &nbsp
                <input type="radio" value="Pending" name="str_CustomerStatus">
                Pending
            </fieldset>
            </form>
            <div class="col-lg-4">
                &nbsp</div>
        </div>*@


        <div class="col-md-12">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="well bs-component" style="text-align: center">
                            <div class="form-horizontal">
                                <fieldset>
                                <div class="form-group">
                                  <div class="col-lg-12" style="padding-top:5px">
                                    @Html.RadioButtonFor(m => m.str_CustomerStatus, "Approved")<span>Approved</span>
                                    &nbsp;&nbsp;&nbsp;&nbsp;
                                    @Html.RadioButtonFor(m => m.str_CustomerStatus, "Rejected")<span>Rejected</span>
                                    &nbsp;&nbsp;&nbsp;&nbsp;
                                    @Html.RadioButtonFor(m => m.str_CustomerStatus, "Pending")<span>Pending</span>
                            </fieldset>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <div>
            <label class="col-lg-4 control-label">
                Remarks<span style="color: Red"> (*)</span></label>
            <div class="form-group">
                <div class="col-lg-4">
                    @*@Html.TextAreaFor(model => model.str_Remarks, null, new { @class = "form-control" })*@
                    @Html.TextAreaFor(model => model.str_Remarks, new { @class = "form-control", required = "required" })
                </div>
            </div>
        </div>
        <div class="col-lg-12" style="padding-top: 20px">
            <div class="form-group">
                <div class="col-lg-10 col-lg-offset-5">
                @if (Session["UserType"].ToString() != "Region" && Session["Designation"].ToString() != "CCO")
                {
               
                    <button type="submit" class="btn btn-primary" onclick="return error()">
                        Submit</button>
                }
                    @Html.ActionLink("Cancel", "ListCustomer", "Admin", null, new { @class = "btn btn-default" })
                </div>
            </div>
        </div>
    </div>

   
}
@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        window.onload = function () {
            var aa = "@ViewBag.Message";
            alert(aa);
            if (aa == "Data updated Successfully.") {
                window.location.href = '/Admin/ListCustomer';

            }
        };
    </script>
}
<script src="@Url.Content("~/Content/js/SpotbookingRegistrationdetails Validation.js")"></script>
