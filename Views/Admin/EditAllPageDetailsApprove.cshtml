@model Hindustancopperlimited.Models.tbl_mstPageDetail_Approve
@{
    ViewBag.Title = "Edit Page Details";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}
<div class="col-lg-12">
    <div class="well bs-component">
        <fieldset>
            @using (Html.BeginForm("EditAllPageDetailsApprove", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
            {
  
    
                @Html.AntiForgeryToken()
                <legend><b>Edit  Page  Details </b><span style="color: Red; font-size: 14px; padding-left: 40%">( * ) Fields are Mandatory</span></legend>
                    
                
                
                  <div class="form-group">
                          <label for="textArea" class="col-lg-3 control-label">Page Title <span style="color:#C00000"> (*)</span></label>
                          <div class="col-lg-6">                           
                                @Html.TextBoxFor(model => model.strPageTitle, null, new { @class = "form-control",@required="required" })
                          </div>
                        </div>
                
	
              <div class="form-group">
                    <label class="col-lg-3 control-label">
                        Page Details
                    </label>
                    <div class="col-lg-9">
                        <div>@Html.TextArea("strPageDetails", new { @class = "editor2", @id = "editor2" })</div>
                             @Html.HiddenFor(model => model.Pk_intAllStaticPageID)         
                        @Html.HiddenFor(model => model.dtEntryDate)         
                        @Html.HiddenFor(model => model.IsActive)     
                    </div>
                </div>
                
                
                      <div class="form-group">
                          <label for="textArea" class="col-lg-3 control-label">Page Title (In Hindi-UNICODE)<span style="color:#C00000"> (*)</span></label>
                          <div class="col-lg-6">                           
                                @Html.TextBoxFor(model => model.strHindiPageTitle, null, new { @class = "form-control", @required = "required" })
                          </div>
                        </div>
                
	
              <div class="form-group">
                    <label class="col-lg-3 control-label">
                        Page Details (In Hindi-UNICODE)
                    </label>
                    <div class="col-lg-9">
                        <div>@Html.TextArea("strHindiPageDetails", new { @class = "editor1", @id = "editor1" })</div>
                              
                       
                    </div>
                </div>
    
                <div class="form-group">
                    <div class="col-lg-6 col-lg-offset-6">
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <button type="reset" class="btn btn-default">Reset</button>     
                        <a href="@Url.Action("ListAllPageDetails")"><button type="button" class="btn btn-primary">ViewList</button></a>        
                    </div>
                </div>
                      
                      
                      
                  

            }
        </fieldset>
    </div>
</div>
@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        window.onload = function () {
            var aa = "@ViewBag.Message";
            alert(aa); window.location.href = '/Admin/ListAllPageDetailsApprove';
        };
    </script>
}
