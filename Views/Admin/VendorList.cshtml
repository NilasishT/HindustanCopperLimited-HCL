@model IEnumerable<Hindustancopperlimited.Models.VendorRegistration>

@{
    ViewBag.Title = "Vendor Detail List";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{
    
   
   <fieldset>
                        
                         
                         
                         <div class="form-group">

                          <div class="col-lg-3">
                           <label>Select the HCL Plant/Unit</label>
                           @*  @Html.DropDownList("Fk_intUnitId", null, "ALL", new { @class = "form-control" })*@

                              @if (Session["UserType"].ToString() == "Super Admin" || Session["strEmail"].ToString() == "reddy_pks@hindustancopper.com")
                        {
                           @Html.DropDownList("Fk_intUnitId", null, "All", new { @class = "form-control" })
                        }
                          else
                          {
                              @Html.DropDownList("Fk_intUnitId", null, new { @class = "form-control" })
                          }
                             
                           
                          </div>

                         <div class="col-lg-3">
                           <label>Approved Vendors</label>
                             @Html.DropDownList("IsVerify", new List<SelectListItem> {
                                              new SelectListItem {Text="YES",Value="YES"},
                                              new SelectListItem {Text="NO",Value="NO"}
                                                                       }, "ALL", new { @class = "form-control"})
                          </div>
                         
                          <div class="col-lg-3">
                           <label>Registration Status</label>
                            @Html.DropDownList("RegistrationStatus", new List<SelectListItem> {                                              
                                              new SelectListItem {Text="COMPLETE",Value="COMPLETE"},
                                              new SelectListItem {Text="RUNNING",Value="RUNNING"}
                                                                       }, "ALL", new { @class = "form-control"})

                           
                          </div>
                         
                          <div class="col-lg-3">
                          <br />
                           <input type="submit" value="Search" id="search" class="btn btn-primary" />                           
                          </div>
                          <div class="col-lg-10">                         
                          <br />
                         @Html.ActionLink("Downlad Data in Excel", "DownloadManageVendorDetails", null, new { @class = "btn btn-primary" })
                         </div>
                        </div>
  </fieldset>

    

    <br />
    
    
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="VendorDataviewsampleTable" class="table table-hover table-bordered" >
                  <thead>
                    <tr>
                    <th>Details</th>
                     <th>Status</th>
                   <th>Vendor Code</th>
                      <th>Name of FirmCompany</th>
                      <th>Correspondence Address</th>
                      <th>Registered Office Address</th>
                      <th>Email</th>
                      <th>Mobile</th>
                      
                    </tr>
                  </thead>
                 
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
  <!-- Javascripts-->
   


    <script type="text/javascript">    

    $(document).ready(function () {



        $("#VendorDataviewsampleTable").DataTable({
            "processing": true, // for show progress bar
            "serverSide": true, // for process server side
            "filter": true, // this is for disable filter (search box)
            "orderMulti": false, // for disable multiple column at once



            "ajax": {
                "url": "/Admin/LoadVendorData?RegStatus=" + $("#RegistrationStatus").val() + "&isVerify=" + $("#IsVerify").val() + "&selectedunitId=" + $("#Fk_intUnitId").val(),
                "type": "POST",
                "datatype": "json"
            },

            createdRow: function (row, data, index) {
                if (data.strVerify == "YES") {
                    $('td', row).eq(1).addClass('text-success').text('Approved');
                } else {
                    $('td', row).eq(1).addClass('text-danger').text('Not Approved');
                }
            },

            "columns": [

                        { "data": "Pk_intNewVendorRegistrationID", "fnCreatedCell": function (nTd, sData, oData, iRow, iCol) { $(nTd).html("<a href='VendorDetails/" + oData.Pk_intNewVendorRegistrationID + "'>Details</a>"); } },

                         { "data": "strVerify", "name": "strVerify", "autoWidth": true },

                      { "data": "strVendorRegistrationID", "name": "strVendorRegistrationID", "autoWidth": true },
                      { "data": "strNameofFirmCompany", "name": "strNameofFirmCompany", "autoWidth": true },
                     { "data": "strCorrespondenceAddress", "name": "strCorrespondenceAddress", "autoWidth": true },
                      { "data": "strstrRegisteredOfficeAddress", "name": "strstrRegisteredOfficeAddress", "autoWidth": true },
                       { "data": "strEmail", "name": "strEmail", "autoWidth": true },
                        { "data": "strMobile", "name": "strMobile", "autoWidth": true }
                ]

        });

        
       
       
       
        $("#search").click(function () {
            if ($("#Fk_intUnitId").val() == "") {
                notifyError('Please Select Unit.');
                return false;
            }


        });

    });
      </script>