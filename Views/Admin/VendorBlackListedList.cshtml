@model IEnumerable<Hindustancopperlimited.Models.tbl_VendorBlackListed>

@{
    ViewBag.Title = "Vendor Black Listed List";
    Layout = "~/Views/Shared/Dashboard.cshtml";
    //Layout = "~/Views/Shared/Datatable.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{
    
    @Html.ActionLink("Vendor Black Listed", "VendorBlackListed", null, new { @class = "btn btn-primary" })
    <br />
    <br />
    
    
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered" >
                  <thead>
                      <tr>

                          <th>Vendor Name</th>
                          <th>Unit</th>
                          <th>From Date</th>
                          <th>To Date</th>
                          <th>Remarks</th>
                      </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>                   
                     <td> @item.strVendorName</td> 
                     <td>@item.Unit</td>
                     <td> @item.dtFromDate.Value.ToString("dd-MMM-yyyy")</td> 
                     <td> @item.dtToDate.Value.ToString("dd-MMM-yyyy")</td> 
                     <td> @item.strRemarks</td> 
                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
  
