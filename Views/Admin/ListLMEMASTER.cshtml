@model IEnumerable<Hindustancopperlimited.Models.tbl_mst_LMEdetails>

@{
    ViewBag.Title = "List LME Master";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{

       @Html.ActionLink("Add LME Details", "AddLMEMASTER", null, new { @class = "btn btn-primary" })
      <br />
    <br />
    
    <fieldset>
   <div>
        
        <div class="row">
          <div class="col-md-12">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered">
                  <thead>
                    <tr>
                      <th>Edit</th>
                      
                      <th>Type</th>
                       
                       <th>LME Description</th>
                        <th>IsActive</th>
                     
                    
                   
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                      <td>@Html.ActionLink("Edit", "EditLMEMASTER", new { id = item.pk_lmeusermaster })</td>
                     
                      <td> @item.str_lmetype</td>
                      <td>@item.str_lmedescription</td>
                      <td> @item.isactive</td>
                     
                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
