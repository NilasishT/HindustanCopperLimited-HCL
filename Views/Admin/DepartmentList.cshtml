@model IEnumerable<Hindustancopperlimited.Models.tbl_mstDepartment>

@{
    ViewBag.Title = "Department List";
    Layout = "~/Views/Shared/Dashboard.cshtml";
    //Layout = "~/Views/Shared/Datatable.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{
    
    @Html.ActionLink("Add Department", "AddDepartment", null, new { @class = "btn btn-primary" })
    <br />
    <br />
    
    
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered" >
                  <thead>
                    <tr>
                    <th>Edit</th>
                    <th>Delete</th>
                   <th>Department Name</th>
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                    <td>@Html.ActionLink("Edit", "EditDepartment", new { id = item.pk_intID })</td>
                     <td>@Html.ActionLink("Delete", "DeleteDepartment", "Admin", new { id = item.pk_intID }, new { id = item.pk_intID, onclick = "return confirm('Are you sure for delete?')" })</td>
                     <td> @item.strDepartmentName</td>
                     
                       
                         
                     
                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
<script>
    function DeleteConfirm() {
        if (confirm("Are you sure want to delete record"))
            return true;
        else
            return false;
    }
</script>
 
  