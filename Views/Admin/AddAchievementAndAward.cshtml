@{
    ViewBag.Title = "Add Achievement And Award";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}
<div class="col-lg-8">
    <div class="well bs-component">
        @using (Html.BeginForm("AddAchievementAndAward", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
        {

            <fieldset>
                <legend>Add Achievement And Award<span style="color: Red; font-size: 14px; padding-left: 35%"> ( * Fields
                    are Mandatory )</span></legend>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Subject in English<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        @Html.TextBox("strSubjectdfsEnglish", null, new { @class = "form-control", required = "required" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Subject in Hindi<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        @Html.TextBox("strSubjectdfsHindi", null, new { @class = "form-control", required = "required" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Description in English<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        @Html.TextArea("strDescriptiondfsEnglish", null, new { @class = "form-control", required = "required" })
                    </div>
                </div>
                 <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Description in Hindi<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        @Html.TextArea("strDescriptiondfsHindi", null, new { @class = "form-control", required = "required" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Achievement / Award Date<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        @Html.TextBox("dtAwardDate", null, new { @class = "date form-control", required = "required" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Expiry Date</label>
                    <div class="col-lg-8">
                        @Html.TextBox("dtExpiryDate", null, new { @class = "date form-control" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Achievement / Award Image<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        <input type="file" name="strAwardFile" id="strAwardFile" required />
                        <input id="HidFile" type="hidden" />
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-lg-8 col-lg-offset-4">
                        <button type="submit" class="btn btn-primary" onclick="return error()">
                            Submit</button>
                        @Html.ActionLink("Cancel", "AchievementAndAwardList", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </fieldset>
        }
    </div>
</div>

@if (ViewBag.Message != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                alert("@ViewBag.Message");
                //                window.location.href = '/Admin/AddWorkListforApproved';
            };
        </script>
    }


<script src=" @Url.Content("~/Content/js/ValidationAdminAddAchievementAndAward.js")"></script>
