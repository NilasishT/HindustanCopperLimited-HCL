@model IEnumerable<Hindustancopperlimited.Models.tbl_MailContent>

@{
    ViewBag.Title = "ListMailContent";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}

 <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{
     <div class="form-group">
     <div class="col-lg-7">
   
    </div>
    <div class="col-lg-5">
    @Html.ActionLink("Add Mail Content", "CreateMailcontent", null, new { @class = "btn btn-primary" })
   
    </div>
    
    </div>
    <br />
    <br />
    
    

    <br />
    
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered" >
                  <thead>
                   <tr>
                      <th>Edit</th>
                       <th>Delete</th>
                      
                      <th>Mail Title </th>
                      <th>Mail Subject </th>
                      <th>Mail Body</th>
                      <th>Mail Signature</th>
                      <th>Mail Template</th>
                      
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                      <td>@Html.ActionLink("Edit", "EditMailcontent", new { id = item.pk_intMailId })</td>
                      <td>@Html.ActionLink("Delete", "DeleteMailcontent", "Admin", new { id = item.pk_intMailId }, new { id = item.pk_intMailId, onclick = "return confirm('Are you sure for delete?')" })</td>
                      <td> @item.strTitle</td>
                       <td> @item.strSubject</td>
                       <td>@item.strBody</td>
                       <td>@item.strSign</td>
                       <td>@item.strMailPurposeType</td>
	                    
                    </tr>

            }
                    
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
 <script>
     function DeleteConfirm() {
         if (confirm("Are you sure want to delete record"))
             return true;
         else
             return false;
     }
</script>