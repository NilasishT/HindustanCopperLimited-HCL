<script>
    $(document).ready(function () {

        $('#btnUpload').click(function () {

            if (window.FormData !== undefined) {

                var strImageFileEnglish = $("#HidFile").val();
                var str_uploadfile = $("#HidFile1").val();

                //var title = $('#title').val();

               
                var fileupload = $('#str_uploadfile').get(0);
                var files = fileupload.files;


                var fileupload1 = $('#strImageFileEnglish').get(0);
                var MainImage = fileupload1.files;

//                var noerror = 1;

//                if ($('#title').val() == "" || $('#title').val()  == null) {

//                    //alert(" Image Title is Required");
//                    $("#strimageTitle").after("<span style='color:Red'> Image Title is Required</span>");
//                    noerror = 0;
//                }



//                if (MainImage.length <= 0) {
//                    //alert(" Please Select Image/Images");
//                    $("#strImagefileupload1").after("<span style='color:Red'>Please Select Image</span>");
//                    noerror = 0;
//                }

//                if (files.length <= 0) {
