//                    noerror = 0;
//                }

//                if ($("#strstatus").val() == "") {
//                    $("#strstatus").after("<span style='color:Red'>This field is required</span>");
//                    noerror = 0;

//                }


//                if (noerror == 1)

                var SubjectdfsEnglish = $('#strSubjectdfsEnglish').val();
                var SubjectdfsHindi = $('#strSubjectdfsHindi').val();
                var DescriptiondfsEnglish = $('#strDescriptiondfsEnglish').val();
                var DescriptiondfsHindi = $('#strDescriptiondfsHindi').val();
                var EventDate = $('#dtEventDate').val();
                var ExpiryDate = $('#dtExpiryDate').val();
               
                // Create FormData object  
                var fileFormData = new FormData();

                fileFormData.append(MainImage[0].name, MainImage[0]);

                for (var i = 0; i < files.length; i++) {
                    fileFormData.append(files[i].name, files[i]);

                }
                // Adding other keys to FormData object  
                // alert(MainImage[0].name);
                fileFormData.append('strSubjectdfsEnglish', SubjectdfsEnglish);
                fileFormData.append('strSubjectdfsHindi', SubjectdfsHindi);
                fileFormData.append('strDescriptiondfsEnglish', DescriptiondfsEnglish);
                fileFormData.append('strDescriptiondfsHindi', DescriptiondfsHindi);
                fileFormData.append('dtEventDate', EventDate);
                fileFormData.append('dtExpiryDate', ExpiryDate);

                $.ajax({

                    url: '/Admin/AddEvent1',
                    type: "POST",
                    contentType: false, // Not to set any content header  
                    processData: false, // Not to process data  

                    data: fileFormData,

                    success: function (result) {

                        alert(result);
                    },
                    error: function (err) {
                        alert(err.statusText);
                    }
                });

            }

            else
             {
                alert("FormData is not supported.");
            }



        });




    });


</script>