@{
    ViewBag.Title = "Add Event";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}
<div class="col-lg-8">
    <div class="well bs-component">
        @using (Html.BeginForm("AddEvent", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
        {

            <fieldset>
                <legend>Add Event<span style="color: Red; font-size: 14px; padding-left: 40%"> ( * Fields
                    are Mandatory )</span></legend>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Subject in English<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        @Html.TextBox("strSubjectdfsEnglish", null, new { @class = "form-control"})
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Subject in Hindi<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        @Html.TextBox("strSubjectdfsHindi", null, new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Description in English<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        @Html.TextArea("strDescriptiondfsEnglish", null, new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Description in Hindi<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        @Html.TextArea("strDescriptiondfsHindi", null, new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Event Date<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        @Html.TextBox("dtEventDate", null, new { @class = "form-control date" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Expiry Date<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        @Html.TextBox("dtExpiryDate", null, new { @class = "form-control date" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Upload Image<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        <input type="file" name="strImageFileEnglish" id="strImageFileEnglish" />
                        <input id="HidFile" type="hidden" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                       Upload Other Images<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        <input type="file" name="str_uploadfile" id="str_uploadfile" multiple required="required" />
                        <input id="HidFile1" type="hidden" />
                    </div>
                </div>
                
                <div class="form-group">
                    <div class="col-lg-8 col-lg-offset-4">
                         <input type="button" id="btnUpload" onclick="return error()"  value="submit" class="btn btn-primary" />
                        @Html.ActionLink("Cancel", "EventList", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </fieldset>
        }
    </div>
</div>

@if (ViewBag.Message != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                alert("@ViewBag.Message");
//                window.location.href = '/Admin/AddWorkListforApproved';
            };
        </script>
    }
