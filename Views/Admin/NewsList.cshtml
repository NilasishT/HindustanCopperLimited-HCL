@model IEnumerable<Hindustancopperlimited.Models.tbl_mst_News>

@{
    ViewBag.Title = "News List";
    Layout = "~/Views/Shared/Dashboard.cshtml";
    //Layout = "~/Views/Shared/Datatable.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{
    
    @Html.ActionLink("Add News", "AddNews", null, new { @class = "btn btn-primary" })
    <br />
    <br />
    
    
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered" >
                  <thead>
                    <tr>
                    <th>Edit</th>
                   <th>Subject in English</th>
                   <th>Subject in Hindi</th>
                   <th>Document in English</th>
                    <th>Document in Hindi</th>
                   <th>Expiry Date</th>
                   <th>Type</th>
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                        <td>@Html.ActionLink("Edit", "EditNews", new { id = item.Pk_intNewsID })</td>
                        <td> @item.strSubjectdfsEnglish</td>
                        <td> @item.strSubjectdfshindi</td>
                        @*<td><a href=@item.strFileEnglish.Replace("~", "../..") target="_blank">Download</a></td>
        <td><a href=@item.strFileHindi.Replace("~", "../..") target="_blank">Download</a></td>*@
                        <td>
                            @if (!string.IsNullOrEmpty(item.strFileEnglish))
                            {
                                <a href=@item.strFileEnglish.Replace("~", "../..") target="_blank">Download</a>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.strFileHindi))
                            {
                                <a href=@item.strFileHindi.Replace("~", "../..") target="_blank">Download</a>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td> @item.dtExpiryDate.Value.ToString("dd-MMM-yyyy")</td>
                        <td> @item.strNewsType</td>



                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
  