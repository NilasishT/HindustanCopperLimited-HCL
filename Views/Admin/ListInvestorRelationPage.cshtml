@model IEnumerable<Hindustancopperlimited.Models.tbl_mst_InvestorRelationsPage>

@{
    ViewBag.Title = "Categorywise File Upload";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{

       @Html.ActionLink("Add", "AddInvestorRelationPage", null, new { @class = "btn btn-primary" })
      <br />
    <br />
    
    <fieldset>
   <div>
        
        <div class="row">
          <div class="col-md-12">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered">
                  <thead>
                    <tr>
                      <th>Edit</th>
                     @* <th>Delete</th>*@
                      <th>English Text</th>
                      <th>Hindi Text</th>
                       <th>English Upload Document</th>
                      <th> Hindi Upload Document</th>
                    
                   
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                      <td>@Html.ActionLink("Edit", "EditInvestorRelationPage", new { id = item.pk_int_InvestorRelationsID })</td>
                      
                      <td> @item.strEnglishText</td>
                     <td> @item.strHindiText</td>


                     @if (item.strEnglishFileUpload != null)
                           { 
                       <td><a href=@item.strEnglishFileUpload.Replace("~", "../..") target="_blank">View Document</a></td>
                           }
                           else
                           {
                            <td>N/A</td>
                           }

                           @if (item.strHindiFileUpload != null)
                           { 
                       <td><a href=@item.strHindiFileUpload.Replace("~", "../..") target="_blank">View Document</a></td>
                           }
                           else
                           {
                            <td>N/A</td>
                           }


                         


                      
                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
<script>
    function DeleteConfirm() {
        if (confirm("Are you sure want to delete record"))
            return true;
        else
            return false;
    }
</script>
 


   