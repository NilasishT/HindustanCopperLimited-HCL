@model Hindustancopperlimited.Models.tbl_mst_InvestorRelationsPage

@{
    ViewBag.Title = "Edit Categorywise File Upload";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}



<div class="col-lg-8">
    <div class="well bs-component">
        @using (Html.BeginForm("EditInvestorRelationPage", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
        {
              @Html.AntiForgeryToken()

            <fieldset>
                <legend>Edit Investor Relation<span style="color: Red; font-size: 14px; padding-left: 40%"> ( * Fields
                    are Mandatory )</span></legend>




                      <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Category<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                      
                            @Html.DropDownList("strPageType", null, "--- Select ---", new { @class = "form-control choosenDropdown", required = "required" })
                    </div>
                </div>





        @*<div class="form-group">
                    <label class="col-lg-4 control-label">
                        Sub Head<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                      
                           @Html.TextBoxFor(m => m.strSubhead, new { @class = "form-control", required = "required"})
                    </div>
                </div>*@



                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        English Text<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                      
                           @Html.TextBoxFor(m => m.strEnglishText, new { @class = "form-control", required = "required" })

               @Html.HiddenFor(m => m.pk_int_InvestorRelationsID)
              @Html.HiddenFor(m => m.dtEntryDate)

                  @* @Html.HiddenFor(m => m.strPageType)
                  @Html.HiddenFor(m => m.isActive)*@


                   @Html.HiddenFor(m => m.strHindiFileUpload)
                    @Html.HiddenFor(m => m.strEnglishFileUpload)
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                      Hindi Text<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                      
                           @Html.TextBoxFor(m => m.strHindiText, new { @class = "form-control", required = "required" })
                    </div>
                </div>
                
                
                <div class="form-group">
            <label class="col-lg-4 control-label">Uplaod (In English)<span style="color:Red"> (*)</span></label>
            <div class="col-lg-8">
            <input type="file" name="strEnglishFileUpload" class="form-control" /> 
             @if (ViewBag.strEnglishFileUpload != null)
             {
                 <a href=@ViewBag.strEnglishFileUpload.Replace("~", "../..") target="_blank">View Upload Doc...</a>
             }
             <input type="hidden" id="hidEnglishText" name="hidEnglishText" />
            </div>

        </div>            



      <div class="form-group">
            <label class="col-lg-4 control-label">Upload (In Hindi-UNICODE)<span style="color:Red"> (*)</span></label>
            <div class="col-lg-8">
            <input type="file" name="strHindiFileUpload" class="form-control" /> 
             @if (ViewBag.strHindiFileUpload != null)
             {
                 <a href=@ViewBag.strHindiFileUpload.Replace("~", "../..") target="_blank">View Upload Doc...</a>
             }
             <input type="hidden" id="hidHindiText" name="hidHindiText" />
            </div>

        </div>   
        
                 

            <div class="form-group">
                          <label  class="col-lg-4 control-label"> Do you want to show this <br />(checked = Yes)</label>
                          <div class="col-lg-4">
                            

                              @Html.CheckBox("IsActive", new { htmlAttributes = new { @class = "form-control" } })
                            
                          </div>
                        </div>

                
                               
        <div class="form-group">
            <div class="col-lg-8 col-lg-offset-4">
                           
            <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
               @Html.ActionLink("Cancel", "ListInvestorRelationPage", null, new { @class = "btn btn-default" })
            </div>
        </div>
          
                
                
                
            </fieldset>
        }
    </div>
</div>









 @if (ViewBag.Message != null)
 {
        <script type="text/javascript">
            window.onload = function () {
                alert("@ViewBag.Message");

            };


        </script>
    }




    <script type="text/javascript">

        function error() {
            $("#strEnglishText,#strHindiText,#strHindiFileUpload,#strEnglishFileUpload").next("span").remove();

            var noerror = 1;


            if ($('#strEnglishText').val() == "") {
                $("#strEnglishText").after("<span style='color:Red'>This field is required</span>");
                noerror = 0;
            }
            if ($('#strHindiText').val() == "") {
                $("#strHindiText").after("<span style='color:Red'>This field is required</span>");
                noerror = 0;
            }

            if ($('#strHindiFileUpload').val() == "") {
                $("#strHindiFileUpload").after("<span style='color:Red'>This field is required</span>");
                noerror = 0;
            }


            if ($('#strEnglishFileUpload').val() == "") {
                $("#strEnglishFileUpload").after("<span style='color:Red'>This field is required</span>");
                noerror = 0;
            }



            if (noerror == 1) {
                if (confirm("Are you sure ?")) {
                    return true;

                }
                else {
                    return false;
                }
            }

            if (noerror == 0) {
                return false;
            }
        }

</script>



     <script type="text/javascript">
        

         $('input[type="file"]').change(function (e) {
             var extension = $(this).val().replace(/^.*\./, '');

             if (extension.toLowerCase() == 'pdf' || extension.toLowerCase() == 'jpeg' || extension.toLowerCase() == 'jpg' || extension.toLowerCase() == 'doc' || extension.toLowerCase() == 'docx' || extension.toLowerCase() == 'xls' || extension.toLowerCase() == 'xlsx') {
                 var size = this.files[0].size / 1048576;
                 if (parseFloat(size) <= 4) {
                 }
                 else {
                     alert('Please check file Size');
                     $(this).val('');
                 }

             }
             else {
                 alert('Please check file extension');
                 $(this).val('');
             }


         })

       

       
  </script>