@model IEnumerable<Hindustancopperlimited.Models.UploadBillTracking>

@{
    ViewBag.Title = "List Upload Bill Tracking";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}

<div class="col-lg-12">
    <div class="well bs-component">

        @using (Html.BeginForm())
        {
            <div class="form-group">
                <div class="col-lg-7">

                </div>
                <div class="col-lg-5">
                    @Html.ActionLink("Upload Bill Tracking", "UploadBillTracking", null, new { @class = "btn btn-primary" })

                </div>

            </div>
            <br />
            <br />



            <br />

            <fieldset>
                <div>

                    <div class="row">
                        <div class="col-md-18">
                            <div class="card">
                                <div class="card-body">
                                    <table id="sampleTable" class="table table-hover table-bordered">
                                        <thead>
                                            <tr>
                                                <th>PurchaseOrders</th>
                                                <th>BillSubmitted</th>
                                                <th>BillStatus</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var item in Model)
                                            {
                                            <tr>

                                                @if (@item.PurchaseOrders != null)
                                                {
                                                    <td><a href=@item.PurchaseOrders.Replace("~","../..") target="_blank"> Download/View</a></td>
                                                }
                                                else
                                                {
                                                    <td>N/A</td>
                                                }

                                                @if (@item.BillSubmitted != null)
                                                {
                                                    <td><a href=@item.BillSubmitted.Replace("~", "../..") target="_blank"> Download/View</a></td>
                                                }
                                                else
                                                {
                                                    <td>N/A</td>
                                                }

                                                @if (@item.BillStatus != null)
                                                {
                                                    <td><a href=@item.BillStatus.Replace("~", "../..") target="_blank"> Download/View</a></td>
                                                }
                                                else
                                                {
                                                    <td>N/A</td>
                                                }
                                            </tr>

                                            }


                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>

        }
    </div>
</div>





