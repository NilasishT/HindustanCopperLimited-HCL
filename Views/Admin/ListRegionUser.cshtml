@model IEnumerable<Hindustancopperlimited.Models.RegionUser>

@{
    ViewBag.Title = "Region User List";
    Layout = "~/Views/Shared/Dashboard.cshtml";
    //Layout = "~/Views/Shared/Datatable.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{
@Html.ActionLink("Add Region User", "CreateRegionUser", null, new { @class = "btn btn-primary" })
  
   
    <br />
    <br />
    <br />
    
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered" >
                  <thead>
                    <tr>
                   <th>Edit</th>
                   <th>Delete</th>
                   <th>User Name</th>
                      <th>Designation</th>
                      <th>Email</th>
                      
                     @*  <th>Comments</th>*@
                      
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                    <td>@Html.ActionLink("Edit", "EditRegionUser", new { id = item.pk_intRegionUserId })</td>
                      <td>@Html.ActionLink("Delete", "DeleteRegionUser", "Admin", new { id = item.pk_intRegionUserId }, new { id = item.pk_intRegionUserId, onclick = "return confirm('Are you sure for delete?')" })</td>
                     <td> @item.strUserName</td>
                       <td>@item.strDesignation</td>
                       <td>@item.strEmail</td>                 
                       
                         
                     
                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
 <script>
     function DeleteConfirm() {
         if (confirm("Are you sure want to delete record"))
             return true;
         else
             return false;
     }
</script>
 
   


