@{
    ViewBag.Title = "Add Corrigendum";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}
<div class="col-lg-8">
    <div class="well bs-component">
        @using (Html.BeginForm("AddCorrigendum", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
        {
            @Html.ActionLink("Corrigendum List", "CorrigendumList", null, new { @class = "btn btn-primary" })<br />
            <br />
            <fieldset>
                <legend>Add Corrigendum</legend>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Enq. No.<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                      @*  @Html.DropDownList("EnqNo", null, "Select", new { @class = "form-control input-append form_datetime", required = "required" })*@
                        @Html.DropDownList("EnqNo", ViewData["EnqNolist"] as SelectList, "Select", new { @class = "form-control", required = "required" })

                        @*shoumya*@
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Enquiry Title
                    </label>
                    <div class="col-lg-8">
                        @Html.Label("Enquiry Title", null, new { @class = "form-control", id = "EnqTitle" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Enq. Closing Date & Time
                    </label>
                    <div class="col-lg-8">
                        @Html.Label("Enq. Closing Date & Time", null, new { @class = "form-control", id = "EnqClosing" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Extended Date<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        @Html.TextBox("dtExtendedDate", null, new { @class = "form-control input-append form_datetime", required = "required" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Cost of Tender Document
                    </label>
                    <div class="col-lg-8">
                        @Html.Label("Cost of Tender Document", null, new { @class = "form-control", id = "EnqCost" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Earnest Money Deposit
                    </label>
                    <div class="col-lg-8">
                        @Html.Label("Earnest Money Deposit", null, new { @class = "form-control", id = "EnqEarnest" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Document (In English)<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        <input type="file" name="strFile" class="form-control" required />
                        <input type="hidden" id="hidText" name="hidText" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-lg-4 control-label">
                        Document (In Hindi-UNICODE)<span style="color: Red"> (*)</span></label>
                    <div class="col-lg-8">
                        <input type="file" name="strFileNameHindi" class="form-control" required />
                        <input type="hidden" id="hidHindiText" name="hidHindiText" />
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-lg-8 col-lg-offset-4">
                        <button type="submit" class="btn btn-primary" onclick="return error()">
                            Submit</button>
                        @Html.ActionLink("Cancel", "CorrigendumList", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </fieldset>
        }
    </div>
</div>
@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.Message");
            window.location.href = '/Admin/CorrigendumList';

        };


    </script>
}
<script>
    $(document).ready(function () {
        $("#EnqNo").chosen({ allow_single_deselect: true });
    });

    $('input[type="file"]').change(function (e) {
        var extension = $(this).val().replace(/^.*\./, '');

        if (extension.toLowerCase() == 'pdf' || extension.toLowerCase() == 'jpeg' || extension.toLowerCase() == 'doc' || extension.toLowerCase() == 'docx' || extension.toLowerCase() == 'xls' || extension.toLowerCase() == 'xlsx') {
            var size = this.files[0].size / 1048576;
            if (parseFloat(size) <= 4) {
            }
            else {
                alert('Please check file Size');
                $(this).val('');
            }

        }
        else {
            alert('Please check file extension');
            $(this).val('');
        }


    })

    $("#EnqNo").change(function () {

        var tenderId = $("#EnqNo").val();
        if (tenderId == "") {
            $("#EnqClosing").html('');
            $("#EnqTitle").html('');
            $("#EnqCost").html('');
            $("#EnqEarnest").html('');
        }
        else {
            $.ajax({
                type: 'POST',
                dataType: 'json',
                url: '/Admin/EnquiryDate',
                data: { 'tenderId': tenderId },
                success: function (result) {

                    if (result.enqDate != "") {
                        $("#EnqClosing").html(result.enqClosingValue);
                        $("#EnqTitle").html(result.enqTitleValue);
                        $("#EnqCost").html(result.enqCostValue);
                        $("#EnqEarnest").html(result.enqEarnestValue);
                    }
                },
                error: function () {

                    alert('Error');
                }

            });
        }
    });



    $(function () {
        $("form").submit(function () {
            var selTypeText = $("#EnqNo option:selected").text();
            $("#hidText").val(selTypeText);
        });
    });
</script>
<script>
    ("#EnqNo").change(function () {

        var EnqNo = $("#EnqNo").val();
        $("#EnqNo").next("span").remove();
        if (EnqNo == "") {
            $("#EnqNo").after("<span style='color:Red'> This field is required</span>");
        }
        else {
            $("#EnqNo").next("span").remove();
        }
    });

    function error() {
    var noerror = 1;
    if ($("#EnqNo").val() == "") {
        $("#EnqNo").next("span").remove();
        $("#EnqNo").after("<span style='color:Red'> This field is required</span>");
        noerror = 0;
    }

    if (noerror == 1) {
        if (confirm("Are you sure ?")) {

            if ($('#tbl_mstCorrigendum')[0].checkValidity()) {
                return true;
            }
        }
        else {
            return false;
        }
    }

    if (noerror == 0) {
        return false;
    }
}

</script>