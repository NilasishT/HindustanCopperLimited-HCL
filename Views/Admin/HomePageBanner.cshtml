@{
    ViewBag.Title = "Home Page Banner";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}



<div class="col-lg-12">
    <div class="well bs-component">
        @*@Html.ActionLink("Add Achievement And Award", "AddAchievementAndAward", null, new { @class = "btn btn-primary" })*@
        <div id="divTable">
            <a class="btn btn-primary" id="btnAddNew">Add New Banner</a>
            <br />
            <br />
            <fieldset>
                <div>
                    <div class="row">
                        <div class="col-md-18">
                            <div class="card">
                                <div class="card-body">
                                    <table id="sampleTable" class="table table-hover table-bordered">
                                        <thead>
                                            <tr>
                                                <th>English Title</th>
                                                <th>Hindi Title</th>
                                                <th>English Image</th>
                                                <th>Hindi Image</th>
                                                <th>Status</th>
                                                <th>Order</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>
        <div id="divForm" style="display:none;">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        <label>English Title</label>
                        <input type="text" id="txt-Title" class="form-control" />
                    </div>
                    <div class="col-md-12">
                        <label>Hindi Title</label>
                        <input type="text" id="txt-HindiTitle" class="form-control" />
                    </div>
                    <div class="col-md-12">
                        <label>English Image</label>
                        <input type="file" id="fl-ImageUrl" />
                    </div>
                    <div class="col-md-12">
                        <label>Hindi Image</label>
                        <input type="file" id="fl-HindiImageUrl" />
                    </div>
                    <div class="col-md-12">
                        <label>Order Index</label>
                        <input type="number" id="txt-OrderIndex" class="form-control" />
                    </div>
                    <div class="col-md-12">
                        <a class="btn btn-success" id="btn-Submit" data-id="">Add</a>
                        <a class="btn btn-danger" id="btn-Cancel" data-id="">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<textarea style="display:none" id="editor1"></textarea>
<script>

    $(function () {
        var Controller = '/Admin';
        function BindData(res) {
            $.each(res.data, function (i, v) {
                var jj = '<tr>';
                jj += '<td>' + v.Title + '</td>';
                jj += '<td>' + v.HindiTitle + '</td>';
                jj += '<td>' + v.ImageUrl + '</td>';
                jj += '<td>' + v.HindiImageUrl + '</td>';
                jj += '<td>' + v.IsActive + '</td>';
                jj += '<td>' + v.OrderIndex + '</td>';
                jj += '</tr>';
                ele.append(jj);
            });
        }
        $(document).on('click', '#btnAddNew,.clsEdit,#btn-Cancel', function () {
            $('#btn-Submit').attr('data-id', '');
            $('#txt-Title').val('');
            $('#txt-HindiTitle').val('');
            $('#fl-ImageUrl').val('');
            $('#fl-HindiImageUrl').val('');
            $('#txt-OrderIndex').val('');
            if ($(this).haClass('clsEdit')) {
                $('#btn-Submit').attr('data-id', $(this).attr('data-id'));
                var o = {};
                o.Id = $(this).attr('data-id');
                $.ajax({
                    url: Controller + '/GetHomePageBanner',
                    type: 'post',
                    data: JSON.stringify({ o: o }),
                    contentType: 'application/json;charset=utf-8;',
                    dataType: 'json',
                    success: function (res) {

                    }
                });
            }
        });
        function GetData() {
            var ele = $('#tbody').empty().append('<tr><td colspan="6">loading...</td></tr>');
            $.ajax({
                url: Controller + '/GetHomePageBanner',
                type: 'post',
                data: {},
                contentType: 'application/json;charset=utf-8;',
                dataType: 'json',
                success: function (res) {
                    BindData(res, ele.empty());
                }
            });
        }
        GetData();
        $('#btn-Submit').on('click', function () {
            var files = $this.files;
            // Create FormData object
            var fileData = new FormData();
            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);
            }
            $.ajax({
                url: '/Admin/UploadFile',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                async: false,
                success: function (result) {
                    if (result.status == 'success') {
                        $($this).attr('url', result.data);
                    }
                    else {
                        AlertError(result.msg);
                    }
                },
                error: function (res) {
                }

            })
        });
    });
</script>