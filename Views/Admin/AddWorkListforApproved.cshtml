@model IEnumerable<Hindustancopperlimited.Models.CONTRACT_WORK_ORDER>
@{
    ViewBag.Title = "Work Order List";
    Layout = "~/Views/Shared/Dashboard.cshtml";
            //Layout = "~/Views/Shared/Datatable.cshtml";
}
<div class="col-lg-12">
    <div class="well bs-component">
        @using (Html.BeginForm())
        {
    
   
    
            <fieldset>
                <div>
                    <div class="row">
                        <div class="col-md-18">
                            <div class="card">
                                <div class="card-body">
                                    <table id="sampleTable" class="table table-hover table-bordered">
                                        <thead>
                                            <tr>
                                                <th>
                                                    Status
                                                </th>
                                                <th>
                                                    Workorder No.
                                                </th>
                                                <th>
                                                    Name of Work
                                                </th>
                                                <th>
                                                    Name of Company
                                                </th>
                                                <th>
                                                    Work Order File
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                if (@item.WO_UNIT != null)
                                                {
                                                <tr>
                                                    @if (item.APPROVED == "Y")
                                                    { 
                                                        <td>@Html.ActionLink("Approved", "WorkOrderApproved", new { id = item.ID })
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td>@Html.ActionLink("Not approved", "WorkOrderApproved", new { id = item.ID })
                                                        </td>
                                                    }
                                                    <td>
                                                        @item.WORKORDERNO
                                                    </td>
                                                    <td>
                                                        @item.NAMEOFTHEWORK
                                                    </td>
                                                    <td>
                                                        @item.NAMEOFTHECOMPANY
                                                    </td>
                                                    <td>
                                                     @if (item.WO_FILE != null)
                                                     { 
                                                        <a href=@item.WO_FILE.Replace("~", "../..") target="_blank">View Work Order</a>
                                                     }
                                                     else
                                                     {
                                                        <a>NA</a>
                                                     }
                                                    </td>
                                                </tr>
                                                }

                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
	
        }
    </div>
</div>
