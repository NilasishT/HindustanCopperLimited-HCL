         <div class="form-group">
            <label class="col-lg-4 control-label">Bidding Instructions (In Hindi-UNICODE)</label>
            <div class="col-lg-8">
            @Html.TextAreaFor(m => m.strBiddingInstructionHindi, new { @class = "form-control", rows = "5" })<span id="errmsg20"></span>
