            <input type="file" name="strFilehindi2" class="form-control" />
             @if (ViewBag.strFilehindi2 != null)
            {
                 <a href=@ViewBag.strFilehindi2.Replace("~", "../..") target="_blank">View Upload Doc...</a>
            }
