            <div class="col-lg-8">
            <input type="file" name="strFilehindi" id="strFilechangehindi" class="form-control" /><span id="errmsg36"></span>
            @Html.Hidden("HidFilehindi")
            @if (ViewBag.strFilehindi != null)
            {
                 <a href=@ViewBag.strFilehindi.Replace("~", "../..") target="_blank">View Upload Doc...</a>
            }
