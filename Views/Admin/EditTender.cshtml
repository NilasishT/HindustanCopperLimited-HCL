            <input type="file" name="strFile3" class="form-control" />
             @if (ViewBag.strFile3 != null)
            {
                 <a href=@ViewBag.strFile3.Replace("~", "../..") target="_blank">View Upload Doc...</a>
            }
            else
            { }
            <input type="file" name="strFile4" class="form-control" />
             @if (ViewBag.strFile4 != null)
