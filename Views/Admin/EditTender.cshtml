            <input type="file" name="strFilehindi1" class="form-control" />
             @if (ViewBag.strFilehindi1 != null)
            {
                 <a href=@ViewBag.strFilehindi1.Replace("~", "../..") target="_blank">View Upload Doc...</a>
            }
