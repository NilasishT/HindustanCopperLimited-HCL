            <label class="col-lg-4 control-label">Bidder's Pre-Qualification (In Hindi-UNICODE)</label>
            <div class="col-lg-8">
            @Html.TextAreaFor(m => m.strBiddersQualificationHindi, new { @class = "form-control", rows = "5" })<span id="errmsg18"></span>
