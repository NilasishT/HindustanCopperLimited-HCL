@model IEnumerable<Hindustancopperlimited.Models.tbl_mst_tender>

@{
    ViewBag.Title = "Tender List";
    Layout = "~/Views/Shared/Dashboard.cshtml";
    //Layout = "~/Views/Shared/Datatable.cshtml";
}
                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{
     <div class="form-group">
     <div class="col-lg-7">
   
    </div>
    <div class="col-lg-5">
     @Html.ActionLink("Add Tender", "ManageTender", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("Addendum", "AddAddendum", null, new { @class = "btn btn-primary" })
     @Html.ActionLink("Corrigendum", "AddCorrigendum", null, new { @class = "btn btn-primary" })
    </div>
    
    </div>
    <br />
    <br />
    
     <fieldset>
                        
                         
                         <div class="form-group">
                         <div class="col-lg-3">
                         </div>
                          <div class="col-lg-6">
                           <label>Select the HCL Plant/Unit</label>
                            @* @Html.DropDownList("Fk_intUnitId", null, "All", new { @class = "form-control"})*@

                              @if (Session["UserType"].ToString() == "Super Admin")
                        {
                           @Html.DropDownList("Fk_intUnitId", null, "All", new { @class = "form-control" })
                        }
                          else
                          {
                              @Html.DropDownList("Fk_intUnitId", null, new { @class = "form-control" })
                          }
                             
                             
                             
                             <br />
                           <input type="submit" value="Search" id="search" class="btn btn-primary" />
                          </div>
                         
                        </div>
  </fieldset>

    

    <br />
    
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered" >
                  <thead>
                    <tr>
                    <th>Edit</th>
                   <th>Enquiry Title</th>
                   <th>Enquiry No</th>
                   <th>Enquiry Date</th>
                   <th>Tender Type</th>
                    <th>Closing Date/Time</th>
                   <th>Cost of Tender</th>                   
                   <th>Tender Document</th>
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                    <td>@Html.ActionLink("Edit", "EditTender", new { id = item.pk_intTenderId })</td>
                     <td> @item.strEnquiryTitle</td>
                     <td> @item.strEnquiryNo</td>                      
                      <td> @item.dtEnquiryDate.Value.ToString("dd-MMM-yyyy")</td>                      
                       <td> @item.strTenderType</td>
                       <td> @item.dtClosingDate.ToString("dd-MMM-yyyy h:mm tt")</td>                     
                       <td> @item.numCostofTender</td>
                     <td><a href=@item.strFilePath.Replace("~", "../..") target="_blank">Download</a></td>
                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
  