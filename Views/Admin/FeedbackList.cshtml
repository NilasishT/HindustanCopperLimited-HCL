@model IEnumerable<Hindustancopperlimited.Models.tbl_feedback>

@{
    ViewBag.Title = "Feedback List";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{
    
     
    
    <fieldset>
    <legend>Feedback List</legend>
   <div>
        
        <div class="row">
          <div class="col-md-12">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered">
                  <thead>
                    <tr>
                      <th>View</th>
                      
                      <th>First Name</th>
                      <th>Last Name</th>
                      <th>Email</th>
                      <th>Address</th>
                      <th>City</th>
                      <th>State</th>
                      <th>Country</th>
                      <th>Feedback</th>
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                      <td>@Html.ActionLink("View", "Feedbackview", new { id = item.Pk_Titleid })</td>
                      @*<td>@Html.ActionLink("Delete", "DisciplineDelete", "Admin", new { id = item.Pk_Disciplineid }, new { id = item.Pk_Disciplineid, onclick = "return confirm('Are you sure for delete?')" })</td>*@
                      <td> @item.strf_name</td>
                      <td> @item.strl_name</td>
                      <td> @item.str_email</td>
                      <td> @item.str_address</td>
                      <td> @item.str_city</td>
                      <td> @item.str_state</td>
                      <td> @item.str_country</td>
                      
                      <td>@item.str_comment</td>
                       

                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>