@model Hindustancopperlimited.Models.tbl_DisableOrder

@{
    ViewBag.Title = "Disable Order";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}

<div class="col-lg-12">
    <div class="well bs-component">
            
@using (Html.BeginForm("DisableOrder", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
   
        <fieldset>
        <legend> Disable Order<b><span style="color:Red; font-size:14px; padding-left:40%"> (*) Fields are Mandatory </span></b></legend>

        
        
        <div class="form-group">
            <label class="col-lg-4 control-label">From Date & Time<span style="color:Red"> (*)</span></label>
            <div class="col-lg-4">
            @Html.TextBoxFor(model => model.dtFromDate, new { @class = "form-control input-append form_datetime" })
            </div>
        </div>  
        
        <div class="form-group">
            <label class="col-lg-4 control-label">To Date & Time<span style="color:Red"> (*)</span></label>
            <div class="col-lg-4">
            @Html.TextBoxFor(model => model.dtTodate, new { @class = "form-control input-append form_datetime" })
            </div>
        </div>
        
        
                        
        <div class="form-group">
            <div class="col-lg-8 col-lg-offset-4">
                           
            <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
                 @Html.ActionLink("Cancel", "ProducttenderList", null, new { @class = "btn btn-default" })
            </div>
        </div>
        </fieldset>
}       
    </div>
</div>
       
   


 @if (ViewBag.Message != null)
 {
        <script type="text/javascript">
            window.onload = function () {
                var aa = "@ViewBag.Message";
                alert(aa);
                
            };
        </script>
 }
 


 




