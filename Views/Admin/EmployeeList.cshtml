<script>
    $(document).ready(function () {

        $("#sampleTableEmploymentNotice").DataTable({
            "processing": true, // for show progress bar
            "serverSide": true, // for process server side
            "filter": true, // this is for disable filter (search box)
            "orderMulti": true, // for disable multiple column at once

            "ajax": {
                "url": "/Admin/LoadEmploymentNotice",
                "type": "POST",
                "datatype": "json"
            },

           


            "columns": [

                        { "data": "Pk_employmentid", "fnCreatedCell": function (nTd, sData, oData, iRow, iCol) { $(nTd).html("<a href='EmploymentEdit/" + oData.Pk_employmentid + "'>Edit</a>"); } },
                        { "data": "Empnoticeno", "name": "Empnoticeno", "autoWidth": true },
                        { "data": "strEmploymentType", "name": "strEmploymentType", "autoWidth": true },
                        
                        { "data": "Emptitle", "name": "Emptitle", "autoWidth": true },
                        { "data": "Strupload", "fnCreatedCell": function (nTd, sData, oData, iRow, iCol) { $(nTd).html("<a target='_blank' href='" + oData.Strupload.replace('~','../..') + "'>Download Notice</a>"); } },

                ]

        });

    });
</script>