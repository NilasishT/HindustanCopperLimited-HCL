@model Hindustancopperlimited.Models.Login
@{
    ViewBag.Title = "Edit SignUp ";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}

<style>
#topBarHclHedT {

    font-size: 27px;
    font-family: 'Open Sans',sans-serif;
    font-weight: 600;
    padding-left: 0%;
    margin: 9px 0;
    display: inline-block;
    color: #6f3706;

}
</style>        
  
                <div class="col-lg-8">
                  <div class="well bs-component">
                    <form class="form-horizontal" method="post">
                      <fieldset>
                        <legend>Edit SignUp <span style="color:Red; font-size:14px; padding-left:20%"> ( * Fields are Mandatory )</span></legend>

                          <div class="form-group">
                          <label for="textArea" class="col-lg-4 control-label">Select Unit <span style="color:Red"> (*)</span></label>
                          <div class="col-lg-8">
                        @* @Html.DropDownList("Fk_intUnitId", null, "Select", new { @class = "form-control", required = "required" })*@

                        @if (Session["UserType"].ToString() == "Super Admin")
                        {
                         @Html.DropDownListFor(model => model.Fk_intUnitId, ViewBag.UnitList as SelectList, "All", new { @class = "form-control" })<span id="errmsg4"></span>
                        }
                        else
                        {
                             @Html.DropDownListFor(model => model.Fk_intUnitId, ViewBag.UnitList as SelectList, new { @class = "form-control" })<span id="errmsg4"></span>
                        }


                         @Html.HiddenFor(model => model.dtEntrydate)

                          </div>
                        </div>

                        @*  <div class="form-group">
                          <label for="textArea" class="col-lg-4 control-label">Select Workable Area <span style="color:Red"> (*)</span></label>
                          <div class="col-lg-8">
                          @Html.DropDownList("strusertype", new List<SelectListItem> {
                                              new SelectListItem {Text="Manage Tender",Value="Tender"},
                                              new SelectListItem {Text="CLIP",Value="CLIP"},
                                               new SelectListItem {Text="LME",Value="LME"}
                                                                       }, "Select", new { @class = "form-control", required = "required" }
                                           )<span id="errmsg5"></span>
                          </div>
                        </div>*@

                        
                   <div class="form-group">
                          <label for="textArea" class="col-lg-4 control-label">Menu privilege    <span style="color:Red"> (*)</span></label>
                          <div class="col-lg-8" style="height:200px">
                         
                            @Html.ListBox("strMenuRightID")
                          @Html.Hidden("hid_strMenuRightID")
                          </div>
                        </div>      

                        <div class="form-group">
                          <label class="col-lg-4 control-label">User Name<span style="color:Red"> (*)</span></label>
                          <div class="col-lg-8">
                            @*<input id="strUserName" type="text" placeholder=" Enter User Name" name="strUserName" class="form-control" required><span id="errmsg"></span>*@
                            @Html.TextBoxFor(model => model.strUserName, null, new { @class = "form-control", required = "required" })<span id="errmsg"></span>
                            @Html.HiddenFor(model => model.pk_intUserId)
                          </div>
                        </div>

                         <div class="form-group">
                          <label  class="col-lg-4 control-label">User Password<span style="color:Red"> (*)</span></label>
                          <div class="col-lg-8">
                            <input id="strUserPwd" type="password" placeholder="Enter User Password" name="strUserPwd" class="form-control" required="required">
                            
                          </div>
                        </div>

                        <div class="form-group">
                          <label class="col-lg-4 control-label">Email<span style="color:Red"> (*)</span></label>
                          <div class="col-lg-8">
                            @*<input id="strEmail" type="text" placeholder="Enter Email" name="strEmail" class="form-control" required><span id="errmsg2"></span>*@
                             @Html.TextBoxFor(model => model.strEmail, null, new { @class = "form-control", required = "required" })<span id="errmsg1"></span>
                          </div>
                        </div>
                        
                        <div class="form-group">
                          <label for="textArea" class="col-lg-4 control-label">Designation<span style="color:Red"> (*)</span></label>
                          <div class="col-lg-8">
                            @*<input id="strDesignation" type="text" placeholder=" Enter Designation" class="form-control" name="strDesignation" required><span id="errmsg3"></span>*@
                            @Html.TextBoxFor(model => model.strDesignation, null, new { @class = "form-control", required = "required" })<span id="errmsg3"></span>
                          </div>
                        </div>                     


                       


                        
                        <div class="form-group">
                          <div class="col-lg-8 col-lg-offset-4">
                           
                            <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
                              @Html.ActionLink("Cancel", "UserList", null, new { @class = "btn btn-default" })
                          </div>
                        </div>
                      </fieldset>
                    </form>
                  </div>
                </div>
                
             @if (ViewBag.Message != null)
             {
        <script type="text/javascript">
            window.onload = function () {
                alert("@ViewBag.Message");
                window.location.href = '/Admin/UserList';

            };
        </script>
             }
 <script src="@Url.Content("~/Content/js/ValidationSignUp.js?a=5")"></script>


