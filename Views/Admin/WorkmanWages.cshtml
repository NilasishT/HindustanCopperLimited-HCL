@model IEnumerable<Hindustancopperlimited.Models.vw_CONTRACT_WORKMAN_WAGES>

@{
    ViewBag.Title = "Workman Wages for Approved";
    Layout = "~/Views/Shared/Dashboard.cshtml";
    //Layout = "~/Views/Shared/Datatable.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{
    
    
    
    
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered" >
                  <thead>
                    <tr>

                  <td>Action</td>
                  <th>Workman Name</th>

                   <th>Work Order No.</th> 
                     <th>Month</th>
                      <th>Year</th>
                  <th>Vendor Code</th>
                    <th>Net Amount</th>
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                   @if (item.APPROVED == "Y")
                   {                       
                   <td>@Html.ActionLink("Approved", "EditWorkmanWages", new { id = item.ID })</td>
                   }
                   else
                   {
                        <td>@Html.ActionLink("Not Approved", "EditWorkmanWages", new { id = item.ID })</td>
                   }
                     
                     <td>@item.NAME @item.SURNAME</td>
                     <td>@item.WORKORDERNO</td>
                     <td>@item.MNTH</td>
                     <td>@item.YEAR</td>
                     <td>@item.strVendorRegistrationID</td>
                     <td>@item.NETAMOUNT</td>
                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>