@model Hindustancopperlimited.Models.tbl_Quarterly_Report

@{
    ViewBag.Title = "Edit Quarterly Report";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}

        <div class="col-lg-8">
    <div class="well bs-component">
    @using (Html.BeginForm("EditQuarterlyReport", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
    {

        <fieldset>
        <legend> Edit Quarterly Report <span style="color:Red; font-size:14px; padding-left:20%"> ( * Fields are Mandatory )</span></legend>

        



        <div class="form-group">
            <label class="col-lg-5 control-label">Select Quarterly Report <span style="color:Red"> (*)</span></label>
            <div class="col-lg-7">
            @Html.DropDownListFor(model => model.txtData, new SelectListItem[]{
                new SelectListItem() {Text = "Financial", Value="FN"},
                new SelectListItem() {Text = "Sales volume", Value="SD"}, 
                 new SelectListItem() {Text = "Sales Revenue", Value="RD"},
                  new SelectListItem() {Text = "Production Report", Value="PD"}}, "Select", new { @class = "form-control" })
                   @Html.HiddenFor(model => model.Pk_ReportId)
                              @Html.HiddenFor(model => model.dtmCreatedOn)
                              @Html.HiddenFor(model => model.vchProfStatus)


            </div>
        </div>




        <div class="form-group">
            <label class="col-lg-5 control-label">Select Year<span style="color:Red"> (*)</span></label>
            <div class="col-lg-7">
           @Html.DropDownList("numYear", null, "Select", new { @class = "form-control" })
                         
          
                     
   
          
            </div>
        </div>


        
        <div class="form-group">
            <label class="col-lg-5 control-label">Select Quarter<span style="color:Red">(*)</span></label>
            <div class="col-lg-7">
           @Html.DropDownList("QuarterId", null, "Select", new { @class = "form-control" })
              
   
          
            </div>
        </div>


              <div class="form-group">
            <label class="col-lg-5 control-label">Particular/Item<span style="color:Red"> (*)</span></label>
            <div class="col-lg-7">
            @Html.DropDownList("ItemId", null, "Select", new { @class = "form-control" })
            </div>
        </div>


        
            <div class="form-group">
            <label class="col-lg-5 control-label">Value<span style="color:Red"> (*)</span></label>
            <div class="col-lg-7">

               @Html.TextBoxFor(model => model.numSalesData, null, new { @class = "form-control" })
            </div>
        </div>



  
              

     
                        
        <div class="form-group">
            <div class="col-lg-6 col-lg-offset-6">
                           
            <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
               @Html.ActionLink("Cancel", "ListQuarterlyReport", null, new { @class = "btn btn-default" })
            </div>
        </div>
        </fieldset>
    }
                
    </div>
</div>
 @if (ViewBag.Message != null)
 {
        <script type="text/javascript">
            window.onload = function () {
                var aa = "@ViewBag.Message";
                alert(aa);
                if (aa == "Data updated successfully !") {
                    window.location.href = '/Admin/ListQuarterlyReport';
                }
            };


        </script>
    }


<script src=" @Url.Content("~/Content/js/Admin_Quarterlyreport.js")"></script>
<script type="text/javascript">
    $("#txtData").change(function () {

        var QuarterReport = $("#txtData").val();
        if (QuarterReport == "") {
            alert("Please select Quarterly Report.");

        }
        else {


            $.ajax({
                type: 'POST',
                dataType: 'json',
                url: '/Admin/QuarterReport',
                data: { 'txtData': QuarterReport },
                success: function (result) {

                    $('#ItemId').empty();
                    if (result.Particular.length > 0) {

                        $.each(result.Particular, function (result) {
                            $('#ItemId').append($('<option/>').attr('value', this.ParticularId).text(this.ParticularDesc));
                        });

                    }

                },
                error: function () {

                    alert('Error');
                }

            });
        }



    });

</script>