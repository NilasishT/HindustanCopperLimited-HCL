@{
    ViewBag.Title = "Add Department";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}

                <div class="col-lg-8">
                  <div class="well bs-component">
                    <form class="form-horizontal" method="post">
                      <fieldset>
                        <legend> Add Department</legend>
                        <div class="form-group">
                          <label class="col-lg-4 control-label">Department Name</label>
                          <div class="col-lg-8">
                          @Html.TextBox("strDepartmentName", null, new { @class = "form-control", required = "required" })<span id="errmsg"></span>
                          
                            
                          </div>
                        </div>
                        
                        <div class="form-group">
                          <div class="col-lg-8 col-lg-offset-4">
                           
                            <button type="submit" class="btn btn-primary">Submit</button>
                             @Html.ActionLink("Cancel", "DepartmentList", null, new { @class = "btn btn-default" })
                          </div>
                        </div>
                      </fieldset>
                    </form>
                  </div>
                </div>
    @if (ViewBag.Message != null)
 {
        <script type="text/javascript">
            window.onload = function () {
                alert("@ViewBag.Message");
                window.location.href = '/Admin/DepartmentList';

            };
        </script>
    } 
                
    <script>


        $("#strDepartmentName").on("input", function () {
            LimtCharacters(this, 100, 'errmsg');
        });
       

        function LimtCharacters(txtMsg, CharLength, errmsg) {
            chars = txtMsg.value.length;
            if (chars > CharLength) {
                txtMsg.value = txtMsg.value.substring(0, CharLength);
                $("#" + errmsg).html("Max Length reached..").show().fadeOut("slow").css("color", "red");
            }
        }
 </script>          
