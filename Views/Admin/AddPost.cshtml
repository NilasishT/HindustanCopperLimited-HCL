@model Hindustancopperlimited.Models.tbl_mst_Post
@{
    ViewBag.Title = "Add Post";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}
<div class="col-lg-12">
                  <div class="well bs-component">
                 @using (Html.BeginForm("AddPost", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
                 {
                  @Html.AntiForgeryToken()
                      <fieldset>
                        <legend> <b>Add Post <span style="color:Red; font-size:14px; padding-left:60%"> ( * Fields are Mandatory )</span></b></legend>

                         <div class="row">




          <div class="col-md-12">
            <div class="card">
             <div class="row">
              <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Discipline<span style="color:Red"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                            @Html.DropDownList("Fk_Disciplineid", null, "Select", new { @class = "form-control" })

                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>   
                
                      

             <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Post Name<span style="color:Red"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                          
                            @Html.TextBoxFor(model => model.Postname, null, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
             <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>No. Of Post(Gen)</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                            
                            @Html.TextBoxFor(model => model.Postnumber_gen, null, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
                <div class="col-lg-12"></div>
             <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>No. Of Post(OBC)</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                          @Html.TextBoxFor(model => model.Postnumber_obc, null, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
               
                <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>No. Of Post(SC)</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                            @Html.TextBoxFor(model => model.Postnumber_sc, null, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>


                 <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>No. Of Post(ST)</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                             

                           @Html.TextBoxFor(model => model.Postnumber_st, null, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>


                   <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>No. Of Post(PWD)</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                            
                             @Html.TextBoxFor(model => model.Postnumber_pwd, null, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
                   <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Grade<span style="color:Red"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                            
                            @Html.TextBoxFor(model => model.Fk_intGrade, null, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
                   <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label> Pay Scale<span style="color:Red"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                             
                        @Html.TextBoxFor(model => model.Payscale, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
<div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Maximum Age For Freshers(Months)</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                             @Html.TextBoxFor(model => model.Maxage_freshers, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
                   <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Maximum Age For Experienced(Months)</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                             @Html.TextBoxFor(model => model.Maxage_exp, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>                  
                   <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Minimum Age For Freshers(Months)</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                            @Html.TextBoxFor(model => model.Minage_freshers, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>                  
                   



                 <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label> Minimum Age For Experienced(Months)</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                           @Html.TextBoxFor(model => model.Minage_exp, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>


                 <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Minimum Experience(Months)</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                            @Html.TextBoxFor(model => model.Minexp, new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
                <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Allow Fresher<span style="color:Red"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                             @Html.DropDownList("Isfresher", new List<SelectListItem> {
                                              new SelectListItem {Text="Yes",Value="Yes"},
                                              new SelectListItem {Text="No",Value="No"}
                                                                       }, "Select", new { @class = "form-control" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
                <div class="col-lg-12"></div>
                <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Compared Date<span style="color:Red"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                            @Html.TextBoxFor(model => model.dtcompareDate, null, new { @class = "form-control input-append Date" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
                <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Start Date<span style="color:Red"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                           @Html.TextBoxFor(model => model.dtstartdate, null, new { @class = "form-control input-append currentDate" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>  
                <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Expiry Date<span style="color:Red"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                           @Html.TextBoxFor(model => model.dtExpiryDate, null, new { @class = "form-control input-append currentDate" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>  

                <div class="col-lg-2">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Qualification-1</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                             
                        @Html.DropDownList("Fk_Qualification1", null, "Select", new { @style = "width:150px" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>

                <div class="col-lg-2">

                <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>AND/OR</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                             
                      @Html.DropDownList("quli1YesNo", new List<SelectListItem> {
                                              new SelectListItem {Text="AND",Value="AND"},
                                              new SelectListItem {Text="OR",Value="OR"}
                                                                       }, "Select", new { @class = "form-control"})
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                
                
                </div>

                <div class="col-lg-2">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Qualification-2</label>
                         
                         <div class="form-group">
                          <div class="col-lg-12">                          
                             
                        @Html.DropDownList("Fk_Qualification2",null, "Select", new { @style="width:150px"})
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>

                <div class="col-lg-2">

                <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>AND/OR</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                             
                       @Html.DropDownList("quli2YesNo", new List<SelectListItem> {
                                              new SelectListItem {Text="AND",Value="AND"},
                                              new SelectListItem {Text="OR",Value="OR"}
                                                                       }, "Select", new { @class = "form-control"})

                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                
                
                </div>

                 <div class="col-lg-2" style="height:220px">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Qualification-3</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                             
                        @Html.DropDownList("Fk_Qualification3", null, "Select", new { @style = "width:150px" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>


                <div class="col-lg-2">

                <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Add criteria</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                          
                             
                       <button type="button" class="btn btn-primary" id="dtnAdd">Add</button>
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                
                
                </div>


                <div class="col-lg-12" style="height:250px; text-align:center">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>                       
                         
                         <div class="form-group">
                          <div class="col-lg-12">                          
                             
                        @Html.ListBox("Fk_Qualification6")
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>


 
                
             </div>
             </div>
             </div>
             </div>

               <div class="form-group">
                          <div class="col-lg-8 col-lg-offset-4">
                           
                            <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
                             
                            
                            @* <button type="reset" class="btn btn-default">Cancel</button>*@
                             @Html.ActionLink("Cancel", "ListPost", null, new { @class = "btn btn-default" })
                             @Html.Hidden("hidQualification6")
                          </div>
                        </div>
             </fieldset>


                 }
                
                  </div>
                </div>
@if (ViewBag.Message != null)
{
    <script type="text/javascript">
         window.onload = function () {
         var aa = "@ViewBag.Message";
                alert(aa);
                if (aa == "Your data saved successfully") {
                window.location.href = '/Admin/ListPost';
                    }        
                };
    </script>
}

<script src="@Url.Content("~/Content/js/ValidationAddpost.js")"></script>


<script>
    $("#Fk_Qualification1").chosen({ allow_single_deselect: true });
    $("#Fk_Qualification2").chosen({ allow_single_deselect: true });
    $("#Fk_Qualification3").chosen({ allow_single_deselect: true });

  
    $("#dtnAdd").click(function () {
        var value = $("#Fk_Qualification1").val(); ///+ "!!" + $("#quli1YesNo").val() + "!!" + $("#Fk_Qualification2").val() + "!!" + $("#quli2YesNo").val() + "!!" + $("#Fk_Qualification3").val()
        if (value == "") {
            alert("Please select Qualification-1");
        }
        else {
            if ($("#quli1YesNo").val() != "") {
                value = value + "!!" + $("#quli1YesNo").val()
            }
            if ($("#Fk_Qualification2").val() != "") {
                value = value + "!!" + $("#Fk_Qualification2").val()
            }
            if ($("#quli2YesNo").val() != "") {
                value = value + "!!" + $("#quli2YesNo").val()
            }
            if ($("#Fk_Qualification3").val() != "") {
                value = value + "!!" + $("#Fk_Qualification3").val()
            }
        }



        $('#Fk_Qualification6').append($('<option/>').attr('value', value).text(value));
        $("#Fk_Qualification6").multipleSelect('refresh');



    });


</script>