<style>
    .tabBlock
    {
        background-color: #6f3706;
        border: solid 0px #FFA54F;
        border-radius: 5px;
        -moz-border-radius: 5px;
        -webkit-border-radius: 5px;
        max-width: 200px;
        width: 100%;
        overflow: hidden;
        display: block;
    }
    .clock
    {
        vertical-align: middle;
        font-family: Orbitron;
        font-size: 40px;
        font-weight: normal;
        color: #FFF;
        padding: 0 10px;
    }
    .clocklg
    {
        vertical-align: middle;
        font-family: Orbitron;
        font-size: 20px;
        font-weight: normal;
        color: #FFF;
    }
</style>

<script>

    $('#str_bookingbasicprice').numeric();
    $('#str_bookingproductaccept').numeric();
    $('#str_bookingquantityaccept').numeric();

    $('input[name=str_OrderStatus]').change(function () {
        
        var OrderStatus = $('input[name=str_OrderStatus]:checked').val();
        $("#str_bookingbasicprice").next("span").remove();
        $("#str_bookingproductaccept").next("span").remove();
        $("#str_bookingquantityaccept").next("span").remove();

        $("#str_bookingbasicprice").val('');
        $("#str_bookingproductaccept").val('');
        $("#str_bookingquantityaccept").val('');

        $("#str_bookingbasicprice").attr('readonly', true);
        $("#str_bookingproductaccept").attr('readonly', true);
        $("#str_bookingquantityaccept").attr('readonly', true);

        if (OrderStatus == "Approved") {
            $("#str_bookingbasicprice").attr('readonly', false);
            $("#str_bookingproductaccept").attr('readonly', false);
            $("#str_bookingquantityaccept").attr('readonly', false);
        }

    });


    
function error() {


    var noerror = 1;

    if ($('input[name=str_OrderStatus]:checked').val() == "Approved") {

        if ($("#str_bookingbasicprice").val() == "") {
            $("#str_bookingbasicprice").next("span").remove();
            $("#str_bookingbasicprice").after("<span style='color:Red'> This field is required</span>");
            noerror = 0;
        }

        if ($("#str_bookingproductaccept").val() == "") {
            $("#str_bookingproductaccept").next("span").remove();
            $("#str_bookingproductaccept").after("<span style='color:Red'> This field is required</span>");
            noerror = 0;
        }

        if ($("#str_bookingquantityaccept").val() == "") {
            $("#str_bookingquantityaccept").next("span").remove();
            $("#str_bookingquantityaccept").after("<span style='color:Red'> This field is required</span>");
            noerror = 0;
        }
    }

    

   

    if (noerror == 1) {      
        if (confirm("Are you sure ?")) {
            if ($('#tbl_mst_SpotbookingOrders')[0].checkValidity()) {                
            }
        }
        else {
            return false;
        }
    }

    if (noerror == 0) {
        return false;
    }
}

</script>


<script type="text/javascript">

    $('#myNewLink').click(function () {
        var Order = @ViewBag.Id; // get the textbox value
       

        var url = $(this).attr('href').replace("Admin", "Spotbooking") + '?Order=' + Order ; // build new url            
        location.href = url; // redirect             
        return false; // cancel default redirect
    });
</script>