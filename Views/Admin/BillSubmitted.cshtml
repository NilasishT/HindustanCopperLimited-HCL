@model IEnumerable<Hindustancopperlimited.Models.BillDetails>

@{
    ViewBag.Title = "Bill Submitted";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{
    
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="sampleTableScrolling" class="table table-hover table-bordered" >
                  <thead>
                    <tr>
                 
                        <th>	UNIT	</th>
                        @*<th>	Vendor Code	</th>
                        <th>	Vendor GST No	</th>*@
                        <th>	Contract No	</th>
                        <th>	Invoice No.	</th>
                        <th>	Invoice date	</th>
                        <th>	Invoice Amount	</th>
                        <th>	Bill Received Date	</th>
                        <th>	Remarks	</th>
                        <th>	Status in User Dept	</th>
                        <th>	Processed in User Dept	</th>


                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>                 
                     
                    <td>	@item.UNIT	</td>
                    @*<td>	@item.VendorCode	</td>
                    <td>	@item.VendorGSTNo	</td>*@
                    <td>	@item.ContractNo	</td>
                    <td>	@item.InvoiceNo	</td>
                    <td>	@item.Invoicedate	</td>
                    <td>	@item.InvoiceAmount	</td>
                    <td>	@item.BillReceivedDate	</td>
                    <td>	@item.Remarks	</td>
                    <td>	@item.StatusinUserDept	</td>
                    <td>	@item.ProcessedinUserDept	</td>


                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
