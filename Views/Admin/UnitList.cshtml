@model IEnumerable<Hindustancopperlimited.Models.Unit>

@{
    ViewBag.Title = "Unit Detail List";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{

       @Html.ActionLink("Add Unit", "UnitCreate", null, new { @class = "btn btn-primary" })
      <br />
    <br />
    
    <fieldset>
   <div>
        
        <div class="row">
          <div class="col-md-12">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered">
                  <thead>
                    <tr>
                      <th>Edit</th>
                      <th>Delete</th>
                      <th>Unit Name</th>
                      <th>Unit Code</th>
                      <th>Unit Address</th>
                      <th>Unit Contact Information</th>
                    @*  <th>Details</th>*@
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                      <td>@Html.ActionLink("Edit", "UnitEdit", new { id = item.pk_intUnitId })</td>
                      <td>@Html.ActionLink("Delete", "UnitDetailListDelete", "Admin", new { id = item.pk_intUnitId }, new { id = item.pk_intUnitId, onclick = "return confirm('Are you sure for delete?')" })</td>
                      <td> @item.strUnitName</td>
                      <td> @item.strUnitName</td>
                      <td>@item.strUnitCode</td>
                      <td>@item.strUnitAddress</td>
                      <td>@item.strContactInfo</td>
                    @*  <td>@Html.ActionLink("Details", "UnitDetails", new { id = item.pk_intUnitId })</td>*@
                       
                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
<script>
    function DeleteConfirm() {
        if (confirm("Are you sure want to delete record"))
            return true;
        else
            return false;
    }
</script>
 


   