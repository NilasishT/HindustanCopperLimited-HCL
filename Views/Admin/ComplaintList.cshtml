    <br />
    
    
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="VendorDataviewsampleTable" class="table table-hover table-bordered" >
                  <thead>
                    <tr>
                    <th>Details</th>
                     <th>Status</th>
                   <th>Vendor Code</th>
                      <th>Name of FirmCompany</th>
                      <th>Correspondence Address</th>
                      <th>Registered Office Address</th>
                      <th>Email</th>
                      <th>Mobile</th>
                      
                     @*  <th>Comments</th>*@
                      
                    </tr>
                  </thead>
                 @*<tbody>

            @foreach (var item in Model)
            {
                    <tr>
                    <td>@Html.ActionLink("Details", "VendorDetails", new { id = item.Pk_intNewVendorRegistrationID })</td>

                    @if (item.strVerify == "YES")
