<html lang="en">

  <head>

    <meta charset="utf-8">
   @* <meta http-equiv="X-UA-Compatible" content="IE=edge">*@
    <meta http-equiv="Content-Security-Policy" content="default-src *; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://www.google.com">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- CSS-->
    <link rel="stylesheet" type="text/css" href="../AdminCssJs/css/main.css?a=1">
    <title>Admin Login</title>
    <script src="@Url.Content("~/Content/js/sha.js?a=5")"></script>
    <script src="@Url.Content("~/Content/js/jquery-1.10.2.min.js")"></script>    
  </head>
  <body>
    <section class="material-half-bg">
      <div class="cover"></div>
    </section>
    <section class="login-content">
  <div style="text-align:center"><a href="@Url.Action("index", "Home")"><img src="@Url.Content("~/Content/img/logo.png")" class="img-responsive" alt="" /></a></div>  
      <div class="logo">       
        <h1 style="text-align:center">Admin Login</h1>
      </div>
     
      <div class="login-box">
        <form class="login-form" method="post" autocomplete="off" @*id = "mc-form"*@>
       
          <h3 class="login-head"><i class="fa fa-lg fa-fw fa-user"></i>SIGN IN</h3>
          <div class="form-group">
            <label class="control-label">EMAIL ID</label>
            <input type="text" placeholder="EMAIL ID" id="strEmail" name="strEmail" autofocus class="form-control" required>
          </div>
          <div class="form-group">
            <label class="control-label">PASSWORD</label>
            @Html.Hidden("strUserPwd")
            <input type="password" placeholder="Password" id="strUserPwdNew" name="strUserPwdNew" autocomplete="off" class="form-control" required>
          </div>


           <br />
          

          @*captcha*@
                          <div class="form-group">                          
                          <center>
                          <div style="font-size:30px; text-align:center;">
                         @HttpContext.Current.Session["query"].ToString()  = ? 
                         <input type="text" placeholder="Answer" name="answer" class="form-control" required>
                         <p><a href="@Url.Action("Login", "Admin")" title="Click for a new shape"> <img style="width:20%; height:10%; margin:0; padding:0" src="/Content/images/reCAPTCHA.gif" /></a></p>
                          </div>
                          </center>
                          
                        </div>

 @*captcha*@


          
          <div class="form-group btn-container">
            <button class="btn btn-primary btn-block" onclick="return error()">SIGN IN <i class="fa fa-sign-in fa-lg"></i></button>           
            
          </div>
           @*captcha*@
          <div style="color:Red; text-align:center; font-size:16px">@ViewBag.Message</div>
           @*captcha*@
        </form>
        <form class="forget-form" method="post" autocomplete="off" >
          <h3 class="login-head"><i class="fa fa-lg fa-fw fa-lock"></i>Forgot Password ?</h3>
          <div class="form-group">
            <label class="control-label">EMAIL</label>
            <input type="text" placeholder="Email" name="forEmail" class="form-control" required>
          </div>
          <div class="form-group btn-container">
            <button class="btn btn-primary btn-block">RESET <i class="fa fa-unlock fa-lg"></i></button>
          </div>
          <div class="form-group mt-20">
            <p class="semibold-text mb-0"><a id="noFlip" href="#"><i class="fa fa-angle-left fa-fw"></i> Back to Login</a></p>
          </div>
        </form>
      </div>
     
    </section>

    <script>

        function error() {
            var noerror = 1;



            if ($("#strEmail").val() == "") {
                $("#strEmail").next("span").remove();
                $("#strEmail").after("<span style='color:Red'> This field is required</span>");
                noerror = 0;
            }

            if ($("#strUserPwdNew").val() == "") {
                $("#strUserPwdNew").next("span").remove();
                $("#strUserPwdNew").after("<span style='color:Red'> This field is required</span>");
                noerror = 0;
            }
            if (noerror == 1) {

                $("#strUserPwd").val($("#strUserPwdNew").val());
                var pwdObj = document.getElementById('strUserPwdNew');
                var hashObj = new jsSHA("SHA-512", "TEXT", { numRounds: 1 });
                hashObj.update(pwdObj.value);
                var hash = hashObj.getHash("HEX");
                pwdObj.value = hash;
                if (confirm("Are you sure ?")) {

                    if ($('#SpotbookingRegistrationdetails')[0].checkValidity()) {
                        return true;
                    }
                }
                else {
                    return false;
                }

            }


            if (noerror == 0) {
                return false;



            }

        }
</script>
    

  </body>
  
    
</html>


