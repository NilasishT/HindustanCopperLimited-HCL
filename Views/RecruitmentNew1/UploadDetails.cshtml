@using Hindustancopperlimited.Controllers;
@{
    ViewBag.Title = "Upload Details";
    Layout = "~/Views/Shared/ITIDashboard.cshtml";
    bool IsShow = RecruitmentNew1Controller.CheckEmailExclude();
}

@using (Html.BeginForm("UploadDetails", "RecruitmentNew1", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{

    @Html.AntiForgeryToken()

    <div class="row" style="z-index:1; position:relative">
        <div class="col-md-12">
            <div class="card">
                <div class="row">

                    <div class="col-md-12" style="text-align:right">
                        <span style="color:Red; font-size:14px; padding-left:65%"> (*) Fields are Mandatory </span>
                    </div>

                    <div class="col-lg-12">
                        <div class="well bs-component" style="text-align:center; padding:4px;  color:#6f3706; margin:8px; border:solid 1px #6f3706">
                            <div class="form-horizontal">
                                <fieldset>
                                    <label style="font-size:medium"><b>Upload Details (Maximum file size allowed for upload 50 KB)</b></label>
                                </fieldset>
                            </div>
                        </div>
                    </div>


                    <div class="col-lg-12">
                        <div class="well bs-component">
                            <div class="form-horizontal">
                                <fieldset>

                                    <div class="form-group">
                                        <label></label>
                                        <div class="col-lg-12">
                                            <center>
                                                <table id="tbllistofplantMachinery" border="2" style="text-align:center; width:80%">
                                                    <tr>
                                                        <td class="col-lg-4"><b>Type</b></td>
                                                        <td class="col-lg-4"><b>Upload (Size Upto 50 KB)</b></td>
                                                        <td class="col-lg-4"><b>View Upload</b></td>
                                                    </tr>

                                                    <tr>
                                                        <td style="text-align:left; font-weight:bold">Photo <span style="color:#C00000"> (*)</span></td>
                                                        <td><input type="file" id="str_uploadphoto" name="str_uploadphoto" onchange="readURL(this,'blah');" accept="image/*" /></td>
                                                        <td><img id="blah" src="@ViewBag.Photo" width="100px" ; height="100px" ; /></td>
                                                        @Html.Hidden("hdPhoto")
                                                        @Html.Hidden("hdSignature")
                                                    </tr>
                                                    <tr>
                                                        <td style="text-align:left; font-weight:bold">Signature <span style="color:#C00000"> (*)</span></td>
                                                        <td><input type="file" id="str_uploadsignature" name="str_uploadsignature" onchange="readURL(this,'blah1');" accept="image/*" /></td>
                                                        <td><img id="blah1" src="@ViewBag.Signature" width="100px" height="100px" /></td>
                                                    </tr>

                                                </table>
                                            </center>
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-12" style="border-top:1px solid #6f3706">
                    </div>

                    <div class="col-lg-12" style="padding-top:10px">
                        <div class="form-group">
                            <div class="col-lg-10 col-lg-offset-5">
                                @if (ViewBag.IsFinalSubmit != "Yes")
                                {
                                    <button type="submit" class="btn btn-primary" onclick="return error()" value="Submit" name="strSubmit" id="Submit">Save & Next</button>
                                }
                                <button type="button" class="btn btn-primary" onclick="location.href = '../Dashboard/@Url.RequestContext.RouteData.Values["id"]';" value="Submit" name="strSubmit">Dashboard</button>
                            </div>
                        </div>

                    </div>


                </div>
            </div>
        </div>
    </div>
}

<script src="@Url.Content("~/Content/js/RecruitementUploadDetails.js?a=bhashkarghosjh011")"></script>

<script>
    $("#hdPhoto").val('@ViewBag.Photo');
    $("#hdSignature").val('@ViewBag.Signature');
</script>