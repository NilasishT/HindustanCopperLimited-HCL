        <!-- IP / PRINT ROW
    <div class="ip-print-row">
        <span>Your IP Address: 192.168.1.101</span>
        <span>Print Date and Time: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</span>
    </div> -->

    </div><!-- end outer-wrapper -->

        <script type="text/javascript">
            $("#dashboard").hide();
            window.print();
            var afterPrint = function () { $("#dashboard").show(); };
            window.onafterprint = afterPrint;
        </script>
</body>
</html>
