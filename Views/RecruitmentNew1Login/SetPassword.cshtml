@model Hindustancopperlimited.Models.tbl_mst_CandidateRegistrationForRecruitment

@{
    ViewBag.Title = "Set Password";
    Layout = "~/Views/Shared/ITIDashboard.cshtml";
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <fieldset>
        <legend><b><span style="color:#6f3706; font-size:24px; padding-left:35%">Set Password</span>   <span style="color:Red; font-size:14px; padding-left:25%"> (*) Fields are Mandatory </span></b></legend>
        <br />
        <br />
        <br />
        <div class="row">


            <div class="col-md-12">
                <div class="col-lg-2">
                </div>

                <div class="col-lg-2">
                    <div class="well bs-component">
                        <div class="form-horizontal">
                            <fieldset>
                                <label>New Password <span style="color:Red"> (*)</span></label>
                            </fieldset>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="well bs-component">
                        <div class="form-horizontal">
                            <fieldset>

                                <div class="form-group">
                                    <div class="col-lg-5">
                                        <input id="strUserPwd" type="password" name="strUserPwd" class="form-control" required>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>



            </div>

            <div class="col-md-12">
                <div class="col-lg-2">
                </div>
                <div class="col-lg-2">
                    <div class="well bs-component">
                        <div class="form-horizontal">
                            <fieldset>
                                <label>Re-Password <span style="color:Red"> (*)</span></label>
                            </fieldset>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="well bs-component">
                        <div class="form-horizontal">
                            <fieldset>

                                <div class="form-group">
                                    <div class="col-lg-5">
                                        <input id="strUserRePwd" type="password" name="strUserRePwd" class="form-control" required>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>


            </div>
            <div class="col-lg-12">
                <div class="form-group">
                    <div class="col-lg-10 col-lg-offset-5">
                        <button type="reset" class="btn btn-default">Cancel</button>
                        <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
                    </div>
                </div>

            </div>


        </div>

    </fieldset>
}

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
            window.onload = function () {
                alert("@ViewBag.Message");
                window.location.href = '/RecruitmentNew1Login/CandidateLogin';

            };
    </script>
}

<script src="@Url.Content("~/Content/js/SetPassword.js?a=5")"></script>