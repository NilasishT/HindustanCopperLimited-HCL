@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        window.onload = function () {
            var aa = "@ViewBag.Message";
            alert(aa);
            if (aa == "Data saved successfully !") {
                window.location.href = '/Spotbooking/Dashboard';
            }
        };
    </script>
    
    
}





<script type="text/javascript">

    $('#myNewLink').click(function () {
        var Order = @ViewBag.Id; // get the textbox value
       

        var url = $(this).attr('href') + '?Order=' + Order ; // build new url            
        location.href = url; // redirect             
        return false; // cancel default redirect
    });
</script>






