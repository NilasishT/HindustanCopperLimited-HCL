<script src=" @Url.Content("~/Content/js/ValidationSpotbookingOrderBooking.js?a=0")"></script>
<script type="text/javascript">


    $('#fltProductPrice').numeric();
    $('#fltBookedQuantity').numeric();

    var dt = new Date();
    var ampm = ($("#hidCurrenth").val() >= 12) ? "PM" : "AM";


    if ($("#hidCurrenth").val() > 12) {
        var hourstwelve = parseInt($("#hidCurrenth").val()) - 12;
        $("#hidCurrenth").val("0" + hourstwelve)
    }

    $("#tmRealBookingTimeh").val($("#hidCurrenth").val());
    $("#tmRealBookingTimem").val($("#hidCurrentm").val());
    $("#tmRealBookingTimes").val($("#hidCurrents").val());
    $("#tmRealBookingTimeampm").val(ampm);

    $('#strComments').on('keypress', function (e) {
        var regex = new RegExp("^[a-zA-Z ]*$");
        var str = String.fromCharCode(!e.charCode ? e.which : e.charCode);
        if (regex.test(str)) {
            return true;
        }
        e.preventDefault();
        return false;
    });

    
    $("#strProducts").change(function () {
        var Products = $("#strProducts").val();


        if (Products == "") {
            alert("Please select Product.");

        }
        else {


            $.ajax({
                type: 'POST',
                dataType: 'json',
                url: '/Spotbooking/TenderProduct',
                data: { 'Products': Products },
                success: function (result) {

                    $("#fltProductPrice").next("p").remove();
                    $("#fltBookedQuantity").next("p").remove();
                    $("#hidfltProductPrice").val('');
                    $("#hidfltBookedQuantity").val('');


                    if (result.Quantity != "") {
                        $("#fltBookedQuantity").after("<p style='color:red; font-weight:bold'> Tender Qty. is : " + result.Quantity + "</p>");
                        $("#hidfltBookedQuantity").val(result.Quantity);
                    }
                    if (result.ResevedPrice != "") {
                        $("#fltProductPrice").after("<p style='color:red; font-weight:bold'> Reserve Price is : " + result.Currency + " " + result.ResevedPrice + "</p>");
                        $("#hidfltProductPrice").val(result.ResevedPrice);
                    }

                },
                error: function () {

                    alert('Error');
                }

            });
        }



    });
        

    $("#strOrderType").change(function () {

        var OrderType = $("#strOrderType").val();


        if (OrderType == "") {
            alert("Please select Type.");

        }
        else {


            $.ajax({
                type: 'POST',
                dataType: 'json',
                url: '/Spotbooking/Real',
                data: { 'strOrderType': OrderType },
                success: function (result) {

                    $('#strOrderOption').empty();                    

                    if (result.Post.length > 0) {                        

                        if (result.Real == 0) {
                            $('#hidPrice').val('');
                            $('#fltProductPrice').val('');
                            $('#fltProductPrice').attr('readonly', true);
                            $("#fltProductPrice").next("span").remove();

                            $('#tmRealBookingTimeh').attr('disabled', true);
                            $('#tmRealBookingTimem').attr('disabled', true);
                            $('#tmRealBookingTimes').attr('disabled', true);
                            $('#tmRealBookingTimeampm').attr('disabled', true);

                        }
                        else {                            

                            $('#hidPrice').val('required');
                            $('#fltProductPrice').attr('readonly', false);

                            $('#tmRealBookingTimeh').attr('disabled', false);
                            $('#tmRealBookingTimem').attr('disabled', false);
                            $('#tmRealBookingTimes').attr('disabled', false);
                            $('#tmRealBookingTimeampm').attr('disabled', false);
                        }

                        $('#strOrderOption').append($('<option/>').attr('value', "0").text("Select"));
                        $.each(result.Post, function (result) {
                            $('#strOrderOption').append($('<option/>').attr('value', this.str_lmedescription).text(this.str_lmedescription));
                        });

                    }




                },
                error: function () {

                    alert('Error');
                }

            });
        }



    });

</script>

 
