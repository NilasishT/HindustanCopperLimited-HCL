@model Hindustancopperlimited.Models.SpotbookingRegistrationdetails

@{
    ViewBag.Title = "User Login";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}


 <br />
  <br /> 
  <br />
  <br />         
<div class="col-lg-12">
    <div class="well bs-component">            
@using (Html.BeginForm("Login", "Spotbooking", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", @autocomplete = "off"}))

{
   
    <fieldset>
    <legend><b><span style="color:#6f3706; font-size:24px; padding-left:40%">User Login</span>   <span style="color: #C00000; font-size: 14px; padding-left: 25%"> (*) Fields are Mandatory </span></b></legend>
    <br />
    <br />
    <br />

                     
                        <div class="form-group">
                          <label class="col-lg-4 control-label">User Id <span style="color: #C00000"> (*)</span></label>
                          <div class="col-lg-3">
                           
                             @Html.TextBoxFor(model => model.str_code, null, new { @class = "form-control", aria_label = "User Id", placeholder = "Enter User Id" })
                            
                          </div>
                        </div>
    
   
    
       <div class="form-group">
                          <label class="col-lg-4 control-label">Password <span style="color: #C00000"> (*)</span></label>
                          <div class="col-lg-3">
                            @Html.HiddenFor(model => model.str_pw, new { @class = "form-control", aria_label = "Password", placeholder = "Enter Password " })
                             @Html.Password("str_pwNew",null, new { @class = "form-control", @autocomplete = "off", aria_label = "Password", placeholder = "Enter Password " })
                            
                          </div>
                        </div>
      
    
     @*captcha*@
                          <div class="form-group">  
                          <center>
                          <div style="font-size:30px; text-align:center;" class="col-lg-4 col-lg-offset-4">
                         @HttpContext.Current.Session["query"].ToString()  = ? 
                         <input type="text" aria-label="Answer" placeholder="Answer" name="answer" class="form-control" required>
                         <p><a href="@Url.Action("Login", "Spotbooking")" title="Click for a new shape"> <img alt="Click for a new shape" style="width:20%; height:10%; margin:0; padding:0" src="/Content/images/reCAPTCHA.gif" /></a></p>
                          </div>
                          </center>
                          
                        </div>

 @*captcha*@
    
    
    
    
        <div class="form-group">
                          <div class="col-lg-4 col-lg-offset-4">
                           
                               <a href="@Url.Action("ForgotPassword", "Spotbooking")" style="color:Blue ; font-size:large ; font-style:inherit" > Forgot Password ?</a>
                            
                          </div>
                        </div>
                        <div class="form-group">
                          <div class="col-lg-6 col-lg-offset-4">
                           
                             <button type="submit" class="btn btn-primary" onclick="return error()" style="background-color:#6f3706">Log in</button>
                             @*<input disabled="disabled" autocomplete="false" type="submit" value="Log in" class="btn btn-primary" style="background-color:#6f3706" onclick="return error()">*@
                    

                     <a href="@Url.Action("SpotbookingRegistration", "Spotbooking")"> <button type ="button" class="btn btn-primary" style="background-color: #b36200; color: #ffffff;">New User</button></a>
                      @* <button type="reset" class="btn btn-default">Cancel</button>*@

                     @* <a href="@Url.Action("ForgotPassword")">    <button type ="button" class="btn btn-primary">Forgot Password</button></a>*@
                      
                          </div>
        </div>

         <div class="form-group">
                          <div class="col-lg-4 col-lg-offset-4" style="font-size:medium; color:Red">
       <b>@ViewBag.Message</b></div>

      </fieldset>   
    }
               
    </div>
</div>




<script src="@Url.Content("~/Content/js/Spotbookinglogin validation.js")"></script>





