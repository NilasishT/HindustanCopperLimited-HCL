@model Hindustancopperlimited.Models.SpotbookingRegistrationdetails

@{
    ViewBag.Title = "Forgot Password";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}
<br />
      
<div class="col-lg-10">
    <div class="well bs-component"> 

            
@using (Html.BeginForm("ForgotPassword", "Spotbooking", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))

{
    <fieldset>
    <legend><b><span style="color:#6f3706; font-size:24px; padding-left:35%">Forgot Password</span>   <span style="color:Red; font-size:14px; padding-left:25%"> (*) Fields are Mandatory </span></b></legend>
    <br />
    <br />
    <br />
                      <div class="form-group">
                          <label class="col-lg-4 control-label">Email <span style="color:Red"> (*)</span></label>
                          <div class="col-lg-3">
                           
                             @Html.TextBoxFor(model => model.str_email, null, new { @class = "form-control" })<span style="color:Maroon; font-size:small" ><b>Password will be send your email</b> </span>
                            
                          </div>
                        </div>
    
        
        
        
    

        
                        <div class="form-group">
                          <div class="col-lg-6 col-lg-offset-4">
                           
                       
                         <button type="submit" class="btn btn-primary" onclick="return error()" style="background-color:#6f3706">Submit</button>
                <button type="reset" class="btn btn-default" style="background-color:#777;color:#fff;">Reset</button>
                 

                  @*   <a href="@Url.Action("ListTender")"> <button type ="button" class="btn btn-primary">ViewList</button></a>*@

                                                </div>
        </div>
      </fieldset>   
}
               
    </div>
</div>



                


@if (ViewBag.Message != null)
{
        <script type="text/javascript">
            window.onload = function () {
                var aa = "@ViewBag.Message";
                alert(aa);
                if (aa == "Password will be send.Please check your email.") {
                    window.location.href = '/Spotbooking/Login';
                }
            };
        </script>
}
 <script src="@Url.Content("~/Content/js/Spotbookingforgotpassword.js")"></script>




