                    <div class="minImgDiv---" style="margin:0 auto">
                        <img class="minImgPM" src="@Url.Content("~/Content/img/HomePage/sri-narendra-modi.png")" alt="Sri Narendra Modi">
                    </div>
                    <p class="minDeg" style="color:#6f3706">Shri Narendra Modi</p>
                    <p class="minName" style="color:#6f3706; font-weight:600;font-size:12px;">Hon'ble Prime Minister</p>

                </div>

            </div>


            <div class="col-lg-6 col-md-12 col-sm-12" style="padding-top:5%">

                <div style="width:100%; float:left; background-color:#fff; border:2px solid #C30;">

                    <div class="aboutus_area wow fadeInLeft wow fadeInUp" style="padding-top:2%;">
                        <h1 class="titile" style="padding:0 6%;">Welcome to Hindustan Copper Limited</h1>
                        <p style="padding: 0px 8%; font-size: 16px; color: #935116; font-weight: 600; ">A Government of India Enterprise under the Ministry of Mines</p>
                        <p style="padding:0 8%;">
                            Incorporated on 9 November 1967, HCL is India's only copper producer that handles every stage itself, from mining to finished products. We mine copper ore, process it to increase its copper content (called beneficiation), melt it (smelting), purify it (refining) and cast it into copper products ready for sale. Our operating units are at Khetri (Rajasthan), Malanjkhand (Madhya Pradesh), Ghatsila (Jharkhand), Taloja (Maharashtra) and Jhagadia (Gujarat), with the Corporate Office in Kolkata (West Bengal).
                        </p>
                        @*<a href="@Url.Action("CompanyProfile", "Page")" class="blog_readmore" aria-label="Read more about Hindustan Copper Company Profile"> read more </a>*@
                        <!-- #region MySection -->

                    <button type="button"
                            class="btn btn-default read-more-default"
                            aria-label="Read more about Hindustan Copper Company Profile"
                            onclick="window.location.href='@Url.Action("CompanyProfile", "Page")'">
                        Hindustan Copper Limited — Company profile
                    </button>
                        @*Button Change-Suravi*@



                        <!-- #endregion -->
                    </div>

                </div>


            </div>

            <div class="col-lg-3 col-md-12 col-sm-12">

                <div style="width:100%; float:left; text-align:center; margin-top:4%;">
                    <div class="minImgDiv">

                        <img class="minImg" src="@Url.Content("~/Content/img/ShriGKishanReddy.jpg")" alt="Shri G. Kishan Reddy, Minister of Coal and Mines"> @*alt="minister"*@
                        @*<img class="minImg" src="@Url.Content("~/Content/img/HomePage/PJoshiHnew.png")" alt="minister">*@
                    </div>
                    <p class="minDeg" style="color:#6f3706;">Shri G. Kishan Reddy</p>
                    <p class="minName" style="color:#6f3706; font-weight:600;font-size:12px;">Hon'ble Minister of Coal and Mines</p>

                </div>

                <div style="width:100%; float:left; text-align:center; margin-top:4%;">
                    <div class="minImgDiv">
                        @*<img class="minImg" src="@Url.Content("~/Content/img/HomePage/RaosahebPatilDanve.png")" alt="minister">*@
                        <img class="minImg" src="@Url.Content("~/Content/img/SatishChandraDubey.jpg")" alt="Satish Chandra Dubey Minister of Coal and Mines">
                    </div>
                    <p class="minDeg" style="color:#6f3706;">Shri Satish Chandra Dubey</p>
                    <p class="minName" style="color:#6f3706; font-weight:600;font-size:12px;">Hon'ble Minister of State of Coal and Mines</p>

