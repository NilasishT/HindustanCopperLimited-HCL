                                                                onclick="newPopup('/Page/TenderListforDetails/@item.pk_intTenderId')">
                                                            Tender list — view document
                                                        </button>
                                                            }
                                                            else
                                                            {
                                                                if (@item.strFileUpload != null)
                                                                {
                                                                    @*<a class="text-warning pull-right" href=@item.strFileUpload.Replace("~", "../..") target="_blank" aria-label="Read more about tender list page"> [Read More]</a>*@

                                                        <button type="button"
                                                                class="btn btn-default read-more-default"
                                                                aria-label="Read more about tender list page"
