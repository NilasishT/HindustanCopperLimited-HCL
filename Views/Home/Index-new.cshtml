<section id="events">
  <div class="row">
    <div class="col-lg-12 col-sm-12">
      <div class="container">
        <div class="row">
          <div class="col-lg-12 col-md-12">
            <div class="title_area">
              <h2 class="title_two">Events</h2>
            </div>
            <div class="container">
              <div class="row">
                <div class='col-md-offset-2 col-md-8 text-center'> 
                  <!--<h2>Responsive Quote Carousel BS3</h2>--> 
                </div>
              </div>
              <div class="carousel slide" data-ride="carousel" id="quote-carousel"> 
                <!-- Bottom Carousel Indicators -->
                <ol class="carousel-indicators">
                 @foreach (var events in ViewBag.Events)
                 {
                     if (countEvent == 0)
                     {
                  <li data-target="#quote-carousel" data-slide-to="0" class="active"></li>
                     }
                     else
                     {
                  <li data-target="#quote-carousel" data-slide-to=@countEvent></li>
                     }
                     countEvent++;
                 }
                     
                 @* <li data-target="#quote-carousel" data-slide-to="2"></li>*@
                </ol>
                
                <!-- Carousel Slides / Quotes -->
                <div class="carousel-inner"> 
                  

                  <!-- Quote 1 -->


                  @foreach (var events in ViewBag.Events)
                  {
                      if (count == 0)
                      {
                  <div class="item active">
                    <blockquote>
                      <div class="row">
                        <div class="col-sm-3 col-xs-4 text-center"> <img src="@events.strImageFileEnglish.Replace("~", "../..").Replace(" ", "%20")"  alt="Image" style="width:138px; height:190px"> 
                          
                        </div>
                        <div class="col-sm-9 col-xs-8">
                          <h3>@events.strSubjectdfsEnglish</h3>
                          <p>@events.strDescriptiondfsEnglish</p>
                           <small><a href="@Url.Action("Events", "Page")" class=" btn btn-default text-center" aria-label="Read more about Hindustan Copper Awards" > Read More </a></small> </div>
                      </div>
                    </blockquote>
                  </div>
                      }
                      else
                      {
                          <div class="item">
                    <blockquote>
                      <div class="row">
                        <div class="col-sm-3 col-xs-4 text-center"> <img src="@events.strImageFileEnglish.Replace("~", "../..").Replace(" ", "%20")" alt="Image" style="width:138px; height:190px">                         
                        </div>
                        <div class="col-sm-9 col-xs-8">
                          <h3>@events.strSubjectdfsEnglish</h3>
                          <p>@events.strDescriptiondfsEnglish</p>
                          <small><a href="@Url.Action("Events", "Page")" class=" btn btn-default text-center" aria-label="Read more about Hindustan Copper Awards" > Read More </a></small> </div>
                            
                      </div>
                    </blockquote>
                  </div>
                      }
                      count++;
                  }
                  
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
