                  <td> @item.strSnippet <br />
                  @if (@item.strType == "T")
                  {
                  <a class="text-warning pull-right" href="JavaScript:newPopup('/Page/TenderListforDetails/@item.pk_intTenderId');" aria-label="Read more about tender list page"> [Read More]</a>
                  }
                  else
                  {
                      if (@item.strFileUpload != null)
                      {
                      <a class="text-warning pull-right" href=@item.strFileUpload.Replace("~", "../..") target="_blank" aria-label="Read more about tender list page"> [Read More]</a>
                      }
                  }
                   </td>
                </tr>
              </table>
            </li>
            }
  
          </ul>
        </div>
      </div>
    </div>
    <div class="panel-footer"> </div>
