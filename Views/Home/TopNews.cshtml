@model IEnumerable<Hindustancopperlimited.Models.tbl_mst_News>


    <style>
        /* News ticker: keep each news item together */
        .hcl-news-ticker .hcl-news-item {
            display: inline-flex;
            align-items: center;
            white-space: nowrap;
            vertical-align: middle;
        }

        .hcl-news-ticker .hcl-news-item a {
            display: inline-flex;
            align-items: center;
            white-space: nowrap;
            text-decoration: none;
        }

        .hcl-news-ticker .hcl-news-icon {
            display: inline-block;
            flex-shrink: 0;
            width: auto;
            height: auto;
            margin-right: 4px;
            vertical-align: middle;
        }

        .hcl-news-ticker .hcl-news-text {
            display: inline;
            white-space: nowrap;
            line-height: 1.5;
        }

        .hcl-news-ticker .hcl-news-separator {
            display: inline-block;
            white-space: pre;
            flex-shrink: 0;
        }
    </style>
    <div class="clear"></div>
    <div style="margin-top:20px">

        <div class="marquee-with-options hcl-news-ticker">

            @foreach (var item in Model)
            {
                if (Session["Page"] == "Hindi")
                {
                    if (!string.IsNullOrEmpty(item.strFileHindi))
                    {
                        <span class="hcl-news-item">
                            <a href="@item.strFileHindi.Replace("~", "../..")"
                               target="_blank">
                                <img src="@Url.Content("~/Content/img/New.gif")"
                                     alt="New"
                                     class="hcl-news-icon" />
                                <span class="hcl-news-text">@item.strSubjectdfshindi</span>
                            </a>
                            <span class="hcl-news-separator">&nbsp; | &nbsp;</span>
                        </span>
                    }
                }
                else
                {
                    if (!string.IsNullOrEmpty(item.strFileEnglish))
                    {
                        <span class="hcl-news-item">
                            <a href="@item.strFileEnglish.Replace("~", "../..")"
                               target="_blank">
                                <img src="@Url.Content("~/Content/img/New.gif")"
                                     alt="New"
                                     class="hcl-news-icon" />
                                <span class="hcl-news-text">@item.strSubjectdfsEnglish</span>
                            </a>
                            <span class="hcl-news-separator">&nbsp; | &nbsp;</span>
                        </span>
                    }
                }
            }

        </div>
        

    </div>
 


    <script >


        function newPopup(url) {
            var h = 700;
            var w = 900;
            var y = window.outerHeight / 2 + window.screenY - (h / 2)
            var x = window.outerWidth / 2 + window.screenX - (w / 2)
            popupWindow = window.open(url, "Tender List", 'toolbar=no, location=no, directories=no, status=no, menubar=no, scrollbars=yes, resizable=no, copyhistory=no, width=' + w + ', height=' + h + ', top=' + y + ', left=' + x);

            //popupWindow = window.open(url, 'popUpWindow', 'height=500,width=800,left=10,top=10,resizable=yes,scrollbars=yes,toolbar=yes,menubar=no,location=no,directories=no,status=yes')
        }
</script>
