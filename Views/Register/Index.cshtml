@{
    ViewBag.Title = "Sign UP";
    Layout = "~/Views/Shared/DashboardWithoutSideBar.cshtml";
}

   <div class="col-lg-10">
                  <div class="well bs-component">
                    <form class="form-horizontal" method="post">
                      <fieldset>
                        <legend>Vendor Initial Registration Form</legend>

                        <div class="form-group">
                          <label for="inputEmail" class="col-lg-2 control-label">First Name</label>
                          <div class="col-lg-10">
                            <input id="inputFirstName" type="text" placeholder="Enter First Name" name="strFirstName" class="form-control">
                            
                          </div>
                        </div>
                        <br />

                        <div class="form-group">
                          <label for="inputEmail" class="col-lg-2 control-label">Middle Name</label>
                          <div class="col-lg-10">
                            <input id="inputMiddleName" type="text" placeholder="Enter Middle Name" name="strMiddleName" class="form-control">
                            
                          </div>
                        </div>
                        
                        <br />
                        
                        <div class="form-group">
                          <label for="textArea" class="col-lg-2 control-label">Last Name</label>
                          <div class="col-lg-10">
                            
                             <input id="inputLastName" type="text" placeholder="Enter Last Name" name="strLastName" class="form-control">
                          </div>
                        </div>
                       
                       <br />
                         <div class="form-group">
                          <label for="textArea" class="col-lg-2 control-label">User Name</label>
                          <div class="col-lg-10">
                           

                              <input id="txtuserName" type="text" placeholder="Enter User Name" name="struserName" class="form-control">
                          </div>
                        </div>
                        <br />

                        <div class="form-group">
                          <label for="textArea" class="col-lg-2 control-label">Mobile</label>
                          <div class="col-lg-10">
                           
                            <input id="txtstrMobile" type="text" placeholder="Enter Mobile Number" name="strMobile" class="form-control">
                          </div>
                        </div>

                        <br />
                        <div class="form-group">
                          <label for="textArea" class="col-lg-2 control-label">Email</label>
                          <div class="col-lg-10">
                           

                             <input id="txtEmail" type="text" placeholder="Enter Email" name="strEmail" class="form-control">
                          </div>
                        </div>
                        <br />
                        
                        <div class="form-group">
                          <div class="col-lg-10 col-lg-offset-2">
                            <button type="reset" class="btn btn-default">Cancel</button>
                            <button type="submit" class="btn btn-primary">Submit</button>
                          </div>
                        </div>
                      </fieldset>
                    </form>
                  </div>
                </div>