                                <th style="border: 1px solid #000;text-align: center; padding: 3px; ">Eligible for</th>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000;text-align: center; padding: 3px; ">1</td>
                                <td style="border: 1px solid #000; text-align: center; padding: 3px;">Graduate Engineer Trainee [E1] </td>
                                <td style="border: 1px solid #000; text-align: center; padding: 3px;">Rail AC III Tier </td>
                            </tr>

                        </tbody>
                    </table>
