@model Hindustancopperlimited.Models.AdvId99_CandidateDetails
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admit Card / प्रवेश पत्र</title>
    <link rel="stylesheet" type="text/css" href="https://www.hindustancopper.com/Content/css/bootstrap.min.css?a=2">
    <script src="@Url.Content("~/Content/js/jquery-1.10.2.min.js")"></script>
    <style type="text/css">
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            margin: 0;
            padding: 0;
            background: #fff;
        }

        /* ── OUTER WRAPPER ── */
        .outer-wrapper {
            width: 900px;
            margin: 0 auto;
            border: 2px solid #000;
            padding: 0;
        }

        /* ── HEADER ── */
        .header-table {
            width: 100%;
            border-collapse: collapse;
            border-bottom: 2px solid #000;
        }

        .header-logo-cell {
            width: 15%;
            padding: 5px 8px;
            vertical-align: middle;
            text-align: center;
            border-right: 1px solid #999;
        }

        .header-logo-cell img {
            width: 85px;
            height: auto;
        }

        .header-logo-cell .cin {
            font-size: 9px;
            margin-top: 3px;
        }

        .header-title-cell {
            text-align: center;
            padding: 5px 8px;
            vertical-align: middle;
        }

        .header-title-cell h2 {
            margin: 0 0 2px 0;
            font-size: 16px;
            font-weight: bold;
            color: #8B0000;
        }

        .header-title-cell h2 span {
            font-size: 13px;
        }

        .header-title-cell .advt-no {
            font-size: 11px;
            font-weight: bold;
            margin-top: 2px;
        }

        .header-title-cell .exam-title {
            font-size: 12px;
            font-weight: bold;
            margin-top: 2px;
            line-height: 1.4;
        }

        /* ── ADMIT CARD TITLE BAR ── */
        .admit-title-bar {
            background: #8B0000;
            color: #fff;
            text-align: center;
            padding: 4px 0;
            font-size: 14px;
            font-weight: bold;
            letter-spacing: 1px;
            border-bottom: 2px solid #000;
        }

        /* ── NOTE BLOCK ── */
        .note-block {
            border: 1px solid #999;
            margin: 5px 8px;
            padding: 5px 8px;
            font-size: 10.5px;
            line-height: 1.45;
            background: #fffbe6;
        }

        .note-block b {
            color: #8B0000;
        }

        /* ── CANDIDATE DETAILS OUTER ── */
        .details-outer {
            padding: 4px 8px 0 8px;
        }

        /* ── MAIN LAYOUT TABLE (candidate info + photo) ── */
        .main-layout-table {
            width: 100%;
            border-collapse: collapse;
        }

        /* ── EXAM/CANDIDATE INFO TABLE ── */
        .exam-table {
            width: 100%;
            border-collapse: collapse;
        }

        .exam-table td {
            border: 1px solid #aaa;
            padding: 3px 6px;
            font-size: 11px;
            vertical-align: middle;
        }

        .exam-table .lbl {
            font-weight: bold;
            background: #f2f2f2;
            width: 45%;
            line-height: 1.3;
        }

        /* ── PHOTO / SIGNATURE CELL ── */
        .photo-sig-cell {
            width: 22%;
            text-align: center;
            font-size: 10px;
            font-weight: bold;
            vertical-align: top;
            border: 1px solid #aaa;
            padding: 5px;
            background: #fafafa;
        }

        .photo-box {
            border: 1px solid #ccc;
            height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            margin-bottom: 3px;
        }

        .photo-box img {
            max-height: 98px;
            max-width: 100%;
            object-fit: contain;
        }

        .sig-box {
            border: 1px solid #ccc;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .sig-box img {
            max-height: 43px;
            max-width: 100%;
            object-fit: contain;
        }

        .photo-label {
            font-weight: bold;
            font-size: 10px;
            margin-bottom: 3px;
        }

        .sig-label {
            font-weight: bold;
            font-size: 10px;
            margin: 5px 0 3px 0;
        }

        /* ── DECLARATION ── */
        .declaration-section {
            margin: 5px 8px;
            border: 1px solid #aaa;
            padding: 5px 8px;
            font-size: 10.5px;
            line-height: 1.45;
        }

        .declaration-section .dec-title {
            font-weight: bold;
            font-size: 11px;
            text-align: center;
            margin-bottom: 4px;
            color: #8B0000;
        }

        /* ── HANDOVER NOTE ── */
        .handover-note {
            margin: 4px 8px;
            font-size: 10px;
            font-style: italic;
            color: #333;
            text-align: center;
            border-top: 1px dashed #999;
            padding-top: 4px;
            line-height: 1.4;
        }

        /* ── IP / PRINT ── */
        .ip-print-row {
            display: flex;
            justify-content: space-between;
            font-size: 9px;
            color: #666;
            padding: 2px 10px;
            border-top: 1px solid #ddd;
        }

        /* ── INSTRUCTIONS PAGE ── */
        .instructions-wrapper {
            width: 900px;
            margin: 10px auto 0 auto;
            border: 2px solid #000;
            padding: 10px 14px;
        }

        .instructions-wrapper h3 {
            text-align: center;
            color: #8B0000;
            font-size: 13px;
            margin: 0 0 6px 0;
            line-height: 1.4;
        }

        .instructions-wrapper h3 span {
            font-size: 12px;
            display: block;
            color: #000;
        }

        .instructions-wrapper ol {
            padding-left: 18px;
            margin: 0;
        }

        .instructions-wrapper ol li {
            font-size: 11px;
            line-height: 1.55;
            margin-bottom: 5px;
        }

        .instructions-wrapper ol li .hindi-li {
            display: block;
            color: #444;
            font-size: 10.5px;
            margin-top: 1px;
        }

        /* ── PRINT ── */
        media print {
           page {
                size: A4;
                margin: 8mm;
            }

            body {
                font-size: 9pt;
            }

            .outer-wrapper,
            .instructions-wrapper {
                width: 100%;
                border: 1.5px solid #000;
            }
        }
    </style>
</head>
<body>

    <!-- ════════════════════════════════════════════
         ADMIT CARD
    ════════════════════════════════════════════ -->
    <div class="outer-wrapper">

        <!-- HEADER -->
        <table class="header-table" cellspacing="0" cellpadding="0">
            <tr>
                <td class="header-logo-cell">
                    <img src="https://i.ibb.co/1mwnq6n/logo-Hindustan.png" alt="HCL Logo">
                    <div class="cin">CIN No. : L27201WB1967GO1028825</div>
                </td>
                <td class="header-title-cell">
                    <h2>HINDUSTAN COPPER LIMITED <span>/ हिंदुस्तान कॉपर लिमिटेड</span></h2>
                    <div class="advt-no">Estt. /1/2029/2025-26</div>
                    <div class="exam-title">
                        Computer Based Examination for appointment on Supervisory (E0 Grade) posts<br>
                        <span style="font-size:11px;font-weight:normal;">पर्यवेक्षक (E0 ग्रेड) पदों पर नियुक्ति हेतु कंप्यूटर आधारित परीक्षा</span>
                    </div>
                </td>
            </tr>
        </table>

        <!-- ADMIT CARD TITLE BAR -->
        <div class="admit-title-bar">ADMIT CARD &nbsp;/&nbsp; प्रवेश पत्र</div>

        <!-- NOTE -->
        <div class="note-block">
            <b>NOTE:</b> This admit card is provisionally issued to you solely on the basis of the particulars provided by you in the online application form for the post mentioned hereunder to appear in the Computer Based Examination. Mere issuance of this Admit Card shall not necessarily make you eligible for the post applied automatically. Your documents regarding eligibility for the post as per the recruitment notification will be scrutinized subsequently after the CBT Examination. In the event of you not meeting the eligibility criteria as per the recruitment notification for the post, your candidature shall be rejected.<br>
            <b>नोट:</b> यह प्रवेश पत्र आपको केवल आपके द्वारा ऑनलाइन आवेदन पत्र में उपलब्ध कराई गई जानकारी के आधार पर कंप्यूटर आधारित परीक्षा में सम्मिलित होने हेतु अस्थायी रूप से जारी किया गया है। केवल इस प्रवेश पत्र का जारी किया जाना आपको आवेदन किए गए पद हेतु स्वतः पात्र नहीं बनाता है। भर्ती अधिसूचना के अनुसार पद हेतु आपकी पात्रता से संबंधित दस्तावेजों की जांच CBT परीक्षा के बाद की जाएगी। यदि आप भर्ती अधिसूचना के अनुसार पद की पात्रता शर्तों को पूरा नहीं करते पाए जाते हैं, तो आपकी अभ्यर्थिता निरस्त कर दी जाएगी।
        </div>

        <!-- CANDIDATE & EXAM DETAILS + PHOTO -->
        <div class="details-outer">
            <table class="main-layout-table" cellspacing="0" cellpadding="0">
                <tr>
                    <!-- LEFT: candidate info (78%) -->
                    <td style="width:78%; vertical-align:top; padding:0; border:none;">
                        <table class="exam-table">
                            <tr>
                                <td class="lbl">Roll Number / रोल नंबर</td>
                                <td>01245</td>
                            </tr>
                            <tr>
                                <td class="lbl">PIN Number / पिन नंबर</td>
                                <td>@Html.DisplayFor(model => model.strPin)</td>
                            </tr>
                            <tr>
                                <td class="lbl">Application Number / आवेदन संख्या</td>
                                <td>@Html.DisplayFor(model => model.strApplicationNo)</td>
                            </tr>
                            <tr>
                                <td class="lbl">Post Applied for / जिस पद के लिए आवेदन किया गया</td>
                                <td>@Html.DisplayFor(model => model.fk_diciplineid)</td>
                            </tr>
                            <tr>
                                <td class="lbl">Category / श्रेणी</td>
                                <td>@Html.DisplayFor(model => model.strCategory)</td>
                            </tr>
                            <tr>
                                <td class="lbl">Name of the Candidate / उम्मीदवार का नाम</td>
                                <td><b>@Html.DisplayFor(model => model.strApplicantName)</b></td>
                            </tr>
                            <tr>
                                <td class="lbl">Date of Birth / जन्म तिथि</td>
                                <td>@Html.DisplayFor(model => model.dtDOB)</td>
                            </tr>
                            <tr>
                                <td class="lbl">Gender / लिंग</td>
                                <td>@Html.DisplayFor(model => model.strGender)</td>
                            </tr>
                            <tr>
                                <td class="lbl">Person with Benchmark Disability (PwBD) / दिव्यांगता श्रेणी</td>
                                <td>@Html.DisplayFor(model => model.strtypeofdisable)</td>
                            </tr>
                            <tr>
                                <td class="lbl">Scribe Required / स्क्राइब आवश्यक</td>
                                <td>@Html.DisplayFor(model => model.strScribe)</td>
                            </tr>
                            <tr>
                                <td class="lbl">Exam Date / परीक्षा तिथि</td>
                                <td><b>To Be Announced / घोषित किया जाएगा</b></td>
                            </tr>
                            <tr>
                                <td class="lbl">Entry Timing / प्रवेश समय</td>
                                <td>To Be Announced / घोषित किया जाएगा</td>
                            </tr>
                            <tr>
                                <td class="lbl">Gate Closure Time / गेट बंद होने का समय</td>
                                <td>To Be Announced / घोषित किया जाएगा</td>
                            </tr>
                            <tr>
                                <td class="lbl">Exam City / परीक्षा शहर</td>
                                <td>To Be Announced / घोषित किया जाएगा</td>
                            </tr>
                            <tr>
                                <td class="lbl">Exam Start Time / परीक्षा प्रारंभ समय</td>
                                <td>To Be Announced / घोषित किया जाएगा</td>
                            </tr>
                            <tr>
                                <td class="lbl">Exam End Time / परीक्षा समाप्ति समय</td>
                                <td>To Be Announced / घोषित किया जाएगा</td>
                            </tr>
                            <tr>
                                <td class="lbl">Exam Center Name / परीक्षा केंद्र का नाम</td>
                                <td>To Be Announced / घोषित किया जाएगा</td>
                            </tr>
                            <tr>
                                <td class="lbl">Exam Center Address / परीक्षा केंद्र का पता</td>
                                <td>To Be Announced / घोषित किया जाएगा</td>
                            </tr>
                        </table>
                    </td>

                    <!-- RIGHT: photo + signature (22%) -->
                    <td class="photo-sig-cell">
                        @{
                            var photoSrc = ("~/" + Model.str_uploadphoto.Replace("\\", "/").TrimStart('~', '/', '\\'));
                            var sigSrc = ("~/" + Model.str_uploadsignature.Replace("\\", "/").TrimStart('~', '/', '\\'));
                        }
                        <div class="photo-label">UPLOADED PHOTO<br>अपलोड की गई तस्वीर</div>
                        <div class="photo-box">
                            @if (!string.IsNullOrEmpty(Model.str_uploadphoto))
                            {
                                <img src='@Url.Content(photoSrc)' alt="Candidate Photo" />
                            }
                        </div>
                        <div class="sig-label">UPLOADED SIGNATURE<br>अपलोड किए गए हस्ताक्षर</div>
                        <div class="sig-box">
                            @if (!string.IsNullOrEmpty(Model.str_uploadsignature))
                            {
                                <img src='@Url.Content(sigSrc)' alt="Candidate Signature" />
                            }
                        </div>
                    </td>
                </tr>
            </table>
        </div><!-- end details-outer -->
        <!-- SELF DECLARATION -->
        <div class="declaration-section">
            <div class="dec-title">SELF DECLARATION BY CANDIDATE / उम्मीदवार द्वारा स्व-घोषणा</div>
            I hereby declare that all the particulars stated in the application form submitted by me through online, are true to the best of my knowledge and belief. Further I also confirm that I meet the medical standard required for the jobs to the best of my knowledge. If at any stage, it is found that the information furnished in the online application and declaration form is false/fake/misinterpreted/incorrect or myself does not satisfy the eligibility criteria for the post applied, my candidature may be cancelled, even after appearing in the CBT examination or even after selection for the said Post in addition to any other action as may be deemed fit.<br><br>
            मैं यह घोषित करता/करती हूँ कि मेरे द्वारा ऑनलाइन आवेदन पत्र में दी गई सभी जानकारी मेरी जानकारी एवं विश्वास के अनुसार सत्य है। साथ ही, मैं यह भी पुष्टि करता/करती हूँ कि मेरी जानकारी के अनुसार मैं संबंधित पद हेतु आवश्यक चिकित्सीय मानकों को पूरा करता/करती हूँ। यदि किसी भी चरण में यह पाया जाता है कि ऑनलाइन आवेदन एवं घोषणा पत्र में दी गई जानकारी असत्य/फर्जी/भ्रामक/गलत है अथवा मैं आवेदन किए गए पद के पात्रता मानदंडों को पूरा नहीं करता/करती हूँ, तो मेरी अभ्यर्थिता CBT परीक्षा में सम्मिलित होने के बाद या चयन होने के पश्चात भी रद्द की जा सकती है।

            <div style="display:flex; justify-content:space-between; margin-top:10px; font-size:11px;">
                <div>Date / दिनांक : ………………………………</div>
                <div>Place / स्थान : ………………………………</div>
            </div>
            <div style="display:flex; justify-content:space-between; margin-top:16px; text-align:center; font-size:10.5px;">
                <div style="width:45%;">
                    <div style="border-top:1px solid #000; padding-top:3px;">
                        (Left Thumb Impression / बाएँ हाथ के अंगूठे का निशान)
                    </div>
                </div>
                <div style="width:45%;">
                    <div style="border-top:1px solid #000; padding-top:3px;">
                        (Signature of the candidate / उम्मीदवार के हस्ताक्षर)
                    </div>
                </div>
            </div>
        </div>

        <!-- HANDOVER NOTE -->
        <div class="handover-note">
            <i>Admit card to be handed over to the Test Administrator/Invigilator in the examination hall. You should put your left thumb impression and signature on the declaration provided on the Admit card in the presence of the Invigilator. Please ensure reading the Instructions provided overleaf.</i><br>
            <i>प्रवेश पत्र परीक्षा कक्ष में टेस्ट एडमिनिस्ट्रेटर/निरीक्षक को सौंपना होगा। कृपया प्रवेश पत्र पर दिए गए घोषणा-पत्र में अपना बाएँ हाथ के अंगूठे का निशान एवं हस्ताक्षर निरीक्षक की उपस्थिति में करें। कृपया पीछे दिए गए निर्देशों को ध्यानपूर्वक पढ़ लें।</i>
        </div>

        <!-- IP / PRINT ROW -->
        <div class="ip-print-row">
            <span>Your IP Address: 192.168.1.101</span>
            <span>Print Date and Time: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</span>
        </div>

    </div><!-- end outer-wrapper -->
    <!-- ════════════════════════════════════════════
         INSTRUCTIONS PAGE (overleaf)
    ════════════════════════════════════════════ -->
    <div class="instructions-wrapper">
        <h3>
            IMPORTANT INSTRUCTIONS FOR THE CANDIDATES APPEARING IN COMPUTER BASED EXAMINATION
            <span>कंप्यूटर आधारित परीक्षा में सम्मिलित होने वाले अभ्यर्थियों हेतु महत्वपूर्ण निर्देश</span>
        </h3>
        <ol>
            <li>
                Please bring the downloaded copy of Admit card which has your scanned photo. Admission to the CBT examination center will be on the production of the admit card.
                <span class="hindi-li">कृपया प्रवेश पत्र की डाउनलोड की हुई प्रति साथ लाएँ, जिस पर आपका स्कैन किया हुआ फोटो हो। CBT परीक्षा केंद्र में प्रवेश केवल प्रवेश पत्र प्रस्तुत करने पर ही दिया जाएगा।</span>
                <b>NOTE:</b> You have to appear for the Computer Based Test (CBT) at your own expense on the date, time and Venue as indicated above.<br>
                <b>नोट:</b> आपको ऊपर उल्लिखित तिथि, समय एवं स्थान पर अपने स्वयं के खर्च पर कंप्यूटर आधारित परीक्षा (CBT) में उपस्थित होना होगा।
            </li>
            <li>
                Bring any one Photo Identity Proof (original) such as PAN Card / Passport / Driving License / Voter's Card / Nationalized Bank Passbook with photograph / Aadhaar card / Notarized Affidavit (In English) with Photo, Signature, Date of Birth and Residential Address. <b>Candidate without valid Photo ID proof will not be permitted to appear for the examination. If identity of the candidate is doubtful the candidate will not be allowed to appear for the Examination.</b> Note: The photo identity proof must contain the same name as it appears on the call letter. In case of any discrepancy in identity, i.e., mismatch in name, photograph and signature, the candidate may not be permitted to appear for the examination.
                <span class="hindi-li">पैन कार्ड / पासपोर्ट / ड्राइविंग लाइसेंस / मतदाता पहचान पत्र / राष्ट्रीयकृत बैंक की फोटोयुक्त पासबुक / आधार कार्ड / फोटो, हस्ताक्षर, जन्मतिथि एवं आवासीय पते सहित अंग्रेज़ी में नोटरीकृत शपथपत्र में से कोई एक फोटो पहचान पत्र (मूलपत्र) साथ लाएँ। <b>वैध फोटो पहचान पत्र के बिना किसी भी अभ्यर्थी को परीक्षा में बैठने की अनुमति नहीं दी जाएगी।</b> नोट: फोटो पहचान पत्र पर अंकित नाम वही होना चाहिए जो प्रवेश पत्र में अंकित है।</span>
            </li>
            <li>
                You must bring stationery (pencils, ballpoint pen) with you. Rough sheets will be provided at Examination Center.
                <span class="hindi-li">अभ्यर्थी अपने साथ स्टेशनरी सामग्री (पेंसिल, बॉलपॉइंट पेन) अवश्य लाएँ। रफ शीट परीक्षा केंद्र पर उपलब्ध कराई जाएगी।</span>
