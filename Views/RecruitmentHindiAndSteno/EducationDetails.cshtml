<script>
    $(document).ready(function () {

        function toggleTransitionTable() {
            var selectedVal = $('input[name="HasTransitionCertificate"]:checked').val();
            if (selectedVal === 'Yes') {
                $('#transitioncertificate').show();
                $('#transitioncertificate .tc-required').attr('required', true);
            } else {
                $('#transitioncertificate').hide();
                $('#transitioncertificate .tc-required').removeAttr('required');
                // Clear table inputs if needed
                // $('#transitioncertificate .tc-required').val('');
            }
        }

        // Run on page load
        toggleTransitionTable();

        // Run on change
        $('input[name="HasTransitionCertificate"]').change(function () {
            toggleTransitionTable();
        });

    });
</script>


