@model Hindustancopperlimited.Models.tbl_mst_candidatephotoupload

@{
    ViewBag.Title = "Upload Details";
    Layout = "~/Views/Shared/DashboardWithoutSideBar.cshtml";
}

@using (Html.BeginForm("CandidatePersonalDetailsphotoupload", "RecruitmentCareer", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
   @Html.AntiForgeryToken()  

      <div class="col-md-12" style="text-align:right"><span style="color:Red; font-size:14px; padding-left:65%"><b> (*) Fields are Mandatory</b> </span></div>
          <div class="row" style="z-index:1; position:relative">
   
          <div class="col-md-12">
            <div class="card">
            <div class="row">
            <div class="col-lg-12">
            <div class="well bs-component" style="text-align:center; padding:4px;  color:#6f3706; margin:8px; border:solid 1px #6f3706">
                   <div class="form-horizontal">
                    <fieldset>
                          <label style="font-size:medium"><b>Upload Details</b></label>
                         
                        </fieldset>
                   </div>
                  </div>
                </div>
             <div class="col-lg-12 "  style="height:200px">

          <div class="col-lg-6">
           <div class="form-group">
            <label>
            Colour Photo (Size must be between 20KB and 50KB) <span style="color:Red"> (*)</span></label>
          
              <input type="file" name="str_uploadphoto" id="str_uploadphoto"  onchange="readURL(this);" , required = "required"/>
             
        </div>
          </div> 
          <div class="col-lg-6">
           <div class="form-group">
            <label>
           </label><label class="error"></label>
         <img id="blah" src="~/Content/Images/NoPicture.jpg" alt="Photo"  />
             
        </div>
          </div>
           </div> 
                
                 <div class="col-lg-12 ">   </div>
             <div class="col-lg-12" style="height:200px">

          <div class="col-lg-6">
           <div class="form-group">
            <label>
            Signature (Size must be between 20KB and 50KB)<span style="color:Red"> (*)</span></label>
          
              <input type="file" name="str_uploadsignature" id="str_uploadsignature"  onchange="readURL1(this);" , required = "required"/>
             
        </div>
          </div> 
          <div class="col-lg-6">
           <div class="form-group">
            <label>
           </label><label class="error"></label>
         <img id="blah1" src="~/Content/Images/signatureBox.jpg" alt="Signature"  />

       
             
        </div>
          </div>
           </div> 
            
       
              </div>
            </div>
            <div class="col-lg-12" style="padding-top:10px">
       <div class="form-group">
                          <div class="col-lg-10 col-lg-offset-5">                           
                            <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
                             <button type="reset" class="btn btn-default">Reset</button>
                            
                          </div>
                        </div>

</div>
          </div>
        </div>
       
       
    
}

<script>
    function readURL(input) {

        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $('#blah')
                        .attr('src', e.target.result)
                        .width(150)
                        .height(180);
            };

            reader.readAsDataURL(input.files[0]);
        }
    }

    function readURL1(input) {

        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $('#blah1')
                        .attr('src', e.target.result)
                        .width(200)
                        .height(50);
            };

            reader.readAsDataURL(input.files[0]);
        }
    }

    $("#str_uploadphoto").change(function () {
        var str_uploadphoto = $("#str_uploadphoto").val();
        $("#str_uploadphoto").next("span").remove();
        if (str_uploadphoto == "") {
            $("#str_uploadphoto").after("<span style='color:Red'> This field is required</span>");
        }
        else {
            $("#str_uploadphoto").next("span").remove();
        }
    });


    $("#str_uploadsignature").change(function () {
        var str_uploadsignature = $("#str_uploadsignature").val();
        $("#str_uploadsignature").next("span").remove();
        if (str_uploadsignature == "") {
            $("#str_uploadsignature").after("<span style='color:Red'> This field is required</span>");
        }
        else {
            $("#str_uploadsignature").next("span").remove();
        }
    });


    function error() {
     var noerror = 1;

    

     if ($("#str_uploadphoto").val() == "") {
         $("#str_uploadphoto").next("span").remove();
         $("#str_uploadphoto").after("<span style='color:Red'> This field is required</span>");
        noerror = 0;
    }
    if ($("#str_uploadsignature").val() == "") {
        $("#str_uploadsignature").next("span").remove();
        $("#str_uploadsignature").after("<span style='color:Red'> This field is required</span>");
        noerror = 0;
    }
    if (noerror == 1) {
        if (confirm("Are you sure ?")) {

            if ($('#tbl_mst_candidatephotoupload')[0].checkValidity()) {
                return true;
            }
        }
        else {
            return false;
        }

    }


    if (noerror == 0) {
        return false;



    }

}
</script>