    @model Hindustancopperlimited.Models.tbl_mst_CandidatePersonalDetails

@{
    ViewBag.Title = "Applicant Details";
    Layout = "~/Views/Shared/DashboardWithoutSideBar.cshtml";
}

<style>
    
.white
{
    color:#4d070f;
    padding-right:10px;
    padding-left:10px;
}
.white:hover
{
    color:White;
}

</style>

            
@using (Html.BeginForm("CandidatePersonalDetails", "RecruitmentCareer", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
   
    @Html.AntiForgeryToken()   

