                                 </div>
                                 </div>
                            </fieldset>
                          </div>

                   <div class="form-horizontal">
                    <fieldset>
                          <label class="col-lg-5 control-label">Name of the post Applied for<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-4">                       
