@model Hindustancopperlimited.Models.T_GrievanceMaster
@{

    ViewBag.Title = "शिकायत| हिंदुस्तान कॉपर लिमिटेड";
    ViewBag.MetaDescription = "हिंदुस्तान कॉपर लिमिटेड (एचसीएल) भारत की अग्रणी तांबा उत्पादक कंपनी है, जो तांबे के खनन, संकेंद्रण, प्रगलन, परिशोधन और डाउनस्ट्रीम उत्पादों के क्षेत्र में कार्यरत है।";
    ViewBag.MetaKeywords = "हिंदुस्तान कॉपर लिमिटेड, एचसीएल, तांबा उत्पादक, तांबा खनन, तांबा संकेंद्रण, तांबा प्रगलन, तांबा परिशोधन, तांबा उत्पाद, तांबा कैथोड, तांबा सांद्रण, तांबा छड़ें, खान मंत्रालय, एचसीएल भारत, Hindustan Copper Limited, HCL, Copper Producer, Copper Mining, Copper Beneficiation, Copper Smelting, Copper Refining, Copper Products, Copper Cathodes, Copper Concentrates, Copper Rods, Ministry of Mines, HCL India.";


    Layout = "~/Views/Shared/HindiVigilance.cshtml";
}

<style>
    .mandatory {
        color: #DC3545;
    }

    /* Visually hidden, still read by screen readers */
    .sr-only {
        position: absolute !important;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* Single-column source order, shown as two columns on wide screens */
    .hc-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px 24px;
        margin: 0;
        padding: 0;
    }

    .hc-field {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

        .hc-field label,
        .hc-field legend {
            font-weight: 600;
            margin-bottom: 4px;
        }

    .hc-full {
        grid-column: 1 / -1;
    }

    fieldset.hc-field {
        border: 0;
        margin: 0;
        padding: 0;
        min-width: 0;
    }

        fieldset.hc-field legend {
            padding: 0;
            font-size: inherit;
            border: 0;
            width: auto;
        }

    .hc-phone-row {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 12px;
    }

        .hc-phone-row > div {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .hc-phone-row label {
            font-weight: 400;
        }

    .hc-form-grid input[type="text"],
    .hc-form-grid input[type="email"],
    .hc-form-grid input[type="file"],
    .hc-form-grid select,
    .hc-form-grid textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 6px !important;
        border: 1px solid #C6C6C6 !important;
        border-radius: 4px !important;
        font-size: 14px !important;
    }

    .hc-form-grid textarea {
        min-height: 80px;
    }

        .hc-form-grid input:focus-visible,
        .hc-form-grid select:focus-visible,
        .hc-form-grid textarea:focus-visible,
        .hc-captcha-refresh:focus-visible,
        #btnSubmit:focus-visible,
        .vigiLeft:focus-visible {
            outline: 3px solid #0b57d0;
            outline-offset: 2px;
        }

    .hc-hint {
        font-size: 13px;
        margin: 2px 0 0 0;
    }

    .hc-captcha {
        text-align: center;
        padding-top: 8px;
    }

    .hc-captcha-question {
        font-size: 30px;
        display: block;
        margin-bottom: 8px;
    }

    .hc-captcha input[type="text"] {
        max-width: 260px;
        margin: 0 auto;
    }

    .hc-captcha-refresh img {
        width: 20%;
        height: auto;
        margin: 0;
        padding: 0;
    }

    .hc-submit {
        text-align: center;
        padding-top: 20px;
    }

    #R1 {
        display: block;
    }

    @@media (max-width: 767px) {
        .hc-form-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="row" style="width:100%">
    <div class="vigiTop">
        @*<img src="@Url.Content("~/Content/images/complaintTop.jpg")"/>*@
        <h1>शिकायत दर्ज करें</h1>
    </div>
</div>

<div class="hgap1">
    &nbsp;
</div>
<div>
    @using (Html.BeginForm("complaint", "Vigilance", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
    {
        var captchaQuery = (HttpContext.Current.Session["query"] ?? "").ToString();

        <div class="container">
            <div class="row">
                <div class="col-lg-8 col-md-12 col-sm-12">
                    @Html.Hidden("HidFile")

                    <p><strong>शिकायत विवरण</strong> &ndash; <span class="mandatory"><strong>(*) फ़ील्ड अनिवार्य हैं</strong></span></p>

                    <div class="hc-form-grid">

                        <div class="hc-field">
                            <label for="vchComplainer">नाम <span class="mandatory" aria-hidden="true">*</span><span class="sr-only">(अनिवार्य)</span></label>
                            @Html.TextBoxFor(model => model.vchComplainer, new { aria_required = "true", aria_describedby = "R1", autocomplete = "name" })
                            <span class="alert" id="R1" role="alert" style="display: none">
                                कृपया अपना प्रथम नाम प्रविष्ट करें
                            </span>
                        </div>

                        <div class="hc-field">
                            <label for="vchEmail">ईमेल आईडी <span class="mandatory" aria-hidden="true">*</span><span class="sr-only">(अनिवार्य)</span></label>
                            @Html.TextBoxFor(model => model.vchEmail, new { aria_required = "true", autocomplete = "email", inputmode = "email" })
                        </div>

                        <div class="hc-field">
                            <label for="vchContactNo">मोबाइल नंबर (10 अंक नंबर दर्ज करें) <span class="mandatory" aria-hidden="true">*</span><span class="sr-only">(अनिवार्य)</span></label>
                            @Html.TextBoxFor(model => model.vchContactNo, new { aria_required = "true", autocomplete = "tel-national", inputmode = "numeric" })
                        </div>

                        <div class="hc-field">
                            <label for="dtmDob">जन्म की तारीख <span class="mandatory" aria-hidden="true">*</span><span class="sr-only">(अनिवार्य)</span></label>
                            @Html.TextBoxFor(model => model.dtmDob, new { @class = "date", aria_required = "true", autocomplete = "bday" })
                        </div>

                        <div class="hc-field">
                            <label for="vchComplainerAddress">पता <span class="mandatory" aria-hidden="true">*</span><span class="sr-only">(अनिवार्य)</span></label>
                            @Html.TextAreaFor(model => model.vchComplainerAddress, htmlAttributes: new { aria_required = "true", autocomplete = "street-address" })

                            @* <textarea name="txtAddress" rows="2" cols="20" id="txtAddress" class="textbox" style="width: 165px;"></textarea>
                                <span class="alert" id="R2" style="display: none">Please Enter Your Last Name </span>*@
                        </div>

                        <div class="hc-field">
                            <label for="vchCity">शहर <span class="mandatory" aria-hidden="true">*</span><span class="sr-only">(अनिवार्य)</span></label>
                            @Html.TextBoxFor(model => model.vchCity, new { aria_required = "true", autocomplete = "address-level2" })
                            @* <input name="txtCity" maxlength="100" id="txtCity" class="textbox" style="width: 165px;"
                                type="text">*@
                        </div>

                        <div class="hc-field">
                            <label for="vchPin">पिन नंबर <span class="mandatory" aria-hidden="true">*</span><span class="sr-only">(अनिवार्य)</span></label>
                            @Html.TextBoxFor(model => model.vchPin, new { aria_required = "true", autocomplete = "postal-code", inputmode = "numeric" })
                            @* <input name="txtPin" maxlength="7" id="txtPin" class="textbox" style="width: 165px;"
                                type="text">*@
                        </div>

                        <fieldset class="hc-field">
                            <legend>फ़ोन</legend>
                            <div class="hc-phone-row">
                                <div>
                                    <label for="vchStdCode">एसटीडी कोड</label>
                                    @Html.TextBoxFor(model => model.vchStdCode, new { inputmode = "numeric" })
                                </div>
                                <div>
                                    <label for="vchLPhoneNo">फोन नंबर</label>
                                    @Html.TextBoxFor(model => model.vchLPhoneNo, new { inputmode = "numeric", autocomplete = "tel-national" })
                                    @*<input name="txtLphoneNo" maxlength="10" id="txtLphoneNo" class="textbox" style="width: 165px;"
                                        type="text">*@
                                </div>
                            </div>
                        </fieldset>

                        <div class="hc-field">
                            <label for="vchComplainType">शिकायत प्रकार <span class="mandatory" aria-hidden="true">*</span><span class="sr-only">(अनिवार्य)</span></label>
                            <select name="vchComplainType" id="vchComplainType" aria-required="true">
                                <option value="0">-- चुनें --</option>
                                <option value="Contract-Labour">ठेका श्रमिक</option>
                                <option value="Disproportionate Assets-Income">आय से अधिक संपत्ति</option>
                                <option value="HRD-Administration">मानव संसाधन विकास &ndash; प्रशासन</option>
                                <option value="HRD-Promotion">मानव संसाधन विकास &ndash; पदोन्नति</option>
                                <option value="HRD-Recruitment">मानव संसाधन विकास &ndash; भर्ती</option>
                                <option value="Others">अन्य</option>
                                <option value="Procurement">क्रय (खरीद)</option>
                                <option value="Project Implementation">परियोजना कार्यान्वयन</option>
                                <option value="Supply-Sale">आपूर्ति-बिक्री</option>
                            </select>
                        </div>

                        <div class="hc-field">
                            <label for="vchLocation">शिकायत स्थान <span class="mandatory" aria-hidden="true">*</span><span class="sr-only">(अनिवार्य)</span></label>
                            <select name="vchLocation" id="vchLocation" class="textbox" aria-required="true">
                                <option value="0">-- चुनें --</option>
                                <option value="Bangalore Office">बेंगलुरु कार्यालय</option>
                                <option value="Corporate Office">कॉर्पोरेट कार्यालय</option>
                                <option value="Delhi Office">दिल्ली कार्यालय</option>
                                <option value="ICC" lang="en">ICC</option>
                                <option value="KCC" lang="en">KCC</option>
                                <option value="KCM" lang="en">KCM</option>
                                <option value="MCP" lang="en">MCP</option>
                                <option value="TCP" lang="en">TCP</option>
                            </select>
                        </div>

                        <div class="hc-field">
                            <!--Code Commented by Jyoti on 18 Jan 2010 to make Complain Against Drop down-->
                            <!--<td class="smltxt">Complaint Against <span class="mandatory">*</span> </td>
                            <td><input name="txtCompAgnstOff" type="text" maxlength="50" id="txtCompAgnstOff" class="textbox" /></td>-->
                            <label for="vchCompAgainstOff">शिकायत किसके विरुद्ध है <span class="mandatory" aria-hidden="true">*</span><span class="sr-only">(अनिवार्य)</span></label>
                            <select name="vchCompAgainstOff" id="vchCompAgainstOff" aria-required="true">
                                <option selected="selected" value="0">-- चुनें --</option>
                                <option value="Individual">व्यक्ति</option>
                                <option value="Department">विभाग</option>
                                <option value="Contractor/Firm">ठेकेदार / फर्म</option>
                            </select>
                            <div id="tdDesigdet" style="display: none;">
                                <label for="txtDesig" class="sr-only">पद</label>
                                <input name="txtDesig" maxlength="50" id="txtDesig" class="textbox" type="text">
                            </div>
                        </div>

                        <div class="hc-field">
                            <label for="vchFileName">दस्तावेज़ अपलोड करें</label>
                            <input type="file" name="vchFileName" id="vchFileName" />
                            @* @if (Model.vchFileName != null)
                                {
                                    <a href=@Model.vchFileName.Replace("~", "../..") target="_blank" id="strConstitutionofthefirmview">View</a>
                                }*@
                            @*<input name="FileUpload1" id="FileUpload1" class="textbox" maxlength="10" type="file">*@
                        </div>

                        <div class="hc-field hc-full">
                            <label for="vchComplainDetails">शिकायत विवरण <span class="mandatory" aria-hidden="true">*</span><span class="sr-only">(अनिवार्य)</span></label>
                            @Html.TextAreaFor(model => model.vchComplainDetails, new { aria_required = "true" })
                            @* <textarea name="txtCompDetails" rows="2" cols="20" id="txtCompDetails" class="textbox"
                                style="width: 190px;"></textarea>*@
                        </div>

                        <div class="hc-field hc-full hc-captcha">
                            <label for="answer" class="hc-captcha-question">
                                सुरक्षा प्रश्न: <span>@captchaQuery</span> = ? <span class="sr-only">(सही उत्तर संख्या में दर्ज करें)</span>
                            </label>
                            <input type="text" placeholder="उत्तर" name="answer" id="answer" class="form-control" required aria-required="true" autocomplete="off" inputmode="numeric">
                            <p>
                                <a class="hc-captcha-refresh" href="@Url.Action("complaint")" title="नया सुरक्षा प्रश्न प्राप्त करें">
                                    <img src="/Content/images/reCAPTCHA.jpeg" alt="नया सुरक्षा प्रश्न प्राप्त करें" />
                                </a>
                            </p>
                        </div>

                        <div class="hc-full hc-submit">
                            <input name="btnSubmit" value="सबमिट" id="btnSubmit" class="btn btn-primary" onclick="return error()" type="submit">
                        </div>

                    </div>
                </div>

                <div class="col-lg-4 col-md-12 col-sm-12">

                    <div class="aboutus_area wow fadeInLeft wow fadeInUp">
                        <div class="vigiLeft" style="overflow: auto; height:400px; padding:15px;" role="region" aria-labelledby="guidelinesHeading" tabindex="0">
                            <div class="vigiLeftHeader">
                                <h2 id="guidelinesHeading" style="margin: 0; font: inherit; font-size: 24px; margin-bottom: 10px; ">
                                    <span class="vigiLeftHeaderText" style="color: #ffffff; font-size: 24px;">शिकायत लोड करने के लिए दिशानिर्देश</span>
                                </h2>
                            </div>
                            <ul class="vigiTopUl">
                                <li>शिकायत को विशिष्ट विवरण जैसे कि निविदा / आपूर्ति / आदेश / कार्य क्रम संख्या, के साथ विशिष्ट होना चाहिए। निविदाओं से संबंधित शिकायत के मामले में और तारीख आदि। खनन योजना / खनन योजना की योजना के बारे में शिकायत संबंधित अनुमोदन के मामले में उल्लेख किया जाना चाहिए</li>
                                <li>शिकायत प्रसंस्करण के लिए सही नाम और पता अनिवार्य है।</li>
                                <li>शिकायत दर्ज करने के बाद विषय पर कोई पत्राचार नहीं किया जाएगा।</li>
                                <li>अगर यह पाया जाता है कि शिकायत झूठी थी और अधिकारियों के उत्पीड़न के कारण होता है, शिकायतकर्ता के खिलाफ कार्रवाई की जा सकती है।</li>
                                <li>सतर्कता वाले कोण की शिकायत केवल जांच की जाएगी। सतर्कता के कोण में अधिकारी की आधिकारिक स्थिति, मांग और अवैध अनुग्रह की स्वीकृति, गैरकानूनी / जालसाजी या धोखाधड़ी, सकल और जानबूझकर लापरवाही के मामले, निर्धारित प्रणाली और प्रक्रियाओं का अत्यधिक उल्लंघन, विवेक की बेरहम प्रक्रिया, मामलों के प्रसंस्करण में देरी, आदि।</li>
                            </ul>
                        </div>
                    </div>
                </div>


            </div>
        </div><!--end container-->

    }
</div>



@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        window.onload = function () {
            var aa = "@ViewBag.Message";
            alert(aa);
            if (aa == "Data updated successfully !") {
                window.location.href = '/Home/Index';
            }
        };


    </script>
}
<script src="@Url.Content("~/Content/js/Grievance_Validation.js")"></script>


