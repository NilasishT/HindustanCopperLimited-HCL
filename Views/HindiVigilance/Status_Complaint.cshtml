@model Hindustancopperlimited.Models.T_GrievanceMaster
@{

    ViewBag.Title = "शिकायत की स्थिति | हिंदुस्तान कॉपर लिमिटेड";
    ViewBag.MetaDescription = "हिंदुस्तान कॉपर लिमिटेड (एचसीएल) भारत की अग्रणी तांबा उत्पादक कंपनी है, जो तांबे के खनन, संकेंद्रण, प्रगलन, परिशोधन और डाउनस्ट्रीम उत्पादों के क्षेत्र में कार्यरत है।";
    ViewBag.MetaKeywords = "हिंदुस्तान कॉपर लिमिटेड, एचसीएल, तांबा उत्पादक, तांबा खनन, तांबा संकेंद्रण, तांबा प्रगलन, तांबा परिशोधन, तांबा उत्पाद, तांबा कैथोड, तांबा सांद्रण, तांबा छड़ें, खान मंत्रालय, एचसीएल भारत, Hindustan Copper Limited, HCL, Copper Producer, Copper Mining, Copper Beneficiation, Copper Smelting, Copper Refining, Copper Products, Copper Cathodes, Copper Concentrates, Copper Rods, Ministry of Mines, HCL India.";

    Layout = "~/Views/Shared/HindiVigilance.cshtml";
}

<div class="row" style="width:100%">
              <div class="vigiTopHindi">
            
              <h1> शिकायत की स्थिति </h1>
              </div>
        </div>
        


@using (Html.BeginForm("Status_Complaint", "HindiVigilance", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
<div class="container">
        <div class="row">
              		<div class="col-lg-8 col-md-12 col-sm-12">
                      <div class="aboutus_area wow fadeInLeft wow fadeInUp">
                            <h2 style="text-align: center!important;">अवस्था जांच</h2>
                      </div>
                  </div>

                  <div class="col-lg-12">
                  
                 <div class="col-lg-8">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                        @Html.LabelFor(model => model.vchCompRegNo, "शिकायत संख्या :", new { @class = "col-lg-6 control-label" })

                        <div class="form-group">
                            <div class="col-lg-4" style="padding-top:9px">

                                @Html.TextBoxFor(model => model.vchCompRegNo, null, new { @class = "form-control" })

                            </div>
                        </div>
                    </fieldset>
                  
                 
                    <fieldset>
                        @Html.LabelFor(model => model.dtmDob, "जन्म की तारीख :", new { @class = "col-lg-6 control-label" })

                        <div class="form-group">
                            <div class="col-lg-6" style="padding-top:9px">

                                @Html.TextBoxFor(model => model.dtmDob, new { @class = "date" })

                            </div>
                        </div>
                    </fieldset>
                    

                   </div>
                  </div>
                  <div class="col-lg-10 col-lg-offset-5">
               
                  <button type="submit" class="btn btn-primary" style="margin-top:15px;">
                        सबमिट </button>
             
               
                   
                </div>
                </div>

                  <div class="col-lg-4 col-md-12 col-sm-12">
                  		<div class="aboutus_area wow fadeInLeft wow fadeInUp">
                        	<div class="vigiLeft">
                            	<div class="vigiLeftHeader">
                                 <span class="vigiLeftHeaderText" style="color:#ffffff">शिकायत लोड करने के लिए दिशानिर्देश</span>
                                </div>
                              <ul class="vigiTopUl">
                              <li>शिकायत को विशिष्ट विवरण जैसे कि निविदा / आपूर्ति / आदेश / कार्य क्रम संख्या, के साथ विशिष्ट होना चाहिए। निविदाओं से संबंधित शिकायत के मामले में और तारीख आदि। खनन योजना / खनन योजना की योजना के बारे में शिकायत संबंधित अनुमोदन के मामले में उल्लेख किया जाना चाहिए</li>
                              <li>शिकायत प्रसंस्करण के लिए सही नाम और पता अनिवार्य है।</li>
                              <li>शिकायत दर्ज करने के बाद विषय पर कोई पत्राचार नहीं किया जाएगा।</li>
                              <li>अगर यह पाया जाता है कि शिकायत झूठी थी और अधिकारियों के उत्पीड़न के कारण होता है, शिकायतकर्ता के खिलाफ कार्रवाई की जा सकती है।</li>
                              <li>सतर्कता वाले कोण की शिकायत केवल जांच की जाएगी। सतर्कता के कोण में अधिकारी की आधिकारिक स्थिति, मांग और अवैध अनुग्रह की स्वीकृति, गैरकानूनी / जालसाजी या धोखाधड़ी, सकल और जानबूझकर लापरवाही के मामले, निर्धारित प्रणाली और प्रक्रियाओं का अत्यधिक उल्लंघन, विवेक की बेरहम प्रक्रिया, मामलों के प्रसंस्करण में देरी, आदि।<br/>&nbsp;</li>
                              </ul>
                         	</div>
                       </div>
                  </div>

              
        </div>
</div><!--end container-->

</div>
}










