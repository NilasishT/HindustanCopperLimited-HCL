@using Hindustancopperlimited.Controllers;
@{
    ViewBag.Title = "Experience Details";
    Layout = "~/Views/Shared/ITIDashboard.cshtml";
    bool IsShow = RecruitmentEnglishController.CheckEmailExclude();
}
<input type="hidden" id="hdnStartDate" value="@ViewBag.datecertificatestart" />
<input type="hidden" id="hdnIsMedicalDiscipline" value="@(ViewBag.IsMedicalDiscipline == true ? "Yes" : "No")" />

@using (Html.BeginForm("ExperienceDetails", "RecruitmentEnglish", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
