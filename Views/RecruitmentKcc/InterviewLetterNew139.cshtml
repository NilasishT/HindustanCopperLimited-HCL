@model Hindustancopperlimited.Models.AdvId99_CandidateDetailsInterview_139

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admit Card</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eee;
            color: #000;
            font-family: Arial, sans-serif;
        }

        .sheet {
            width: 210mm;
            min-height: 297mm;
            margin: 12px auto;
            padding: 15mm 12mm;
            background: #fff;
        }

        .header {
            width: 100%;
            border-collapse: collapse;
            border-bottom: 1px solid #666;
            margin-bottom: 4mm;
        }

            .header td {
                padding-bottom: 4mm;
                vertical-align: middle;
            }

        .logo {
            width: 34mm;
        }

            .logo img {
                width: 23mm;
                height: 35mm;
                object-fit: contain;
            }

        .company {
            text-align: center;
            font: bold 15pt/1.22 "Times New Roman", serif;
        }

            .company a {
                color: #0000ee;
                text-decoration: underline;
            }

        .title {
            border: 1px solid #555;
            text-align: center;
            padding: 2mm 3mm 6mm;
            margin-bottom: 8mm;
        }

            .title h1 {
                font-size: 20pt;
                text-decoration: underline;
                margin: 0 0 2mm;
            }

            .title h2 {
                font-size: 12pt;
                text-decoration: underline;
                margin: 0 0 3mm;
            }

            .title p {
                font-size: 12pt;
                margin: 0;
            }

        .content {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .content > tbody > tr > td {
                vertical-align: top;
            }

        .details-column {
            width: 70%;
            padding: 0 5mm 0 5mm;
        }

        .photo-column {
            width: 30%;
            padding-left: 6mm;
        }

        .details {
            width: 100%;
            border-collapse: collapse;
            font-size: 12pt;
            table-layout: fixed;
        }

            .details td {
                border: 1px solid #000;
                padding: 1mm 2mm;
                vertical-align: top;
                overflow-wrap: break-word;
            }

            .details .label {
                width: 40%;
                font-weight: normal;
            }

            .details .value {
                width: 60%;
                font-weight: bold;
            }

            .details .name-row {
                height: 10mm;
            }

            .details .address-row {
                height: 20mm;
            }

            .details .venue-row {
                height: 24mm;
            }

            .details .signature-row {
                height: 17mm;
            }

        .multiline {
            white-space: pre-line;
        }

        .photo-box {
            width: 100%;
            height: 49mm;
            border: 1px solid #555;
            text-align: center;
            padding: 2mm;
            font-size: 12pt;
            line-height: 1.5;
        }

        .candidate-photo {
            display: block;
            max-width: 100%;
            height: 34mm;
            margin: 0 auto;
            object-fit: contain;
        }

        .candidate-signature {
            display: block;
            max-width: 100%;
            height: 9mm;
            margin: 1mm auto 0;
            object-fit: contain;
        }

        .affix-box {
            margin-top: 20mm;
            height: auto;
            overflow: visible;
            padding: 2mm;
            text-align: left;
            font-size: 12pt;
            line-height: 1.5;
        }

        .instructions h2 {
            font: bold 15pt "Times New Roman", serif;
            text-align: center;
            margin: 0 0 6mm;
            text-decoration: underline;
        }

        .instructions ol {
            margin: 0;
            padding-left: 7mm;
            font: 10.5pt/1.25 "Times New Roman", serif;
        }

        .instructions li {
            padding-left: 1mm;
            margin-bottom: 2.5mm;
        }

        .marks {
            border-collapse: collapse;
            width: 85%;
            margin: 2mm auto;
            font-size: 10.5pt;
        }

            .marks th, .marks td {
                border: 1px solid #000;
                padding: 1mm 2mm;
                text-align: center;
            }

                .marks th:nth-child(2), .marks td:nth-child(2) {
                    text-align: left;
                }

        @@media print {
            @@page {
                size: A4 portrait;
                margin: 0;
            }

            body {
                background: #fff;
            }

            .sheet {
                margin: 0;
                width: 210mm;
                min-height: 297mm;
            }

            .instructions {
                break-before: page;
                page-break-before: always;
            }

            .details tr, .photo-box, .title, .marks {
                break-inside: avoid;
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <section class="sheet">
        <table class="header">
            <tr>
                <td class="logo"><img src="data:image/jpeg;base64," alt="Hindustan Copper Limited logo" /></td>
                <td class="company">HINDUSTAN COPPER LIMITED<br />KHETRI COPPER COMPLEX<br />(A Govt. of India Enterprise) –<br />MINIRATNA Schedule ‘A’ Company<br />P.O. Khetri Nagar -333504<br />District: - Jhunjhunu (Rajasthan)<br />Website: <a href="https://www.hindustancopper.com">www.hindustancopper.com</a></td>
            </tr>
        </table>
        <div class="title">
            @{
                var d = Model.Exam_Date;
                string suffix = (d.Day >= 11 && d.Day <= 13) ? "th"
                              : (d.Day % 10 == 1) ? "st"
                              : (d.Day % 10 == 2) ? "nd"
                              : (d.Day % 10 == 3) ? "rd" : "th";
                var ci = System.Globalization.CultureInfo.InvariantCulture;
            }
            <p> @d.Day<sup>@suffix</sup> @d.ToString("MMM yyyy", ci) (@d.ToString("dddd", ci)), Test Time – 09:00 AM to 11:00 AM</p>

        </div>
        <table class="content">
            <tr>
                <td class="details-column">
                    <table class="details">
                        <tr><td class="label">Application No.</td><td class="value">@Html.DisplayFor(model => model.strApplicationNo)</td></tr>
                        <tr class="name-row"><td class="label">Applicant’s name</td><td class="value">@Html.DisplayFor(model => model.strApplicantName)</td></tr>
                        <tr class="name-row"><td class="label">Father’s Name</td><td class="value">@Html.DisplayFor(model => model.strFatherName)</td></tr>
                        <tr class="name-row"><td class="label">Date of Birth</td><td class="value">@Html.DisplayFor(model => model.dtDOB)</td></tr>
                        <tr class="address-row"><td class="label">Address</td><td class="value multiline">@Html.DisplayFor(model => model.strPermanentAddress)</td></tr>
                        <tr><td class="label">Roll Number</td><td class="value">@Html.DisplayFor(model => model.Rollno)</td></tr>
                        <tr><td class="label">Post Applied for</td><td class="value" style="text-align:center;font-weight:normal;">@Html.DisplayFor(model => model.POST_APPLIED)</td></tr>
                        
                        <tr class="venue-row">
                            <td class="label">Test Venue Name &amp; Address</td>
                            <td class="value" style="text-align:center;">
                                <div><strong>Group Vocational Training Center</strong></div>
                                <div><strong>Khetri Copper Complex</strong></div>
                                <div class="multiline" style="font-weight:normal;">
                                    Khetri Nagar District Jhunjhunu<br />
                                    Rajasthan – 333504
                                </div>
                            </td>
                        </tr>
                       
                        <tr class="signature-row"><td class="label">Signature of the candidate<br />(In front of the Invigilator)</td><td></td></tr>
                        <tr class="signature-row"><td class="label">Signature of the Invigilator</td><td></td></tr>
                    </table>
                </td>
                <td class="photo-column">
                    
                    @{
                    string photoPath = ViewBag.Photo as string;
                    string signPath = ViewBag.Signature as string;
                    }

                    @if (!string.IsNullOrWhiteSpace(photoPath))
                    {
                    <img class="candidate-photo"
                         src="@Url.Content(photoPath)"
                         alt="Candidate photograph" />
                    }
                    else
                    {
                    <span>Candidate photograph not available</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(signPath))
                    {
                    <img class="candidate-signature"
                         src="@Url.Content(signPath)"
                         alt="Candidate signature" />
                    }
                    else
                    {
                    <span>Candidate signature not available</span>
                    }
                    
                    <div class="photo-box affix-box"><b>Please affix your recent passport size identical colour photograph as uploaded in application form &amp; Sign across the photograph</b> (Please keep 2 copies of the same for future use.)</div>
                </td>
            </tr>
        </table>
    </section>
    <section class="sheet instructions">
        <h2>Instructions to the Candidates</h2>
        <ol>
            <li>Admission to the test venue will be on production of this admit card along with your original photo Identity proof and one self-attested photocopy of that ID Proof (like Driving License/ Voter Card/ Aadhar Card/ Passport etc.). The examination will start as per the schedule given in the admit card.</li>
            <li>The admission to the test room will be allowed only 30 Min before the scheduled time. No candidate will be allowed to the examination hall after 08:55 AM in Forenoon Session &amp; after 03:55 PM in afternoon session and will also not be allowed to leave the examination hall till the test is over.</li>
            <li>Applicants who appear to be prima facie eligible are provisionally permitted to sit for the examination. If after scrutiny at any stage, it is found that the candidate is otherwise ineligible his candidature will be automatically cancelled, even if he has appeared at the examination and secured a position in the merit.</li>
            <li>You should compulsorily hand over the OMR Answer sheet and question papers to Invigilator after completion of examination.</li>
            <li>At the test center you are expected to maintain discipline. Thus interchanging seats, creating disturbance, exchanging notes, consulting/ talking to each other, seeking/ receiving any help from external means etc. will result in cancellation of your candidature for the post.</li>
            <li>Mobile phone, pager, electronic calculator, test booklet, notes, scales and logarithm table shall not be permitted during the test. You have to make your own arrangement to keep these items out of the premises of the test venues.</li>
            <li>Candidates resorting to any kind of unfair means will be disqualified.</li>
            <li>You must ensure that your signature and invigilator’s signature are put (in the space provided for it) on the Admit Card &amp; attendance sheet, failing which the Candidate will be treated as absent.</li>
            <li>Please quote your 6-digit Roll number as a reference for any future communication and keep a photocopy with you as this admit card will be collected from you during the examination.</li>
            <li>This Admit card issued to you is on the basis of information furnished by you on your application form. Your candidature for the post applied will be subject to your fulfilling the eligibility criteria stipulated in the detailed Advertisement available on the website www.hindustancopper.com.</li>
            <li>Please note that this letter does not constitute an offer of appointment to you.</li>
            <li>Strictly follow the instructions given by the Center Supervisor / Room invigilator and those given on the question booklet.</li>
            <li>No travelling expenses will be admissible for appearing in the written test</li>
            <li>Do not use white fluid/whitener/marker on the OMR sheet. In case of usage by any candidate, his candidature shall be summarily rejected.</li>
            <li>Multiple circle marking of the answer in the OMR sheet is prohibited. In case of multiple circle marking is done by any candidate against any answer, then the said answer shall not be evaluated.</li>
            <li>The Duration of Test is 2 hours. All questions will be of multiple choices. The written test will consists of two parts. Details are given below: -<table class="marks"><thead><tr><th>Sl. No.</th><th>Subject</th><th>Marks</th></tr></thead><tbody><tr><td>1</td><td>Subject Knowledge (On Specific Trade)</td><td>80</td></tr><tr><td>2</td><td>General Knowledge</td><td>20</td></tr></tbody></table></li>
            <li>Candidate must bring only Black ball point pen for the written test. Answers are to be marked in the concerned space in OMR sheet provided.</li>
            <li>For all future correspondence, candidates may refer to the company website www.hindustancopper.com.</li>
        </ol>
    </section>
    <script>
        (function () {
            function printCard() {
                var waits = Array.prototype.map.call(document.images, function (img) {
                    if (img.complete) { return Promise.resolve(); }
                    return new Promise(function (resolve) {
                        img.addEventListener('load', resolve, { once: true });
                        img.addEventListener('error', resolve, { once: true });
                    });
                });
                Promise.all(waits).then(function () { window.print(); });
            }
            if (document.readyState === 'complete') { printCard(); }
            else { window.addEventListener('load', printCard, { once: true }); }
        }());
    </script>
</body>
</html>
