@using Hindustancopperlimited.Controllers;
@{
    ViewBag.Title = "Experience Details";
    Layout = "~/Views/Shared/ITIDashboard.cshtml";
    bool IsShow = RecruitmentController.CheckEmailExclude();
}
<input type="hidden" id="hdnStartDate" value="@ViewBag.datecertificatestart" />

@using (Html.BeginForm("ExperienceDetails", "Recruitment", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{

    @Html.AntiForgeryToken()
    <div class="row" style="z-index:1; position:relative">
        <div class="col-md-12">
            <div class="card">
                <div class="row">



                    <div class="col-lg-12">
                        <div class="well bs-component" style="text-align:center; padding:4px;  color:#6f3706; margin:8px; border:solid 1px #6f3706">
                            <div class="form-horizontal">
                                <fieldset>
                                    <label style="font-size:medium"><b>Experience Details (Chronological Order - Starting with First Job)</b> </label>
                                    <p id="pExperience">@ViewBag.strEssentialQualification</p>
                                </fieldset>
                            </div>
                        </div>


                    </div>

                    <div class="col-lg-12">
                        <div class="well bs-component">
                            <div class="form-horizontal">
                                <fieldset>

                                    <div class="form-group">
                                        <label></label>
                                        <div class="col-lg-12">






                                            <table id="tblexprenceDetails" border="2" width="100%" style="text-align:center">

                                                <tr>
                                                    <td><b>Organisation Type</b></td>
                                                    <td><b>Employment Status </b></td>
                                                    <td><b>Organisation Name</b></td>
                                                    <td><b>Last Designation/Post Held </b></td>
                                                    <td><b>Annual CTC</b></td>
                                                    <td><b>Scale of Pay </b></td>
                                                    <td><b>From Date</b></td>
                                                    <td><b>To Date</b></td>
                                                    <td><b>Total Days of Experience</b></td>
                                                </tr>

                                                <tr>
                                                    <td>@Html.DropDownList("str_organisationType", null, "Select", new { @class = "form-control" })</td>
                                                    <td>
                                                        @Html.DropDownList("StrEmploymentPresentStatus", new List<SelectListItem> {
                                                                                         new SelectListItem {Text="Currently Working",Value="Currently Working"},
                                                                                         new SelectListItem {Text="Previous Employment",Value="Previous Employment"}
                                                                                                                  }, "Select", new { @class = "form-control" })
                                                    </td>


                                                    <td>@Html.TextBox("str_organisation", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("Str_designation", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("str_CTC", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("str_PayScale", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("dt_fromdate", null, new { @class = "form-control input-append fromdate", @type = "date", @placeholder = "dd-mm-yyyy ", @style = "height: 30px;", @min = @ViewBag.datecertificatestart})</td>
                                                    <td>@Html.TextBox("dt_todate", null, new { @class = "form-control input-append todate", @type = "date", @placeholder = "dd-mm-yyyy", @style = "height: 30px;", @min = @ViewBag.datecertificatestart})</td>
                                                    <td>@Html.TextBox("str_noyears", null, new { @class = "form-control", @readonly = "readonly" })</td>
                                                </tr>

                                                <tr>
                                                    <td>@Html.DropDownList("str_organisationType1", null, "Select", new { @class = "form-control" })</td>
                                                    <td>
                                                        @Html.DropDownList("StrEmploymentPresentStatus1", new List<SelectListItem> {
                                                                                          new SelectListItem {Text="Currently Working",Value="Currently Working"},
                                                                                         new SelectListItem {Text="Previous Employment",Value="Previous Employment"}

                                                                       }, "Select", new { @class = "form-control" })
                                                    </td>

                                                    <td>@Html.TextBox("str_organisation1", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("Str_designation1", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("str_CTC1", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("str_PayScale1", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("dt_fromdate1", null, new { @class = "form-control input-append fromdate", @type = "date", @placeholder = "dd-mm-yyyy", @style = "height: 30px;", @min = @ViewBag.datecertificatestart ,fmin= @ViewBag.datecertificatestart})</td>
                                                    <td>@Html.TextBox("dt_todate1", null, new { @class = "form-control input-append todate", @type = "date", @placeholder = "dd-mm-yyyy", @style = "height: 30px;", @min = @ViewBag.datecertificatestart, fmin = @ViewBag.datecertificatestart})</td>
                                                    <td>@Html.TextBox("str_noyears1", null, new { @class = "form-control", @readonly = "readonly" })</td>
                                                </tr>

                                                <tr>
                                                    <td>@Html.DropDownList("str_organisationType2", null, "Select", new { @class = "form-control" })</td>
                                                    <td>
                                                        @Html.DropDownList("StrEmploymentPresentStatus2", new List<SelectListItem> {
                                                                                          new SelectListItem {Text="Currently Working",Value="Currently Working"},
                                                                                         new SelectListItem {Text="Previous Employment",Value="Previous Employment"}

                                                                       }, "Select", new { @class = "form-control" })
                                                    </td>

                                                    <td>@Html.TextBox("str_organisation2", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("Str_designation2", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("str_CTC2", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("str_PayScale2", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("dt_fromdate2", null, new { @class = "form-control input-append fromdate", @type = "date", @placeholder = "dd-mm-yyyy", @style = "height: 30px;", @min = @ViewBag.datecertificatestart, fmin = @ViewBag.datecertificatestart})</td>
                                                    <td>@Html.TextBox("dt_todate2", null, new { @class = "form-control input-append todate", @type = "date", @placeholder = "dd-mm-yyyy", @style = "height: 30px;", @min = @ViewBag.datecertificatestart, fmin = @ViewBag.datecertificatestart})</td>
                                                    <td>@Html.TextBox("str_noyears2", null, new { @class = "form-control", @readonly = "readonly" })</td>
                                                </tr>

                                                <tr>
                                                    <td>@Html.DropDownList("str_organisationType3", null, "Select", new { @class = "form-control" })</td>
                                                    <td>
                                                        @Html.DropDownList("StrEmploymentPresentStatus3", new List<SelectListItem> {
                                                                                          new SelectListItem {Text="Currently Working",Value="Currently Working"},
                                                                                         new SelectListItem {Text="Previous Employment",Value="Previous Employment"}

                                                                       }, "Select", new { @class = "form-control" })
                                                    </td>

                                                    <td>@Html.TextBox("str_organisation3", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("Str_designation3", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("str_CTC3", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("str_PayScale3", null, new { @class = "form-control" })</td>
                                                    <td>@Html.TextBox("dt_fromdate3", null, new { @class = "form-control input-append fromdate", @type = "date", @placeholder = "dd-mm-yyyy", @style = "height: 30px;", @min = @ViewBag.datecertificatestart, fmin = @ViewBag.datecertificatestart})</td>
                                                    <td>@Html.TextBox("dt_todate3", null, new { @class = "form-control input-append todate", @type = "date", @placeholder = "dd-mm-yyyy", @style = "height: 30px;", @min = @ViewBag.datecertificatestart, fmin = @ViewBag.datecertificatestart})</td>
                                                    <td>@Html.TextBox("str_noyears3", null, new { @class = "form-control", @readonly = "readonly" })</td>
                                                </tr>



                                                <tr>
                                                    <td >@Html.Hidden("hidMaxExpdate")</td>
                                                    <td id="dtmxdt" style="display:none">@ViewBag.hidMaxExpdate</td>
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                    <td><b>Total Experience</b></td> 
                                                    <td colspan="3">
                                                        @Html.Hidden("totalYear", null, new { @class = "form-control" })
                                                        @Html.TextBox("totalYearproper", null, new { @class = "form-control", @readonly = "readonly" })
                                                    </td>
                                                </tr>
                                            </table>

                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                    </div>


                    <div class="col-lg-12" style="border-top:1px solid #6f3706">
                    </div>

                    <div class="col-lg-12" style="padding-top:10px">
                        <div class="form-group">
                            <div class="col-lg-10 col-lg-offset-5">
                                @if (!IsShow && ViewBag.IsFinalSubmit != "Yes")
                                {
                                    <button type="submit" class="btn btn-primary" value="Submit" name="strSubmit" id="Submit" onclick="return ErrorValidate()">Save & Next</button>
                                }
                                <button type="button" class="btn btn-primary" onclick="location.href = '../Dashboard/@Url.RequestContext.RouteData.Values["id"]';" value="Submit" name="strSubmit">Dashboard</button>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
}

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
            var msg = "@ViewBag.Message";
            alert("@ViewBag.Message");
    </script>
}

<script src="@Url.Content("~/Content/js/Recruitementexperiencedetails.js?a="+DateTime.Now.ToString("yyyyMMddHHmmss"))"></script>


