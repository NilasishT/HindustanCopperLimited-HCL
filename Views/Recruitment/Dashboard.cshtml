@*@model Hindustancopperlimited.Models.Vw_ApplicationdetailsNew
    @{
        string Domain = "https://www.hindustancopper.com/";
    }*@

@using Hindustancopperlimited.Controllers;
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/ITIDashboard.cshtml";
    bool IsShow = RecruitmentController.CheckEmailExclude();
}

<style>

    table {
        margin-top: 50px;
        width: 60%
    }

    table, th, td {
        border: 1px solid black;
        text-align: center;
    }

    .tableHead {
        background-color: #ac8446;
        font-size: 24px;
        font-family: Monotype Corsiva;
        font-weight: bold;
    }

    .tableSubHead {
        font-size: 20px;
        font-family: Monotype Corsiva;
        font-weight: bold;
        color: Green;
    }
</style>

<center>
    <table>
        <thead>
            <tr>
                <th colspan="2">
                    @if (ViewBag.finalSubmit != "Yes")
                    {
                        <label style="color:Red; font-size:20px;">Pending for final submission</label>
                    }
                </th>
            </tr>
            <tr>
                <th colspan="2" class="tableHead" style="text-transform:uppercase">@ViewBag.Name</th>
            </tr>
        </thead>
        <tbody>

            <tr>
                @if ((ViewBag.finalSubmit != "Yes" && ViewBag.dateEnd == "No") || IsShow)
                {
                    <td colspan="2" class="tableSubHead"><a href="../CandidatePersonalDetails/@ViewBag.noticeId"> Personal Details </a></td>
                }
            </tr>
            <tr>
                @if ((ViewBag.finalSubmit != "Yes" && ViewBag.checkPersonalDetails >= 1 && ViewBag.dateEnd == "No") || IsShow)
                {
                    <td colspan="2" class="tableSubHead"><a href="../EducationDetails/@ViewBag.noticeId"> Education Details </a></td>
                }
            </tr>

            <tr>
                @if ((ViewBag.checkQualificationDetails >= 1 && ViewBag.finalSubmit != "Yes" && ViewBag.dateEnd == "No") || IsShow)
                {
                    <td colspan="2" class="tableSubHead"><a href="../ExperienceDetails/@ViewBag.noticeId"> Experience Details </a></td>
                }
            </tr>
            <tr>

                @if ((ViewBag.checkQualificationDetails >= 1 && ViewBag.finalSubmit != "Yes" && ViewBag.dateEnd == "No") || IsShow)
                {
                    <td colspan="2" class="tableSubHead"><a href="../UploadDetails/@ViewBag.noticeId"> Upload Details </a></td>
                }
            </tr>
            <tr>
                @if (ViewBag.checkPersonalDetails != 0 && ViewBag.checkQualificationDetails != 0 && ViewBag.checkDocumentDetails != 0)
                {
                    <td colspan="2" class="tableSubHead"><a href="../PrintPreview/@ViewBag.noticeId"> Print Application </a></td>
                }
            </tr>

            <tr>
                @if (ViewBag.finalSubmit == "Yes")
                {
                    <td colspan="2" class="tableSubHead"><a href="../Acknowledgement/@ViewBag.noticeId"> Acknowledgement Report </a></td>
                }
            </tr>
            <tr>
                @if (ViewBag.finalSubmit == "Yes" && ViewBag.Admitflag == false) //Model.RollNo!=null && !string.IsNullOrEmpty(Model.ExamTime))
                {
                    <td colspan="2" class="tableSubHead"><a href="~/Recruitment/AdmitCard/@ViewBag.noticeId"> AdmitCard </a></td>
                }
            </tr>
            <tr>
                @if (ViewBag.InterviewLetter != null)
                {
                    <td colspan="2" class="tableSubHead"><a href="../InterviewLetter/@ViewBag.noticeId"> Interview Letter </a></td>
                }
            </tr>
            <tr>
                <td colspan="2" class="tableSubHead"><a href="../ChangePassword"> Change Password </a></td>
            </tr>
            <tr>
                <td colspan="2" class="tableSubHead"><a href="../Logout"> Logout </a></td>
            </tr>
            <tr>
                <td><img src="@ViewBag.Photo" width="100px" /></td>
                <td><img src="@ViewBag.Signature" width="100px" /></td>
            </tr>
        </tbody>

    </table>
</center>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
            var msg = "@ViewBag.Message";
            alert("@ViewBag.Message");
    </script>
}
