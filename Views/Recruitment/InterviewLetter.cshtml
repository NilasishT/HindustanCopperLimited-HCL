@model Hindustancopperlimited.Models.vw_InterviewCall
@{
    ViewBag.Title = "InterviewLetter";

}

<script src="@Url.Content("~/Content/js/jquery-1.10.2.min.js")"></script>
<style>
    body {
        font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        color: #000;
        font-size: 16px;
    }
    .text {
        display: block;
        width: 100%;
        padding: 4px 12px;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.44;
        text-align: left;
    }

    .btn-primary {
        color: #fff;
        background-color: #6f3706;
        border-color: transparent;
    }
    .paging {
        margin-top: 20px;
        padding: 20px;
    }

    .printPanel page-2 {
        padding-top: 20px;
    }

  

    .print-wrap {
        max-width: 1024px;
        width: 100%;
        margin: 20px auto 20px;
        padding: 10px;
    }

    .printPanel.printPanel img {
        width: 100%;
        height: auto;
    }

    .printPanel.page-4 table tr td img {
        width: 120px;
    }

    .form-group {
        margin-bottom: 0px;
    }
    .BorderArea {
        margin: 60px auto 60px;
        padding: 10px;
    }
</style>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
@if (Model == null)
{
    if (ViewBag.Message != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var message = "@ViewBag.Message";
                alert(message);

            };
        </script>
    }
}
else
{

    <html xmlns="http://www.w3.org/1999/xhtml">
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <title>Interview Letter</title>


    </head>
    <body style="width:800px; margin:auto; padding:5px; ">
        <div class="print-wrap" style="width: 800px; height: auto; ">
            <div class="BorderArea" style="border: solid 4px #6f3706;">
                <div class="header">
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td><img src="@Url.Content("~/Content/img/HCL_IL.jpg")" width="100%" height="188" /></td>
                        </tr>
                    </table>
                </div>
                <div class="printArea content" style="padding-top: 10px;">
                    <div class="printPanel page-1">

                        <!--<div class="entranceName">Interview Letter </div>-->
                        <table width="100%" border="0" cellspacing="0" cellpadding="3">
                            <tr>
                                <td>No.Estt/1/2013/2022-23/@Html.DisplayFor(model => model.code, null, new { @class = "form-control" })/@Html.DisplayFor(model => model.b, null, new { @class = "form-control" })</td>
                                <td align="right">Date: 14th November, 2022</td>
                            </tr>
                            <tr>
                                <td height="5" colspan="2"></td>
                            </tr>
                            <tr>
                                <td colspan="2" valign="top">
                                    <strong>Mr.&nbsp;<span style="text-transform:uppercase"> @Html.DisplayFor(model => model.ApplicantName, null, new { @class = "form-control" })</span> </strong><br />
                                    @Html.DisplayFor(model => model.strCorrespondenceAddress, null, new { @class = "form-control" })<br />
                                    @Html.DisplayFor(model => model.strDistrict, null, new { @class = "form-control" })<br />
                                    @Html.DisplayFor(model => model.strState, null, new { @class = "form-control" })- @Html.DisplayFor(model => model.strPin, null, new { @class = "form-control" })
                                </td>
                            </tr>
                            <tr>
                                <td height="10" colspan="2"></td>
                            </tr>
                            <tr>
                                <td colspan="2" valign="top">
                                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td width="40" valign="top"><strong>Sub</strong>:</td>
                                            <td>
                                                Interview for selection to the post of Graduate Engineer Trainee (@Html.DisplayFor(model => model.discipline, null, new { @class = "form-control" })) in the IDA Pay Scale of Rs. 40000 – 3%- 140000/- in Hindustan Copper Limited.
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td height="5" colspan="2"></td>
                            </tr>
                            <tr>
                                <td height="15" colspan="2">
                                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td width="40" valign="top"><strong>Ref</strong>:</td>
                                            <td>Registration No  <strong>@Html.DisplayFor(model => model.CandidateId, null, new { @class = "form-control" })</strong></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td height="5" colspan="2"></td>
                            </tr>
                            <tr>
                                <td colspan="2"></td>
                            </tr>
                            <tr>
                                <td colspan="2" valign="top">Sir / Madam,</td>
                            </tr>
                            <tr>
                                <td height="5" colspan="2"></td>
                            </tr>
                            <tr>
