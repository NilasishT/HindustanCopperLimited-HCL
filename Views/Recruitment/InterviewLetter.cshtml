                                            <td valign="top">ii.</td>
                                            <td>Declaration  Form-3 for SC / ST / OBC / EWS (if applicable)</td>
                                        </tr>
                                        <tr>
                                            <td valign="top">&nbsp;</td>
                                            <td valign="top">iii.</td>
                                            <td>SC / ST / OBC / EWS Certificate (if applicable)</td>
                                        </tr>
                                        <tr>
                                            <td valign="top">&nbsp;</td>
                                            <td valign="top">iv.</td>
                                            <td>Disability / Discharge Certificate (if applicable)</td>
                                        </tr>
                                        <tr>
                                            <td valign="top">&nbsp;</td>
                                            <td valign="top">v.</td>
                                            <td>Online Application Form and Acknowledgement Slip</td>
                                        </tr>
                                        <tr>
                                            <td valign="top">&nbsp;</td>
                                            <td valign="top">vi.</td>
                                            <td>10th Class Certificate & Mark Sheet</td>
                                        </tr>
                                        <tr>
                                            <td valign="top">&nbsp;</td>
