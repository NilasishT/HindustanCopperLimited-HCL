@model Hindustancopperlimited.Models.tbl_mst_CandidatePersonalDetails

@using Hindustancopperlimited.Controllers;
@using Hindustancopperlimited.Models;

@{
    ViewBag.Title = "Applicant Details";
    Layout = "~/Views/Shared/DashboardWithoutSideBarForNew.cshtml";
    bool IsShow = RecruitmentController.CheckEmailExclude();

    List<tblCasteCategories> castCatList = new List<tblCasteCategories>();
    using (tblCasteCategoriesContext castcat = new tblCasteCategoriesContext())
    {
        castCatList = castcat.tblCasteCategories.Where(a => a.IsActive == true).ToList();
    }
}

<style>

    .white {
        color: #4d070f;
        padding-right: 10px;
        padding-left: 10px;
    }

        .white:hover {
            color: White;
        }
</style>


