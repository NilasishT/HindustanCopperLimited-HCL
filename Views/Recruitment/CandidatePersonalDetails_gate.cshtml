                                    </div>
                                </div>
                                <label class="col-lg-4 control-label">Nearest Railway Station<span style="color:Red"> (*)</span></label>

                                <div class="form-group">
                                    <div class="col-lg-6">
                                        @Html.TextBoxFor(model => model.strPermanentNearestRailwayStation, null, new { @class = "form-control" })

                                    </div>
                                </div>
                                <label class="col-lg-4 control-label">Pin<span style="color:Red"> (*)</span></label>

                                <div class="form-group">
                                    <div class="col-lg-6">
                                        @Html.TextBoxFor(model => model.strPermanentPinCode, null, new { @class = "form-control" })

                                    </div>
                                </div>
                                <label class="col-lg-4 control-label">Telephone No.(With STD Code)</label>

                                <div class="form-group">
                                    <div class="col-lg-6">
                                        @Html.TextBoxFor(model => model.strPermanentTelephoneNo, null, new { @class = "form-control" })

                                    </div>
                                </div>
                                <label class="col-lg-4 control-label">Mobile No.</label>

                                <div class="form-group">
                                    <div class="col-lg-6">
                                        @Html.TextBoxFor(model => model.strPermanentMobile1, null, new { @class = "form-control" })

                                    </div>
                                </div>
                            </fieldset>
                        </div>
                        @*</div>*@
                    </div>
                    <div class="col-lg-12" style="border-top:1px solid #6f3706">
                    </div>
                    <div class="col-lg-12" style="padding-top:10px">
                        <div class="form-group">
                            <div class="col-lg-10 col-lg-offset-5">
                                @if (ViewBag.IsFinalSubmit != "Yes")
                                {
                                    <button type="submit" class="btn btn-primary" onclick="return error()" value="Submit" name="strSubmit" id="Submit">Save & Next</button>
                                }
                                <button type="button" class="btn btn-primary" onclick="location.href = '../Dashboard/@Url.RequestContext.RouteData.Values["id"]';" value="Submit" name="strSubmit">Dashboard</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>


}
@if (ViewBag.Message != null)
{
    <script type="text/javascript">
            var msg = "@ViewBag.Message";
            alert("@ViewBag.Message");
    </script>
}
<script src="@Url.Content("~/Content/js/Recruitementpersonaldetails.js?a="+DateTime.Now.ToString("yyyyMMddHHmm"))"></script>