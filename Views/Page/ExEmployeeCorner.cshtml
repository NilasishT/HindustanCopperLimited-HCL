@{
    ViewBag.Title = "Ex-Employee Corner";
    Layout = "~/Views/Shared/WebsitePage.cshtml";

}

<main role="main">
    <div class="colmidl">
        <h1 class="titile">Ex-Employee Corner</h1>
        <div id="viewTable">
            <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                    <th colspan="3" style="padding-top:6px; padding-bottom:6px;">Ex-Employee Corner</th>
                </tr>
                <tr>
                    <th style="padding-top:6px; padding-bottom:6px; width:65%;">News HeadLine</th>
                    <th style="padding-top:6px; padding-bottom:6px;">Reference Document</th>
                    <th style="padding-top:6px; padding-bottom:6px;">Reference Link</th>
                </tr>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="tblcol2t" height="24">@item.strSubjectdfsEnglish</td>
                        <td class="tblcol2t" height="24"><a href=@item.strFileEnglish.Replace("~", "../..") target="_blank">Download</a></td>
                        <td class="tblcol2t" height="24"><i class="fa fa-globe" style="font-size:30px;"></i></td>
                    </tr>
                }
            </table>
        </div>
        <!-- Icon after table -->
        <br />
        <h1 class="titile">Contact Us</h1>
        <div style="padding:10px; border-left:4px solid #00539B; background:#fff; border-radius:6px;">
            <p style="margin:0 0 6px 0;">
                The customer, communities and ex-employees may lodge their complaint / grievances, if any, at the following address / email id:
            </p>
            <p style="margin:0; font-weight:bold;">Hindustan Copper Limited</p>
            <p style="margin:0;"> Tamra Bhavan,</p>
            <p style="margin:0;">1, Ashutosh Chowdhury Avenue</p>
            <p style="margin:0;">Kolkata-700 019</p>
            <p style="margin:4px 0 0 0;">
                📞 Phone: <b>(033) 2283-2676 (Off.)</b><br />
                ✉️ Email: <a href="mailto:community_hcl@hindustancopper.com"
                             style="color:#00539B; text-decoration:none;">
                    community_hcl@hindustancopper.com
                </a><br />
                Website: <a href="www.hindustancopper.com" style="color:#00539B; text-decoration:none;">www.hindustancopper.com</a>
            </p>
        </div>
    </div>
</main>
