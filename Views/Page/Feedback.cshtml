@model Hindustancopperlimited.Models.tbl_feedback

@{
    ViewBag.Title = "Add Feedback | Hindustan Copper Limited";
    ViewBag.MetaDescription = "Hindustan Copper Limited (HCL) is India’s leading copper producer, engaged in copper mining, beneficiation, smelting, refining and downstream products.";
    ViewBag.MetaKeywords = "Hindustan Copper Limited, HCL, copper producer, copper mining, copper beneficiation, copper smelting, copper refining, copper products, copper cathodes, copper concentrates, copper rods, Ministry of Mines, HCL India.";

    Layout = "~/Views/Shared/WebsitePage.cshtml";
}

<style>
    .sr-only {
        position: absolute !important;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .form-control:focus-visible,
    .btn:focus-visible,
    .hc-captcha-refresh:focus-visible {
        outline: 3px solid #0b57d0;
        outline-offset: 2px;
    }

    .hc-captcha {
        text-align: center;
    }

    .hc-captcha-question {
        font-size: 30px;
        display: block;
        margin-bottom: 8px;
    }

    .hc-captcha-refresh img {
        width: 20%;
        height: auto;
        margin: 0;
        padding: 0;
    }
</style>

<main role="main" style="width: 100%;">
    <div class="col-lg-8  AddFeedbackFrm" style="float: unset; margin: auto;">
        <div class="well bs-component" style=" max-width: 100%; margin: 0 auto;">
            <h1>Add Feedback</h1>
            <p style="color: #DC3545!important">( * Fields are Mandatory )</p>

            @using (Html.BeginForm("Feedback", "Page", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
            {
                <div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label" for="Fk_titleid">Title</label>
                        <div class="col-lg-2">
                            @Html.DropDownList("Fk_titleid", null, new { @class = "form-control", autocomplete = "honorific-prefix" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-4 control-label" for="strf_name">First Name<span style="color: #DC3545" aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></label>
                        <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.strf_name, null, new { @class = "form-control", aria_required = "true", aria_describedby = "errmsg", id = "strf_name", autocomplete = "given-name" })<span id="errmsg" role="alert"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label" for="strm_name">Middle Name</label>
                        <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.strm_name, null, new { @class = "form-control", aria_describedby = "errmsg1", autocomplete = "additional-name" })<span id="errmsg1" role="alert"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label" for="strl_name">Last Name<span style="color: #DC3545" aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></label>
                        <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.strl_name, null, new { @class = "form-control", aria_required = "true", aria_describedby = "errmsg2", autocomplete = "family-name" })<span id="errmsg2" role="alert"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label" for="str_email">Email<span style="color: #DC3545" aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></label>
                        <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.str_email, new { @class = "form-control", aria_required = "true", aria_describedby = "errmsg3", autocomplete = "email", inputmode = "email" })<span id="errmsg3" role="alert"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label" for="str_ph">Telephone No</label>
                        <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.str_ph, new { @class = "form-control", aria_describedby = "errmsg4", autocomplete = "tel", inputmode = "tel" })<span id="errmsg4" role="alert"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label" for="str_zipcode">Pin Code</label>
                        <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.str_zipcode, new { @class = "form-control", aria_describedby = "errmsg5", autocomplete = "postal-code", inputmode = "numeric" })<span id="errmsg5" role="alert"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label" for="str_address">Address<span style="color: #DC3545" aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></label>
                        <div class="col-lg-6">
                            @Html.TextAreaFor(model => model.str_address, new { @class = "form-control", aria_required = "true", aria_describedby = "errmsg6", autocomplete = "street-address" })<span id="errmsg6" role="alert"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label" for="str_city">City<span style="color: #DC3545" aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></label>
                        <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.str_city, new { @class = "form-control", aria_required = "true", aria_describedby = "errmsg7", autocomplete = "address-level2" })<span id="errmsg7" role="alert"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label" for="str_state">State<span style="color: #DC3545" aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></label>
                        <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.str_state, new { @class = "form-control", aria_required = "true", aria_describedby = "errmsg8", autocomplete = "address-level1" })<span id="errmsg8" role="alert"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label" for="str_country">Country<span style="color: #DC3545" aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></label>
                        <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.str_country, null, new { @class = "form-control", aria_required = "true", aria_describedby = "errmsg9", autocomplete = "country-name" })<span id="errmsg9" role="alert"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label" for="str_comment">Your Comments<span style="color: #DC3545" aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></label>
                        <div class="col-lg-6">
                            @Html.TextAreaFor(model => model.str_comment, new { @class = "form-control", aria_required = "true", aria_describedby = "errmsg10", rows = "4" })<span id="errmsg10" role="alert"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label" for="str_cntactp">Contact person in HCL</label>
                        <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.str_cntactp, null, new { @class = "form-control", aria_describedby = "errmsg11" })<span id="errmsg11" role="alert"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-lg-6 col-lg-offset-4 hc-captcha">
                            <label for="answer" class="hc-captcha-question">
                                Security question: <span>@((HttpContext.Current.Session["query"] ?? "").ToString())</span> = ? <span class="sr-only">(enter the correct answer as a number)</span>
                            </label>
                            <input type="text" id="answer" aria-required="true" placeholder="Answer" name="answer" class="form-control" required autocomplete="off" inputmode="numeric">
                            <p>
                                <a class="hc-captcha-refresh" href="@Url.Action("Feedback")" title="Get a new security question">
                                    <img alt="Get a new security question" src="/Content/images/reCAPTCHA.jpeg" />
                                </a>
                            </p>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-lg-7 col-lg-offset-5">

                            <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
                            @Html.ActionLink("Cancel", "Index", "Home", null, new { @class = "btn btn-default" })
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</main>


@if (ViewBag.Message != null)
{
    <script type="text/javascript">
            alert("@ViewBag.Message");
    </script>
}


<script src="@Url.Content("~/Content/js/Feedback.js")"></script>
