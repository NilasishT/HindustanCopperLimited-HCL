@{
    ViewBag.Title = "Plantsand Offices";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}

@Html.Partial("~/Views/Shared/Page/About.cshtml")

<style>
    .plants-page-container {
        line-height: 1.8;
        color: #4A4A4A;
    }

    .plants-page-container h1.titile {
        font-size: 26px;
        color: #333333;
        border-bottom: 2px solid #dcdcdc;
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

    .filter-utility-bar {
        background-color: #f5eae1;
        border: 1px solid #e2d2c5;
        border-radius: 4px;
        padding: 15px;
        margin-bottom: 25px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .filter-select, .search-box-input {
        padding: 8px 12px;
        font-size: 14px;
        border: 1px solid #cccccc;
        border-radius: 4px;
        min-height: 44px;
        min-width: 180px;
        background-color: #ffffff;
    }

    .btn-share {
        display: inline-block;
        padding: 6px 14px;
        margin: 2px;
        background-color: #ffffff;
        color: #4A4A4A !important;
        text-decoration: none !important;
        border: 1px solid #cccccc;
        border-radius: 4px;
        font-size: 13px;
        min-height: 40px;
        transition: all 0.2s;
    }
    .btn-share:hover {
        background-color: #f5eae1;
        border-color: #a92323;
    }

    .plant-direct-link {
        color: #a34500 !important;
        text-decoration: none !important;
        font-weight: bold;
        font-size: 15px;
        padding: 8px 0;
        display: inline-block;
    }
    .plant-direct-link:hover, .plant-direct-link:focus {
        color: #003366 !important;
        outline: 2px solid #0066cc;
    }

    .table-responsive-container {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        margin-bottom: 25px;
    }

    .plant-item-row {
        border-bottom: 1px solid #eeeeee;
        transition: background-color 0.2s;
    }

    .plantlcol {
        padding: 15px 10px;
    }
    .plantrcol {
        padding: 15px 10px;
        vertical-align: middle;
    }

    .plantrcol img {
        width: 100%;
        height: auto;
        border: 1px solid #ddd;
        border-radius: 4px;
    }

    @@media (max-width: 768px) {
        .filter-utility-bar {
            flex-direction: column;
            align-items: stretch;
        }
        .filter-select, .search-box-input {
            width: 100%;
        }
        #plantsDataTable tr {
            display: flex;
            flex-direction: column;
            border-bottom: 2px solid #e2d2c5;
            padding-bottom: 15px;
        }
        #plantsDataTable td {
            width: 100% !important;
            display: block;
            text-align: left !important;
        }
        .plantrcol p {
            text-align: left !important;
        }
        .plantrcol img {
            max-width: 100%;
            margin-top: 10px;
        }
    }
</style>

