        font-size: 14px;
        border: 1px solid #cccccc;
        border-radius: 4px;
        min-height: 44px;
        min-width: 180px;
        background-color: #ffffff;
        box-sizing: border-box;
    }

    .btn-share {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        margin: 4px;
        background-color: #ffffff;
        color: #4A4A4A !important;
        text-decoration: none !important;
        border: 1px solid #cccccc;
        border-radius: 4px;
        font-size: 13px;
        min-height: 44px;
        min-width: 44px;
        box-sizing: border-box;
        transition: all 0.2s;
    }
    .btn-share:hover {
        background-color: #f5eae1;
        border-color: #a92323;
    }

    .plant-direct-link {
        color: #a34500 !important;
        text-decoration: none !important;
        font-weight: bold;
        font-size: 15.5px;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        box-sizing: border-box;
    }
    .plant-direct-link:hover, .plant-direct-link:focus {
        color: #003366 !important;
        outline: 2px solid #0066cc;
    }

    .table-responsive-container {
        width: 100%;
        margin-bottom: 25px;
    }

    #plantsDataTable {
        width: 100%;
        border-collapse: collapse;
    }

    .plant-item-row {
        border-bottom: 1px solid #eeeeee;
        transition: background-color 0.2s;
    }

    .plantlcol {
        padding: 20px 15px;
        vertical-align: top;
    }
    .plantrcol {
        padding: 20px 15px;
        vertical-align: middle;
        text-align: center;
    }

    .plantrcol img {
        max-width: 280px;
        width: 100%;
        height: auto;
        border: 1px solid #ddd;
        border-radius: 4px;
        display: inline-block;
    }

    @@media (max-width: 768px) {
        .filter-utility-bar {
            flex-direction: column;
            align-items: stretch;
        }
        .filter-select, .search-box-input {
            width: 100%;
        }
        .btn-share {
            display: block;
            width: 100%;
            text-align: center;
            margin: 6px 0;
        }

        #plantsDataTable, #plantsDataTable tbody, .plant-item-row, .plantlcol, .plantrcol {
            display: block !important;
            width: 100% !important;
            box-sizing: border-box !important;
            float: none !important;
            position: relative !important;
        }

        .plant-item-row {
            background-color: #ffffff !important;
            background-image: none !important;
            border: 1px solid #e2d2c5 !important;
            border-radius: 6px !important;
            margin-bottom: 30px !important;
            padding: 15px !important;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05) !important;
            overflow: hidden !important;
        }

        .plantlcol {
            padding: 0 0 15px 0 !important;
            border-bottom: 1px dashed #e2d2c5 !important;
            text-align: left !important;
        }

        .plantrcol {
            padding: 15px 0 0 0 !important;
            text-align: center !important;
            clear: both !important;
            height: unset;
        }

        .plantrcol p {
            text-align: center !important;
            margin: 0 !important;
        }

        .plantrcol img {
            max-width: 100% !important;
            width: 100% !important;
            height: auto !important;
            margin-top: 5px !important;
            display: block !important;
        }

        .plant-direct-link {
            width: 100%;
            background-color: #fdfaf7;
            border: 1px solid #eddcd0;
            border-radius: 4px;
            margin-bottom: 8px;
        }
    }
</style>

