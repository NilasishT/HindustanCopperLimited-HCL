</div>

<script>
        function filterPlants() {
            var dropdown = document.getElementById("stateFilter");
            var selectedState = dropdown.value.toUpperCase();

            var searchInput = document.getElementById("plantSearchInput");
            var filterText = searchInput.value.toUpperCase();

            var table = document.getElementById("plantsDataTable");
            var rows = table.getElementsByClassName("plant-item-row");

            for (var i = 0; i < rows.length; i++) {
                var row = rows[i];
                var rowState = row.getAttribute("data-state") ? row.getAttribute("data-state").toUpperCase() : "";
                var rowText = row.textContent || row.innerText;
                var rowTextUpper = rowText.toUpperCase();

                var stateMatches = (selectedState === "ALL" || rowState === selectedState);
                var textMatches = (rowTextUpper.indexOf(filterText) > -1);

                if (stateMatches && textMatches) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            }
        }
</script>
