@using Hindustancopperlimited.Helpers

@{
    ViewBag.Title = "Minister & Secretary | Hindustan Copper Limited";
    ViewBag.MetaDescription = "Hindustan Copper Limited (HCL) is India’s leading copper producer, engaged in copper mining, beneficiation, smelting, refining and downstream products.";
    ViewBag.MetaKeywords = "Hindustan Copper Limited, HCL, copper producer, copper mining, copper beneficiation, copper smelting, copper refining, copper products, copper cathodes, copper concentrates, copper rods, Ministry of Mines, HCL India.";

    Layout = "~/Views/Shared/WebsitePage.cshtml";
}

<style>
    .colmidlA_col1_pic img {
        display: inline-block;
        margin: 0 auto;
    }

    .colmidlA_col1_pic span {
        display: block;
        background: var(--dbim-bg-page);
        width: 200px;
        height: 200px;
        border: 1px solid var(--dbim-gray-01);
        border-radius: 4px;
        margin: 0 auto;
        overflow: hidden;
    }

        .colmidlA_col1_pic span img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: top center;
            border: 0;
        }
</style>



@Html.Partial("~/Views/Shared/Page/About.cshtml")

<div class="colmidl">
    <h1 class="titile">Minister & Secretary</h1>

    <div class="colmidlA">

        <div class="clear"></div>

        <div class="colmidlA_col1">
            <div class="colmidlA_col1_pic">
                <span>
                    <img src="@Url.VersionedImage("~/Content/img/ShriGKishanReddy.jpg")" alt="Shri G. Kishan Reddy"
                         style="border:0px;"
                         loading="lazy"
                         decoding="async" />
                </span>

                <h3>Shri G. Kishan Reddy</h3>
                <p>Hon'ble Minister of Mines</p>
            </div>
        </div>

