@{
    ViewBag.Title = "AudioOrVideoRecordings";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}

<div id="totalCol">
    <div class="wrap">
        @Html.Partial("SideBarMenu_InvestorRelations")
        <div class="colmidl">
            <h1 class="titile">Audio or Video recordings and transcripts of post earnings / quarterly calls</h1>

            <div id="viewTable">
                <table width="100%" cellpadding="0" cellspacing="0">
                    <tr>
                        <th colspan="2" style="padding-top:6px; padding-bottom:6px;">Audio or Video recordings and transcripts of Investors Meet</th>
                    </tr>
                    @foreach (var item in Model)
                    {
                        if (item.strEnglishFileUpload != null)
                        {
                            <tr>  <td class="tblcol2t" height="24"><a href=@item.strEnglishFileUpload.Replace("~", "../..") target="_blank">  @item.strEnglishText</a></td></tr>
                        }
                        else
                        {
                            <tr> <td class="tblcol2t" height="24"><a href="#">  @item.strEnglishText</a></td></tr>
                        }
                    }
                   
					<tr>
                        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/Transcript-of-Investor-Meet-to-Exchanges-18.09.2025.pdf")" target="_blank">Transcript of Investor Meet to Exchanges - 18.09.2025</a></td>
                    </tr>

				   <tr>
                        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/Audio-Recording-to-Exchanges-18.09.2025.pdf")" target="_blank">Audio Recording to Exchanges - 18.09.2025</a></td>
                    </tr>
					
					<tr>
                        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/HCL-Audio-Transcript.mp3")" target="_blank">Audio Recording of Investors Meet - 18.09.2025</a></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>