
@model Hindustancopperlimited.Models.SpotbookingRegistrationdetails

@{
    ViewBag.Title = "Spot Booking";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}

    <div class="colleft">
	<div class="sliderw">
    
    <ul class="sidebar-menu">
      <li class="sidebar-header">BUSINESS</li>
      <li><a href="@Url.Action("OfficeandGodown", "Page")"><i class="fa fa-users"></i><span>Office & Godown</span></a></li>
      <li><a href="@Url.Action("PriceCircular", "Page")"><i class="fa fa-address-book-o"></i><span>Price Circular</span></a></li>
      <li><a href="@Url.Action("SpotBooking", "Page")"><i class="fa fa-industry"></i><span>Spot Booking</span></a></li>
      <li><a href="@Url.Action("FeedbackandBusiness", "Page")"><i class="fa fa-building"></i><span>Feedback & Business</span></a></li>
      <li><a href="@Url.Action("MarketingPolicy", "Page")"><i class="fa fa-eye"></i><span>Marketing Policy</span></a></li>
      
      <li class="sidebar-header">OTHER INFORMATION</li>
     <li><a href="http://www.pgportal.gov.in/" target="_blank"><i class="fa fa-bullhorn"></i><span>Public Grievance</span></a></li>
      <li><a href="@Url.Action("RelatedLink", "Page")"><i class="fa fa-link"></i><span>Related Links</span></a></li>
      <li><a href="@Url.Action("RIAct", "Page")"><i class="fa fa-hand-rock-o"></i><span>Right to Information Act</span></a></li>
    </ul>
    </div>
    </div>
    <div class="colmidl">
        <h1 class="titile">Spot Booking</h1>

    <div class="col-lg-10">
    <div class="well bs-component">            
@using (Html.BeginForm("Login", "Spotbooking", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))

{
   
    <fieldset>
    <legend><b><span style="color:#6f3706; font-size:24px; padding-left:35%">User Login</span>   <span style="color:Red; font-size:14px; padding-left:25%"> (*) Fields are Mandatory </span></b></legend>
    <br />
    <br />
    <br />

                     
                        <div class="form-group">
                          <label class="col-lg-4 control-label">User Id <span style="color:Red"> (*)</span></label>
                          <div class="col-lg-3">
                           
                             @Html.TextBoxFor(model => model.str_code, null, new { @class = "form-control"})
                            
                          </div>
                        </div>
    
   
    
       <div class="form-group">
                          <label class="col-lg-4 control-label">Password <span style="color:Red"> (*)</span></label>
                          <div class="col-lg-3">
                           
                             @Html.PasswordFor(model => model.str_pw, new { @class = "form-control" })
                            
                          </div>
                        </div>
      
    
    
    
    
    
    
        <div class="form-group">
                          <label class="col-lg-4 control-label">  </label>
                          <div class="col-lg-3">
                           
                               <a href="@Url.Action("ForgotPassword", "Spotbooking")" style="color:Blue ; font-size:large ; font-style:inherit" > Forgot Password ?</a>
                            
                          </div>
                        </div>
                        <div class="form-group">
                          <div class="col-lg-6 col-lg-offset-4">
                           
                             <button type="submit" class="btn btn-primary" onclick="return error()">Log in</button>
                    

                     <a href="@Url.Action("SpotbookingRegistration", "Spotbooking")"> <button type ="button" class="btn btn-primary">New User</button></a>
                      @* <button type="reset" class="btn btn-default">Cancel</button>*@

                     @* <a href="@Url.Action("ForgotPassword")">    <button type ="button" class="btn btn-primary">Forgot Password</button></a>*@
                          </div>
        </div>
      </fieldset>   
    }
               
    </div>
</div>



@if (ViewBag.Message != null)
{
        <script type="text/javascript">
            window.onload = function () {
                alert("@ViewBag.Message");
                //  window.location.href = '/Admin/LisTTender'

            };
        </script>
}

    </div>