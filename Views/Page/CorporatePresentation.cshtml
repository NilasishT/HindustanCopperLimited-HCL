@{
    ViewBag.Title = "CorporatePresentation";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}

<div id="totalCol">
<div class="wrap">
  @Html.Partial("SideBarMenu_InvestorRelations")
  <div class="colmidl">
    <h1 class="titile">Corporate/ Investor Presentation</h2>
    
        <div id="viewTable">
        <table width="100%" cellpadding="0" cellspacing="0">
        
        <tr>
        <th colspan="2" style="padding-top:6px; padding-bottom:6px;">Corporate/ Investor Presentation </th>
        </tr>
        
        
            @foreach (var item in Model)
       {
           if (item.strEnglishFileUpload != null)
           {           
            <tr>  <td class="tblcol2t" height="24"><a href=@item.strEnglishFileUpload.Replace("~", "../..") target="_blank">  @item.strEnglishText</a></td></tr>
           }
           else
           {
                    <tr> <td class="tblcol2t" height="24"><a href="#" >  @item.strEnglishText</a></td></tr>
           }
       }
        		
		<tr>
        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/CP_Aug_2021.pdf")" target="_blank">Corporate Presentation - August 2021</a></td>
        </tr>
		
        </table>

       
        
        </div>
        
        </div></div></div>
