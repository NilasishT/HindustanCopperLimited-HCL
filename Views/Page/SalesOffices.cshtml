            <label for="officeSearch" style="font-weight: bold; margin-right: 5px;">Filter Offices:</label>
            <input type="text" id="officeSearch" class="search-input" placeholder="Type City or Office Name..." onkeyup="filterOfficesTable()" aria-label="Search offices by name or location" />
        </div>
        <div>
            <span style="font-weight: bold; margin-right: 5px; font-size: 13px;">Share Page:</span>
            <a href="https://facebook.com" target="_blank" class="btn-share" rel="noopener" aria-label="Share on Facebook">Facebook</a>
            <a href="https://twitter.com" target="_blank" class="btn-share" rel="noopener" aria-label="Share on Twitter">Twitter</a>
            <button onclick="navigator.clipboard.writeText(window.location.href); alert('Page link copied!');" class="btn-share" style="cursor:pointer;" aria-label="Copy link">Copy Link</button>
        </div>
    </div>

    <div id="viewTable" class="table-responsive-container">
        <table id="officesDataTable">
            <tr class="office-row">
                <td rowspan="3"><p class="tblcol1h" style="font-weight: bold; margin:0;">Corporate Office</p></td>
                <td><p class="tblcol2h" style="font-weight: bold; margin:0;">Address</p></td>
                <td>
                    <p class="tblcol2t" style="margin:0;">
                        Hindustan Copper Limited <br />
                        Tamra Bhavan, <br />
                        1, Ashutosh Chowdhury Avenue,<br />
                        Kolkata – 700 019
                    </p>
                </td>
            </tr>
            <tr class="office-row">
                <td><p class="tblcol2h" style="font-weight: bold; margin:0;">Phone</p></td>
                <td>
                    <p class="tblcol2t" style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin:0;">
                        <a href="tel:03322832226" class="office-cta-btn" aria-label="Call Corporate Office at 033-22832226">033-22832226 [Call]</a>
                    </p>
                </td>
            </tr>
            <tr class="office-row">
                <td><p class="tblcol2h" style="font-weight: bold; margin:0;">Email</p></td>
                <td>
                    <p class="tblcol2t" style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin:0;">
                        <a href="mailto:chandraker_a@hindustancopper.com" class="office-cta-btn" aria-label="Email Corporate Office at chandraker_a@hindustancopper.com">chandraker_a@hindustancopper.com [Email]</a>
                    </p>
                </td>
            </tr>

            <tr class="office-row">
                <td rowspan="3"><p class="tblcol1h" style="font-weight: bold; margin:0;">Coordination Office - New Delhi</p></td>
                <td><p class="tblcol2h" style="font-weight: bold; margin:0;">Address</p></td>
                <td>
                    <p class="tblcol2t" style="margin:0;">
                        Hindustan Copper Limited <br />
                        “Scope Minar”, <br />
                        2nd Floor, North Tower, <br />
                        Laxmi Nagar,<br />
                        Delhi-110 092
                    </p>
                </td>
            </tr>
            <tr class="office-row">
                <td><p class="tblcol2h" style="font-weight: bold; margin:0;">Phone</p></td>
                <td>
                    <p class="tblcol2t" style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin:0;">
                        <a href="tel:01122445010" class="office-cta-btn" aria-label="Call Delhi Office at 011-22445010">011-22445010 [Call]</a>
                    </p>
                </td>
            </tr>
            <tr class="office-row">
                <td><p class="tblcol2h" style="font-weight: bold; margin:0;">Email</p></td>
                <td>
                    <p class="tblcol2t" style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin:0;">
                        <a href="mailto:jaswant_kr@hindustancopper.com" class="office-cta-btn" aria-label="Email Delhi Office at jaswant_kr@hindustancopper.com">jaswant_kr@hindustancopper.com [Email]</a>
                    </p>
                </td>
            </tr>
        </table>
    </div>
</div>

<script>
    function filterOfficesTable() {
        var input = document.getElementById("officeSearch");
        var filter = input.value.toUpperCase();
        var table = document.getElementById("officesDataTable");
        var rows = table.getElementsByClassName("office-row");

        for (var i = 0; i < rows.length; i += 3) {
            var row1 = rows[i];
            var row2 = rows[i + 1];
            var row3 = rows[i + 2];

            if (row1) {
                var cells = row1.getElementsByTagName("td");

                if (cells.length >= 3) {
                    var cellTarget = cells[0];
                    var addressTarget = cells[2];

                    var officeNameText = cellTarget.textContent || cellTarget.innerText;
                    var addressText = addressTarget.textContent || addressTarget.innerText;
                    var combinedText = (officeNameText + " " + addressText).toUpperCase();

                    if (combinedText.indexOf(filter) > -1) {
                        row1.style.display = "";
                        if (row2) row2.style.display = "";
                        if (row3) row3.style.display = "";
                    } else {
                        row1.style.display = "none";
                        if (row2) row2.style.display = "none";
                        if (row3) row3.style.display = "none";
                    }
                }
            }
        }
    }
</script>



