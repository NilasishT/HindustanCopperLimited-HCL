@{
    ViewBag.Title = "Sales Offices";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}

@Html.Partial("~/Views/Shared/Page/About.cshtml")

<style>
    .colmidl {
        color: #4A4A4A;
    }

        .colmidl h1.titile {
            font-size: 26px;
            color: #333333;
            border-bottom: 2px solid #dcdcdc;
            padding-bottom: 10px;
            margin-bottom: 20px;
            font-weight: bold;
        }

    .utility-search-bar {
        background-color: #f5eae1;
        border: 1px solid #e2d2c5;
        border-radius: 4px;
        padding: 12px 15px;
        margin-bottom: 20px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .search-input {
        padding: 8px 12px;
        font-size: 14px;
        border: 1px solid #cccccc;
        border-radius: 4px;
        min-width: 200px;
        min-height: 44px;
        box-sizing: border-box;
    }

    .btn-share {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        margin: 4px;
        background-color: #ffffff;
        color: #4A4A4A !important;
        text-decoration: none !important;
        border: 1px solid #cccccc;
        border-radius: 4px;
        font-size: 13px;
        min-height: 44px;
        min-width: 44px;
        box-sizing: border-box;
    }

        .btn-share:hover {
            background-color: #f5eae1;
            border-color: #a92323;
        }

    .table-responsive-container {
        width: 100%;
        margin-bottom: 25px;
        border: 1px solid #dcdcdc;
        border-radius: 4px;
    }

    #officesDataTable {
        width: 100%;
        border-collapse: collapse;
    }

        #officesDataTable td {
            padding: 12px;
            border-bottom: 1px solid #e0e0e0;
            vertical-align: top;
        }

    .office-cta-btn {
        color: #0066cc !important;
        text-decoration: underline !important;
        font-size: 16px !important;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 4px 8px;
        box-sizing: border-box;
    }

        .office-cta-btn:hover {
            color: #003366 !important;
        }

    @@media (max-width: 768px) {
        .utility-search-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-input {
            width: 100%;
        }

        .btn-share {
            display: block;
            width: 100%;
            text-align: center;
            margin: 6px 0;
        }
        #officesDataTable, #officesDataTable tbody {
            display: block;
            width: 100% !important;
        }
            #officesDataTable tr {
                display: grid !important;
                grid-template-columns: 1fr;
                margin-bottom: 20px;
                background: #ffffff;
                border: 1px solid #ccc;
                border-radius: 6px;
                padding: 10px;
                box-sizing: border-box;
            }

            #officesDataTable td {
                border: none !important;
                padding: 6px 8px !important;
                width: 100% !important;
                box-sizing: border-box;
            }
                #officesDataTable td[rowspan] {
                    background-color: #f8f9fa;
                    font-weight: bold;
                    font-size: 16px;
                    border-bottom: 2px solid #1e7e34 !important;
                    padding: 10px 8px !important;
                    border-radius: 4px 4px 0 0;
                    margin-bottom: 6px;
                }
        .tblcol2h {
            color: #333333;
            margin-bottom: 2px !important;
        }

        .office-cta-btn {
            display: flex;
            width: 100%;
            background-color: #f8f9fa;
            border: 1px solid #ddd;
            border-radius: 4px;
            margin-top: 4px;
            padding-left: 12px;
        }
    }
</style>
<div class="colmidl">
