<script>
    function openModal(id) {
        var modal = document.getElementById(id);
        modal.style.display = 'block';

        window.addEventListener('click', function (event) {
            if (event.target == modal) {
                closeModal(id);
            }
        });
    }
    function closeModal(id) {
        var modal = document.getElementById(id);
        modal.style.display = 'none';
    }
</script>
