    <!-- Citizen Services and Online Resources -->
    <section class="citizen-service-journey"
             aria-labelledby="citizenJourneyTitle">

        <h1 id="citizenJourneyTitle">
            Citizen Services &amp; Online Resources
        </h1>

        <p class="journey-intro">
            Access important services, submit feedback, and find
            information through the following links.
        </p>

        <p class="journey-note">
            These are separate services. Choose the one you need. Each service
            below shows how to submit a request, track its status and view the
            response, where these functions are available.
        </p>

        <div class="journey-steps">

            <div class="journey-step">
                @* <span class="journey-step-number"
                    aria-hidden="true">1</span> *@

                <h2>Public Grievance</h2>

                <p>
                    Visit the public grievance portal to submit
                    and follow up on grievances.
                </p>

                <button type="button"
                        class="journey-action"
                        onclick="window.open('https://pgportal.gov.in/', '_blank', 'noopener,noreferrer')">
                    Visit Grievance Portal
                </button>

                <p class="journey-group-label">Submit, track and view the outcome</p>
                <ul class="journey-service-links">
                    <li><a class="journey-service-link" href="https://pgportal.gov.in/" target="_blank" rel="noopener noreferrer">Submit a grievance<span class="journey-sr"> (opens the CPGRAMS portal in a new tab)</span></a></li>
                    <li><a class="journey-service-link" href="https://pgportal.gov.in/" target="_blank" rel="noopener noreferrer">Track grievance status<span class="journey-sr"> (opens the CPGRAMS portal in a new tab)</span></a></li>
                    <li><a class="journey-service-link" href="https://pgportal.gov.in/" target="_blank" rel="noopener noreferrer">View the response to your grievance<span class="journey-sr"> (opens the CPGRAMS portal in a new tab)</span></a></li>
                </ul>
                <p class="journey-note">
                    You must register and sign in on the portal. After you submit,
                    the portal gives you a grievance registration number. Keep it.
                    Use it on the portal to track the status and to read the reply.
                </p>
            </div>

            <div class="journey-step">
                @* <span class="journey-step-number"
                    aria-hidden="true">2</span> *@

                <h2>Right to Information</h2>

                <p>
                    Access information about the RTI process
                    and related resources on the HCL website.
                </p>

                @*<button type="button"
                            class="journey-action"
                            onclick="window.location.href='@Url.Action("RIAct", "Page")'">
