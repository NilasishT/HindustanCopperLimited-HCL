@{
    ViewBag.Title = "Company Profile";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}

@Html.Partial("~/Views/Shared/Page/About.cshtml")

<style>
    .colmidl {
        color: #2b2b2b;
        padding: 0 15px;
        line-height: 1.8;
    }

    .card {
        background: #ffffff;
        margin-bottom: 30px;
        padding: 20px;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
    }

    .colmidl h1.titile, .colmidl h2.titile, .colmidl h3.titile {
        color: #111111;
        border-bottom: 2px solid #dcdcdc;
        padding-bottom: 10px;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .colmidl h1.titile {
        font-size: 28px;
    }

    .colmidl h2.titile {
        font-size: 22px;
        margin-top: 15px;
    }

    .colmidl h3.titile {
        font-size: 18px;
        border-bottom: 1px dashed #dcdcdc;
    }

    .profile-utility-bar {
        background-color: #f5eae1;
        border: 1px solid #e2d2c5;
        border-radius: 4px;
        padding: 15px;
        margin-bottom: 25px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .utility-group {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 15px;
    }

    .search-box-input, .lang-select {
        padding: 8px 12px;
        font-size: 15px;
        border: 1px solid #a1a1a1;
        border-radius: 4px;
        min-height: 44px;
        background-color: #ffffff;
        box-sizing: border-box;
        color: #111111;
    }

    .search-box-input {
        min-width: 240px;
    }

    .lang-select {
        min-width: 150px;
        font-weight: 500;
    }

    .btn-share {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        margin: 4px;
        background-color: #ffffff;
        color: #2b2b2b !important;
        text-decoration: none !important;
        border: 1px solid #a1a1a1;
        border-radius: 4px;
        font-size: 14px;
        min-height: 44px;
        min-width: 44px;
        box-sizing: border-box;
        transition: all 0.2s;
        font-weight: 500;
    }

        .btn-share:hover {
            background-color: #f5eae1;
            border-color: #a92323;
        }

    .colmidl p {
        font-size: 15.5px;
        color: #2b2b2b;
        margin-bottom: 15px;
        text-align: justify;
    }

    .colmidl ul {
        padding-left: 20px;
        margin-bottom: 20px;
    }

    .colmidl li {
        margin-bottom: 10px;
        font-size: 15px;
    }

    .profile-data-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
        margin-bottom: 15px;
    }

        .profile-data-table td {
            padding: 14px 12px;
            border-bottom: 1px solid #dddddd;
            vertical-align: top;
            font-size: 15px;
            color: #2b2b2b;
            line-height: 1.7;
        }

        .profile-data-table tr:last-child td {
            border-bottom: 2px solid #cccccc;
        }

    .profile-direct-link {
        color: #a34500 !important;
        text-decoration: none !important;
        font-weight: bold;
        font-size: 15px;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        box-sizing: border-box;
    }

        .profile-direct-link:hover, .profile-direct-link:focus {
            color: #003366 !important;
            outline: 2px solid #0066cc;
        }

    .citizen-summary-box {
        background-color: #f0f7f4;
        border-left: 5px solid #2e7d32;
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 0 4px 4px 0;
    }

    @@media (max-width: 768px) {
        .profile-utility-bar {
            flex-direction: column;
            align-items: stretch;
            gap: 20px;
        }

        .utility-group {
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
        }

        .profile-utility-bar label, .profile-utility-bar span {
            display: block;
            margin-bottom: 4px;
        }

        .search-box-input, .lang-select {
            width: 100%;
        }

        .btn-share {
            display: block;
            width: 100%;
            text-align: center;
            margin: 6px 0;
        }

        .profile-data-table, .profile-data-table tbody, .profile-data-table tr, .profile-data-table td {
            display: block !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }

            .profile-data-table tr {
                background-color: #ffffff !important;
                border: 1px solid #e2d2c5 !important;
                border-radius: 6px;
                margin-bottom: 20px;
                padding: 14px;
                box-shadow: 0 2px 5px rgba(0,0,0,0.04);
            }

            .profile-data-table td {
                border: none !important;
                padding: 4px 6px !important;
            }

                .profile-data-table td:first-child {
                    font-size: 16px;
                    color: #a34500;
                    font-weight: bold;
                    border-bottom: 1px dashed #e2d2c5 !important;
                    padding-bottom: 8px !important;
                    margin-bottom: 8px;
                }

        .profile-direct-link {
            width: 100%;
            background-color: #fdfaf7;
            border: 1px solid #eddcd0;
            border-radius: 4px;
        }
    }
</style>
<style>
    /* Citizen Service Journey */
    .citizen-service-journey {
        margin: 20px 0;
        padding: 22px;
        background: #f8f9fa;
        border: 1px solid #dedede;
        border-radius: 5px;
    }

        /* Section heading */
        .citizen-service-journey h1,
        .citizen-service-journey h2 {
            margin: 0 0 8px;
            color: #a34500;
            font-size: 22px;
            line-height: 1.5;
        }

    /* Introduction text */
    .journey-intro {
        margin: 0 0 18px;
        color: #333;
        line-height: 1.6;
    }

    /* Journey steps layout */
    .journey-steps {
        display: flex;
        gap: 16px;
    }

    /* Individual step card */
    .journey-step {
        flex: 1;
        min-width: 0;
        padding: 18px;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 5px;
        box-sizing: border-box;
    }

    /* Numbered circle */
    .journey-step-number {
        display: inline-flex;
        width: 34px;
        height: 34px;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #a34500;
        color: #fff;
        font-weight: bold;
        font-size: 16px;
    }

    /* Step heading */
    .journey-step h3 {
        margin: 12px 0 8px;
        color: #222;
        font-size: 17px;
        line-height: 1.5;
    }

    /* Step description */
    .journey-step p {
        margin: 0 0 10px;
        color: #444;
        line-height: 1.6;
    }

    /* Journey buttons */
    button.journey-action {
        display: inline-block;
        margin-top: 8px;
        padding: 10px 16px;
        background-color: #a34500;
        border: 1px solid #a34500;
        border-radius: 4px;
        color: #fff;
        font-family: inherit;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
        line-height: 1.5;
        text-align: center;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        box-sizing: border-box;
    }

        /* Button hover */
        button.journey-action:hover {
            background-color: #873900;
            border-color: #873900;
            color: #fff;
        }

        /* Keyboard accessibility */
        button.journey-action:focus-visible {
            outline: 2px solid #005fcc;
            outline-offset: 3px;
        }

        /* Button active state */
        button.journey-action:active {
            background-color: #6f2f00;
            border-color: #6f2f00;
        }

    /* Responsive layout for tablets and mobile */
    @@media (max-width: 768px) {
        .citizen-service-journey {
            padding: 15px;
        }

        .journey-steps {
            flex-direction: column;
            gap: 12px;
        }

        .journey-step {
            width: 100%;
        }

            .journey-step h3 {
                font-size: 16px;
            }

        button.journey-action {
            min-height: 44px;
            padding: 10px 16px;
        }
    }

    .journey-step .journey-action + .journey-action {
        margin-left: 6px;
    }
</style>



<style>
    /* ===== Compliance additions (UX4G / GIGW) - extends existing theme, no existing rule changed ===== */

    /* Readability: consistent paragraph rhythm inside cards */
    .colmidl .card p {
        line-height: 1.8;
        margin-bottom: 16px;
    }

    .colmidl .card h3.titile {
        margin-top: 28px;
    }

    .colmidl .card h2.titile + h3.titile,
    .colmidl .card .citizen-summary-box + h3.titile {
        margin-top: 22px;
    }

    .profile-facility-list li strong {
        color: #a34500;
    }

    /* Core values */
    .core-values-intro {
        text-align: left;
    }

    .core-values-list {
        list-style: none;
        padding-left: 0 !important;
        margin: 0 0 10px 0;
    }

        .core-values-list li {
            background-color: #fdfaf7;
            padding: 12px 14px;
            margin-bottom: 12px;
            border-left: 4px solid #a34500;
            border-radius: 0 4px 4px 0;
            line-height: 1.7;
        }

            .core-values-list li strong {
                display: block;
                color: #a34500;
                font-size: 16px;
                margin-bottom: 4px;
            }

    /* Citizen services: labelled submit / track / outcome links */
    .journey-note {
        text-align: left;
        font-size: 14px;
        color: #333333;
        background-color: #fdfaf7;
        border-left: 4px solid #a34500;
        border-radius: 0 4px 4px 0;
        padding: 10px 12px;
        margin: 12px 0 0;
        line-height: 1.6;
    }

    .journey-group-label {
        text-align: left;
        font-weight: bold;
        font-size: 14px;
        color: #222222;
        margin: 16px 0 6px !important;
    }

    .journey-service-links {
        list-style: none;
        padding: 0 !important;
        margin: 0 0 6px 0;
    }

        .journey-service-links li {
            margin: 0 0 8px 0;
            font-size: 14px;
        }

    .journey-service-link {
        display: flex;
        align-items: center;
        min-height: 44px;
        padding: 8px 12px;
        background-color: #ffffff;
        border: 1px solid #a34500;
        border-radius: 4px;
        color: #a34500 !important;
        font-weight: bold;
        font-size: 14px;
        line-height: 1.4;
        text-decoration: none !important;
        box-sizing: border-box;
    }

        .journey-service-link:hover {
            background-color: #f5eae1;
            color: #873900 !important;
        }

        .journey-service-link:focus-visible {
            outline: 2px solid #005fcc;
            outline-offset: 3px;
        }

    .journey-sr {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* Mobile: left-aligned text, comfortable spacing */
    @@media (max-width: 768px) {
        .colmidl .card p,
        .colmidl .card li {
            text-align: left;
            line-height: 1.8;
        }

        .colmidl .card p {
            margin-bottom: 18px;
        }

        .colmidl .card ul {
            padding-left: 20px;
        }

        .journey-service-link {
            width: 100%;
        }
    }
</style>

