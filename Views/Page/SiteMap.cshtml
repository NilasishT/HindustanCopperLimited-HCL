@using Hindustancopperlimited.Models
@{

    ViewBag.Title = "Site Map | Hindustan Copper Limited";
    ViewBag.MetaDescription = "Hindustan Copper Limited (HCL) is India’s leading copper producer, engaged in copper mining, beneficiation, smelting, refining and downstream products.";
    ViewBag.MetaKeywords = "Hindustan Copper Limited, HCL, copper producer, copper mining, copper beneficiation, copper smelting, copper refining, copper products, copper cathodes, copper concentrates, copper rods, Ministry of Mines, HCL India.";

    Layout = "~/Views/Shared/WebsitePage.cshtml";
}

<style>
    .siteMap {
        width: 50%;
        float: left;
        vertical-align: top;
        margin-top: 1%;
    }

        .siteMap ul {
            width: 100%;
        }

            .siteMap ul li {
                list-style-type: square;
                font-family: "Noto Sans", sans-serif !important;
                font-size: 14px;
                text-align: left;
                padding: 4px 0;
            }

                .siteMap ul li a {
                    text-decoration: none !important;
                    color: #916100;
                }

                    .siteMap ul li a:hover {
                        width: 100%;
                        text-decoration: none !important;
                        color: #916100;
                        background-color: #ffeecc;
                    }

                .siteMap ul li ul li {
                    list-style-type: disc;
                    font-family: "Noto Sans", sans-serif !important;
                    font-size: 14px;
                    text-align: left;
                    padding: 2px 0;
                }

                    .siteMap ul li ul li a {
                        text-decoration: none;
                        color: #916100;
                    }

    .maindiv {
        width: 100%;
        margin: 0 auto;
    }

    .wrap {
        width: 90%;
        margin: 0 auto;
    }

    .leftCol {
        width: 24%;
        float: left;
        overflow: hidden;
        border: solid 1px #C6C6C6;
    }

    .comDiv {
        width: 100%;
        float: left;
    }

    .comDivIn {
        width: 98%;
        margin: 0 auto;
        background-color: #916100;
    }

    .pText1 {
        font-size: 18px;
        text-transform: uppercase;
        color: #FFF;
        font-family: "Noto Sans", sans-serif !important;
        text-align: center;
        padding: 10px 0;
        margin: 1% 0 0 0;
    }

    .pText2 {
        font-size: 16px;
        text-transform: uppercase;
        font-weight: 600;
        font-family: "Noto Sans", sans-serif !important;
        color: #916100;
        text-align: left;
        padding-left: 4%;
        margin: 0;
    }

    .pText3 {
        font-size: 14px;
        text-transform: uppercase;
        font-weight: 600;
        font-family: "Noto Sans", sans-serif !important;
        color: #1A1D5E;
        ;
        text-align: left;
        padding-left: 4%;
        margin: 4% 0 0 0;
    }

    .RightCol {
        width: 73%;
        float: right;
        overflow: hidden;
        border: solid 1px #C6C6C6;
    }

    /* ---- accessibility / responsive additions ---- */
    .sitemap-title {
        font-size: 28px;
        color: #150202;
        padding-bottom: 10px;
        margin: 0;
        font-weight: bold;
    }

    h2.pText1 {
        font-weight: normal;
    }

    h2.pText2 {
        font-weight: 600;
    }

    h3.pText3 {
        font-weight: 600;
    }

    .siteMap ul li h3.siteMapSection {
        font-family: "Noto Sans", sans-serif !important;
        font-size: 14px;
        font-weight: bold;
        color: #916100;
        margin: 0;
        padding: 0;
    }

    .siteMap ul li a:focus-visible {
        outline: 3px solid #0B57D0;
        outline-offset: 2px;
    }

    .wrap::after {
        content: "";
        display: table;
        clear: both;
    }

    .sr-only {
        position: absolute !important;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    @@media (max-width: 991px) {
        .leftCol, .RightCol, .siteMap {
            width: 100%;
            float: none;
        }

        .wrap {
            width: 95%;
        }

        .leftCol {
            box-sizing: border-box;
            margin-bottom: 15px;
        }
    }
</style>


