@model IEnumerable<Hindustancopperlimited.Models.UploadPhotoGallery>

@{
    ViewBag.Title = "Photo Gallery | Hindustan Copper Limited";
    ViewBag.MetaDescription = "Hindustan Copper Limited (HCL) is India’s leading copper producer, engaged in copper mining, beneficiation, smelting, refining and downstream products.";
    ViewBag.MetaKeywords = "Hindustan Copper Limited, HCL, copper producer, copper mining, copper beneficiation, copper smelting, copper refining, copper products, copper cathodes, copper concentrates, copper rods, Ministry of Mines, HCL India.";

    Layout = "~/Views/Shared/WebsitePage.cshtml";
}


@functions {
    private const int ThumbWidth = 280;   // DBIM recommendation: ~280px wide thumbnail
    private const int ThumbQuality = 80;  // JPEG quality (1-100)
    private const string ThumbFolder = "~/Content/GalleryThumbs/";

    private string GetThumbnailUrl(string imagePath)
    {
        string originalUrl = Url.Content(imagePath);

        try
        {
            if (string.IsNullOrWhiteSpace(imagePath) ||
                imagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            {
                return originalUrl;
            }

            string originalFile = Server.MapPath(Uri.UnescapeDataString(originalUrl));
            if (!System.IO.File.Exists(originalFile))
            {
                return originalUrl;
            }

            string thumbFolder = Server.MapPath(ThumbFolder);
            System.IO.Directory.CreateDirectory(thumbFolder);

            string key = originalUrl.ToLowerInvariant()
                         + System.IO.File.GetLastWriteTimeUtc(originalFile).Ticks
                         + "_" + ThumbWidth;
            string thumbName = GetHash(key) + ".jpg";
            string thumbFile = System.IO.Path.Combine(thumbFolder, thumbName);

            if (!System.IO.File.Exists(thumbFile))
            {
                if (!CreateThumbnail(originalFile, thumbFile))
                {
                    return originalUrl;
                }
            }

            return Url.Content(ThumbFolder + thumbName);
        }
        catch
        {
            return originalUrl;
        }
    }

    private bool CreateThumbnail(string originalFile, string thumbFile)
    {
        string tempFile = thumbFile + "." + Guid.NewGuid().ToString("N") + ".tmp";

        using (var stream = new System.IO.FileStream(originalFile, System.IO.FileMode.Open,
                                                     System.IO.FileAccess.Read, System.IO.FileShare.Read))
        using (var original = System.Drawing.Image.FromStream(stream))
        {
            if (original.Width <= ThumbWidth)
            {
                return false;
            }

            int thumbHeight = (int)Math.Round(original.Height * (double)ThumbWidth / original.Width);

            using (var thumb = new System.Drawing.Bitmap(ThumbWidth, thumbHeight))
            using (var graphics = System.Drawing.Graphics.FromImage(thumb))
            {
                graphics.Clear(System.Drawing.Color.White);
                graphics.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.HighQualityBicubic;
                graphics.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.HighQuality;
                graphics.PixelOffsetMode = System.Drawing.Drawing2D.PixelOffsetMode.HighQuality;
                graphics.DrawImage(original, 0, 0, ThumbWidth, thumbHeight);

                var jpegCodec = System.Array.Find(
                    System.Drawing.Imaging.ImageCodecInfo.GetImageEncoders(),
                    c => c.MimeType == "image/jpeg");

                using (var encoderParams = new System.Drawing.Imaging.EncoderParameters(1))
                {
                    encoderParams.Param[0] = new System.Drawing.Imaging.EncoderParameter(
                        System.Drawing.Imaging.Encoder.Quality, (long)ThumbQuality);
                    thumb.Save(tempFile, jpegCodec, encoderParams);
                }
            }
        }

        if (System.IO.File.Exists(thumbFile))
        {
            System.IO.File.Delete(tempFile);
        }
        else
        {
            System.IO.File.Move(tempFile, thumbFile);
        }
        return true;
    }

    private static string GetHash(string text)
    {
        using (var md5 = System.Security.Cryptography.MD5.Create())
        {
            byte[] bytes = md5.ComputeHash(System.Text.Encoding.UTF8.GetBytes(text));
            return BitConverter.ToString(bytes).Replace("-", "").ToLowerInvariant();
        }
    }

    // Short alt text (about 125 characters) taken from the start of the caption.
    // The full caption stays visible in the <figcaption>.
    private static string ShortAlt(string text, int max)
    {
        if (string.IsNullOrWhiteSpace(text)) { return ""; }
        string t = System.Text.RegularExpressions.Regex.Replace(text, "<[^>]+>", " ");
        t = System.Net.WebUtility.HtmlDecode(t);
        t = System.Text.RegularExpressions.Regex.Replace(t, @"\s+", " ").Trim();
        if (t.Length <= max) { return t; }
        int cut = t.LastIndexOf(' ', max);
        if (cut < max / 2) { cut = max; }
        return t.Substring(0, cut).TrimEnd(',', ';', ':', '-', ' ') + "…";
    }
}

<style>
    .gtabimg {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 6px;
        cursor: pointer;
        transition: transform 0.3s;
        background-color: transparent;
    }

        .gtabimg:hover {
            transform: scale(1.05);
        }

    @@media (prefers-reduced-motion: reduce) {
        .gtabimg {
            transition: none;
        }

            .gtabimg:hover {
                transform: none;
            }
    }

    .gtabimgcap {
        font-size: 14px;
        color: #5D3E00;
        padding: 8px;
        text-align: left;
    }

    .gallery-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    li.gallery-cell {
        padding: 10px;
        text-align: center;
        min-width: 0;
    }

        li.gallery-cell figure {
            margin: 0;
        }

    @@media (max-width: 991px) {
        .gallery-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 575px) {
        .gallery-grid {
            grid-template-columns: 1fr;
        }
    }

    .gallery-link {
        display: block;
        border: 0;
        text-decoration: none;
    }

        .gallery-link img {
            border: 0;
        }

        .gallery-link:focus-visible {
            outline: 3px solid #0b57d0;
            outline-offset: 3px;
        }

    #imgModal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.95);
    }

    #modalImg {
        margin: auto;
        display: block;
        max-width: 100%;
        max-height: 100%;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        border-radius: 8px;
    }

    #caption {
        margin: auto;
        display: block;
        text-align: center;
        color: #ccc;
        padding: 10px;
        font-size: 16px;
    }

    #closeModal {
        position: absolute;
        top: 20px;
        right: 35px;
        color: #fff;
        font-size: 40px;
        font-weight: bold;
        line-height: 1;
        cursor: pointer;
        background: none;
        border: 0;
        padding: 4px 10px;
    }

        #closeModal:focus-visible {
            outline: 3px solid #fff;
            outline-offset: 2px;
        }
</style>

<script>
    $(document).ready(function () {
        var $modal = $("#imgModal");
        var $close = $("#closeModal");
        var lastFocus = null;

        function openModal($trigger) {
            lastFocus = $trigger[0];
            var $thumb = $trigger.find("img");
            $("#modalImg")
                .attr("src", $trigger.attr("href"))
                .attr("alt", $thumb.attr("alt") || "");
            $modal.stop(true, true).fadeIn(150, function () {
                $close.trigger("focus");
            });
        }

        function closeModal() {
            if (!$modal.is(":visible")) { return; }
            $modal.stop(true, true).fadeOut(150, function () {
                if (lastFocus) { lastFocus.focus(); }
            });
        }

        $(".gallery-link").on("click", function (e) {
            if (e.ctrlKey || e.shiftKey || e.metaKey) {
                return;
            }
            e.preventDefault();
            openModal($(this));
        });

        $close.on("click", closeModal);

        $(document).on("keydown", function (e) {
            if (!$modal.is(":visible")) { return; }
            if (e.key === "Escape") {
                e.preventDefault();
                closeModal();
            } else if (e.key === "Tab") {
                // Only one control inside the viewer: keep focus on it.
                e.preventDefault();
                $close.trigger("focus");
            }
        });

        $modal.on("click", function (e) {
            if (e.target.id === "imgModal") {
                closeModal();
            }
        });
    });
</script>

@Html.Partial("~/Views/Shared/Page/Newsroom.cshtml")

<div class="colmidl">
    <h1 class="titile">Photo Gallery</h1>
    @{
        var usedAlts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        int photoNo = 0;
    }
    <ul class="gallery-grid">
        @foreach (var photo in Model)
        {
            photoNo++;

            // Full caption stays visible below the picture.
            string captionText = (photo.strPhotoContent ?? "").Trim();

            // Short, unique alt text (the full caption is shown below the picture).
            string altText = ShortAlt(captionText, 125);
            if (altText.Length == 0)
            {
                altText = "Gallery photo " + photoNo;
            }
            int seen;
            if (usedAlts.TryGetValue(altText, out seen))
            {
                seen++;
                usedAlts[altText] = seen;
                altText = altText + " (photo " + seen + ")";
            }
            else
            {
                usedAlts[altText] = 1;
            }

            <li class="gallery-cell">
                <figure>
                    <a href="@Url.Content(photo.PhotoGallery)" class="gallery-link" target="_blank" rel="noopener" aria-haspopup="dialog">
                        <img src="@GetThumbnailUrl(photo.PhotoGallery)" class="gtabimg" alt="@altText" />
                    </a>
                    @if (captionText.Length > 0)
                    {
                        <figcaption class="gtabimgcap">@captionText</figcaption>
                    }
                </figure>
            </li>
        }
    </ul>
</div>

<div id="imgModal" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button type="button" id="closeModal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    <img id="modalImg" alt="">
</div>

<script>
    $(document).ready(function () {
        var galleryContainer = $(".colmidl");
        var galleryImages = galleryContainer.find("img");

        if (galleryImages.length > 0) {
            new QueryLoader2(galleryContainer[0], {
                barColor: "#fff",          // white progress bar
                backgroundColor: "#fff",
                percentage: true,
                minimumTime: 1000,
                maxTime: 5000,
                onComplete: function () {
                    console.log("Gallery images loaded!");
                }
            });
        } else {
            $("#pageloader").fadeOut();
        }
    });
</script>
