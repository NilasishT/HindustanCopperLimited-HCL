@model IEnumerable<Hindustancopperlimited.Models.UploadPhotoGallery>

@{
    ViewBag.Title = "Photo Gallery";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}

<style>
    .gtabimg {
        width: 100%;
        height: 130px;
        object-fit: fill;
        border-radius: 6px;
        cursor: pointer;
        transition: transform 0.3s;
        background-color: transparent;
    }

    .gtabimg:hover {
        transform: scale(1.05);
    }

    .gtabimgcap {
        font-size: 13px;
        color: #b30000;
        padding: 8px;
        text-align: justify;
    }

    td.gallery-cell {
        padding: 10px;
        vertical-align: top;
    }

    #imgModal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.95);
    }

    #modalImg {
        margin: auto;
        display: block;
        max-width: 100%;
        max-height: 100%;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        border-radius: 8px;
    }





    @*@keyframes fadeIn {
        from {opacity:0}
        to {opacity:1}
    }*@

  /*  #modalImg {
        margin:auto;
        display:block;
        max-width:90%;
        max-height:90%;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.6);
    }*/

    #caption {
        margin:auto;
        display:block;
        text-align:center;
        color:#ccc;
        padding:10px;
        font-size:16px;
    }

    #closeModal {
        position:absolute;
        top:20px;
        right:35px;
        color:#fff;
        font-size:40px;
        font-weight:bold;
        cursor:pointer;
    }
</style>

<script>
    $(document).ready(function () {
        $(".gtabimg").on("click", function () {
            var src = $(this).attr("src");
            $("#modalImg").attr("src", src);
            $("#imgModal").fadeIn();
        });

        $("#closeModal").on("click", function () {
            $("#imgModal").fadeOut();
        });

        $(document).on("keydown", function (e) {
            if (e.key === "Escape") {
                $("#imgModal").fadeOut();
            }
        });

        $("#imgModal").on("click", function (e) {
            if (e.target.id === "imgModal") {
                $(this).fadeOut();
            }
        });
    });

</script>


@Html.Partial("~/Views/Shared/Page/Newsroom.cshtml")
<div class="colmidl">
    <h2 class="titile">Photo Gallery</h2>

    <table cellspacing="0" cellpadding="0" border="0" width="100%">
        <tbody>
            <tr>
                @{
                    int count = 0;
                }
                @foreach (var photo in Model)
                {
                    if (count > 0 && count % 4 == 0)
                    {
                    @:</tr><tr>
                    }

                    <td align="center" width="25%" class="gallery-cell">
                        <img src="@Url.Content(photo.PhotoGallery)" class="gtabimg" />
                        <div class="gtabimgcap">@photo.strPhotoContent</div>
                    </td>


                    count++;
                }
            </tr>
        </tbody>
    </table>
</div>

<div id="imgModal">
    <span id="closeModal">&times;</span>
    <img id="modalImg">
</div>

<script>
    $(document).ready(function () {
        var galleryContainer = $(".colmidl");
        var galleryImages = galleryContainer.find("img");

        if (galleryImages.length > 0) {
            new QueryLoader2(galleryContainer[0], {
                barColor: "#fff",          // white progress bar
                backgroundColor: "#fff",
                percentage: true,
                minimumTime: 1000,  
                maxTime: 5000,    
                onComplete: function () {
                    console.log("Gallery images loaded!");
                }
            });
        } else {
            $("#pageloader").fadeOut();
        }
    });
</script>
