@{
    ViewBag.Title = "Download";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}
<div id="totalCol">
<div class="wrap">
  @Html.Partial("SideBarMenu_InvestorRelations")
     <div class="colmidl">
         <h1 class="titile">Download</h1>
    
          <div id="viewTable">
         <table width="100%" cellpadding="0" cellspacing="0">
        
		@foreach (var item in Model)
                    {
                        if (item.strEnglishFileUpload != null)
                        {           
                        <tr>
                            <td class="tblcol2t" height="24">
                                <a href=@item.strEnglishFileUpload.Replace("~", "../..") target="_blank">@item.strEnglishText</a>
                            </td>
                        </tr>
                        }
                        else
                        {
                        <tr>
                            <td class="tblcol2t" height="24">
                                <a href="#">@item.strEnglishText</a>
                            </td>
                        </tr>
                        }
                    }
        <tr>
        <th colspan="2" style="padding-top:6px; padding-bottom:6px;">Download</th>
        </tr>
		
		<tr>
        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/SEBI Circular- Special Window for Transfer and Dematerialisation of Physical Securities-30.01.2026.pdf")" target="_blank">SEBI Circular- Special Window for Transfer and Dematerialisation of Physical Securities-30.01.2026</a></td>
        </tr>
		
		<tr>
        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/SEBI-Circular-Special-Window-for-Re-lodgement-of-Transfer-Requests-of-Physical-Shares-02.07.2025.pdf")" target="_blank">SEBI Circular - Special Window for Re-lodgement of Transfer Requests of Physical Shares - 02.07.2025</a></td>
        </tr>
		
		<tr>
        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/Model_Tripartite_Agreement_in_terms_of_SEBI_Circular-25.5.2023.pdf")" target="_blank">Model Tripartite Agreement in terms of SEBI Circular -25.5.2023</a></td>
        </tr>
		
		<tr>
        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/Message for Dispute Resolution Mechanism to Physical Shareholders-20.2.2023.pdf")" target="_blank">Message for Dispute Resolution Mechanism to Physical Shareholders- 20.2.2023</a></td>
        </tr>
		
		<tr>
        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/Form ISR-4 (Request for issue of Duplicate Certificate and other Service Requests).docx")" target="_blank"> Form ISR-4 (Request for issue of Duplicate Certificate and other Service Requests)</a></td>
        </tr>
		
		 <tr>
        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/Intimation of TDS on Dividend for FY 2020-21.pdf")" target="_blank"> Intimation of TDS on Dividend for FY 2020-21</a></td>
        </tr>
		
		 <tr>
        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/Guidance for Dematerialization of shares.pdf")" target="_blank"> Guidance for Dematerialization of Shares</a></td>
        </tr>
		<tr>
        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/Form%20SH-4%20(Share%20Transfer%20Form).pdf")" target="_blank"> Form SH-4 (Share Transfer Form)</a></td>
        </tr>
        <tr>
        <td class="tblcol2t" height="24"><a href="@Url.Content("~/Content/PDF/Form%20SH-14%20(Cancellation%20or%20Variation%20of%20Nomination).pdf")" target="_blank"> Form SH-14 (Cancellation or Variation of Nomination)</a></td>
        </tr>
        <tr>
