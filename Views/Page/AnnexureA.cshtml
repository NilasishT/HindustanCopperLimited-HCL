@model Hindustancopperlimited.Models.BankerAnnexureA
@{
    ViewBag.Title = "Annexure-A";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}

<style>
table {
  font-family: arial, sans-serif;
  border-collapse: collapse;
  width: 100%;
}

td, th {
  border: 1px solid #dddddd;
  text-align: left;
  padding: 8px;
}

tr:nth-child(even) {
  background-color: #dddddd;
}

.input {
    width: 100%
}

</style>

<form method="post">
<center>
<h2>Invitation for Bulk Deposit Interest Rates (Non- callable)  from Banks <br />for Investment in Fixed Deposits / Term Deposits</h2>
<table>
<tr>
<th>Bank Name</th>
<th>Branch Name</th>
<th>Bank Address</th>
<th>Branch Code</th>
<th>IFS Code</th>
</tr>
<tr>
<td><input type="text" class="input" name="Bank" /></td>
<td><input type="text" class="input" name="BranchName" /></td>
<td><input type="text" class="input" name="Address" /></td>
<td><input type="text" class="input" name="Branch" /></td>
<td><input type="text" class="input" name="IFS" /></td>

</tr>
<tr>
<th>Email Id</th>
<th>Phone Number</th>
<th>Name of authorised official</th>
<th>Designation of authorised official</th>
</tr>
<tr>
<td><input type="text" class="input" name="Email" /></td>
<td><input type="text" class="input" name="Phone" /></td>
<td><input type="text" class="input" name="OfficialName" /></td>
<td><input type="text" class="input" name="OfficialDesignation" /></td>
</tr>
</table>


<h2>Annexure-A</h2>

<table>
  <tr>
    <th>Tenor of the Fixed Deposit/Term Deposit</th>
    <th>07 Days</th>
    <th>28-31 Days</th>
    <th>88-92 Days</th>
    <th>178-182 Days</th>
  </tr>
  <tr>
    <td>Amount of Fixed Deposit/Term Deposit (Rs. in Crore) <br /> <br /><b>(To be quoted by Bank)</b></td>
    <td><input type="number" class="input" name="SevAmount" /></td>
    <td><input type="number" class="input" name="ThiAmount"/></td>
    <td><input type="number" class="input" name="ThreeAmount"/></td>
    <td><input type="number" class="input" name="SixAmount"/></td>
  </tr>
  <tr>
    <td>Rate of Interest (% p.a.) <br /><br /> <b>(To be quoted by Bank)</b></td>
    <td><input type="number" class="input" name="SevInt" /></td>
    <td><input type="number" class="input" name="ThiInt" /></td>
    <td><input type="number" class="input" name="ThreeInt" /></td>
    <td><input type="number" class="input" name="SixInt" /></td>
  </tr>

  <tr>
  <td colspan="5"> <button class="btn btn-primary btn-block" type="submit">SUBMIT <i class="fa fa-sign-in fa-lg"></i></button> </td>
  </tr>
  
</table>

</center>
</form>


