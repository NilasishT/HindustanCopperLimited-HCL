
@model IEnumerable<Hindustancopperlimited.Models.tbl_ManagementKeyExecutives>
@{
    ViewBag.Title = "ManagementKey Executives";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}


@Html.Partial("~/Views/Shared/Page/About.cshtml")

    <div class="colmidl">
        <h1 class="titile">Key Executives</h1>
    <table>
    <tr>
    <table width="100%" cellpadding="0" cellspacing="0" border="0">
    <td align="center">
    <strong>
    Our Key Executives and their Area of responsibility
    <br>
    (below the board level)
    </strong>
    </td>
    </tr>
      </table> 
      
   
         <div id="viewTable" style="margin-top:4%;">
 
           
             <table width="100%" cellspacing="0" cellpadding="0" border="0">
                                  <tbody><tr >
                                    <td  bgcolor="#935116" color="#ffffff!important" colspan="5" class="link55" height="30"><strong class="blacksub" style="color: #fff">Head Office</strong></td>
                                  </tr>
                 
                    <tr class="tablebg">
                    
                  
                   <th style="width:25%">Name</th>
                   <th style="width:15%">Designation</th>
                  <th style="width:15%">Responsibility Area</th>
                   <th style="width:15%">Phone</th>
                    <th style="width:30%">Email id</th>
                    
                      
                    </tr>
                 
                 


                     @foreach (var item in Model.Where(x=>x.strOfficeType=="Head Office").OrderBy(x=>x.intSlNo))
            {
                    <tr>
                    
                     <td> @item.strName</td>
                     <td> @item.strDesignation</td>
                    
                     <td> @item.strReaponsibilityArea</td>
                    
                     <td> @item.strPhone</td>
                     <td> @item.strEmailId</td>
                   
                    </tr>

            }
            
                    
                  </tbody>
                </table>
             <table width="100%" cellspacing="0" cellpadding="0" border="0">
                                  <tbody><tr>
                                    <td  bgcolor="#935116" color="#ffffff!important" colspan="5" class="link55" height="30"><strong class="blacksub" style="color: #fff">Unit Offices</strong></td>
                                  </tr>
                 
                    <tr class="tablebg">
                    
                  
                   <th style="width:25%">Name</th>
                   <th style="width:15%">Designation</th>
                  <th style="width:15%">Responsibility Area</th>
                   <th style="width:15%">Phone</th>
                    <th style="width:30%">Email id</th>
                    
                      
                    </tr>
                 
                 


                     @foreach (var item in Model.Where(x => x.strOfficeType == "Unit Offices").OrderBy(x => x.intSlNo))
            {
                    <tr>
                    
                     <td> @item.strName</td>
                     <td> @item.strDesignation</td>
                    
                     <td> @item.strReaponsibilityArea</td>
                    
                     <td> @item.strPhone</td>
                     <td> @item.strEmailId</td>
                   
                    </tr>

            }
            
                    
                  </tbody>
                </table>
            <table width="100%" cellspacing="0" cellpadding="0" border="0" style="display:none">
                                  <tbody><tr>
                                    <td  bgcolor="#aa6726" colspan="5" class="link55" height="30"><strong class="blacksub">Sales & Other Offices</strong></td>
                                  </tr>
                 
                    <tr bgcolor="#AC8446">
                    
                  
                   <th style="width:25%">Name</th>
                   <th style="width:15%">Designation</th>
                  <th style="width:15%">Responsibility Area</th>
                   <th style="width:15%">Phone</th>
                    <th style="width:30%">Email id</th>
                    
                      
                    </tr>
                 
                 


                     @foreach (var item in Model.Where(x => x.strOfficeType == "Sales & Other Offices").OrderBy(x => x.intSlNo))
            {
                    <tr>
                    
                     <td> @item.strName</td>
                     <td> @item.strDesignation</td>
                    
                     <td> @item.strReaponsibilityArea</td>
                    
                     <td> @item.strPhone</td>
                     <td> @item.strEmailId</td>
                   
                    </tr>

            }
            
                    
                  </tbody>
                </table>


        </div>
