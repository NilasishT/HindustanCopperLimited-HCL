@model Hindustancopperlimited.Models.tbl_mstEmployee

@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}

<div class="col-lg-12">
    <div class="well bs-component">            
@using (Html.BeginForm("EmployeeSection", "Page", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
   
    <fieldset>
    <legend><b><span style="color:#6f3706; font-size:24px; padding-left:40%">Change Password</span>   <span style="color:Red; font-size:14px; padding-left:25%"> (*) Fields are Mandatory </span></b></legend>
    <br />
    <br />
    <br />
    
                        <div class="form-group">
                          <label class="col-lg-4 control-label">Current Password<span style="color:Red"> (*)</span></label>
                          <div class="col-lg-3">
       <input id="strUsercurrentPwd" type="password" name="strUsercurrentPwd" class="form-control" required>
     </div>
    </div>
    
    
                        <div class="form-group">
                          <label class="col-lg-4 control-label">New Password<span style="color:Red"> (*)</span></label>
                          <div class="col-lg-3">
        <input id="strUserPwd" type="password" name="strUserPwd" class="form-control" required>
     </div>
    </div>

    <div class="form-group">
                          <label class="col-lg-4 control-label">Re-Password <span style="color:Red"> (*)</span></label>
                          <div class="col-lg-3">
        <input id="strUserRePwd" type="password" name="strUserRePwd" class="form-control" required>
     </div>
    </div>
    <div class="form-group">
                          <div class="col-lg-6 col-lg-offset-4">
                           
                             <button type="submit" class="btn btn-primary"  style="background-color:#6f3706" onclick="return error()">Submit</button>
                            <button type="reset" class="btn btn-default">Cancel</button>

                    @* <a href="@Url.Action("SpotbookingRegistration", "Spotbooking")"> <button type ="button" class="btn btn-primary" style="background-color:#f09822">New User</button></a>*@
                      @* <button type="reset" class="btn btn-default">Cancel</button>*@

                     @* <a href="@Url.Action("ForgotPassword")">    <button type ="button" class="btn btn-primary">Forgot Password</button></a>*@
                          </div>
        </div>
      </fieldset>   
}
               
    </div>
</div>
 @if (ViewBag.Message != null)
 {
        <script type="text/javascript">
            window.onload = function () {
                alert("@ViewBag.Message");

            };
        </script>
 }

  <script src="@Url.Content("~/Content/js/CandidateChangePassword.js?a=5")"></script>