   <script>
       $(document).ready(function () {
           $("#sucStory1").show();
           $("#sucStory2").hide();
           $("#sucStory3").hide();


           $("#ss1").click(function () {
               $("#sucStory1").show();
               $("#sucStory2").hide();
               $("#sucStory3").hide();
               $(this).addClass("active");
               $("#ss2").removeClass("active");
               $("#ss3").removeClass("active");

           });

           $("#ss2").click(function () {
               $("#sucStory2").show();
               $("#sucStory1").hide();
               $("#sucStory3").hide();
               $(this).addClass("active");
               $("#ss1").removeClass("active");
               $("#ss3").removeClass("active");
           });

           $("#ss3").click(function () {
               $("#sucStory3").show();
               $("#sucStory1").hide();
               $("#sucStory2").hide();
               $(this).addClass("active");
               $("#ss1").removeClass("active");
               $("#ss2").removeClass("active");
           });

       });

	</script>



