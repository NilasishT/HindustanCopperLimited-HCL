@model IEnumerable<Hindustancopperlimited.Models.tbl_mst_News>

@using (Html.BeginForm())
        {
    
    <div class="clear"></div>
<div id="runningText" style="margin-top:20px">
        <marquee align="middle" behavior="scroll" direction="left" onmouseover="javascript:this.stop()" onmouseout="javascript:this.start()" scrollamount="4" scrolldelay="1" style="margin-top:10px;">
        
        @foreach (var item in Model)
                                            {
                                                if (Session["Page"] == "Hindi")
                                                {
         <a href=@item.strFileHindi.Replace("~", "../..") target="_blank"><img src="@Url.Content("~/Content/img/New.gif")">&nbsp; 
        @item.strSubjectdfshindi   &nbsp; &nbsp;|&nbsp; &nbsp;     </a> 
                                                }
                                                else
                                                {
             <a href=@item.strFileEnglish.Replace("~", "../..") target="_blank"><img src="@Url.Content("~/Content/img/New.gif")">&nbsp; 
        @item.strSubjectdfsEnglish   &nbsp; &nbsp;|&nbsp; &nbsp;     </a>
                                                }

                                            }
                                            
                                                
        
        
       
        </marquee>
	</div>
    }


    
