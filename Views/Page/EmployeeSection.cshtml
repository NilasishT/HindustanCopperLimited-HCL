@{
    ViewBag.Title = "Employee Section | Hindustan Copper Limited";
    ViewBag.MetaDescription = "Hindustan Copper Limited (HCL) is India’s leading copper producer, engaged in copper mining, beneficiation, smelting, refining and downstream products.";
    ViewBag.MetaKeywords = "Hindustan Copper Limited, HCL, copper producer, copper mining, copper beneficiation, copper smelting, copper refining, copper products, copper cathodes, copper concentrates, copper rods, Ministry of Mines, HCL India.";

    Layout = "~/Views/Shared/WebsitePage.cshtml";
}
@Html.Partial("~/Views/Shared/Page/About.cshtml")



<div class="colmidl">
    <h1 class="titile">
        Employee Section
    </h1>



   






    <div class="col-lg-12">
        <div class="well bs-component">
            @using (Html.BeginForm("EmployeeSection", "Page", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", @autocomplete = "off" }))
            {

                <fieldset>
                    <legend><b><span style="color:#916100; font-size:24px; padding-left:40%">User Login</span>   <span style="color:#DC3545; font-size: 14px; padding-left: 25%"> (*) Fields are Mandatory </span></b></legend>
                    <br />
                    <br />
                    <br />


                    <div class="form-group">
                        <label class="col-lg-4 control-label">Employee Code<span style="color: #DC3545"> (*)</span></label>
                        <div class="col-lg-3">
                            <input aria-label="Employee Code" type="text" placeholder="EMPLOYEE CODE" id="EmpCd" name="EmpCd" autofocus
                                   class="form-control" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-4 control-label">Password <span style="color: #DC3545"> (*)</span></label>
                        <div class="col-lg-3">
                            <input aria-label="Password" type="password" placeholder="Password" id="Password" name="Password" autocomplete="off" class="form-control"
                                   required>
                        </div>
                    </div>


                    @*captcha*@
                    <div class="form-group">
                        <center>
                            <div style="font-size:30px; text-align:center;" class="col-lg-4 col-lg-offset-4">
                                @HttpContext.Current.Session["query"].ToString()  = ?
                                <input aria-label="Answer" type="text" placeholder="Answer" name="answer" class="form-control" required>
                                <p><a href="@Url.Action("EmployeeSection", "Page")" title="Click for a new shape"> <img alt="Click for a new shape" style="width:20%; height:10%; margin:0; padding:0" src="/Content/images/reCAPTCHA.jpeg" /></a></p>
                            </div>
                        </center>

                    </div>

                    @*captcha*@

                    <div class="form-group">
                        <div class="col-lg-6 col-lg-offset-4">

                            <button type="submit" class="btn btn-primary" style="background-color:#916100">Log in</button>



                            @* <button type="reset" class="btn btn-default">Cancel</button>*@
                            <a href="@Url.Action("ForgotPassword")" style="color: #0D6EFD; font-size: large; font-style: inherit"> Forgot Password ?</a>

                        </div>
                        <div class="col-lg-6 col-lg-offset-4" style="font-size:medium; color:#DC3545"><b>@ViewBag.Message</b></div>
                    </div>
                </fieldset>
            }

        </div>
    </div>




</div>