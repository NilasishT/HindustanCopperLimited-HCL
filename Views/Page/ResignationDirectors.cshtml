@{
    ViewBag.Title = "ResignationDirectors";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}
<div id="totalCol">
<div class="wrap">
   @Html.Partial("SideBarMenu_InvestorRelations")
       
     <div class="colmidl">
