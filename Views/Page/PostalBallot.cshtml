@{
    ViewBag.Title = "PostalBallot";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
}
<style>
    #viewTable ul li
    {
        padding-bottom:2%;
    }
</style>

<div id="totalCol">
<div class="wrap">
   @Html.Partial("SideBarMenu_InvestorRelations")
       
 <div class="colmidl">
    <h1 class="titile">Postal Ballot</h2>
    
        <div id="viewTable">
        <ul>
		 @foreach (var item in Model)
       {
           if (item.strEnglishFileUpload != null)
           {           
           <li><span class="colmidlli"><a href=@item.strEnglishFileUpload.Replace("~", "../..") target="_blank" style="color:#a34500; font-weight: bold;">  @item.strEnglishText</a></span></li>
           }
           else
           {
                  <li><span class="colmidlli"><a href="#" style="color:#a34500; font-weight: bold;">  @item.strEnglishText</a></span></li>
           }
       }
        
		<li><span class="colmidlli"><a href="@Url.Content("~/Content/PDF/Result of Postal Ballot declared on 17.6.2022.pdf")" target="_blank" style="color:#a34500; font-weight: bold;">Result of Postal Ballot declared on 17.6.2022</a></span></li>
		<li><span class="colmidlli"><a href="@Url.Content("~/Content/PDF/Notice of Postal Ballot dated 11.5.2022.pdf")" target="_blank" style="color:#a34500; font-weight: bold;">Notice of Postal Ballot dated 11.5.2022</a></span></li>
		<li><span class="colmidlli"><a href="@Url.Content("~/Content/PDF/Result of Postal Ballot declared on 29.1.2021.pdf")" target="_blank" style="color:#a34500; font-weight: bold;">Result of Postal Ballot declared on 29.1.2021</a></span></li>
		<li><span class="colmidlli"><a href="@Url.Content("~/Content/PDF/Notice of Postal Ballot dated 29.12.2020.pdf")" target="_blank" style="color:#a34500; font-weight: bold;">Notice of Postal Ballot dated 29.12.2020</a></span></li>
