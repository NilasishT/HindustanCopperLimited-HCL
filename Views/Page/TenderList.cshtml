@model IEnumerable<Hindustancopperlimited.Models.vw_TendetList>
@{
    ViewBag.Title = "Tenders List";
    Layout = "~/Views/Shared/WebsitePage.cshtml";
            //Layout = "~/Views/Shared/Datatable.cshtml";
}
<style>
/*.btn-primary {
    color: #fff;
    background-color: #aa6726;
    border-color: #aa6726;
    
}*/
    /* #region MySection */
    .btn-primary {
        color: #ffffff;
        background-color: #935116;
        border-color: #935116;
    }
    /* #endregion */
</style>
<h1>Tenders List</h1>
<div class="col-lg-12">
    <div class="well bs-component">
        @using (Html.BeginForm())
        {
    
<p style="font-weight:bold; text-align:right;">Tenders are also available at <a href="http://eprocure.gov.in/cppp/" style="color: #0056b3; text-decoration: underline;" target="_blank">http://eprocure.gov.in/cppp/</a></p>
        <!--Debanko-->
             @*<input type="button" onclick="window.location.href('@Url.Action("ArcrivedTenderList", "Page")')" class="btn btn-primary" value="Arcrived Tender List"/>*@@*<button type="submit" class="btn btn-primary" value="Arcrived Tenders" href="@Url.Action("ArcrivedTenderList", "Page")"></button></a>*@
                <p>@Html.ActionLink("Archived Tender List", "ArcrivedTenderList", null, new {@class="btn btn-primary"})</p>
               @* @Html.ActionLink("Add Projects Scholars", "AddProjectScholars", null, new { @class = "btn btn-primary" })*@
    
            <fieldset>
                <div>
                    <div class="row">
                        <div class="col-md-18">
                            <div class="card">
                                <div class="card-body">
                                    <table id="sampleTable" class="table table-hover table-bordered">
                                        <thead>
                                            @*<tr style="background-color:#ac8446">*@                                                
                                            <tr style="background-color: #935116; color: #fff;">
                                                <td style="width:10%" role="columnheader">
                                                    Unit Name aaa
                                                </td>

                                                <td style="width:10%">
                                                    Enquiry No
                                                </td>

                                                <td style="width:10%">
                                                    Enquiry Date
                                                </td>
                                                <td style="width:20%">
                                                    Short Title
                                                </td>
                                                <td style="width:10%">Closing Date/Time</td>
                                                <td style="width:15%">Cost of Tender Document (Rs.)</td>
                                                <td style="width:5%">EMD (Rs.) </td>
                                                <td style="width:5%">Cancel/Discharge </td>
                                                <td style="width:5%">Remarks</td>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                   
                                                    <td>
                                                        @item.strUnitCode
                                                    </td>
                                                   
                                                    <td>
                                                    <a style="color: #935116" href="JavaScript:newPopup('/Page/TenderListforDetails/@item.pk_intTenderId');"> @item.strEnquiryNo</a>
                                                    </td>
                                                    
                                                    <td>
                                                        @item.dtEnquiryDate.Value.ToString("dd-MMM-yyyy")
                                                    </td>
                                                     <td>
                                                        @item.strEnquiryTitle
                                                    </td>
                                                    <td>
                                                        @item.dtClosingDate.ToString("dd-MMM-yyyy h:mm tt")
                                                    </td>
                                                    
                                                    <td>
                                                        @item.numCostofTender
                                                    </td>
                                                    <td>
                                                        @item.numEarnestMoney
                                                    </td>
                                                   <td>
                                                        @item.IsCancel
                                                    </td>
                                                    
                                                    <td>
                                                        @item.strRemarks
                                                    </td>
                                                   
                                                </tr>

                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
	
        }
    </div>
</div>
<div id="dialog" style="display: none">
</div>
<script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.7.2/jquery.min.js"></script>
<script src="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.8.9/jquery-ui.js" type="text/javascript"></script>
<link href="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.8.9/themes/blitzer/jquery-ui.css"rel="stylesheet" type="text/css" />

<script type="text/javascript">


    function newPopup(url) {
        var h = 700;
        var w = 900;
        var y = window.outerHeight / 2 + window.screenY - (h / 2)
        var x = window.outerWidth / 2 + window.screenX - (w / 2)
        popupWindow = window.open(url, "Tender List", 'toolbar=no, location=no, directories=no, status=no, menubar=no, scrollbars=yes, resizable=no, copyhistory=no, width=' + w + ', height=' + h + ', top=' + y + ', left=' + x);

        //popupWindow = window.open(url, 'popUpWindow', 'height=500,width=800,left=10,top=10,resizable=yes,scrollbars=yes,toolbar=yes,menubar=no,location=no,directories=no,status=yes')
    }
</script>

