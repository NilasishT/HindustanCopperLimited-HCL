@{
    ViewBag.Title = "Tenders List | Hindustan Copper Limited";

    ViewBag.MetaDescription = "Hindustan Copper Limited (HCL) is India’s leading copper producer, engaged in copper mining, beneficiation, smelting, refining and downstream products.";

    ViewBag.MetaKeywords = "Hindustan Copper Limited, HCL, copper producer, copper mining, copper beneficiation, copper smelting, copper refining, copper products, copper cathodes, copper concentrates, copper rods, Ministry of Mines, HCL India.";

    Layout = "~/Views/Shared/WebsitePage.cshtml";
}

<style>

    /* Primary button styling */
    .btn-primary {
        color: #ffffff;
        background-color: #916100;
        border-color: #916100;
    }

        .btn-primary:hover,
        .btn-primary:focus {
            color: #ffffff;
            background-color: #765000;
            border-color: #765000;
        }

    /* Table header styling */
    #sampleTable thead th {
        background-color: #916100;
        color: #ffffff;
        font-size: 14px !important;
        vertical-align: middle;
        text-align: center;
        padding: 8px 5px;
    }

    .pagination li a:hover, .pagination li a:focus {
        color: var(--dbim-bg-page);
        background: var(--dbim-primary-dark);
    }

    /* Table cell alignment */
    #sampleTable tbody td {
        vertical-align: middle;
    }

        /* Accessible tender links */
        #sampleTable tbody td a {
            color: #0D6EFD;
            text-decoration: underline;
        }

            #sampleTable tbody td a:hover {
                text-decoration: none;
            }

            /* Keyboard focus visibility */
            #sampleTable tbody td a:focus {
                outline: 2px solid #0D6EFD;
                outline-offset: 3px;
            }

    /* Keyboard accessible table scrolling */
    .table-responsive:focus {
        outline: 3px solid #0D6EFD;
        outline-offset: 3px;
    }

    /* Screen reader only content */
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
</style>

<div class="col-lg-12">

    <h1>Tenders List</h1>

    <div class="well bs-component" style="min-width:100%;">

        @using (Html.BeginForm())
        {

            <!-- CPP Portal -->
            <p style="font-weight:bold; text-align:right;">

                Tenders are also available at the following portals:

                <a href="https://etenders.gov.in/eprocure/app"
                   style="color:#0D6EFD;"
                   target="_blank"
                   rel="noopener noreferrer">

                    Central Public Procurement Portal (Opens in a new window)

                </a>

            </p>

            <!-- GeM Portal -->
            <p style="font-weight:bold; text-align:right;">

                Government e-Marketplace (GeM):

                <a href="https://gem.gov.in/"
                   style="color:#0D6EFD;"
                   target="_blank"
                   rel="noopener noreferrer">

                    Government e-Marketplace (Opens in a new window)

                </a>

            </p>

            <!-- MSTC Portal -->
            <p style="font-weight:bold; text-align:right;">

                MSTC Portal:

                <a href="https://www.mstcecommerce.com/auctionhome/index_new.jsp"
                   style="color:#0D6EFD;"
                   target="_blank"
                   rel="noopener noreferrer">

                    MSTC e-Commerce Portal (Opens in a new window)

                </a>

            </p>

            <!-- Archived Tender List -->
            <p>

                @Html.ActionLink(
                    "Archived Tender List",
                    "ArcrivedTenderList",
                    null,
                    new { @class = "btn btn-primary" }
                )

            </p>

            <fieldset>

                <div>

                    <div class="row">

                        <div class="col-md-12">

                            <div class="card">

                                <div class="card-body">

                                    <!-- Responsive and keyboard accessible table -->
                                    <div class="table-responsive"
                                         role="region"
                                         aria-label="Tenders List"
                                         tabindex="0">

                                        <table id="sampleTable"
                                               class="table table-hover table-bordered">

                                            <!-- Accessible table caption -->
                                            <caption class="sr-only">
                                                Hindustan Copper Limited Tenders List
                                            </caption>

                                            <thead>

                                                <tr>

                                                    <th scope="col" style="width:10%;">

                                                        Unit Name

                                                    </th>

                                                    <th scope="col" style="width:10%;">

                                                        Enquiry No

                                                    </th>

                                                    <th scope="col" style="width:10%;">

                                                        Enquiry Date

                                                    </th>

                                                    <th scope="col" style="width:20%;">

                                                        Short Title

                                                    </th>

                                                    <th scope="col" style="width:10%;">

                                                        Closing Date/Time

                                                    </th>

                                                    <th scope="col" style="width:15%;">

                                                        Estimated Value (Rs.)

                                                    </th>

                                                    <th scope="col" style="width:5%;">

                                                        EMD (Rs.)

                                                    </th>

                                                    <th scope="col" style="width:5%;">

                                                        Cancel/Discharge

                                                    </th>

                                                    <th scope="col" style="width:5%;">

                                                        Remarks

                                                    </th>

                                                </tr>

                                            </thead>

                                            <tbody>

                                                @if (Model != null)
                                                {

                                                    foreach (var item in Model)
                                                    {

                                                        <tr>

                                                            <!-- Unit Name -->
                                                            <td>

                                                                @if (!string.IsNullOrEmpty(item.strUnitCode))
                                                                {
                                                                    <span lang="en">
                                                                        @item.strUnitCode
                                                                    </span>
                                                                }

                                                            </td>

                                                            <!-- Enquiry Number and Tender Details Link -->
                                                            <td>

                                                                <a style="color:#0D6EFD;"
                                                                   href="@Url.Content("~/Page/TenderListforDetails/" + item.pk_intTenderId)"
                                                                   target="_blank"
                                                                   rel="noopener noreferrer"
                                                                   aria-label="View tender details for enquiry number @item.strEnquiryNo">

                                                                    @item.strEnquiryNo

                                                                    <span class="sr-only">
                                                                        - View Tender Details
                                                                    </span>

                                                                </a>

                                                            </td>

                                                            <!-- Enquiry Date -->
                                                            <td>

                                                                @(item.dtEnquiryDate.HasValue
                                                                    ? item.dtEnquiryDate.Value.ToString(
                                                                        "dd-MMM-yyyy",
                                                                        System.Globalization.CultureInfo.InvariantCulture)
                                                                    : "")

                                                            </td>

                                                            <!-- Short Title -->
                                                            <td>

                                                                @item.strEnquiryTitle

                                                            </td>

                                                            <!-- Closing Date and Time -->
                                                            <td>

                                                                @item.dtClosingDate.ToString(
                                                                    "dd-MMM-yyyy h:mm tt",
                                                                    System.Globalization.CultureInfo.InvariantCulture)

                                                            </td>

                                                            <!-- Estimated Value -->
                                                            <td style="text-align:right;">

                                                                @if (item.numCostofTender.HasValue)
                                                                {

                                                                    if (item.numCostofTender.Value == 0.00m)
                                                                    {
                                                                        @:NA
                                                                    }
                                                                    else
                                                                    {
                                                                        @item.numCostofTender.Value.ToString("0.00")
                                                                    }

                                                                }
                                                                else
                                                                {
                                                                    @:NA
                                                                }

                                                            </td>

                                                            <!-- EMD -->
                                                            <td style="text-align:right;">

                                                                @item.numEarnestMoney

                                                            </td>

                                                            <!-- Cancellation Status -->
                                                            <td>

                                                                @if (item.IsCancel != null)
                                                                {
                                                                    <span lang="en">
                                                                        @item.IsCancel
                                                                    </span>
                                                                }

                                                            </td>

                                                            <!-- Remarks -->
                                                            <td>

                                                                @item.strRemarks

                                                            </td>

                                                        </tr>

                                                    }

                                                }

                                            </tbody>

                                        </table>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </fieldset>

        }

    </div>

</div>

<!-- Existing dialog container -->
<div id="dialog" style="display:none;">
</div>

<!-- jQuery -->
<script type="text/javascript"
        src="https://ajax.googleapis.com/ajax/libs/jquery/1.7.2/jquery.min.js"></script>

<!-- jQuery UI -->
<script src="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.8.9/jquery-ui.js"
        type="text/javascript"></script>

<link href="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.8.9/themes/blitzer/jquery-ui.css"
      rel="stylesheet"
      type="text/css" />

<script type="text/javascript">

    // Opens tender details in a separate browser window.
    function newPopup(url) {

        var h = 700;
        var w = 900;

        var y = window.outerHeight / 2 +
            window.screenY - (h / 2);

        var x = window.outerWidth / 2 +
            window.screenX - (w / 2);

        var popupWindow = window.open(
            url,
            "TenderDetails",
            'scrollbars=yes,resizable=yes,width=' + w +
            ',height=' + h +
            ',top=' + y +
            ',left=' + x
        );

        // Fallback if browser blocks the popup.
        if (!popupWindow) {

            window.location.href = url;

        }

    }

</script>
