@model IEnumerable<Hindustancopperlimited.Models.vw_TendetList>
@{
    ViewBag.Title = "Archived Tender List | Hindustan Copper Limited";
    ViewBag.MetaDescription = "Hindustan Copper Limited (HCL) is India’s leading copper producer, engaged in copper mining, beneficiation, smelting, refining and downstream products.";
    ViewBag.MetaKeywords = "Hindustan Copper Limited, HCL, copper producer, copper mining, copper beneficiation, copper smelting, copper refining, copper products, copper cathodes, copper concentrates, copper rods, Ministry of Mines, HCL India.";

    Layout = "~/Views/Shared/WebsitePage.cshtml";
}
<style>
.btn-primary {
    color: #fff;
    background-color: #aa6726;
    border-color: #aa6726;
    
}
</style>
<div class="col-lg-12">
    <h1><span lang="en">Archived Tenders List</span></h1>
    <div class="well bs-component" style="min-width:100%;">
        @using (Html.BeginForm())
        {

            <p style="font-weight:bold; text-align:right">Tenders are also available at <a href="https://etenders.gov.in/eprocure/app" style="color: #0D6EFD" target="_blank">https://etenders.gov.in/eprocure/app</a></p>
            <p>@Html.ActionLink("Active Tender List", "TenderList", null, new { @class = "btn btn-primary" })</p>
            <!--Debanko-->



            <fieldset>
                <div>
                    <div class="row">
                        <div class="col-md-18">
                            <div class="card">
                                <div class="card-body">
                                    <table id="sampleTable" class="table table-hover table-bordered">
                                        <thead>
                                            <tr style="background-color:#ac8446">
                                                <td style="width:10%">
                                                    Unit Name
                                                </td>

                                                <td style="width:10%">
                                                    Enquiry No
                                                </td>

                                                <td style="width:10%">
                                                    Enquiry Date
                                                </td>
                                                <td style="width:20%">
                                                    Short Title
                                                </td>
                                                <td style="width:10%">Closing Date/Time</td>
                                                <td style="width:15%">Estimated Value (Rs.)</td>
                                                <td style="width:5%">EMD (Rs.) </td>
                                                <td style="width:5%">Cancel/Discharge </td>
                                                <td style="width:5%">Remarks</td>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>

                                                    <td>
                                                        @item.strUnitCode
                                                    </td>

                                                    <td>
                                                        <a style="color:#ac8446" href="JavaScript:newPopup('/Page/TenderListforDetails/@item.pk_intTenderId');"> @item.strEnquiryNo</a>
                                                    </td>

                                                    <td>
                                                        @item.dtEnquiryDate.Value.ToString("dd-MMM-yyyy")
                                                    </td>
                                                    <td>
                                                        @item.strEnquiryTitle
                                                    </td>
                                                    <td>
                                                        @item.dtClosingDate.ToString("dd-MMM-yyyy h:mm tt")
                                                    </td>

                                                    <td style="text-align: right;">
                                                        @item.numCostofTender
                                                    </td>
                                                    <td style="text-align: right;">
                                                        @item.numEarnestMoney
                                                    </td>
                                                    <td>
                                                        @item.IsCancel
                                                    </td>

                                                    <td>
                                                        @item.strRemarks
                                                    </td>

                                                </tr>

                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>

        }
    </div>
</div>
<div id="dialog" style="display: none">
</div>
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.7.2/jquery.min.js"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.8.9/jquery-ui.js" type="text/javascript"></script>
<link href="https://ajax.aspnetcdn.com/ajax/jquery.ui/1.8.9/themes/blitzer/jquery-ui.css"rel="stylesheet" type="text/css" />

<script type="text/javascript">


    function newPopup(url) {
        var h = 700;
        var w = 900;
        var y = window.outerHeight / 2 + window.screenY - (h / 2)
        var x = window.outerWidth / 2 + window.screenX - (w / 2)
        popupWindow = window.open(url, "Tender List", 'toolbar=no, location=no, directories=no, status=no, menubar=no, scrollbars=yes, resizable=no, copyhistory=no, width=' + w + ', height=' + h + ', top=' + y + ', left=' + x);

        //popupWindow = window.open(url, 'popUpWindow', 'height=500,width=800,left=10,top=10,resizable=yes,scrollbars=yes,toolbar=yes,menubar=no,location=no,directories=no,status=yes')
    }
</script>