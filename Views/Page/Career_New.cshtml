@*==== Accessible Marquee Replacement -- Start ====*@




<style>

    .notice-marquee {
        width: 100%;
        overflow: hidden;
        white-space: nowrap;
        margin-top: 20px;
        padding: 10px 0;
    }

    .notice-marquee-content {
        display: inline-block;
        white-space: nowrap;
        animation: noticeScroll 35s linear infinite;
    }

        .notice-marquee-content a {
            color: #333;
            text-decoration: none;
        }

            .notice-marquee-content a:hover {
                text-decoration: underline;
            }

    /* Space between notices */
    .notice-gap {
        display: inline-block;
        width: 80px;
    }

    /* Pause automatically on mouse hover */
    .notice-marquee:hover .notice-marquee-content {
        animation-play-state: paused;
    }

    /* Pause when keyboard user focuses a link */
    .notice-marquee:focus-within .notice-marquee-content {
        animation-play-state: paused;
    }

    .notice-marquee-content a:focus-visible {
        outline: 2px solid #005ea8;
        outline-offset: 3px;
    }


    @@keyframes noticeScroll {

        from {
            transform: translateX(100vw);
        }

        to {
            transform: translateX(-100%);
        }
    }


    /* Accessibility: disable movement if user prefers reduced motion */
    @@media (prefers-reduced-motion: reduce) {

        .notice-marquee {
            white-space: normal;
            overflow: visible;
        }

        .notice-marquee-content {
            animation: none;
            white-space: normal;
        }

        .notice-gap {
            width: 30px;
        }
    }
</style>

@*==== Accessible Marquee Replacement -- End ====*@

