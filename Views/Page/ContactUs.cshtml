        }

        displayOffice(city, offices[city]);
    }

    function displayOffice(city, office, distanceKm) {
        var result = document.getElementById("recommendedOfficeResult");

        // Create elements safely without inserting HTML strings.
        result.replaceChildren();

        var heading = document.createElement("h3");
        heading.textContent = office.name;
        result.appendChild(heading);

        var address = document.createElement("p");
        address.textContent = "Address: " + office.address;
        result.appendChild(address);

        if (office.phone) {
            var phone = document.createElement("p");
            phone.appendChild(document.createTextNode("Telephone: "));

            var phoneLink = document.createElement("a");
            phoneLink.href = "tel:" + office.phone.replace(/[^\d+]/g, "");
            phoneLink.textContent = office.phone;

            phone.appendChild(phoneLink);
            result.appendChild(phone);
        }

        if (typeof distanceKm === "number") {
            var distance = document.createElement("p");
            distance.textContent =
                "Approximate straight-line distance: " +
                Math.round(distanceKm) + " km.";
            result.appendChild(distance);
        }
    }

    function selectOfficeCity(city) {
        var select = document.getElementById("officeCitySelect");
        select.value = city;
        showRecommendedOffice();
    }

    function findNearestOffice() {
        var result = document.getElementById("recommendedOfficeResult");
        var button = document.getElementById("findNearestOfficeBtn");

        if (!navigator.geolocation) {
            result.textContent =
                "Location detection is not supported by this browser. " +
                "Please select a city manually.";
            return;
        }

        button.disabled = true;
        result.textContent =
            "Please allow location access to find the nearest listed office.";

        navigator.geolocation.getCurrentPosition(
            function (position) {
                var userLat = position.coords.latitude;
                var userLon = position.coords.longitude;

                var offices = {
                    "Kolkata": {
                        name: "Corporate Office — Kolkata",
                        address: "1, Ashutosh Chowdhury Avenue, Kolkata – 700019",
                        phone: "+91 (0) 33 2283 2226/2529/2952/2871/2032",
                        lat: 22.513,
                        lon: 88.364
                    },
                    "Delhi": {
                        name: "Delhi Office",
                        address: "2nd Floor, North Tower, Scope Minar, Laxmi Nagar, Delhi",
                        phone: "+91 (0) 11 2244 6564",
                        lat: 28.628,
                        lon: 77.277
                    },
                    @*"Bangalore": {
                        name: "Bangalore Office",
                        address: "57/190 R V Road, Near Vijaya College, Bangalore – 560004",
                        phone: "+91 (0) 80 2656 3343",
                        lat: 12.943,
                        lon: 77.568
                    },
                    "Mumbai": {
                        name: "Mumbai Office",
                        address: "11th Floor, 1104 Embassy Centre, Nariman Point, Mumbai – 400021",
                        phone: "+91 (0) 22 2202 0489",
                        lat: 18.925,
                        lon: 72.824
                    },*@
                    "Khetri": {
                        name: "Khetri Copper Complex",
                        address: "Khetrinagar, District Jhunjhunu, Rajasthan – 333504",
                        phone: "+91 (0) 1593 220002",
                        lat: 28.020,
                        lon: 75.790
                    },
                    "Ghatsila": {
                        name: "Indian Copper Complex",
                        address: "Ghatsila, Jharkhand – 832303",
                        phone: "+91 (0) 6585 225768",
                        lat: 22.590,
                        lon: 86.470
                    },
                    "Malanjkhand": {
                        name: "Malanjkhand Copper Project",
                        address: "P.O. Malanjkhand, District Balaghat, Madhya Pradesh – 481116",
                        phone: "+91 (0) 7637 257042",
                        lat: 22.160,
                        lon: 80.720
                    },
                    "Taloja": {
                        name: "Taloja Copper Project",
                        address: "Plot No. E-33 to E-36, MIDC Area, P.O. Taloja, Raigad, Maharashtra – 410208",
                        phone: "+91 (0) 22 2741 1912",
                        lat: 19.080,
                        lon: 73.100
                    },
                    "Jhagadia": {
                        name: "Gujarat Copper Project",
                        address: "Plot No. 747, GIDC Estate, P.O. Jhagadia, District Bharuch, Gujarat – 393110",
                        phone: "",
                        lat: 21.700,
                        lon: 73.130
                    }
                };

                function calculateDistance(lat1, lon1, lat2, lon2) {
                    var radians = Math.PI / 180;
                    var dLat = (lat2 - lat1) * radians;
                    var dLon = (lon2 - lon1) * radians;

                    var a =
                        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                        Math.cos(lat1 * radians) *
                        Math.cos(lat2 * radians) *
                        Math.sin(dLon / 2) *
                        Math.sin(dLon / 2);

                    return 6371 * 2 *
                        Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
                }

                var nearestCity = null;
                var nearestOffice = null;
                var shortestDistance = Infinity;

                for (var city in offices) {
                    if (Object.prototype.hasOwnProperty.call(offices, city)) {
                        var office = offices[city];

                        var distance = calculateDistance(
                            userLat,
                            userLon,
                            office.lat,
                            office.lon
                        );

                        if (distance < shortestDistance) {
                            shortestDistance = distance;
                            nearestCity = city;
                            nearestOffice = office;
                        }
                    }
                }

                if (nearestOffice) {
                    document.getElementById("officeCitySelect").value = nearestCity;
                    displayOffice(nearestCity, nearestOffice, shortestDistance);
                } else {
                    result.textContent =
                        "No office locations are currently available.";
                }

                button.disabled = false;
            },
            function (error) {
                button.disabled = false;

                if (error.code === 1) {
                    result.textContent =
                        "Location permission was denied. Please select a city manually.";
                } else if (error.code === 3) {
                    result.textContent =
                        "Location request timed out. Please try again or select a city manually.";
                } else {
                    result.textContent =
                        "Unable to determine your location. Please select a city manually.";
                }
            },
            {
                enableHighAccuracy: false,
                timeout: 10000,
                maximumAge: 300000
            }
        );
    }



</script>

