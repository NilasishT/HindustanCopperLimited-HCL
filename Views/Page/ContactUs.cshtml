    }

    .colmidl h1.titile {
        font-size: 28px;
        color: #111111;
        border-bottom: 2px solid #dcdcdc;
        padding-bottom: 10px;
        margin-bottom: 25px;
        font-weight: bold;
    }

    .sidebar-menu {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .sidebar-menu li {
        margin-bottom: 6px !important;
    }
    .sidebar-menu li a {
        display: flex !important;
        align-items: center;
        min-height: 44px !important;
        padding: 10px 15px !important;
        text-decoration: none;
        color: #2b2b2b;
        box-sizing: border-box;
    }
    .sidebar-menu li a i {
