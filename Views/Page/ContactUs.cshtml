        font-weight: bold;
        font-size: 13px;
        color: #111111;
        background-color: #f1f3f5;
        margin-bottom: 8px !important;
    }

    .contact-utility-bar {
        background-color: #f5eae1;
        border: 1px solid #e2d2c5;
        border-radius: 4px;
        padding: 15px;
        margin-bottom: 25px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .search-box-input {
        padding: 8px 12px;
        font-size: 15px;
        border: 1px solid #a1a1a1;
        border-radius: 4px;
        min-height: 44px;
        min-width: 240px;
        background-color: #ffffff;
        box-sizing: border-box;
        color: #111111;
    }

    .btn-share {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 18px;
        margin: 4px;
        background-color: #ffffff;
        color: #2b2b2b !important;
        text-decoration: none !important;
        border: 1px solid #a1a1a1;
        border-radius: 4px;
        font-size: 14px;
        min-height: 44px;
        min-width: 44px;
        box-sizing: border-box;
        transition: all 0.2s;
        font-weight: 500;
    }
    .btn-share:hover {
        background-color: #f5eae1;
        border-color: #a92323;
    }

    #contactDataTable {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 25px;
    }
    #contactDataTable th {
        background-color: #a92323;
        color: #ffffff;
        text-align: left;
        padding: 14px 18px;
        font-size: 16px!important;
        border-bottom: 3px solid #7d1616;
        font-weight: bold;
        letter-spacing: 0.5px;
    }
    #contactDataTable td {
        padding: 18px 15px;
        border-bottom: 1px solid #dddddd;
        vertical-align: top;
        font-size: 15px;
        line-height: 1.8;
        color: #2b2b2b;
    }
    #contactDataTable td:first-child {
        font-weight: bold;
        width: 25%;
        color: #111111;
        font-size: 16px;
    }

    @@media (max-width: 768px) {
        .contact-utility-bar {
            flex-direction: column;
            align-items: stretch;
        }
        .search-box-input {
            width: 100%;
        }
        .btn-share {
            display: block;
            width: 100%;
            text-align: center;
            margin: 6px 0;
        }

        #contactDataTable, #contactDataTable tbody, #contactDataTable tr, #contactDataTable td {
            display: block !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }

            #contactDataTable th {
                display: block !important;
                width: 100% !important;
                text-align: center !important;
                margin-top: 20px;
                border-radius: 4px;
                padding: 12px !important;
                height: unset !important;
            }

        #contactDataTable tr:not(:has(th)) {
            background-color: #ffffff !important;
            border: 1px solid #e2d2c5 !important;
            border-radius: 6px;
            margin-top: 12px;
            margin-bottom: 15px;
            padding: 14px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        #contactDataTable td {
            border: none !important;
            padding: 6px 4px !important;
            font-size: 15px !important;
        }

        #contactDataTable td:first-child {
            font-size: 17px !important;
            color: #a34500;
            border-bottom: 1px dashed #e2d2c5 !important;
            padding-bottom: 8px !important;
            margin-bottom: 8px;
        }
    }
</style>

