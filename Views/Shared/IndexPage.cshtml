    <!-- Top bar: collapsible on mobile. Paste just before </body> (after the other scripts). -->
    <script>
        (function () {
            'use strict';

            function init() {
                var bar = document.querySelector('#header .top-head');
                var list = bar ? bar.querySelector('.login-srch-box') : null;
                if (!bar || !list || list.querySelector('.th-more')) return;

                Array.prototype.forEach.call(list.children, function (li) {
                    if (li.id === 'menuLanguage') {
                        li.classList.add('th-lang');
                    } else if (li.querySelector('.fa-home')) {
                        li.classList.add('th-home');
                    } else if (li.querySelector('.font-size-icon')) {
                        li.classList.add('th-font');
                    } else if (li.classList.contains('header-search')) {
                        li.classList.add('th-search', 'th-extra');
                    } else if (!li.textContent.trim() && !li.querySelector('img, button, input')) {
                        li.classList.add('th-empty');
                    } else {
                        li.classList.add('th-extra');
                        if (li.querySelector('#meripehchanLogin')) li.classList.add('th-wide');
                    }
                });

                var hi = (document.documentElement.lang || '').toLowerCase().indexOf('hi') === 0;
                var moreTxt = hi ? 'और' : 'More';
                var lessTxt = hi ? 'कम' : 'Less';
                var ariaTxt = hi ? 'अधिक विकल्प दिखाएँ या छिपाएँ' : 'Show or hide more options';

                var li = document.createElement('li');
                li.className = 'th-more';
                li.innerHTML =
                    '<button type="button" class="th-more-btn" aria-expanded="false" aria-label="' + ariaTxt + '">' +
                    '<span class="th-more-label">' + moreTxt + '</span>' +
                    '<i class="fa fa-chevron-down th-more-chevron" aria-hidden="true"></i>' +
                    '</button>';
                list.appendChild(li);

                var btn = li.querySelector('button');
                var label = li.querySelector('.th-more-label');

                btn.addEventListener('click', function () {
                    var open = bar.classList.toggle('is-open');
                    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                    label.textContent = open ? lessTxt : moreTxt;
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>

