            }

                #footer .footer_widget_nav li a {
                    display: flex;
                    align-items: center;
                    min-height: 44px;
                    padding: 10px 6px;
                    line-height: 1.5;
                }

            #footer .footer_social li a {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 44px;
                min-height: 44px;
            }

            #footer .footer-links a,
            #footer .privacy_footer_link a {
