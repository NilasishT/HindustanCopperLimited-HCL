        /* =================================
           Language Icon
        ================================= */
        a.login.dropdown-toggle.language-icon {
            display: block !important;
        }

        .nav .open a.login.dropdown-toggle.language-icon {
            background-color: #6f3706;
        }

        .login-srch-box li#menuLanguage ul li:first-child {
            padding: 0px;
        }

        #menuLanguage .dropdown-menu li a:hover {
            background: #6f3706;
            color: #fff;
        }

        #menuLanguage .language-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 !important;
            height: 29px;
            text-decoration: none;
        }

        #menuLanguage .language-symbol {
            position: relative;
            display: inline-block;
            width: 30px;
            height: 29px;
            color: #fff;
            font-family: Arial, sans-serif;
        }

        /* Top letter */
        #menuLanguage .english-letter,
        #menuLanguage .hindi-letter {
            position: absolute;
            font-size: 16px;
            line-height: 16px;
        }

        /* A position */
        #menuLanguage .english-letter {
            top: 0;
            left: 7px;
        }

        /* अ position */
        #menuLanguage .hindi-letter {
            bottom: 0;
            right: 6px;
        }

        /* Vertical lines */


        /* Dropdown */
        #menuLanguage .dropdown-menu {
            min-width: 160px;
            padding: 5px 0;
        }

            #menuLanguage .dropdown-menu li {
                display: block !important;
                float: none !important;
                width: 100%;
            }

                #menuLanguage .dropdown-menu li a {
                    display: block;
                    padding: 8px 15px;
                    white-space: nowrap;
                }


        /* =====================================================
                   UX4G COMPLIANCE ADDITIONS
                   ===================================================== */

        /* --- MeriPehchan SSO button --- */
        .meripehchan-btn {
            display: inline-flex !important;
            align-items: center;
            gap: 6px;
            background: #ffffff;
            color: #1a1d5e !important;
            border: 1px solid #1a1d5e;
            border-radius: 4px;
            font-weight: 600;
            padding: 4px 10px !important;
            min-height: 29px;
            text-decoration: none;
        }

            .meripehchan-btn:hover, .meripehchan-btn:focus {
                background: #1a1d5e;
                color: #ffffff !important;
            }

            .meripehchan-btn img {
                height: 22px;
                width: auto;
                display: inline-block;
            }

        /* --- Visible keyboard focus --- */
        #header a:focus, #header button:focus, #footer a:focus,
        .ux4g-widget a:focus, .ux4g-widget button:focus,
        .ux4g-widget input:focus, .ux4g-widget select:focus {
            outline: 3px solid #ffbf47;
            outline-offset: 2px;
        }

        /* --- Shared widget look --- */
        .ux4g-widget {
            width: 90%;
            margin: 15px auto;
            padding: 15px;
            background: #fff8f0;
            border: 1px solid #e3c9ab;
            border-radius: 6px;
            box-sizing: border-box;
        }

            .ux4g-widget h2 {
                font-size: 18px;
                margin: 0 0 10px;
                color: #5a3311;
            }

            .ux4g-widget .ux4g-row {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                align-items: center;
            }

            .ux4g-widget input[type=text], .ux4g-widget select {
                min-height: 44px;
                padding: 6px 10px;
                border: 1px solid #935116;
                border-radius: 4px;
                background: #fff;
                flex: 1 1 180px;
                max-width: 100%;
                box-sizing: border-box;
            }

        .ux4g-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 44px;
            min-width: 44px;
            padding: 8px 14px;
            background: #935116;
            color: #fff !important;
            border: 0;
            border-radius: 4px;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
        }

            .ux4g-btn:hover {
                background: #6f3706;
            }

        .ux4g-links {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

