    <script>
        $(document).ready(function () {

            // External link confirmation (same as home page)
            jQuery(document.body).RedirectConfirm({
                selector: "a",
                excluding: 'data-rc-exclude',
                title: 'हमारी वेबसाइट से बाहर निकल रहे हैं',
                message: 'आप www.hindustancopper.com से बाहर जा रहे हैं। यह एक बाहरी वेबसाइट है।',
                returnlbl: 'वापस जाएँ',
                continuelbl: 'जारी रखें',
                targetUrl: '_blank'
            });

            // Datepicker used on Vigilance forms
            if ($.fn.datepicker) {
                $('.date').datepicker({
                    format: 'dd-mm-yyyy'
                }).on('changeDate', function (ev) {
                    $(this).next("span").remove();
                });
            }

            $("div.bhoechie-tab-menu>div.list-group>a").click(function (e) {
                e.preventDefault();
                $(this).siblings('a.active').removeClass("active");
                $(this).addClass("active");
                var index = $(this).index();
                $("div.bhoechie-tab>div.bhoechie-tab-content").removeClass("active");
                $("div.bhoechie-tab>div.bhoechie-tab-content").eq(index).addClass("active");
            });
        });

        $(document).on('show', '.accordion', function (e) {
            $(e.target).prev('.accordion-heading').addClass('accordion-opened');
        });

        $(document).on('hide', '.accordion', function (e) {
            $(this).find('.accordion-heading').not($(e.target)).removeClass('accordion-opened');
        });

        // Search
        $('#search').keypress(function (e) {
            if (e.which == 13) {
                $(location).attr('href', "/Page/Search?q=" + this.value);
            }
        });

        $("#searchBg").click(function () {
            var searchText = $("#search").val();
            $(location).attr('href', "/Page/Search?q=" + searchText);
        });

        // Hide top bar on scroll
        var sttt = setTimeout(function () { }, 1000);
        $(window).scroll(function () {
            clearTimeout(sttt);
            sttt = setTimeout(function () {
                if ($(window).scrollTop() > 50) {
                    $(".top-head").addClass("hidden");
                } else {
                    $(".top-head").removeClass("hidden");
                }
            }, 200);
        });

        $('#sampleTable').DataTable();

        /* ===== Accessible text size ===== */
        var min = 8;
        var max = 14;
        var textsize = 12;

        function applyFontSize(size) {
            textsize = Math.max(min, Math.min(max, size));
            var scale = textsize / 12;

            document.body.style.fontSize = textsize + "px";

            var elements = document.querySelectorAll("body *");

            elements.forEach(function (element) {
                if (element.matches("img, svg, script, style, iframe")) {
                    return;
                }

                if (!element.hasAttribute("data-original-font-size")) {
                    var originalSize = parseFloat(window.getComputedStyle(element).fontSize);
                    element.setAttribute("data-original-font-size", originalSize);
                }

                var original = parseFloat(element.getAttribute("data-original-font-size"));

                if (!isNaN(original)) {
                    element.style.fontSize = (original * scale) + "px";
                }
            });

            createCookie("fontSet", textsize, 3);
        }

        window.increaseFontSize = function () { applyFontSize(textsize + 1); };
        window.decreaseFontSize = function () { applyFontSize(textsize - 1); };
        window.resetFontSize = function () { applyFontSize(12); };

        function createCookie(name, value, days) {
            var date = new Date();
            date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
            document.cookie =
                name + "=" + encodeURIComponent(value) +
                "; expires=" + date.toUTCString() +
                "; path=/; SameSite=Lax";
        }

        function readCookie(name) {
            var nameEQ = name + "=";
            var cookies = document.cookie.split(";");
            for (var i = 0; i < cookies.length; i++) {
                var cookie = cookies[i].trim();
                if (cookie.indexOf(nameEQ) === 0) {
                    return decodeURIComponent(cookie.substring(nameEQ.length));
                }
            }
            return null;
        }

        function readCookieSet() {
            var savedSize = parseFloat(readCookie("fontSet"));
            if (!isNaN(savedSize)) {
                textsize = Math.max(min, Math.min(max, savedSize));
            }
            applyFontSize(textsize);
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", readCookieSet);
        } else {
            readCookieSet();
        }
    </script>

    <script>
        /* ---------- Footer accordion on mobile (delegated, resize-safe) ---------- */
        (function () {
            'use strict';

            var mq = window.matchMedia('(max-width: 767px)');

            function widgets() {
                return document.querySelectorAll('#footer .single_footer_widget');
            }

            function setState(w, h, collapsed) {
                if (collapsed) { w.classList.add('footer-collapsed'); }
                else { w.classList.remove('footer-collapsed'); }
                h.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
            }

            function setup() {
                var list = widgets();
                for (var i = 0; i < list.length; i++) {
                    var w = list[i];
                    var h = w.querySelector('h3');
                    var nav = w.querySelector('.footer_widget_nav');
                    if (!h || !nav) continue;

                    if (mq.matches) {
                        if (!h.classList.contains('footer-acc-toggle')) {
                            h.classList.add('footer-acc-toggle');
                            h.setAttribute('role', 'button');
                            h.setAttribute('tabindex', '0');
                            setState(w, h, true);
                        }
                    } else {
                        h.classList.remove('footer-acc-toggle');
                        h.removeAttribute('role');
                        h.removeAttribute('tabindex');
                        h.removeAttribute('aria-expanded');
                        w.classList.remove('footer-collapsed');
                    }
                }
            }

            function toggleFrom(target) {
                var el = target && target.nodeType === 1 ? target : (target ? target.parentNode : null);
                var h = el && el.closest ? el.closest('#footer .single_footer_widget h3.footer-acc-toggle') : null;
                if (!h) return false;
                var w = h.parentNode;
                setState(w, h, !w.classList.contains('footer-collapsed'));
                return true;
            }

            // Delegated: works even if other scripts re-bind or re-render footer elements
            document.addEventListener('click', function (e) {
                if (toggleFrom(e.target)) { e.preventDefault(); }
            });

            document.addEventListener('keydown', function (e) {
                if ((e.key === 'Enter' || e.key === ' ') && toggleFrom(e.target)) {
                    e.preventDefault();
                }
            });

            setup();
            window.addEventListener('resize', setup);
            window.addEventListener('orientationchange', setup);
            window.addEventListener('load', setup);
        })();
    </script>

    <!-- Top bar: collapsible on mobile. Paste just before </body> (after the other scripts). -->
    <script>
        (function () {
            'use strict';

            function init() {
                var bar = document.querySelector('#header .top-head');
                var list = bar ? bar.querySelector('.login-srch-box') : null;
                if (!bar || !list || list.querySelector('.th-more')) return;

                Array.prototype.forEach.call(list.children, function (li) {
                    if (li.id === 'menuLanguage') {
                        li.classList.add('th-lang');
                    } else if (li.querySelector('.fa-home')) {
                        li.classList.add('th-home');
                    } else if (li.querySelector('.font-size-icon')) {
                        li.classList.add('th-font');
                    } else if (li.classList.contains('header-search')) {
                        li.classList.add('th-search', 'th-extra');
                    } else if (!li.textContent.trim() && !li.querySelector('img, button, input')) {
                        li.classList.add('th-empty');
                    } else {
                        li.classList.add('th-extra');
                        if (li.querySelector('#meripehchanLogin')) li.classList.add('th-wide');
                    }
                });

                var hi = (document.documentElement.lang || '').toLowerCase().indexOf('hi') === 0;
                var moreTxt = hi ? 'और' : 'More';
                var lessTxt = hi ? 'कम' : 'Less';
                var ariaTxt = hi ? 'अधिक विकल्प दिखाएँ या छिपाएँ' : 'Show or hide more options';

                var li = document.createElement('li');
                li.className = 'th-more';
                li.innerHTML =
                    '<button type="button" class="th-more-btn" aria-expanded="false" aria-label="' + ariaTxt + '">' +
                    '<span class="th-more-label">' + moreTxt + '</span>' +
                    '</button>';
                list.appendChild(li);

                var btn = li.querySelector('button');
                var label = li.querySelector('.th-more-label');

                btn.addEventListener('click', function () {
                    var open = bar.classList.toggle('is-open');
                    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                    label.textContent = open ? lessTxt : moreTxt;
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>

    <script>
        (function () {
            var header = document.getElementById('gxHeader');
            var html = document.documentElement;

            /* Make sure mobile browsers use the real screen width */
            if (!document.querySelector('meta[name="viewport"]')) {
                var meta = document.createElement('meta');
                meta.name = 'viewport';
                meta.content = 'width=device-width, initial-scale=1';
                document.head.appendChild(meta);
            }

            function save(key, value) { try { localStorage.setItem(key, value); } catch (e) { } }
            function load(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }

            /* ---------- Top popups (language / accessibility) ---------- */
            var popupButtons = header.querySelectorAll('[data-gx-popup]');
            var menuButtons = header.querySelectorAll('.gx-menu-item > button.gx-menu-link');

            function closePopups() {
                header.querySelectorAll('.gx-popup.gx-open').forEach(function (p) { p.classList.remove('gx-open'); });
                popupButtons.forEach(function (b) { b.setAttribute('aria-expanded', 'false'); });
            }
            function closeMenus() {
                header.querySelectorAll('.gx-dropdown.gx-open').forEach(function (d) { d.classList.remove('gx-open'); });
                menuButtons.forEach(function (b) { b.setAttribute('aria-expanded', 'false'); });
            }

            popupButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var popup = document.getElementById(btn.getAttribute('data-gx-popup'));
                    var wasOpen = popup.classList.contains('gx-open');
                    closePopups(); closeMenus();
                    if (!wasOpen) { popup.classList.add('gx-open'); btn.setAttribute('aria-expanded', 'true'); }
                });
            });

            /* ---------- Menu dropdowns ---------- */
            menuButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var drop = btn.nextElementSibling;
                    var wasOpen = drop.classList.contains('gx-open');
                    closeMenus(); closePopups();
                    if (!wasOpen) { drop.classList.add('gx-open'); btn.setAttribute('aria-expanded', 'true'); }
                });
            });

            /* Click outside or Esc closes popups and dropdowns */
            document.addEventListener('click', function (e) {
                if (!e.target.closest('.gx-tool, .gx-menu-item')) { closePopups(); closeMenus(); }
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') { closePopups(); closeMenus(); }
            });

            /* ---------- Mobile hamburger ---------- */
            var burger = document.getElementById('gxBurger');
            var panel = document.getElementById('gxNavPanel');

            burger.addEventListener('click', function () {
                var open = panel.classList.toggle('gx-open');
                burger.setAttribute('aria-expanded', open ? 'true' : 'false');
                closePopups();
            });
            /* ---------- Screen size -> classes (tablet <= 991px, phone <= 575px) ---------- */
            function applyScreenMode() {
                var w = window.innerWidth || document.documentElement.clientWidth;
                header.classList.toggle('gx-tablet', w <= 991);
                header.classList.toggle('gx-phone', w <= 575);
                if (w > 991) {
                    panel.classList.remove('gx-open');
                    burger.setAttribute('aria-expanded', 'false');
                }
            }
            window.addEventListener('resize', applyScreenMode);
            window.addEventListener('orientationchange', applyScreenMode);
            applyScreenMode();

            /* ---------- Accessibility modes ---------- */
            var modeButtons = header.querySelectorAll('[data-gx-mode]');
            var colorModes = ['gx-high-contrast', 'gx-invert', 'gx-saturation'];
            var fontPercent = parseInt(load('gxFont'), 10) || 100;

            function refreshButtons() {
                modeButtons.forEach(function (b) {
                    b.classList.toggle('gx-on', html.classList.contains(b.getAttribute('data-gx-mode')));
                });
                header.querySelector('[data-gx-font="reset"]').classList.toggle('gx-on', fontPercent === 100);
                header.querySelector('[data-gx-reset="contrast"]').classList.toggle('gx-on',
                    !colorModes.some(function (c) { return html.classList.contains(c); }));
            }
            function saveModes() {
                var active = [];
                modeButtons.forEach(function (b) {
                    var m = b.getAttribute('data-gx-mode');
                    if (html.classList.contains(m)) active.push(m);
                });
                save('gxModes', active.join(','));
            }

            modeButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var mode = btn.getAttribute('data-gx-mode');
                    if (colorModes.indexOf(mode) > -1 && !html.classList.contains(mode)) {
                        colorModes.forEach(function (c) { html.classList.remove(c); });   /* one color mode at a time */
                    }
                    html.classList.toggle(mode);
                    saveModes(); refreshButtons();
                });
            });

            header.querySelector('[data-gx-reset="contrast"]').addEventListener('click', function () {
                colorModes.forEach(function (c) { html.classList.remove(c); });
                saveModes(); refreshButtons();
            });

            /* ---------- Font size ---------- */
            /* Many sites use px font sizes, so changing the <html> size does nothing.
               Instead we scale the real font size of every element that holds text. */
            var textScaled = false;

            function hasOwnText(el) {
                for (var i = 0; i < el.childNodes.length; i++) {
                    var n = el.childNodes[i];
                    if (n.nodeType === 3 && n.nodeValue.trim() !== '') return true;
                }
                return false;
            }

            function scaleText() {
                var skip = { SCRIPT: 1, STYLE: 1, NOSCRIPT: 1, SVG: 1, PATH: 1, BR: 1, HTML: 1, HEAD: 1 };
                var all = document.body.querySelectorAll('*');
                var targets = [];

                /* 1) read: remember the original size once */
                for (var i = 0; i < all.length; i++) {
                    var el = all[i];
                    if (skip[el.tagName.toUpperCase()] || el.closest('svg')) continue;
                    var isField = /^(INPUT|TEXTAREA|SELECT|BUTTON)$/.test(el.tagName);
                    if (!isField && !hasOwnText(el)) continue;
                    if (!el.hasAttribute('data-gx-fs')) {
                        el.setAttribute('data-gx-fs', parseFloat(getComputedStyle(el).fontSize) || 16);
                    }
                    targets.push(el);
                }

                /* 2) write: apply the new size (or remove it when back to 100%) */
                targets.forEach(function (el) {
                    if (fontPercent === 100) {
                        el.style.removeProperty('font-size');
                        el.removeAttribute('data-gx-fs');
                    } else {
                        var size = parseFloat(el.getAttribute('data-gx-fs')) * fontPercent / 100;
                        el.style.setProperty('font-size', size + 'px', 'important');
                    }
                });
                textScaled = fontPercent !== 100;
            }

            function applyFont() {
                save('gxFont', fontPercent);
                if (fontPercent !== 100 || textScaled) scaleText();
                refreshButtons();
            }
            header.querySelectorAll('[data-gx-font]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var type = btn.getAttribute('data-gx-font');
                    if (type === 'up' && fontPercent < 150) fontPercent += 10;
                    if (type === 'down' && fontPercent > 80) fontPercent -= 10;
                    if (type === 'reset') fontPercent = 100;
                    applyFont();
                });
            });

            /* ---------- Restore saved settings ---------- */
            (load('gxModes') || '').split(',').forEach(function (m) { if (m) html.classList.add(m); });
            applyFont();

            /* Page is fully loaded -> re-apply the saved text size to the whole page */
            window.addEventListener('load', function () {
                if (fontPercent !== 100) scaleText();
            });
        })();
        header.querySelectorAll('.gx-menu-item').forEach(function (item) {
            item.addEventListener('mouseenter', function () {
                if (!header.classList.contains('gx-tablet')) { closeMenus(); closePopups(); }
            });
        });
    </script>
</body>
</html>
