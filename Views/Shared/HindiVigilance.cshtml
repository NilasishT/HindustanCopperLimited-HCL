    <script src="@Url.Content("~/Content/js/redirect.confirm.js?a=5")"></script>

    <script>
        $(document).ready(function () {

            // External link confirmation (same as home page)
            jQuery(document.body).RedirectConfirm({
                selector: "a",
                excluding: 'data-rc-exclude',
                title: 'हमारी वेबसाइट से बाहर निकल रहे हैं',
                message: 'आप www.hindustancopper.com से बाहर जा रहे हैं। यह एक बाहरी वेबसाइट है।',
                returnlbl: 'वापस जाएँ',
                continuelbl: 'जारी रखें',
                targetUrl: '_blank'
            });

            // Datepicker used on Vigilance forms
            if ($.fn.datepicker) {
                $('.date').datepicker({
                    format: 'dd-mm-yyyy'
                }).on('changeDate', function (ev) {
                    $(this).next("span").remove();
                });
            }

            $("div.bhoechie-tab-menu>div.list-group>a").click(function (e) {
                e.preventDefault();
                $(this).siblings('a.active').removeClass("active");
                $(this).addClass("active");
                var index = $(this).index();
                $("div.bhoechie-tab>div.bhoechie-tab-content").removeClass("active");
                $("div.bhoechie-tab>div.bhoechie-tab-content").eq(index).addClass("active");
            });
        });

        $(document).on('show', '.accordion', function (e) {
            $(e.target).prev('.accordion-heading').addClass('accordion-opened');
        });

        $(document).on('hide', '.accordion', function (e) {
            $(this).find('.accordion-heading').not($(e.target)).removeClass('accordion-opened');
        });

        // Search
        $('#search').keypress(function (e) {
            if (e.which == 13) {
                $(location).attr('href', "/Page/Search?q=" + this.value);
            }
        });

        $("#searchBg").click(function () {
            var searchText = $("#search").val();
            $(location).attr('href', "/Page/Search?q=" + searchText);
        });

        // Hide top bar on scroll
        var sttt = setTimeout(function () { }, 1000);
        $(window).scroll(function () {
            clearTimeout(sttt);
            sttt = setTimeout(function () {
                if ($(window).scrollTop() > 50) {
                    $(".top-head").addClass("hidden");
                } else {
                    $(".top-head").removeClass("hidden");
                }
            }, 200);
        });

        $('#sampleTable').DataTable();

        /* ===== Accessible text size ===== */
        var min = 8;
        var max = 14;
        var textsize = 12;

        function applyFontSize(size) {
            textsize = Math.max(min, Math.min(max, size));
            var scale = textsize / 12;

            document.body.style.fontSize = textsize + "px";

            var elements = document.querySelectorAll("body *");

            elements.forEach(function (element) {
                if (element.matches("img, svg, script, style, iframe")) {
                    return;
                }

                if (!element.hasAttribute("data-original-font-size")) {
                    var originalSize = parseFloat(window.getComputedStyle(element).fontSize);
                    element.setAttribute("data-original-font-size", originalSize);
                }

                var original = parseFloat(element.getAttribute("data-original-font-size"));

                if (!isNaN(original)) {
                    element.style.fontSize = (original * scale) + "px";
                }
            });

            createCookie("fontSet", textsize, 3);
        }

        window.increaseFontSize = function () { applyFontSize(textsize + 1); };
        window.decreaseFontSize = function () { applyFontSize(textsize - 1); };
        window.resetFontSize = function () { applyFontSize(12); };

        function createCookie(name, value, days) {
            var date = new Date();
            date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
            document.cookie =
                name + "=" + encodeURIComponent(value) +
                "; expires=" + date.toUTCString() +
                "; path=/; SameSite=Lax";
        }

        function readCookie(name) {
            var nameEQ = name + "=";
            var cookies = document.cookie.split(";");
            for (var i = 0; i < cookies.length; i++) {
                var cookie = cookies[i].trim();
                if (cookie.indexOf(nameEQ) === 0) {
                    return decodeURIComponent(cookie.substring(nameEQ.length));
                }
            }
            return null;
        }

        function readCookieSet() {
            var savedSize = parseFloat(readCookie("fontSet"));
            if (!isNaN(savedSize)) {
                textsize = Math.max(min, Math.min(max, savedSize));
            }
            applyFontSize(textsize);
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", readCookieSet);
        } else {
            readCookieSet();
        }
    </script>

    <script>
        /* ---------- Footer accordion on mobile (delegated, resize-safe) ---------- */
        (function () {
            'use strict';

            var mq = window.matchMedia('(max-width: 767px)');

            function widgets() {
                return document.querySelectorAll('#footer .single_footer_widget');
            }

            function setState(w, h, collapsed) {
                if (collapsed) { w.classList.add('footer-collapsed'); }
                else { w.classList.remove('footer-collapsed'); }
                h.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
            }

            function setup() {
                var list = widgets();
                for (var i = 0; i < list.length; i++) {
                    var w = list[i];
                    var h = w.querySelector('h3');
                    var nav = w.querySelector('.footer_widget_nav');
                    if (!h || !nav) continue;

                    if (mq.matches) {
                        if (!h.classList.contains('footer-acc-toggle')) {
                            h.classList.add('footer-acc-toggle');
                            h.setAttribute('role', 'button');
                            h.setAttribute('tabindex', '0');
                            setState(w, h, true);
                        }
                    } else {
                        h.classList.remove('footer-acc-toggle');
                        h.removeAttribute('role');
                        h.removeAttribute('tabindex');
                        h.removeAttribute('aria-expanded');
                        w.classList.remove('footer-collapsed');
                    }
                }
            }

            function toggleFrom(target) {
                var el = target && target.nodeType === 1 ? target : (target ? target.parentNode : null);
                var h = el && el.closest ? el.closest('#footer .single_footer_widget h3.footer-acc-toggle') : null;
                if (!h) return false;
                var w = h.parentNode;
                setState(w, h, !w.classList.contains('footer-collapsed'));
                return true;
            }

            // Delegated: works even if other scripts re-bind or re-render footer elements
            document.addEventListener('click', function (e) {
                if (toggleFrom(e.target)) { e.preventDefault(); }
            });

            document.addEventListener('keydown', function (e) {
                if ((e.key === 'Enter' || e.key === ' ') && toggleFrom(e.target)) {
                    e.preventDefault();
                }
            });

            setup();
            window.addEventListener('resize', setup);
            window.addEventListener('orientationchange', setup);
            window.addEventListener('load', setup);
        })();
    </script>

    <!-- Top bar: collapsible on mobile. Paste just before </body> (after the other scripts). -->
    <script>
        (function () {
            'use strict';

            function init() {
                var bar = document.querySelector('#header .top-head');
                var list = bar ? bar.querySelector('.login-srch-box') : null;
                if (!bar || !list || list.querySelector('.th-more')) return;

                Array.prototype.forEach.call(list.children, function (li) {
                    if (li.id === 'menuLanguage') {
                        li.classList.add('th-lang');
                    } else if (li.querySelector('.fa-home')) {
                        li.classList.add('th-home');
                    } else if (li.querySelector('.font-size-icon')) {
                        li.classList.add('th-font');
                    } else if (li.classList.contains('header-search')) {
                        li.classList.add('th-search', 'th-extra');
                    } else if (!li.textContent.trim() && !li.querySelector('img, button, input')) {
                        li.classList.add('th-empty');
                    } else {
                        li.classList.add('th-extra');
                        if (li.querySelector('#meripehchanLogin')) li.classList.add('th-wide');
                    }
                });

                var hi = (document.documentElement.lang || '').toLowerCase().indexOf('hi') === 0;
                var moreTxt = hi ? 'और' : 'More';
                var lessTxt = hi ? 'कम' : 'Less';
                var ariaTxt = hi ? 'अधिक विकल्प दिखाएँ या छिपाएँ' : 'Show or hide more options';

                var li = document.createElement('li');
                li.className = 'th-more';
                li.innerHTML =
                    '<button type="button" class="th-more-btn" aria-expanded="false" aria-label="' + ariaTxt + '">' +
                    '<span class="th-more-label">' + moreTxt + '</span>' +
                    '<i class="fa fa-chevron-down th-more-chevron" aria-hidden="true"></i>' +
                    '</button>';
                list.appendChild(li);

                var btn = li.querySelector('button');
                var label = li.querySelector('.th-more-label');

                btn.addEventListener('click', function () {
                    var open = bar.classList.toggle('is-open');
                    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                    label.textContent = open ? lessTxt : moreTxt;
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>


