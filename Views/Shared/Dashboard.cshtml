                        removeDialogTabs: 'link:upload;image:upload'
                    });

                }

                //});
                $('#spinner').hide();

                $('.date').datepicker({
                    format: 'dd-mm-yyyy'
                }).datepicker().on('changeDate', function (ev) {
                    $(this).next("span").remove();

                });



                var date = new Date();
                date.setDate(date.getDate());





                $('.currentDate').datepicker({
                    startDate: date,
                    format: 'dd-mm-yyyy'
                }).on('changeDate', function (ev) {
                    $(this).next("span").remove();

                });



                $('.date-own').datepicker({
                    minViewMode: 2,
                    format: 'yyyy',
                    endDate: '+0y'
                }).on('changeDate', function (ev) {
                    $(this).next("span").remove();

                });

                $('.date-ownm').datepicker({
                    minViewMode: 1,
                    format: 'MM'
                }).on('changeDate', function (ev) {
                    $(this).next("span").remove();

                });


                $('.date-ownt').datetimepicker({
                    format: 'HH:ii p',
                    minuteStep: 1,
                    autoclose: true,
                    minView: 0,
                    maxView: 1,
                    startView: 1,

                });



                $('.form_datetime').datetimepicker({
                    //language:  'fr',
                    weekStart: 1,
                    todayBtn: 1,
                    autoclose: 1,
                    todayHighlight: 1,
                    startView: 2,
                    forceParse: 0,
                    showMeridian: 1,
                    startDate: date,
                    format: 'dd-mm-yyyy HH:ii p'
                }).on('changeDate', function (ev) {
                    $(this).next("span").remove();

                });

                $('#sampleTableScrolling').DataTable({
                    "scrollX": true
                });
                if ($('#sampleTable')[0] != undefined) {
                    $('#sampleTable').DataTable({
                        bDestroy: true
                    });
                }
                $(".form_datetime").datetimepicker({
                    format: 'dd-mm-yyyy'
                });




                $('.datenew').datepicker({
                    format: 'dd-mm-yyyy', endDate: '+0d',
                    autoclose: true
                }).datepicker().on('changeDate', function (ev) {
                    $(this).next("span").remove();

                });
                $("input,textarea").keyup(function () {
                    var str1 = this.value;
                    //05/12/2018
                    //        var str2="(";
                    //        if (str1.indexOf('(') > -1){
                    //        alert('Invalid input');
                    //           this.value="";
                    //        }
                    if (str1.indexOf(';') > -1) {
                        alert('Invalid input');
                        this.value = "";
                    }
                    if (str1.indexOf('script') > -1) {
                        alert('Invalid input');
                        this.value = "";
                    }
                    if (str1.indexOf('alert') > -1) {
                        alert('Invalid input');
                        this.value = "";
                    }
                });
                $('input[type="file"]').not('#PhotoGallery').change(function (e) {
                    var extension = $(this).val().replace(/^.*\./, '');

                    if (extension.toLowerCase() == 'pdf' || extension.toLowerCase() == 'png' || extension.toLowerCase() == 'jpg' || extension.toLowerCase() == 'jpeg' || extension.toLowerCase() == 'doc' || extension.toLowerCase() == 'docx' || extension.toLowerCase() == 'xls' || extension.toLowerCase() == 'xlsx') {
                        var size = this.files[0].size / 1048576;
                        if (parseFloat(size) <= 4) {
                        }
                        else {
                            alert('Please check file Size');
                            $(this).val('');
                        }

                    }
                    else {
                        alert('Only allow pdf,png,jpg,jpeg,doc,docx,xls,xlsx');
                        $(this).val('');
                    }


                })
            })
