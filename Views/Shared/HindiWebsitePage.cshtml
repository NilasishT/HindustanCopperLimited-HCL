        // Minimum, maximum and default font sizes
        var min = 8;
        var max = 14;
        var textsize = 12;

        // Elements that must not be resized
        function shouldSkipFontResize(element) {
            if (!element || element.nodeType !== 1) {
                return true;
            }

            return element.matches(
                "img, svg, script, style, noscript, template, iframe, canvas, video, audio"
            ) ||
                !!element.closest(
                    ".text-size-control, .font-size-icon, .fa, .fas, .far, .fab, .glyphicon"
                );
        }

        // Store original font sizes for the page elements
        function captureOriginalFontSizes(root) {
            var elements = [];

            if (root && root.nodeType === 1) {
                elements.push(root);
            }

            if (root && root.querySelectorAll) {
                elements = elements.concat(
                    Array.from(root.querySelectorAll("*"))
                );
            }

            elements.forEach(function (element) {
                if (shouldSkipFontResize(element)) {
                    return;
                }

                if (!element.hasAttribute("data-original-font-size")) {
                    var currentSize = parseFloat(
                        window.getComputedStyle(element).fontSize
                    );

                    var originalSize = currentSize / (textsize / 12);

                    if (!isNaN(originalSize) && originalSize > 0) {
                        element.setAttribute(
                            "data-original-font-size",
                            originalSize
                        );
                    }
                }
            });
        }




        // Apply font size to an individual element.
        // This is required by applyFontSize() below.
        function resizeElementFont(element, scale) {

            // Do not resize images, icons, scripts or other excluded elements.
            if (shouldSkipFontResize(element)) {
                return;
            }

            // Get the original font size captured before resizing.
            var originalSize = parseFloat(
                element.getAttribute("data-original-font-size")
            );

            // Apply the selected font scale.
            if (!isNaN(originalSize)) {

                element.style.setProperty(
                    "font-size",
                    (originalSize * scale) + "px",
                    "important"
                );
            }
        }


        // Apply the selected font size to the page
        function resizeWebsiteText() {
            var scale = textsize / 12;

            document.body.style.fontSize = textsize + "px";

            var elements = document.querySelectorAll("body *");

            elements.forEach(function (element) {
                if (shouldSkipFontResize(element)) {
                    return;
                }

                var originalSize = parseFloat(
                    element.getAttribute("data-original-font-size")
                );

                if (!isNaN(originalSize)) {
                    element.style.setProperty(
                        "font-size",
                        (originalSize * scale) + "px",
                        "important"
                    );
                }
            });
        }

