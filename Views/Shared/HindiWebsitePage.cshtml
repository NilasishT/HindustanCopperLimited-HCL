    <script>
        (function () {
            'use strict';

            function saveConsent(personalisationAllowed) {
                var payload = JSON.stringify({
                    essential: true,
                    personalisation: !!personalisationAllowed,
                    timestamp: new Date().toISOString()
                });
                createCookie("hcl_cookie_consent", payload, 180);

                if (personalisationAllowed) {
                    if (textsize !== 12) createCookie("fontSet", textsize, 3);
                } else {
                    eraseCookie("fontSet");
                }

                document.getElementById("hcl-cookie-banner").style.display = "none";
                document.getElementById("hcl-cookie-modal-backdrop").style.display = "none";
            }

            function initCookieConsent() {
                var banner = document.getElementById("hcl-cookie-banner");
                var modal = document.getElementById("hcl-cookie-modal-backdrop");
                var chkPers = document.getElementById("chk-personalisation");

                var existing = readCookie("hcl_cookie_consent");
                if (!existing) {
                    banner.style.display = "block";
                } else {
                    chkPers.checked = hasPersonalisationConsent();
                }

                document.getElementById("cb-accept").addEventListener("click", function () {
                    saveConsent(true);
                });

                document.getElementById("cb-reject").addEventListener("click", function () {
                    saveConsent(false);
                });

                document.getElementById("cb-customise").addEventListener("click", function () {
                    chkPers.checked = hasPersonalisationConsent();
                    modal.style.display = "flex";
                });

                document.getElementById("cm-cancel").addEventListener("click", function () {
                    modal.style.display = "none";
                });

                document.getElementById("cm-save").addEventListener("click", function () {
                    saveConsent(chkPers.checked);
                });

                var reopenLink = document.getElementById("openCookieSettings");
                if (reopenLink) {
                    reopenLink.addEventListener("click", function () {
                        chkPers.checked = hasPersonalisationConsent();
                        modal.style.display = "flex";
                    });
                }
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", initCookieConsent);
            } else {
                initCookieConsent();
            }
        })();
    </script>

</body>
</html>