                display: block;
                font-size: 16px;
                color: #5a3311;
                margin-bottom: 4px;
            }

        .hcl-cb-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .hcl-cb-btn {
            min-height: 44px;
            min-width: 44px;
            padding: 8px 18px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            border: 2px solid #916100;
