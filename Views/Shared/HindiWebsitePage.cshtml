    <style>
        /* =====================================================
        DBIM COMPLIANCE: NOTO SANS TYPEFACE (ALL ELEMENTS)
        ===================================================== */
        *:not(.fa):not(.fas):not(.far):not(.fab):not(.fa-solid):not(.fa-regular):not(.fa-brands):not(.glyphicon):not([class*="icon"]) {
            font-family: 'Noto Sans', 'Noto Sans Devanagari', sans-serif !important;
        }

        /* Protect icon fonts so icons never break */
        .fa, .fas, .far, .fab, .fa-solid, .fa-regular, .fa-brands {
            font-family: "Font Awesome 6 Free", "Font Awesome 6 Brands", "FontAwesome" !important;
        }

        .glyphicon {
            font-family: "Glyphicons Halflings" !important;
        }



        /* === COOKIE CONSENT BANNER & MODAL === */
        #hcl-cookie-banner {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 10050;
            background: #fff8f0;
            border-top: 4px solid #916100;
            box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.18);
            padding: 16px 20px;
            font-family: "Noto Sans", sans-serif !important;
            display: none;
        }

