            padding: 0px;
        }

        #menuLanguage .dropdown-menu li a:hover {
            background: #916100;
            color: #fff;
        }

        #menuLanguage .language-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 !important;
            height: 29px;
            text-decoration: none;
        }

        #menuLanguage .language-symbol {
            position: relative;
            display: inline-block;
            width: 30px;
            height: 29px;
            color: #fff;
            font-family: "Noto Sans Devanagari", sans-serif !important;
        }

        /* Top letter */
        #menuLanguage .english-letter,
        #menuLanguage .hindi-letter {
            position: absolute;
            font-size: 16px;
            line-height: 16px;
        }

        /* A position */
        #menuLanguage .english-letter {
            top: 0;
            left: 7px;
        }

        /* अ position */
        #menuLanguage .hindi-letter {
            bottom: 0;
            right: 6px;
        }

        /* Vertical lines */


        /* Dropdown */
        #menuLanguage .dropdown-menu {
            min-width: 160px;
            padding: 5px 0;
        }

            #menuLanguage .dropdown-menu li {
                display: block !important;
                float: none !important;
                width: 100%;
            }

                #menuLanguage .dropdown-menu li a {
                    display: block;
                    padding: 8px 15px;
                    white-space: nowrap;
                }




        /* Accessible text-size controls */
        #header .text-size-control {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 44px;
            min-height: 44px;
            padding: 4px 6px;
            border: none;
            background: transparent;
            cursor: pointer;
            vertical-align: middle;
        }

            #header .text-size-control img {
                display: block;
                max-width: 100%;
                height: auto;
            }

            #header .text-size-control:focus-visible {
                outline: 3px solid #ffbf47;
                outline-offset: 2px;
            }

        /* Hide the Google Translate top banner */
        .goog-te-banner-frame,
        .goog-te-banner,
        iframe.goog-te-banner-frame,
        body > .skiptranslate {
            display: none !important;
        }

        /* Reset the page position after translation */
        html {
            margin-top: 0 !important;
            top: 0 !important;
        }

        body {
            margin-top: 0 !important;
            top: 0 !important;
        }

        /* Keep the HCL communication bar visible */
        #header,
        #header .top-head {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }

        .font-size-icon {
            display: inline-block;
            font-family: "Noto Sans Devanagari", sans-serif !important;
            font-size: 18px !important;
            font-weight: bold;
            line-height: 1;
        }

            .font-size-icon sup {
                font-size: 18px !important;
                position: relative;
                top: -2px;
            }


        /* Footer navigation - accessible touch targets */

        #footer .footer_widget_nav {
            list-style: none;
            margin: 0;
            padding: 0;
        }

            #footer .footer_widget_nav li {
                display: block;
                margin: 0;
