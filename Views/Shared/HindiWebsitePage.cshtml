        // Check if personalisation cookie consent is granted
        function hasPersonalisationConsent() {
            var consent = readCookie("hcl_cookie_consent");
            if (!consent) return false;
            try {
                return JSON.parse(consent).personalisation === true;
            } catch (e) {
                return false;
            }
        }

        function eraseCookie(name) {
            document.cookie = name + "=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; SameSite=Lax";
        }

        // Apply font size throughout the complete website
        function applyFontSize(size) {
            textsize = Math.max(min, Math.min(max, size));
            captureOriginalFontSizes(document.body);
            var scale = textsize / 12;
            currentFontScale = scale;

            var elements = document.querySelectorAll("body *");
            elements.forEach(function (element) {
                resizeElementFont(element, scale);
            });

            resizeElementFont(document.body, scale);

            // Save selected font size ONLY if user consented to personalisation cookies
            if (hasPersonalisationConsent()) {
                createCookie("fontSet", textsize, 3);
            }
        }

        // Increase font size: A+
        window.increaseFontSize = function () {
            applyFontSize(textsize + 1);
        };

        // Decrease font size: A-
        window.decreaseFontSize = function () {
            applyFontSize(textsize - 1);
        };

        // Reset font size: A
        window.resetFontSize = function () {
            applyFontSize(12);
        };

        // Create cookie
        function createCookie(name, value, days) {
            var date = new Date();
            date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
            document.cookie =
                name + "=" + encodeURIComponent(value) +
                "; expires=" + date.toUTCString() +
                "; path=/; SameSite=Lax";
        }

        // Read cookie
        function readCookie(name) {
            var nameEQ = name + "=";
            var cookies = document.cookie.split(";");
            for (var i = 0; i < cookies.length; i++) {
                var cookie = cookies[i].trim();
                if (cookie.indexOf(nameEQ) === 0) {
                    return decodeURIComponent(cookie.substring(nameEQ.length));
                }
            }
            return null;
        }

        // Restore previously selected font size only if consent exists
        function readCookieSet() {
            if (!hasPersonalisationConsent()) {
                eraseCookie("fontSet");
                return;
            }
            var savedSize = parseFloat(readCookie("fontSet"));
            if (!isNaN(savedSize)) {
                textsize = Math.max(min, Math.min(max, savedSize));
                applyFontSize(textsize);
            }
        }


        // Initialize font size controls
        function initializeFontSizeControls() {
            readCookieSet();

            // Handle dynamically added page content
            if (window.MutationObserver) {
                var observer = new MutationObserver(function (mutations) {
                    mutations.forEach(function (mutation) {
                        mutation.addedNodes.forEach(function (node) {
                            if (node.nodeType === 1) {
                                captureOriginalFontSizes(node);
                                resizeWebsiteText();
                            }
                        });
                    });
                });

                observer.observe(document.body, {
                    childList: true,
                    subtree: true
                });
            }
        }

        // Run after the page has loaded
        if (document.readyState === "loading") {
            document.addEventListener(
                "DOMContentLoaded",
                initializeFontSizeControls
            );
        } else {
            initializeFontSizeControls();
        }




