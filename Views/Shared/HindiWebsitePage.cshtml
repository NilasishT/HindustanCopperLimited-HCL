                padding: 10px 12px;
                box-sizing: border-box;
                line-height: 1.5;
                white-space: normal;
            }

                #footer .footer_widget_nav a:focus,
                #footer .footer_widget_nav a:focus-visible {
                    outline: 3px solid #ffbf47;
                    outline-offset: 2px;
                    position: relative;
                    z-index: 2;
                }

        /* Footer social navigation - accessible touch targets */

        #footer .footer_social {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            margin: 10px 0 0;
            padding: 0;
            list-style: none;
        }

            #footer .footer_social li {
                display: block;
                margin: 0;
                padding: 0;
            }

                #footer .footer_social li a {
                    display: inline-flex !important;
                    align-items: center;
                    justify-content: center;
                    width: 44px;
                    min-width: 44px;
                    height: 44px;
                    min-height: 44px;
                    padding: 8px;
                    box-sizing: border-box;
                    border-radius: 4px;
                    text-decoration: none;
                }

                    #footer .footer_social li a i {
                        font-size: 18px;
                        line-height: 1;
                    }

                    #footer .footer_social li a:hover {
                        text-decoration: none;
                    }

                    #footer .footer_social li a:focus,
                    #footer .footer_social li a:focus-visible {
                        outline: 3px solid #ffbf47;
                        outline-offset: 3px;
                        position: relative;
                        z-index: 2;
                    }
