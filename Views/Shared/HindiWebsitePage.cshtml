            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        .hcl-cm-dialog {
            background: #ffffff;
            border-radius: 12px;
            border-top: 5px solid #916100;
            max-width: 540px;
            width: 100%;
            padding: 24px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            font-family: "Noto Sans", sans-serif !important;
        }

            .hcl-cm-dialog h2 {
                margin: 0 0 10px;
                font-size: 20px;
                color: #5a3311;
            }

        .hcl-cm-item {
            border: 1px solid #ecd7bf;
            background: #fff8f0;
            border-radius: 8px;
            padding: 12px 14px;
            margin-bottom: 12px;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
        }

            .hcl-cm-item label {
                font-weight: 600;
                color: #5a3311;
                margin: 0 0 4px;
                display: block;
                cursor: pointer;
            }

            .hcl-cm-item p {
                margin: 0;
                font-size: 13px;
                color: #4a3a2c;
            }

            .hcl-cm-item input[type="checkbox"] {
                width: 22px;
                height: 22px;
                margin-top: 2px;
                accent-color: #916100;
                cursor: pointer;
            }

        .hcl-cm-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 16px;
        }
    </style>

</head>
