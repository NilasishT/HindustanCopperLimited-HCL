        }

        #menuLanguage .language-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 !important;
            height: 29px;
            text-decoration: none;
        }

        #menuLanguage .language-symbol {
            position: relative;
            display: inline-block;
            width: 30px;
            height: 29px;
            color: #fff;
            font-family: Arial, sans-serif;
        }

        /* Top letter */
        #menuLanguage .english-letter,
        #menuLanguage .hindi-letter {
            position: absolute;
            font-size: 16px;
            line-height: 16px;
        }

        /* A position */
        #menuLanguage .english-letter {
            top: 0;
            left: 7px;
        }

        /* अ position */
        #menuLanguage .hindi-letter {
            bottom: 0;
            right: 6px;
        }

        /* Vertical lines */


        /* Dropdown */
        #menuLanguage .dropdown-menu {
            min-width: 160px;
            padding: 5px 0;
        }

            #menuLanguage .dropdown-menu li {
                display: block !important;
                float: none !important;
                width: 100%;
            }

                #menuLanguage .dropdown-menu li a {
                    display: block;
                    padding: 8px 15px;
                    white-space: nowrap;
