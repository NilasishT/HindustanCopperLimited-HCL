@{
    IEnumerable<Hindustancopperlimited.Models.MenuModel> model1 =((Hindustancopperlimited.Controllers.BaseController)this.ViewContext.Controller).BuildMenu(Convert.ToInt32(Session["UserId"]));
} 



@foreach (var item in model1)
{
    
   <li >
        <a href="~/@item.strMenuController/@item.strMenuAction">@item.strMenuText</a></li>
}

