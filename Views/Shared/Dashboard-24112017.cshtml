    <script type="text/javascript">

        $(document).ready(function () {
            $("form").on('focus', ':input', function () {
                $(this).attr('autocomplete', 'off');
            });
        });


        $('.date').datepicker({ format: 'dd-mm-yyyy'
        }).datepicker().on('changeDate', function (ev) {
            $(this).next("span").remove();

        });



        var date = new Date();
        date.setDate(date.getDate());

      
            
       

        $('.currentDate').datepicker({
            startDate: date,
            format: 'dd-mm-yyyy'
        }).on('changeDate', function (ev) {
            $(this).next("span").remove();

        });



        $('.date-own').datepicker({
            minViewMode: 2,
            format: 'yyyy',
            endDate: '+0y'
        }).on('changeDate', function (ev) {
            $(this).next("span").remove();

        });

        $('.date-ownm').datepicker({
            minViewMode:1,
            format: 'MM'
        }).on('changeDate', function (ev) {
            $(this).next("span").remove();
        
        });


        $('.date-ownt').datetimepicker({
            format: 'HH:ii p',
                    minuteStep: 1,
                    autoclose: true,
                    minView: 0,
                    maxView: 1,
                    startView: 1,

        });



        $('.form_datetime').datetimepicker({
            //language:  'fr',
            weekStart: 1,
            todayBtn: 1,
            autoclose: 1,
            todayHighlight: 1,
            startView: 2,
            forceParse: 0,
            showMeridian: 1,
            startDate: date,
            format: 'dd-mm-yyyy HH:ii p'
        }).on('changeDate', function (ev) {
            $(this).next("span").remove();

        });

        $('#sampleTableScrolling').DataTable({
            "scrollX": true
        });

        $('#sampleTable').DataTable();

        $(".form_datetime").datetimepicker({
            format: 'dd-mm-yyyy'
        });
    </script>
   
	
