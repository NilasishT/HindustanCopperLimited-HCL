    <script>
        /* ===== UX4G / GIGW FIXES: mobile carousel, headings, broken media, empty panels ===== */
        (function () {
            'use strict';

            var mq = window.matchMedia('(max-width: 767px)');

            /* ---------- 1. Mobile carousel: one slide, prev / next controls ---------- */
            function getSlides(root) {
                var owl = root.querySelectorAll('.owl-item');
                if (owl.length) return Array.prototype.slice.call(owl);
                return Array.prototype.filter.call(root.children, function (c) {
                    return c.classList.contains('item');
                });
            }

            function setupCarousel() {
                var roots = document.querySelectorAll('#slider .slider-carousel');
                Array.prototype.forEach.call(roots, function (root) {
                    var old = root.parentNode.querySelector(':scope > .hcl-m-controls');
                    if (!mq.matches) {
                        root.classList.remove('hcl-m-slider');
                        if (old) old.parentNode.removeChild(old);
                        getSlides(root).forEach(function (el) { el.classList.remove('hcl-active'); });
                        return;
                    }
                    if (root.classList.contains('hcl-m-slider')) return;
                    var slides = getSlides(root);
                    if (slides.length < 2) return;

                    root.classList.add('hcl-m-slider');
                    var index = 0;

                    var bar = document.createElement('div');
                    bar.className = 'hcl-m-controls';
                    bar.setAttribute('role', 'group');
                    bar.setAttribute('aria-label', 'उद्योग स्लाइड');
                    bar.innerHTML =
                        '<button type="button" class="ux4g-btn hcl-m-prev" aria-label="पिछली स्लाइड"><i class="fa fa-chevron-left" aria-hidden="true"></i></button>' +
                        '<span class="hcl-m-count" role="status" aria-live="polite"></span>' +
                        '<button type="button" class="ux4g-btn hcl-m-next" aria-label="अगली स्लाइड"><i class="fa fa-chevron-right" aria-hidden="true"></i></button>';
                    root.parentNode.insertBefore(bar, root.nextSibling);
                    var count = bar.querySelector('.hcl-m-count');

                    function show(i) {
                        index = (i + slides.length) % slides.length;
                        slides.forEach(function (el, n) {
                            el.classList.toggle('hcl-active', n === index);
                        });
                        count.textContent = 'स्लाइड ' + (index + 1) + ' / ' + slides.length;
                    }
                    bar.querySelector('.hcl-m-prev').addEventListener('click', function () { show(index - 1); });
                    bar.querySelector('.hcl-m-next').addEventListener('click', function () { show(index + 1); });
                    show(0);
                });
            }

            /* ---------- 2. Heading outline: only the page introduction is H1 ---------- */
            function fixHeadings() {
                var main = document.querySelector('main');
                if (!main) return;
                var h1s = main.querySelectorAll('h1');
                var primary = main.querySelector('h1.hcl-intro-title') || h1s[0];
                for (var i = 0; i < h1s.length; i++) {
                    if (h1s[i] === primary) continue;
                    h1s[i].setAttribute('role', 'heading');
                    h1s[i].setAttribute('aria-level', h1s[i].classList.contains('top-gap') ? '3' : '2');
                }
                /* hidden modal headings must not join the reading outline */
                Array.prototype.forEach.call(document.querySelectorAll('.modal h1, .modal h2, .modal h3, .modal h4'), function (h) {
                    h.setAttribute('role', 'presentation');
                });
            }

            /* ---------- 3. Broken media: compact text fallback ---------- */
            function failImage(img) {
                if (!img || img.getAttribute('data-hcl-failed')) return;
                if (!img.closest('main') || img.closest('.hcl-m-controls')) return;
                img.setAttribute('data-hcl-failed', '1');
                var alt = (img.getAttribute('alt') || '').trim();
                var parent = img.parentNode;
                /* panel only holds the failed image: drop its dark background and reserved height */
                if (parent && parent !== document.body) {
                    parent.style.setProperty('background', 'none', 'important');
                    parent.style.setProperty('min-height', '0', 'important');
                    parent.style.setProperty('height', 'auto', 'important');
                }
                var box = document.createElement('div');
                box.className = 'hcl-media-fallback';
                box.setAttribute('role', 'img');
                box.setAttribute('aria-label', alt || 'छवि उपलब्ध नहीं है');
                box.innerHTML = '<i class="fa fa-picture-o" aria-hidden="true"></i><span></span>';
                box.querySelector('span').textContent = alt ? alt + ' (छवि अभी उपलब्ध नहीं है)' : 'छवि अभी उपलब्ध नहीं है';
                img.style.display = 'none';
                parent.insertBefore(box, img);
            }

            document.addEventListener('error', function (e) {
                if (e.target && e.target.tagName === 'IMG') failImage(e.target);
            }, true);

            function scanImages() {
                Array.prototype.forEach.call(document.querySelectorAll('main img'), function (img) {
                    if (img.complete && img.naturalWidth === 0 && img.getAttribute('src')) failImage(img);
                });
            }

            /* ---------- 4. Collapse empty reserved-height containers ---------- */
            function collapseEmpty() {
                var zone = document.querySelectorAll('#totalCol .wrap *');
                Array.prototype.forEach.call(zone, function (el) {
                    if (!/^(DIV|SECTION|ARTICLE|ASIDE)$/.test(el.tagName)) return;
                    if (el.hasAttribute('data-keep') || el.classList.contains('hcl-collapsed')) return;
                    if (el.offsetHeight < 40) return;
                    if ((el.textContent || '').replace(/\s+/g, '') !== '') return;
                    if (el.querySelector('img, iframe, video, audio, canvas, svg, input, select, textarea, button, a, table, ul, ol, object, embed, .hcl-media-fallback')) return;
                    el.classList.add('hcl-collapsed');
                });
            }

            function run() {
                setupCarousel();
                fixHeadings();
                scanImages();
                collapseEmpty();
            }

            window.addEventListener('load', function () {
                /* wait for owl carousel / news widgets to finish their own init */
                setTimeout(run, 400);
                setTimeout(function () { scanImages(); collapseEmpty(); }, 2000);
            });

            var resizeTimer;
            window.addEventListener('resize', function () {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(setupCarousel, 200);
            });

            if (document.readyState === 'complete') { setTimeout(run, 400); }
        })();
    </script>

</body>
</html>
