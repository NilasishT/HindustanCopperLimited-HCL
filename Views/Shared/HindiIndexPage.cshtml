        /* =====================================================
           UX4G / GIGW FIXES (home page report)
           ===================================================== */

        /* --- Visible introduction (primary H1) and primary-task panel --- */
        .hcl-intro {
            width: 90%;
            margin: 18px auto 10px;
            padding: 22px 26px;
            box-sizing: border-box;
            background: linear-gradient(135deg, var(--hcl-cream) 0%, #fff 100%);
            border: 1px solid var(--hcl-line);
            border-left: 6px solid var(--hcl-copper);
            border-radius: 14px;
            box-shadow: 0 6px 20px rgba(90,51,17,.08);
            font-family: 'Poppins', 'Open Sans', Arial, sans-serif;
        }

            .hcl-intro .hcl-intro-title {
                font-size: 30px;
                font-weight: 700;
                line-height: 1.2;
                color: var(--hcl-dark);
                margin: 0 0 4px;
            }

            .hcl-intro .hcl-intro-tag {
                font-size: 15px;
                font-weight: 600;
                color: var(--hcl-copper);
                margin: 0 0 10px;
            }

            .hcl-intro .hcl-intro-text {
                font-size: 14px;
                line-height: 1.7;
                color: #4a3a2c;
                margin: 0 0 14px;
                max-width: 980px;
            }

        .hcl-tasks {
            width: 90%;
            margin: 10px auto 16px;
            box-sizing: border-box;
            font-family: 'Poppins', 'Open Sans', Arial, sans-serif;
        }

        .hcl-tasks-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--hcl-dark);
            margin: 0 0 10px;
        }

        .hcl-tasks-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
        }

            .hcl-tasks-list a {
                display: flex;
                align-items: center;
                gap: 12px;
                min-height: 56px;
                padding: 10px 14px;
                background: #fff;
                border: 1px solid var(--hcl-line);
                border-top: 4px solid var(--hcl-copper);
                border-radius: 12px;
                color: var(--hcl-dark);
                font-weight: 600;
                font-size: 14px;
                text-decoration: none;
                box-shadow: 0 4px 14px rgba(90,51,17,.07);
                transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
            }

                .hcl-tasks-list a:hover,
                .hcl-tasks-list a:focus {
                    background: var(--hcl-copper);
                    color: #fff;
                    transform: translateY(-2px);
                    box-shadow: 0 10px 22px rgba(90,51,17,.18);
                }

                .hcl-tasks-list a:focus {
                    outline: 3px solid #ffbf47;
                    outline-offset: 2px;
                }

            .hcl-tasks-list i {
                flex: 0 0 auto;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
                color: var(--hcl-copper);
                background: var(--hcl-cream);
                border: 2px solid var(--hcl-line);
            }

            .hcl-tasks-list a:hover i,
            .hcl-tasks-list a:focus i {
                color: #fff;
                background: rgba(255,255,255,.18);
                border-color: rgba(255,255,255,.5);
            }

        /* --- Heading hierarchy: slide captions are not top-level headings --- */
        h1.top-gap, .owl-item h1.top-gap {
            font-size: 18px !important;
            margin: 0;
        }

        /* --- About / overview must never stay hidden by animation helpers --- */
        .aboutus_area,
        .aboutus_area > *,
        #totalCol .wow {
            visibility: visible !important;
            opacity: 1 !important;
            animation-name: none !important;
        }

            .aboutus_area > h1.titile {
                display: block !important;
            }

            .aboutus_area:not(.hcl-intro) {
                min-height: 0 !important;
                height: auto !important;
            }

        /* --- Whitespace: no reserved heights for empty content --- */
        #totalCol,
        #totalCol .wrap {
            min-height: 0 !important;
            height: auto !important;
        }

        .hcl-collapsed {
            min-height: 0 !important;
            height: auto !important;
            margin: 0 !important;
            padding: 0 !important;
            border: 0 !important;
            display: none !important;
        }

        #totalCol .wrap > section,
        #totalCol .wrap > div {
            padding-top: 12px;
            padding-bottom: 12px;
        }

        /* --- Broken media: compact text fallback instead of black panel --- */
        .hcl-media-fallback {
            display: flex;
            align-items: center;
            gap: 8px;
            min-height: 44px;
            padding: 10px 14px;
            margin: 6px 0;
            font-size: 13px;
            color: var(--hcl-dark);
            background: var(--hcl-cream);
            border: 1px dashed var(--hcl-copper);
            border-radius: 8px;
        }

        /* --- Persistent visible form labels --- */
        .hcl-label {
            font-size: 12px;
            font-weight: 600;
            line-height: 1.3;
            color: var(--hcl-dark);
            margin: 0;
        }

        .hcl-label-block {
            display: block;
            width: 100%;
        }

        #header .search-wrapper {
            flex-wrap: wrap;
            gap: 4px 6px;
        }

        #header .hcl-label-inline {
            color: #fff;
            white-space: nowrap;
            display: inline-block;
        }

        .mobile-only-item .hcl-label-block {
            padding: 4px 0 0;
        }

        .hcl-toolbar-inner {
            align-items: flex-end;
        }

        .hcl-toolbar #filterHeading {
            width: 100%;
            margin-bottom: 2px;
        }

        .hcl-toolbar .hcl-field {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex: 1 1 170px;
            min-width: 0;
        }

            .hcl-toolbar .hcl-field input[type=text],
            .hcl-toolbar .hcl-field select {
                flex: none;
                width: 100%;
            }

        .hcl-toolbar .hcl-field-btn {
            flex: 0 0 auto;
        }

        .hcl-row .hcl-label-block {
            margin-bottom: -4px;
        }

        /* --- Mobile carousel: one slide at a time with manual controls --- */
        .hcl-m-controls {
            display: none;
        }

        @@media (max-width: 767px) {

            .hcl-intro {
                width: calc(100% - 24px);
                padding: 16px;
                margin-top: 12px;
            }

                .hcl-intro .hcl-intro-title {
                    font-size: 22px;
                }

            .hcl-tasks {
                width: calc(100% - 24px);
            }

            .hcl-tasks-list {
                grid-template-columns: repeat(2, 1fr);
                gap: 8px;
            }

                .hcl-tasks-list a {
                    min-height: 52px;
                    padding: 8px 10px;
                    font-size: 13px;
                }

                .hcl-tasks-list li:last-child:nth-child(odd) {
                    grid-column: 1 / -1;
                }

            #slider .row,
            #slider .slider_area,
            #slider .slider_area .col-xs-12,
            #slider .slider_area .container {
                margin: 0;
                padding-left: 0;
                padding-right: 0;
            }

            .slider-carousel .item img,
            .slider-carousel .block img {
                width: 100%;
                max-height: 220px;
                object-fit: cover;
            }

            .hcl-m-slider .owl-wrapper-outer,
            .hcl-m-slider .owl-stage-outer {
                overflow: hidden;
                height: auto !important;
            }

            .hcl-m-slider .owl-wrapper,
            .hcl-m-slider .owl-stage {
                width: 100% !important;
                display: block !important;
                transform: none !important;
                left: 0 !important;
            }

            .hcl-m-slider .owl-item,
            .hcl-m-slider > .item {
                width: 100% !important;
                float: none !important;
            }

                .hcl-m-slider .owl-item:not(.hcl-active),
                .hcl-m-slider > .item:not(.hcl-active) {
                    display: none !important;
                }

            .hcl-m-slider .owl-controls,
            .hcl-m-slider .owl-buttons,
            .hcl-m-slider .owl-pagination {
                display: none !important;
            }

            .hcl-m-controls {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                margin: 8px 0;
            }

                .hcl-m-controls .ux4g-btn {
                    min-width: 44px;
                }

                .hcl-m-controls .hcl-m-count {
                    min-width: 70px;
                    text-align: center;
                    font-size: 13px;
                    font-weight: 600;
                    color: var(--hcl-dark);
                }

            .hcl-toolbar .hcl-field {
                flex: 1 1 100%;
            }

            .hcl-toolbar .hcl-field-btn {
                flex: 1 1 100%;
            }

                .hcl-toolbar .hcl-field-btn .ux4g-btn {
                    width: 100%;
                }
        }

        @@media (min-width: 768px) and (max-width: 991px) {
            .hcl-tasks-list {
                grid-template-columns: repeat(3, 1fr);
            }

            .hcl-intro {
                padding: 18px 20px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .hcl-tasks-list a {
                transition: none;
            }

                .hcl-tasks-list a:hover,
                .hcl-tasks-list a:focus {
                    transform: none;
                }
        }


        /* --- Layout order tweaks: Quick services under slider, intro merged with Welcome --- */
        #slider + .hcl-tasks, .hcl-tasks {
            margin: 20px auto 16px;
        }

        #totalCol > .hcl-intro.hcl-intro-welcome {
            margin: 24px auto 0;
            border-bottom-left-radius: 0;
            border-bottom-right-radius: 0;
            box-shadow: none;
            border-bottom: 0;
        }

            #totalCol > .hcl-intro.hcl-intro-welcome + .wrap {
                border: 1px solid var(--hcl-line);
                border-top: 0;
                border-left: 6px solid var(--hcl-copper);
                border-radius: 0 0 14px 14px;
                box-shadow: 0 6px 20px rgba(90,51,17,.08);
                box-sizing: border-box;
                padding: 6px 26px 18px;
            }




        /* =====================================================
   FOOTER ACCESSIBILITY - UX4G / GIGW
   Hindi and English shared footer improvements
   ===================================================== */

        #footer .footer_widget_nav {
            list-style: none;
            margin: 0;
            padding: 0;
        }

            #footer .footer_widget_nav li {
                display: block;
                width: 100%;
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                border-bottom: 1px solid rgba(128, 128, 128, 0.20);
            }

                #footer .footer_widget_nav li:last-child {
                    border-bottom: none;
                }

                #footer .footer_widget_nav li a {
                    display: flex;
                    align-items: center;
                    width: 100%;
                    min-height: 44px;
                    padding: 10px 12px;
                    box-sizing: border-box;
                    line-height: 1.5;
                    text-decoration: none;
                }

                    #footer .footer_widget_nav li a:focus,
                    #footer .footer_widget_nav li a:focus-visible {
                        outline: 3px solid #ffbf47;
                        outline-offset: 2px;
                        position: relative;
                        z-index: 2;
                    }

                    #footer .footer_widget_nav li a:hover {
                        text-decoration: underline;
                    }

        #footer .footer-links a,
        #footer .privacy_footer_link a {
            display: inline-flex;
            align-items: center;
            min-height: 44px;
            padding: 8px 10px;
            box-sizing: border-box;
        }

        #footer .footer_social li a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 44px;
            min-height: 44px;
        }

    </style>
