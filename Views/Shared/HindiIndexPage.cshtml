    <script>
        /* ===== UX4G ADDITIONS ===== */
        (function () {
            'use strict';

            /* ---------- 1. Nearest HCL unit (opt-in geolocation) ---------- */
            // NOTE: coordinates are approximate - please verify against official data.
            var units = [
                { key: 'west bengal', name: 'कॉर्पोरेट कार्यालय, कोलकाता (पश्चिम बंगाल)', lat: 22.5726, lon: 88.3639 },
                { key: 'rajasthan', name: 'खेतड़ी कॉपर कॉम्प्लेक्स (राजस्थान)', lat: 28.0000, lon: 75.7900 },
                { key: 'madhya pradesh', name: 'मलाजखंड कॉपर प्रोजेक्ट (मध्य प्रदेश)', lat: 22.0300, lon: 80.6800 },
                { key: 'jharkhand', name: 'इंडियन कॉपर कॉम्प्लेक्स, घाटशिला (झारखंड)', lat: 22.5800, lon: 86.4800 },
                { key: 'maharashtra', name: 'तलोजा कॉपर प्रोजेक्ट (महाराष्ट्र)', lat: 19.0300, lon: 73.0900 },
                { key: 'gujarat', name: 'गुजरात कॉपर प्रोजेक्ट, झगड़िया (गुजरात)', lat: 21.7200, lon: 73.2000 }
            ];
            function toRad(d) { return d * Math.PI / 180; }
            function dist(a, b, c, d) {
                var R = 6371, dLat = toRad(c - a), dLon = toRad(d - b);
                var x = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                    Math.cos(toRad(a)) * Math.cos(toRad(c)) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
                return R * 2 * Math.atan2(Math.sqrt(x), Math.sqrt(1 - x));
            }
            var btn = document.getElementById('btnNearest');
            var out = document.getElementById('nearestResult');
            if (btn && out) {
                btn.addEventListener('click', function () {
                    if (!navigator.geolocation) {
                        out.textContent = 'आपका ब्राउज़र स्थान सुविधा का समर्थन नहीं करता। कृपया संयंत्र एवं कार्यालय पृष्ठ देखें।';
                        return;
                    }
                    out.textContent = 'आपका स्थान पता लगाया जा रहा है...';
                    navigator.geolocation.getCurrentPosition(function (pos) {
                        var best = null, bestD = Infinity;
                        for (var i = 0; i < units.length; i++) {
                            var d = dist(pos.coords.latitude, pos.coords.longitude, units[i].lat, units[i].lon);
                            if (d < bestD) { bestD = d; best = units[i]; }
                        }
                        out.textContent = 'निकटतम एचसीएल इकाई: ' + best.name + ' (लगभग ' + Math.round(bestD) + ' किमी दूर)।';
                        var rs = document.getElementById('regionSelect');
                        if (rs) {
                            for (var j = 0; j < rs.options.length; j++) {
                                if (best.key && rs.options[j].value.indexOf(best.key) === 0) { rs.selectedIndex = j; break; }
                            }
                        }
                    }, function () {
                        out.textContent = 'स्थान की अनुमति नहीं दी गई। आप फिर भी संयंत्र एवं कार्यालय तथा बिक्री कार्यालय देख सकते हैं।';
                    }, { timeout: 10000 });
                });
            }

            var regionSel = document.getElementById('regionSelect');
            var regionGo = document.getElementById('regionGo');
            if (regionSel && regionGo) {
                regionGo.addEventListener('click', function () {
                    var kwBox = document.getElementById('fltKeyword');
                    if (kwBox && regionSel.value) {
                        kwBox.value = regionSel.value.split('|')[0];
                        kwBox.dispatchEvent(new Event('input'));
                    }
                });
            }

            /* ---------- 2. Share buttons ---------- */
            var url = encodeURIComponent(window.location.href);
            var ttl = encodeURIComponent(document.title);
            function setHref(id, href) { var e = document.getElementById(id); if (e) e.href = href; }
            setHref('shFb', 'https://www.facebook.com/sharer/sharer.php?u=' + url);
            setHref('shTw', 'https://twitter.com/intent/tweet?url=' + url + '&text=' + ttl);
            setHref('shLi', 'https://www.linkedin.com/sharing/share-offsite/?url=' + url);
            setHref('shWa', 'https://wa.me/?text=' + ttl + '%20' + url);
            setHref('shMl', 'mailto:?subject=' + ttl + '&body=' + url);
            var copyBtn = document.getElementById('shCopy');
            var copyStatus = document.getElementById('copyStatus');
            if (copyBtn) {
                copyBtn.addEventListener('click', function () {
                    var link = window.location.href;
                    function done(msg) { if (copyStatus) { copyStatus.textContent = msg; setTimeout(function () { copyStatus.textContent = ''; }, 3000); } }
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(link).then(function () { done('लिंक कॉपी हो गया'); }, function () { done('कॉपी नहीं हो सका'); });
                    } else {
                        var t = document.createElement('input'); t.value = link; document.body.appendChild(t); t.select();
                        try { document.execCommand('copy'); done('लिंक कॉपी हो गया'); } catch (e) { done('कॉपी नहीं हो सका'); }
                        document.body.removeChild(t);
                    }
                });
            }

            /* ---------- 3. Filter & sort (client-side, non-destructive) ---------- */
            var kw = document.getElementById('fltKeyword'),
                cat = document.getElementById('fltCategory'),
                dept = document.getElementById('fltDept'),
                srt = document.getElementById('fltSort'),
                rst = document.getElementById('fltReset'),
                st = document.getElementById('fltStatus');

            function items() {
                var nodes = document.querySelectorAll('#totalCol table tbody tr, #totalCol .demo1 li, #totalCol ul.list-group > li, .demo1 li');
                var seen = [], res = [];
                for (var i = 0; i < nodes.length; i++) {
                    if (seen.indexOf(nodes[i]) === -1) { seen.push(nodes[i]); res.push(nodes[i]); }
                }
                return res;
            }
            function parseDate(txt) {
                var m = txt.match(/(\d{1,2})[-\/.](\d{1,2})[-\/.](\d{4})/);
                if (m) return new Date(+m[3], +m[2] - 1, +m[1]).getTime();
                m = txt.match(/(\d{4})[-\/.](\d{1,2})[-\/.](\d{1,2})/);
                if (m) return new Date(+m[1], +m[2] - 1, +m[3]).getTime();
                return 0;
            }
            function applyFilter() {
                var k = (kw.value || '').toLowerCase().trim(),
                    c = cat.value, d = dept.value, shown = 0, list = items();
                for (var i = 0; i < list.length; i++) {
                    var t = (list[i].textContent || '').toLowerCase();
                    var ok = (!k || t.indexOf(k) > -1) && (!c || t.indexOf(c) > -1) && (!d || t.indexOf(d) > -1);
                    list[i].style.display = ok ? '' : 'none';
                    if (ok) shown++;
                }
                if (st) st.textContent = shown + ' आइटम दिखाए गए';
            }
            var originalOrder = null;
            function applySort() {
                var mode = srt.value, list = items();
                if (!list.length) return;
                if (!originalOrder) {
                    originalOrder = list.map(function (el, idx) { return { el: el, parent: el.parentNode, idx: idx }; });
                }
                var groups = [];
                list.forEach(function (el) {
                    var g = null;
                    for (var i = 0; i < groups.length; i++) { if (groups[i].parent === el.parentNode) { g = groups[i]; break; } }
                    if (!g) { g = { parent: el.parentNode, els: [] }; groups.push(g); }
                    g.els.push(el);
                });
                groups.forEach(function (g) {
                    var els = g.els.slice();
                    if (mode === 'default') {
                        els.sort(function (a, b) {
                            var ia = originalOrder.filter(function (o) { return o.el === a; })[0];
                            var ib = originalOrder.filter(function (o) { return o.el === b; })[0];
                            return (ia ? ia.idx : 0) - (ib ? ib.idx : 0);
                        });
                    } else if (mode === 'newest') {
                        els.sort(function (a, b) { return parseDate(b.textContent) - parseDate(a.textContent); });
                    } else if (mode === 'oldest') {
                        els.sort(function (a, b) { return parseDate(a.textContent) - parseDate(b.textContent); });
                    } else if (mode === 'az') {
                        els.sort(function (a, b) { return a.textContent.trim().localeCompare(b.textContent.trim()); });
                    } else if (mode === 'za') {
                        els.sort(function (a, b) { return b.textContent.trim().localeCompare(a.textContent.trim()); });
                    }
                    els.forEach(function (el) { g.parent.appendChild(el); });
                });
            }
            if (kw && cat && dept && srt) {
                kw.addEventListener('input', applyFilter);
                cat.addEventListener('change', applyFilter);
                dept.addEventListener('change', applyFilter);
                srt.addEventListener('change', applySort);
                if (rst) rst.addEventListener('click', function () {
                    kw.value = ''; cat.value = ''; dept.value = ''; srt.value = 'default';
                    applySort(); applyFilter();
                });
            }

            /* ---------- 4. Footer accordion on mobile ---------- */
            function setupFooterAccordion() {
                var mobile = window.matchMedia('(max-width: 767px)').matches;
                var widgets = document.querySelectorAll('#footer .single_footer_widget');
                for (var i = 0; i < widgets.length; i++) {
                    var w = widgets[i], h = w.querySelector('h3'), list = w.querySelector('.footer_widget_nav');
                    if (!h || !list) continue;
                    if (mobile) {
                        if (!h.classList.contains('footer-acc-toggle')) {
                            h.classList.add('footer-acc-toggle');
                            h.setAttribute('role', 'button');
                            h.setAttribute('tabindex', '0');
                            h.setAttribute('aria-expanded', 'false');
                            w.classList.add('footer-collapsed');
                            (function (hh, ww) {
                                function toggle() {
                                    var collapsed = ww.classList.toggle('footer-collapsed');
                                    hh.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
                                }
                                hh.addEventListener('click', toggle);
                                hh.addEventListener('keydown', function (e) {
                                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
                                });
                            })(h, w);
                        }
                    } else {
                        h.classList.remove('footer-acc-toggle');
                        h.removeAttribute('role'); h.removeAttribute('tabindex'); h.removeAttribute('aria-expanded');
                        w.classList.remove('footer-collapsed');
                    }
                }
            }
            setupFooterAccordion();
            window.addEventListener('resize', setupFooterAccordion);
        })();
    </script>

