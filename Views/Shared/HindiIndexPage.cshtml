        // //     createCookie(name, "", -1);
        // // }
        // // var x = readCookie('fontSet')
        // // if (x && x != 0) {
        // //     x = parseInt(x);
        // //     textsize = x;
        // // }

        // // function readCookieSet(name) {
        // //     var intSize = readCookie(name);
        // //     document.body.style.fontSize = textsize + "px";
        // // }


        var min = 8;
        var max = 14;
        var textsize = 12;


        function applyFontSize(size) {
            textsize = Math.max(min, Math.min(max, size));

            var scale = textsize / 12;

            // Update the body's base font size
            document.body.style.fontSize = textsize + "px";

            // Scale text throughout the page, including fixed-size CSS text
            var elements = document.querySelectorAll("body *");

            elements.forEach(function (element) {
                // Avoid resizing images, icons, scripts, and styles
                if (element.matches("img, svg, script, style, iframe")) {
                    return;
                }

                // Save each element's original font size only once
                if (!element.hasAttribute("data-original-font-size")) {
                    var originalSize = parseFloat(
                        window.getComputedStyle(element).fontSize
                    );

                    element.setAttribute(
                        "data-original-font-size",
                        originalSize
                    );
                }

                var original = parseFloat(
                    element.getAttribute("data-original-font-size")
                );

                if (!isNaN(original)) {
                    element.style.fontSize = (original * scale) + "px";
                }
            });

            createCookie("fontSet", textsize, 3);
        }


        window.increaseFontSize = function () {
            applyFontSize(textsize + 1);
        };

        window.decreaseFontSize = function () {
            applyFontSize(textsize - 1);
        };

        window.resetFontSize = function () {
            applyFontSize(12);
        };

        function createCookie(name, value, days) {
            var date = new Date();
            date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);

            document.cookie =
                name + "=" + encodeURIComponent(value) +
                "; expires=" + date.toUTCString() +
                "; path=/; SameSite=Lax";
        }

        function readCookie(name) {
            var nameEQ = name + "=";
            var cookies = document.cookie.split(";");

            for (var i = 0; i < cookies.length; i++) {
                var cookie = cookies[i].trim();

                if (cookie.indexOf(nameEQ) === 0) {
                    return decodeURIComponent(
                        cookie.substring(nameEQ.length)
                    );
                }
            }

            return null;
        }


        function readCookieSet() {
            var savedSize = parseFloat(readCookie("fontSet"));

            if (!isNaN(savedSize)) {
                textsize = Math.max(min, Math.min(max, savedSize));
            }

            applyFontSize(textsize);
        }


        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", readCookieSet);
        } else {
            readCookieSet();
        }



