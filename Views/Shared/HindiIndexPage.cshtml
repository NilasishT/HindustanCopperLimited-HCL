    <script type="text/javascript">
    function googleTranslateElementInit() {
        new google.translate.TranslateElement({
            pageLanguage: 'hi',
            includedLanguages: 'en,hi,bn',
            autoDisplay: false
        }, 'google_translate_element');
    }


    function changeLanguage(language) {
        if (language === 'en') {
            var hostname = window.location.hostname;

            document.cookie =
                'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';

            document.cookie =
                'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=' +
                hostname;

            document.cookie =
                'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=.' +
                hostname;

            window.location.href = '@Url.Action("Index", "Home")';
            return false;
        }

        if (language === 'hi') {
            var hostname = window.location.hostname;

            // Clear Google Translate language cookie
            document.cookie =
                'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';

            document.cookie =
                'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=' +
                hostname;

            document.cookie =
                'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=.' +
                hostname;

            // Open the original Hindi page
            window.location.href = '@Url.Action("Index", "HindiPage")';
            return false;
        }

        var select = document.querySelector('select.goog-te-combo');

        if (!select) {
            alert('Google Translate is loading. Please try again.');
            return false;
        }

        select.value = language;
        select.dispatchEvent(new Event('change', { bubbles: true }));

        return false;
    }


    </script>

