                /* =====================================================
                           HCL LOOK & FEEL (cards, toolbar, journey)
                           ===================================================== */
                :root {
                    --hcl-copper: #935116;
                    --hcl-dark: #5a3311;
                    --hcl-cream: #fff8f0;
                    --hcl-line: #ecd7bf;
                }

                .hcl-zone {
                    width: 90%;
                    margin: 28px auto;
                    box-sizing: border-box;
                }

                    .hcl-zone, .hcl-zone p, .hcl-zone li, .hcl-toolbar {
                        font-family: 'Poppins', 'Open Sans', Arial, sans-serif;
                    }

                /* slim filter toolbar */
                .hcl-toolbar {
                    width: 90%;
                    margin: 14px auto;
                    box-sizing: border-box;
                }

                .hcl-toolbar-inner {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 10px;
                    align-items: center;
                    background: #fff;
                    border: 1px solid var(--hcl-line);
                    border-left: 5px solid var(--hcl-copper);
                    border-radius: 10px;
                    padding: 10px 14px;
                    box-shadow: 0 2px 8px rgba(90,51,17,.08);
                }

                .hcl-toolbar h2 {
                    font-size: 15px;
                    font-weight: 600;
                    margin: 0 8px 0 0;
                    color: var(--hcl-dark);
                    white-space: nowrap;
                }

                .hcl-toolbar input[type=text], .hcl-toolbar select {
                    min-height: 44px;
                    padding: 6px 12px;
                    font-size: 14px;
                    flex: 1 1 150px;
                    min-width: 0;
                    border: 1px solid #d9bd9a;
                    border-radius: 8px;
                    background: #fffdfa;
                    box-sizing: border-box;
                }

                    .hcl-toolbar input:focus, .hcl-toolbar select:focus {
                        border-color: var(--hcl-copper);
                        outline: 3px solid #ffbf47;
                        outline-offset: 1px;
                    }

                /* cards */
                .hcl-grid-2 {
                    display: grid;
                    grid-template-columns: 1.6fr 1fr;
                    gap: 20px;
                    margin-bottom: 36px;
                }

                .hcl-card {
                    position: relative;
                    background: #fff;
                    border: 1px solid var(--hcl-line);
                    border-radius: 16px;
                    padding: 24px;
                    box-shadow: 0 6px 20px rgba(90,51,17,.08);
                    box-sizing: border-box;
                }

                    .hcl-card h2 {
                        font-size: 20px;
                        font-weight: 600;
                        color: var(--hcl-dark);
                        margin: 0 0 6px;
                    }

                    .hcl-card p {
                        font-size: 14px;
                        line-height: 1.6;
                        margin: 0 0 12px;
                        color: #4a3a2c;
                    }

                        .hcl-card p.hcl-muted {
                            color: #7a6650;
                            font-size: 13px;
                        }

                .hcl-card-icon {
                    width: 48px;
                    height: 48px;
                    border-radius: 12px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 22px;
                    color: #fff;
                    background: linear-gradient(135deg, #b8691f, #5a3311);
                    margin-bottom: 12px;
                }

                .hcl-row {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 10px;
                    align-items: center;
                    margin-bottom: 12px;
                }

                    .hcl-row select {
                        flex: 1 1 220px;
                        min-height: 44px;
                        padding: 6px 12px;
                        font-size: 14px;
                        border: 1px solid #d9bd9a;
                        border-radius: 8px;
                        background: #fffdfa;
                    }

                .hcl-btn-ghost {
                    display: inline-flex;
                    align-items: center;
                    min-height: 44px;
                    padding: 8px 16px;
                    font-size: 14px;
                    border: 1.5px solid var(--hcl-copper);
                    color: var(--hcl-copper) !important;
                    border-radius: 8px;
                    background: #fff;
                    text-decoration: none;
                }

                    .hcl-btn-ghost:hover {
                        background: var(--hcl-copper);
                        color: #fff !important;
                    }

                #nearestResult {
                    font-weight: 600;
                    color: var(--hcl-dark);
                    background: var(--hcl-cream);
                    border-radius: 8px;
                    padding: 10px 12px;
                    margin-top: 4px;
                }

                .hcl-chips {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 8px;
                    align-items: center;
                    margin-top: 8px;
                }

                .hcl-chip-label {
                    font-weight: 600;
                    font-size: 13px;
                    color: var(--hcl-copper);
                    margin-right: 4px;
                }

                .hcl-chips a {
                    display: inline-flex;
                    align-items: center;
                    min-height: 44px;
                    padding: 6px 14px;
                    font-size: 13px;
                    border-radius: 999px;
                    background: var(--hcl-cream);
                    border: 1px solid var(--hcl-line);
                    color: var(--hcl-dark);
                    text-decoration: none;
                }

                    .hcl-chips a:hover {
                        background: var(--hcl-copper);
                        color: #fff;
                    }

                /* SSO card */
                .hcl-sso {
                    background: linear-gradient(145deg, #935116 0%, #5a3311 100%);
                    border: 0;
                    color: #fff;
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                }

                    .hcl-sso h2, .hcl-sso p {
                        color: #fff;
                    }

                    .hcl-sso .hcl-card-icon {
                        background: rgba(255,255,255,.18);
                    }

                    .hcl-sso .meripehchan-btn {
                        align-self: flex-start;
                        font-size: 15px;
                        min-height: 48px;
                        padding: 8px 18px !important;
                        box-shadow: 0 4px 12px rgba(0,0,0,.25);
                    }

                .hcl-link-light {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    min-height: 44px;
                    margin-top: 10px;
                    color: #ffe6c7 !important;
                    font-size: 14px;
                }

                    .hcl-link-light:hover {
                        color: #fff !important;
                        text-decoration: underline;
                    }

                /* section titles */
                .hcl-section {
                    margin-bottom: 40px;
                    text-align: center;
                }

                .hcl-title {
                    font-size: 28px;
                    font-weight: 700;
                    color: var(--hcl-dark);
                    margin: 0 0 6px;
                    position: relative;
                    padding-bottom: 14px;
                }

                    .hcl-title:after {
                        content: "";
                        position: absolute;
                        left: 50%;
                        bottom: 0;
                        width: 70px;
                        height: 4px;
                        margin-left: -35px;
                        border-radius: 4px;
                        background: linear-gradient(90deg, #b8691f, #5a3311);
                    }

                .hcl-sub {
                    font-size: 15px;
                    color: #6b5744;
                    margin: 12px 0 24px;
                }

                .hcl-more {
                    margin-top: 18px;
                }

                    .hcl-more a {
                        display: inline-flex;
                        align-items: center;
                        gap: 8px;
                        min-height: 44px;
                        font-weight: 600;
                        font-size: 15px;
                        color: var(--hcl-copper);
                    }

                        .hcl-more a:hover {
                            color: var(--hcl-dark);
                        }

                /* core values */
                .hcl-values {
                    list-style: none;
                    margin: 0;
                    padding: 0;
                    display: grid;
                    grid-template-columns: repeat(3, 1fr);
                    gap: 20px;
                    text-align: left;
                }

                    .hcl-values li {
                        background: #fff;
                        border: 1px solid var(--hcl-line);
                        border-radius: 16px;
                        padding: 24px;
                        box-shadow: 0 4px 14px rgba(90,51,17,.07);
                        transition: transform .2s ease, box-shadow .2s ease;
                        border-top: 4px solid var(--hcl-copper);
                    }

                        .hcl-values li:hover {
                            transform: translateY(-4px);
                            box-shadow: 0 12px 26px rgba(90,51,17,.15);
                        }

                .hcl-ico {
                    width: 52px;
                    height: 52px;
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 22px;
                    color: var(--hcl-copper);
                    background: var(--hcl-cream);
                    border: 2px solid var(--hcl-line);
                    margin-bottom: 14px;
                }

                .hcl-values h3 {
                    font-size: 18px;
                    font-weight: 600;
                    color: var(--hcl-dark);
                    margin: 0 0 6px;
                }

                .hcl-values p {
                    font-size: 14px;
                    line-height: 1.65;
                    color: #4a3a2c;
                    margin: 0;
                }

                /* journey */
                .hcl-journey {
                    list-style: none;
                    margin: 0;
                    padding: 0;
                    display: grid;
                    grid-template-columns: repeat(4, 1fr);
                    gap: 20px;
                    position: relative;
                    text-align: left;
                }

                    .hcl-journey:before {
                        content: "";
                        position: absolute;
                        top: 14px;
                        left: 0;
                        right: 6%;
                        height: 3px;
                        background: var(--hcl-line);
                    }

                    .hcl-journey li {
                        position: relative;
                        padding-top: 38px;
                    }

                        .hcl-journey li:before {
                            content: "";
                            position: absolute;
                            top: 4px;
                            left: 0;
                            width: 22px;
                            height: 22px;
                            border-radius: 50%;
                            background: var(--hcl-copper);
                            border: 4px solid #fff;
                            box-shadow: 0 0 0 2px var(--hcl-copper);
                        }

                    .hcl-journey .yr {
                        display: inline-block;
                        font-weight: 700;
                        font-size: 16px;
                        color: #fff;
                        background: var(--hcl-copper);
                        border-radius: 999px;
                        padding: 3px 14px;
                        margin-bottom: 8px;
                    }

                    .hcl-journey p {
                        font-size: 14px;
                        line-height: 1.65;
                        color: #4a3a2c;
                        margin: 0;
                    }

                /* share */
                .hcl-share {
                    background: #fff;
                    border: 1px solid var(--hcl-line);
                    border-radius: 16px;
                    padding: 18px 22px;
                    box-shadow: 0 4px 14px rgba(90,51,17,.07);
                }

                    .hcl-share h2 {
                        font-size: 18px;
                        font-weight: 600;
                        color: var(--hcl-dark);
                        margin: 0 0 10px;
                    }

                    .hcl-share .ux4g-row {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 10px;
                        align-items: center;
                    }

                @@media (max-width: 991px) {
                    .hcl-grid-2 {
                        grid-template-columns: 1fr;
                    }

                    .hcl-values {
                        grid-template-columns: repeat(2, 1fr);
                    }

                    .hcl-journey {
                        grid-template-columns: repeat(2, 1fr);
                    }

                        .hcl-journey:before {
                            display: none;
                        }
                }

                @@media (max-width: 767px) {
                    .hcl-zone, .hcl-toolbar {
                        width: calc(100% - 24px);
                        margin-top: 16px;
                        margin-bottom: 16px;
                    }

                    .hcl-card {
                        padding: 18px;
                    }

                    .hcl-title {
                        font-size: 22px;
                    }

                    .hcl-values {
                        grid-template-columns: 1fr;
                        gap: 14px;
                    }

                        .hcl-values li {
                            padding: 18px;
                        }

                    .hcl-journey {
                        grid-template-columns: 1fr;
                        gap: 6px;
                        padding-left: 14px;
                        border-left: 3px solid var(--hcl-line);
                    }

                        .hcl-journey li {
                            padding: 0 0 14px 22px;
                        }

                            .hcl-journey li:before {
                                top: 4px;
                                left: -26px;
                            }

                    .hcl-toolbar-inner {
                        padding: 10px;
                    }

                    .hcl-toolbar h2 {
                        width: 100%;
                    }

                    .hcl-toolbar input[type=text], .hcl-toolbar select {
                        flex: 1 1 100%;
                    }

                    .hcl-section {
                        margin-bottom: 28px;
                    }

                    .hcl-sso .meripehchan-btn {
                        align-self: stretch;
                        justify-content: center;
                    }
                }

                @@media (prefers-reduced-motion: reduce) {
                    .hcl-values li {
                        transition: none;
                    }

                        .hcl-values li:hover {
                            transform: none;
                        }
                }

                /* ---- Hindi page specific adjustments ---- */
                #header .login-srch-box {
                    flex-wrap: wrap;
                }

                #header .top-head .pull-right {
                    max-width: 100%;
                }

                .hcl-zone, .hcl-zone p, .hcl-zone li, .hcl-toolbar, .hcl-card, .hcl-title {
                    font-family: 'Noto Sans Devanagari', 'Mukta', 'Poppins', 'Open Sans', Arial, sans-serif;
                }

                    .hcl-zone p, .hcl-values p, .hcl-journey p {
                        line-height: 1.8;
                    }



        /* Accessible text-size controls */
