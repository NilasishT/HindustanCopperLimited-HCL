<body>

    <!-- #region MySection -->
    <header id="header">
        <div class="menu_area">
            <nav class="navbar navbar-default navbar-fixed-top">

                <div class="top-head">
                    <div class="container">

                        <div class="pull-left">
                            @*<ul class="toplinks">
                                  <li><a href="#" target="#" style="color:#CCC;">info@hindustancopper.com</a></li>
                                  <li> | </li>
                                  <li>(+91) (33) 2283 2226/2529/2952</li>
                                </ul>*@
                        </div>

                        <div class="pull-right nav">
                            <ul class="login-srch-box">

                                @if ((Session["UserType"] != null) && (Session["UserType"].ToString() == "VENDOR" || Session["UserType"].ToString() == "CONTRACTOR"))
                                {
                                    <li class="dropdown" id="menuLogin">
                                        <a href="@Url.Action("LogOut", "VendorRegistration")" title="login" class="login">
                                            <!--<i class="fa fa-lock" aria-hidden="true"></i>--> Vendor Log Out
                                        </a>
                                    </li>

