  </body>
</html>
  <script type="text/javascript">

      $(document).ready(function () {
          $("form").on('focus', ':input', function () {
              $(this).attr('autocomplete', 'off');
          });
      });

      $('#spinner').hide();
      $('.date').datepicker({ format: 'dd-mm-yyyy', endDate: '+0d',
          autoclose: true
      }).datepicker();

      $('.date-own').datepicker({
          minViewMode: 2,
          format: 'yyyy',
          endDate: '+0y'
      });
      $('.date-ownm').datepicker({
          minViewMode: 1,
          format: 'MM'
      });
      //Shoumya
      var date = new Date();
      date.setDate(date.getDate());



      $('.currentDate').datepicker({
          startDate: date,
          format: 'dd-mm-yyyy'
      });

  </script>