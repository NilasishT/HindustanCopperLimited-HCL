<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Hindustan Copper Limited</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Canonical Tag -->
    <link rel="canonical" href="@Request.Url.GetLeftPart(UriPartial.Path)" />


    <link rel="stylesheet" type="text/css" href="@Url.Content("~/AdminCssJs/css/main1.css")">
    <link href="@Url.Content("~/Content/css/bootstrap.min.css?a=2")" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/font-awesome.min.css")" rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/Content/css/superslides.css")">
    <link href="@Url.Content("~/Content/css/slick.css")" rel="stylesheet">

    <link rel="stylesheet" href="@Url.Content("~/Content/css/animate.css")">
    <link type="text/css" media="all" rel="stylesheet" href="@Url.Content("~/Content/css/jquery.tosrus.all.css")" />
    <link href="@Url.Content("~/Content/css/style.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/styleInnerpage.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/owl.carousel.css")" rel="stylesheet" media="screen">
    <link href="@Url.Content("~/Content/css/owl.theme.css")" rel="stylesheet" media="screen">
    <link href='http://fonts.googleapis.com/css?family=Merriweather' rel='stylesheet' type='text/css'>
    <link href='http://fonts.googleapis.com/css?family=Varela' rel='stylesheet' type='text/css'>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href='http://fonts.googleapis.com/css?family=Baumans' rel='stylesheet' type='text/css'>
    <link href='http://fonts.googleapis.com/css?family=Poppins:400,600,700,500,300' rel='stylesheet' type='text/css'>
    <link href='http://fonts.googleapis.com/css?family=Roboto:400,900italic,900,700italic,700,400italic,500,500italic,300,100italic,100,300italic' rel='stylesheet' type='text/css'>
    <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet" type='text/css'>
    <link rel="stylesheet" href="@Url.Content("~/Content/css/sidebar-menu.css")">
    <link href="@Url.Content("~/AdminCssJs/css/bootstrap-datepicker.css")" rel="stylesheet" />


    <script src="@Url.Content("~/Content/js/jquery-1.10.2.min.js")"></script>
    <script src="@Url.Content("~/Content/js/jquery.multiple.select.js")"></script>
    <script src="@Url.Content("~/Content/js/jquery.number.js")"></script>
    <script src="@Url.Content("~/AdminCssJs/js/bootstrap-datepicker.js")"></script>
    @*<script src="@Url.Content("~/AdminCssJs/js/bootstrap-datetimepicker.fr.js")"></script>*@
    <script src="@Url.Content("~/AdminCssJs/js/bootstrap-datetimepicker.js")"></script>
    <script src="@Url.Content("~/AdminCssJs/js/chosen.jquery.js")"></script>
    <script src="@Url.Content("~/AdminCssJs/js/chosen.jquery.min.js")"></script>


    <meta name="description" content="Hindustan Copper Limited (HCL), a public sector undertaking under the administrative control of the Ministry of Mines, was incorporated on 9th November 1967. It has the distinction of being the nation’s only vertically integrated copper producing company as it manufactures copper right from the stage of mining to beneficiation, smelting, refining and casting of refined copper metal into downstream saleable products." />
    <meta name="keywords" content="hindustan, hindustan copper, hindustan Copper Limited, HCL, copper producing company, manufactures copper, continuous cast copper rod manufactures, copper cathode manufactures, copper concentrate manufactures, copper sulphate manufactures, tamra bhavan, hcl procurement manual, hcl vendor registration, copper news" />

    <style>
        .d-flex.gap-2 {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .National-Emblem-Logo img {
            max-height: 80px;
        }

        .top-head .container {
            width: 99.5%;
        }

        #header {
            width: 100%;
            position: relative;
            z-index: 9999;
        }

            #header .menu_area {
                width: 100%;
            }

            #header .navbar {
                min-height: 50px;
                margin-bottom: 0;
                border-radius: 0;
            }

            #header .navbar-fixed-top {
                width: 100%;
                z-index: 9999;
            }

            #header .container {
                position: relative;
            }

            #header .top-head {
                width: 100%;
                min-height: 35px;
            }

            #header .header-utility-wrapper {
                width: 100%;
                position: relative;
            }

                #header .header-utility-wrapper > .nav {
                    float: right;
                }

            #header .login-srch-box {
                margin: 0;
                padding: 0;
                list-style: none;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                flex-wrap: wrap;
                gap: 4px
            }

                #header .login-srch-box > li {
                    display: inline-block;
                    vertical-align: middle;
                    white-space: nowrap;
                }

                    #header .login-srch-box > li > a {
                        display: inline-block;
                        vertical-align: middle;
                    }

            #header .header-search {
                padding-left: 5px;
            }

            #header .search-wrapper {
                display: flex;
                align-items: center;
            }

            #header #search {
                width: 160px;
                height: 29px;
                padding: 5px 10px;
                border: 1px solid #ccc;
                outline: none;
                box-sizing: border-box;
            }

            #header #searchBg {
                height: 29px;
                min-width: 38px;
                padding: 5px 10px;
                border: 0;
                cursor: pointer;
            }

                #header #searchBg i {
                    font-size: 14px;
                }

            #header .header-main {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                width: 100%;
                padding-top: 8px;
            }

            #header .header-logo-area {
                width: 20%;
                margin-top: 0;
                float: none;
                position: relative;
                flex-shrink: 0;
            }

                #header .header-logo-area .logo {
                    display: inline-block;
                    max-width: 100%;
                    margin-top: -5px;
                }

                    #header .header-logo-area .logo img {
                        display: block;
                        max-width: 100%;
                        height: 80px;
                    }

            #header .header-right-area {
                width: 80%;
                display: flex;
                flex-wrap: wrap;
                align-items: flex-start;
                min-width: 0;
            }

            #header .header-partner-logos {
                width: auto;
                display: flex;
                align-items: flex-start;
                flex-shrink: 0;
                padding-top: 0;
            }

                #header .header-partner-logos .yearabc {
                    float: none !important;
                    width: auto !important;
                    margin: 0;
                    padding: 3px 5px;
                }

                    #header .header-partner-logos .yearabc a {
                        display: inline-block;
                    }

                #header .header-partner-logos img {
                    display: block;
                    max-width: 100%;
                    height: 80px;
                }

            #header .header-navigation-area {
                flex: 1;
                min-width: 0;
                width: auto;
            }

            #header .main-navigation-wrapper {
                width: 100%;
            }

            #header .topMenuHcl {
                width: 100%;
                min-height: 35px;
            }

                #header .topMenuHcl ul {
                    margin: 0;
                    padding: 0;
                    list-style: none;
                    display: flex;
                    align-items: center;
                    justify-content: flex-end;
                    flex-wrap: wrap;
                }

                    #header .topMenuHcl ul li {
                        display: inline-block;
                        white-space: nowrap;
                    }

                        #header .topMenuHcl ul li a {
                            display: block;
                            padding: 5px 8px;
                        }

            #header .navbar-collapse {
                padding-right: 0;
                padding-left: 0;
                border-top: 0;
                box-shadow: none;
            }

            #header .navbar-nav {
                margin: 0;
            }

                #header .navbar-nav > li {
                    position: relative;
                }

                    #header .navbar-nav > li > a {
                        white-space: nowrap;
                    }

            #header .js-navbar-collapse {
                width: 100%;
            }

                #header .js-navbar-collapse > .navbar-nav {
                    display: flex;
                    align-items: center;
                    justify-content: flex-end;
                    flex-wrap: wrap;
                    width: 100%;
                }

                    #header .js-navbar-collapse > .navbar-nav > li {
                        float: none;
                        display: block;
                    }

                        #header .js-navbar-collapse > .navbar-nav > li > a {
                            display: block;
                        }

            #header .mega-dropdown {
                position: static;
            }

            #header .mega-dropdown-menu {
                width: auto;
                min-width: 220px;
                left: auto;
                right: 0;
                padding: 15px 0;
                box-sizing: border-box;
            }

                #header .mega-dropdown-menu > li {
                    list-style: none;
                }

                #header .mega-dropdown-menu ul {
                    margin: 0;
                    padding: 0;
                    list-style: none;
                }

                #header .mega-dropdown-menu .dropdown-header,
                #header .mega-dropdown-menu .dropdown-header2 {
                    padding: 0;
                    margin: 0;
                    font-weight: normal;
                }

                    #header .mega-dropdown-menu .dropdown-header a,
                    #header .mega-dropdown-menu .dropdown-header2 a {
                        display: block;
                        padding: 8px 10px;
                        white-space: normal;
                        line-height: 1.4;
                        padding-left: 0;
                    }

                #header .mega-dropdown-menu .col-sm-4,
                #header .mega-dropdown-menu .col-sm-12 {
                    position: relative;
                }

                #header .mega-dropdown-menu .col-sm-4 {
                    min-height: 1px;
                }

            #header .navbar-nav > li > a .caret {
                margin-left: 4px;
            }

            #header .header-main:before,
            #header .header-main:after,
            #header .header-right-area:before,
            #header .header-right-area:after,
            #header .header-navigation-area:before,
            #header .header-navigation-area:after {
                display: table;
                content: " ";
            }

            #header .header-main:after,
            #header .header-right-area:after,
            #header .header-navigation-area:after {
                clear: both;
            }

        @@media (min-width: 992px) and (max-width: 1199px) {

            #header .header-logo-area {
                width: 18%;
            }

            #header .header-right-area {
                width: 82%;
            }

            #header .header-partner-logos img {
                max-width: 100%;
                height: 60px;
            }

            #header .topMenuHcl ul li a {
                padding-left: 5px;
                padding-right: 5px;
            }

            #header .navbar-nav > li > a {
                padding-left: 8px;
                padding-right: 8px;
            }

            #header .mega-dropdown-menu {
                max-width: 700px;
            }
        }

        @@media (min-width: 768px) and (max-width: 991px) {

            #header .header-main {
                display: flex;
            }

            #header .header-logo-area {
                width: 25%;
                margin-top: 10px;
            }

            #header .header-right-area {
                width: 75%;
                display: block;
            }

            #header .header-partner-logos {
                justify-content: flex-end;
                width: 100%;
            }

                #header .header-partner-logos img {
                    max-width: 100%;
                    height: 60px;
                }

            #header .topMenuHcl ul {
                justify-content: flex-end;
            }

            #header .js-navbar-collapse > .navbar-nav {
                justify-content: flex-start;
            }

            #header .navbar-nav > li > a {
                padding-left: 7px;
                padding-right: 7px;
            }

            #header .mega-dropdown-menu {
                max-width: 650px;
            }
        }

        @@media (max-width: 767px) {

            #header .header-main {
                display: block;
                width: 100%;
            }

            #header .header-logo-area {
                width: 100%;
                min-height: 70px;
                margin-top: 0;
                float: none;
                background: #fbdac2;
            }

            .navbar-default .navbar-toggle .icon-bar {
                background-color: #935116;
            }

            .navbar-default .navbar-toggle {
                border-color: #935116;
            }

            #header .header-logo-area .logo {
                display: inline-block;
                padding-top: 8px;
            }

                #header .header-logo-area .logo img {
                    max-width: 100%;
                    height: 60px;
                    padding-left: 10px;
                }

            #header .navbar-toggle {
                display: block;
                float: right;
                margin-top: 15px;
                margin-right: 10px;
                margin-bottom: 10px;
                padding: 9px 10px;
                border-radius: 4px;
            }

                #header .navbar-toggle .icon-bar {
                    display: block;
                    width: 22px;
                    height: 2px;
                    border-radius: 1px;
                }

            #header .header-right-area {
                width: 100%;
                display: block;
            }

            #header .header-partner-logos {
                width: 100%;
                justify-content: space-around;
                padding: 5px 0 8px;
            }

                #header .header-partner-logos .yearabc {
                    padding: 0 4px;
                }

                #header .header-partner-logos img {
                    max-width: 100% !important;
                    width: 100% !important;
                    height: 60px;
                }

            .top-head {
                display: none;
            }

            #header .navbar-collapse {
                width: 100%;
                overflow-x: visible;
                padding-right: 0;
                padding-left: 0;
                border-top: 1px solid #ddd;
                box-shadow: none;
                -webkit-overflow-scrolling: touch;
                background: #d6bea1;
            }

            #header .js-navbar-collapse > .navbar-nav {
                display: block;
                width: 100%;
                margin: 0;
                padding: 0;
            }

                #header .js-navbar-collapse > .navbar-nav > li {
                    display: block;
                    width: 100%;
                    float: none;
                }

                    #header .js-navbar-collapse > .navbar-nav > li > a {
                        display: block;
                        width: 100%;
                        padding: 12px 15px;
                        white-space: normal;
                    }

            #header .mega-dropdown {
                position: relative;
            }

            #header .mega-dropdown-menu {
                position: static !important;
                float: none;
                width: 100% !important;
                min-width: 100% !important;
                max-width: none !important;
                margin: 0;
                padding: 0;
                border: 0;
                box-shadow: none;
                background: transparent;
            }

            #header .mega-dropdown.open .mega-dropdown-menu {
                display: block;
            }

            #header .mega-dropdown-menu .col-sm-4,
            #header .mega-dropdown-menu .col-sm-12 {
                width: 100%;
                float: none;
                display: block;
                padding: 0;
            }

            #header .mega-dropdown-menu ul {
                width: 100%;
                margin: 0;
                padding: 0;
            }

            #header .mega-dropdown-menu .dropdown-header,
            #header .mega-dropdown-menu .dropdown-header2 {
                width: 100%;
            }

                #header .mega-dropdown-menu .dropdown-header a,
                #header .mega-dropdown-menu .dropdown-header2 a {
                    display: block;
                    width: 100%;
                    padding: 10px 25px;
                    white-space: normal;
                    line-height: 1.4;
                }

            #header .top-head {
                min-height: auto;
            }

            #header .header-utility-wrapper {
                min-height: auto;
            }

                #header .header-utility-wrapper > .nav {
                    width: 100%;
                    float: none;
                }

            #header .login-srch-box {
                width: 100%;
                justify-content: flex-start;
                padding: 5px 0;
                overflow: visible;
            }

                #header .login-srch-box > li {
                    white-space: normal;
                }

                    #header .login-srch-box > li > a {
                        padding: 4px 6px;
                    }

            #header .header-search {
                padding: 4px 0;
            }

            #header .search-wrapper {
                width: 100%;
            }

            #header #search {
                width: 150px;
                max-width: 150px;
            }

            #header .header-navigation-area {
                background: #935116;
            }

            .topMenuHcl li a {
                color: #ffffff;
            }

            #header .topMenuHcl ul {
                justify-content: space-around;
            }

            .container > .navbar-header {
                margin-right: 0;
                margin-left: 0;
            }

            .container.header-main {
                padding-right: 0;
                padding-left: 0;
            }

            .navbar-default {
                background-color: rgb(255 255 255);
            }

            .mega-dropdown-menu .dropdown-header a,
            .mega-dropdown-menu .dropdown-header2 a {
                color: #5A3311 !important;
            }

            .mega-dropdown-menu .dropdown-header i,
            .mega-dropdown-menu .dropdown-header2 i {
                color: #5A3311;
            }

            .National-Emblem-Logo img {
                max-height: 60px;
            }

            .d-flex.gap-2 {
                gap: 0px;
            }

            .National-Emblem-Logo {
                margin: 5px;
                margin-right: 0;
            }

            #header .header-main {
                padding-top: 0;
            }
        }

        @@media (max-width: 480px) {

            #header .container {
                padding-left: 0;
                padding-right: 0;
            }

            #header .header-logo-area {
                min-height: 62px;
            }

                #header .header-logo-area .logo {
                    padding-top: 6px;
                }

                    #header .header-logo-area .logo img {
                        max-width: 100%;
                        height: 60px;
                        padding-left: 10px;
                    }

            #header .navbar-toggle {
                margin-top: 10px;
            }

            #header .header-partner-logos {
                justify-content: space-around;
                padding-top: 5px;
                padding-bottom: 8px;
            }

                #header .header-partner-logos img {
                    max-width: 100%;
                    height: 60px;
                }

            #header .login-srch-box {
                justify-content: flex-start;
            }

                #header .login-srch-box > li > a {
                    font-size: 12px;
                    padding: 3px 5px;
                }

            #header #search {
                width: 120px;
                max-width: 120px;
            }

            #header #searchBg {
                min-width: 35px;
                padding-left: 8px;
                padding-right: 8px;
            }

            #header .js-navbar-collapse > .navbar-nav > li > a {
                padding: 11px 12px;
            }

            #header .mega-dropdown-menu .dropdown-header a,
            #header .mega-dropdown-menu .dropdown-header2 a {
                padding: 9px 22px;
                font-size: 13px;
            }
        }

        @@media (max-width: 360px) {

            #header .header-logo-area .logo img {
                max-width: 100%;
                height: 60px;
                padding-left: 10px;
            }

            #header .header-partner-logos img {
                max-width: 100%;
                height: 60px;
            }

            #header .login-srch-box > li > a {
                font-size: 11px;
                padding-left: 3px;
                padding-right: 3px;
            }

            #header #search {
                width: 105px;
                max-width: 105px;
            }
        }

        @@media (min-width: 768px) {
            .navbar-nav > li.mega-dropdown.dropdown-about > ul.mega-dropdown-menu {
                padding: 10px 8px !important;
            }
        }
    </style>
</head>
<body>


    <!-- #region MySection -->
    <header id="header">
        <div class="menu_area">

            <nav class="navbar navbar-default navbar-fixed-top">
                <div class="top-head">
                    <div class="container">
                        <div class="header-utility-wrapper">

                            <div class="pull-right nav">
                                <ul class="login-srch-box">

                                    @if ((Session["UserType"] != null) && (Session["UserType"].ToString() == "VENDOR" || Session["UserType"].ToString() == "CONTRACTOR"))
                                    {
                                        <li class="dropdown">
                                            <a href="@Url.Action("LogOut", "VendorRegistration")" title="login" class="login">
                                                Vendor Log Out
                                            </a>
                                        </li>

                                        <li class="dropdown">
                                            <a href="@Url.Action("Dashboard", "Admin")" title="login" class="login">
                                                Vendor Dashboard
                                            </a>
                                        </li>
                                    }
                                    else if (Session["UserType"] != null && Session["UserType"].ToString() != "VENDOR" && Session["UserType"].ToString() != "CONTRACTOR")
                                    {
                                        <li class="dropdown">
                                            <a href="@Url.Action("LogOut", "Admin")" title="login" class="login">
                                                Log Out
                                            </a>
                                        </li>

                                        <li class="dropdown">
                                            <a href="@Url.Action("Dashboard", "Admin")" title="login" class="login">
                                                Admin Dashboard
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a href="@Url.Action("index", "Home")" title="Home"></a>
                                        </li>

                                        <li>
                                            <a href="@Url.Action("Index", "Home")"
                                               title="Home"
                                               aria-label="Home">
                                                <i class="fa fa-home fa-lg"
                                                   style="color:White; font-size:25px; padding-right:10px"></i>
                                            </a>
                                        </li>

                                        <li class="dropdown">
                                            <a href="@Url.Action("login", "VendorRegistration")"
                                               title="login"
                                               class="login">
                                                Vendor Login
                                            </a>
                                        </li>
                                    }

                                    <li class="dropdown">
                                        <a href="@Url.Action("screenreader", "Page")"
                                           class="login">
                                            Screen Reader Access
                                        </a>
                                    </li>

                                    <li class="dropdown">
                                        <a href="#totalCol"
                                           class="login">
                                            Skip to Content
                                        </a>
                                    </li>

                                    <li class="dropdown">
                                        <a href="javascript:decreaseFontSize();"
                                           title="Decrease text size">
                                            <img src="@Url.Content("~/Content/img/PH/decrease.gif")"
                                                 alt="Decrease"
                                                 title="Decrease">
                                        </a>
                                    </li>

                                    <li class="dropdown">
                                        <a href="javascript:resetFontSize();"
                                           title="Normal text size">
                                            <img src="@Url.Content("~/Content/img/PH/normal.gif")"
                                                 alt="Normal"
                                                 title="Normal">
                                        </a>
                                    </li>

                                    <li class="dropdown">
                                        <a href="javascript:increaseFontSize();"
                                           title="Increase text size">
                                            <img src="@Url.Content("~/Content/img/PH/increase.gif")"
                                                 alt="Increase"
                                                 title="Increase">
                                        </a>
                                    </li>

                                    <li class="dropdown">
                                        <a href="@Url.Action("index", "HindiPage")"
                                           class="login">
                                            हिन्दी संस्करण
                                        </a>
                                    </li>

                                    <li class="header-search">
                                        <div class="search-wrapper">
                                            <input type="text"
                                                   class="pull-left"
                                                   name="search"
                                                   id="search"
                                                   placeholder="Search.."
                                                   aria-label="Search">

                                            <button class="search"
                                                    id="searchBg"
                                                    aria-label="Search">
                                                <i class="fa fa-search"
                                                   aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </li>

                                </ul>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="container header-main">
                    <div class="navbar-header header-logo-area">

                        <button class="navbar-toggle"
                                type="button"
                                data-toggle="collapse"
                                data-target=".js-navbar-collapse"
                                aria-expanded="false">

                            <span class="sr-only">
                                Toggle navigation
                            </span>

                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>

                        </button>

                        <div class="d-flex gap-2">
                            <a href="javascript:void(0)"
                               target="_blank"
                               class="National-Emblem-Logo"
                               rel="noopener noreferrer">

                                <img src="@Url.Content("~/Content/img/National-Emblem.svg")"
                                     alt="AKAM Logo"
                                     style="margin-top: 0px;">

                            </a>

