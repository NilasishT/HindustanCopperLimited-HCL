    <title>@(ViewData["Title"] ?? "Hindustan Copper Limited | India’s Leading Copper Producer")</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Hindustan Copper Limited (HCL) is India’s leading copper producer, engaged in copper mining, beneficiation, smelting, refining and downstream products.")" />
    <meta name="keywords" content="@(ViewData["MetaKeywords"] ?? "Hindustan Copper Limited, HCL, copper producer, copper mining, copper beneficiation, copper smelting, copper refining, copper products, copper cathodes, copper concentrates, copper rods, Ministry of Mines, HCL India.")" />


    <!-- Scripts required by Vigilance inner pages (forms, datepicker, chosen) -->
    <script src="@Url.Content("~/Content/js/jquery-1.10.2.min.js")"></script>
    <script src="@Url.Content("~/Content/js/jquery.multiple.select.js")"></script>
    <script src="@Url.Content("~/Content/js/jquery.number.js")"></script>
    <script src="@Url.Content("~/AdminCssJs/js/bootstrap-datepicker.js")"></script>
    <script src="@Url.Content("~/AdminCssJs/js/bootstrap-datetimepicker.js")"></script>
    <script src="@Url.Content("~/AdminCssJs/js/chosen.jquery.js")"></script>
    <script src="@Url.Content("~/AdminCssJs/js/chosen.jquery.min.js")"></script>

    <style>
        .d-flex.gap-2 {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .National-Emblem-Logo img {
            max-height: 80px;
        }

        .top-head .container {
            width: 99.5%;
        }

        #header {
            width: 100%;
            position: relative;
            z-index: 9999;
        }

            #header .menu_area {
                width: 100%;
            }

            #header .navbar {
                min-height: 50px;
                margin-bottom: 0;
                border-radius: 0;
            }

            #header .navbar-fixed-top {
                width: 100%;
                z-index: 9999;
            }

            #header .container {
                position: relative;
            }

            #header .top-head {
                width: 100%;
                min-height: 35px;
            }

            #header .header-utility-wrapper {
                width: 100%;
                position: relative;
            }

                #header .header-utility-wrapper > .nav {
                    float: right;
                }

            #header .login-srch-box {
                margin: 0;
                padding: 0;
                list-style: none;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                flex-wrap: wrap;
                gap: 4px
            }

                #header .login-srch-box > li {
                    display: inline-block;
                    vertical-align: middle;
                    white-space: nowrap;
                }

                    #header .login-srch-box > li > a {
                        display: inline-block;
                        vertical-align: middle;
                    }

            #header .header-search {
                padding-left: 5px;
            }

            #header .search-wrapper {
                display: flex;
                align-items: center;
            }

            #header #search {
                width: 160px;
                height: 29px;
                padding: 5px 10px;
                border: 1px solid #ccc;
                outline: none;
                box-sizing: border-box;
            }

            #header #searchBg {
                height: 29px;
                min-width: 38px;
                padding: 5px 10px;
                border: 0;
                cursor: pointer;
            }

                #header #searchBg i {
                    font-size: 14px;
                }

            #header .header-main {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                width: 100%;
                padding-top: 8px;
            }

            #header .header-logo-area {
                width: 20%;
                margin-top: 0;
                float: none;
                position: relative;
                flex-shrink: 0;
            }

                #header .header-logo-area .logo {
                    display: inline-block;
                    max-width: 100%;
                    margin-top: -5px;
                }

                    #header .header-logo-area .logo img {
                        display: block;
                        max-width: 100%;
                        height: 80px;
                    }

            #header .header-right-area {
                width: 80%;
                display: flex;
                flex-wrap: wrap;
                align-items: flex-start;
                min-width: 0;
            }

            #header .header-partner-logos {
                width: auto;
                display: flex;
                align-items: flex-start;
                flex-shrink: 0;
                padding-top: 0;
            }

                #header .header-partner-logos .yearabc {
                    float: none !important;
                    width: auto !important;
                    margin: 0;
                    padding: 3px 5px;
                }

                    #header .header-partner-logos .yearabc a {
                        display: inline-block;
                    }

                #header .header-partner-logos img {
                    display: block;
                    max-width: 100%;
                    height: 80px;
                }

            #header .header-navigation-area {
                flex: 1;
                min-width: 0;
                width: auto;
            }

            #header .main-navigation-wrapper {
                width: 100%;
            }

            #header .topMenuHcl {
                width: 100%;
                min-height: 35px;
            }

                #header .topMenuHcl ul {
                    margin: 0;
                    padding: 0;
                    list-style: none;
                    display: flex;
                    align-items: center;
                    justify-content: flex-end;
                    flex-wrap: wrap;
                }

                    #header .topMenuHcl ul li {
                        display: inline-block;
                        white-space: nowrap;
                    }

                        #header .topMenuHcl ul li a {
                            display: block;
                            padding: 5px 8px;
                        }

            #header .navbar-collapse {
                padding-right: 0;
                padding-left: 0;
                border-top: 0;
                box-shadow: none;
            }

            #header .navbar-nav {
                margin: 0;
            }

                #header .navbar-nav > li {
                    position: relative;
                }

                    #header .navbar-nav > li > a {
                        white-space: nowrap;
                    }

            #header .js-navbar-collapse {
                width: 100%;
            }

                #header .js-navbar-collapse > .navbar-nav {
                    display: flex;
                    align-items: center;
                    justify-content: flex-end;
                    flex-wrap: wrap;
                    width: 100%;
                }

                    #header .js-navbar-collapse > .navbar-nav > li {
                        float: none;
                        display: block;
                    }

                        #header .js-navbar-collapse > .navbar-nav > li > a {
                            display: block;
                        }

            #header .mega-dropdown {
                position: static;
            }

            #header .mega-dropdown-menu {
                width: auto;
                min-width: 220px;
                left: auto;
                right: 0;
                padding: 15px 0;
                box-sizing: border-box;
            }

                #header .mega-dropdown-menu > li {
                    list-style: none;
                }

                #header .mega-dropdown-menu ul {
                    margin: 0;
                    padding: 0;
                    list-style: none;
                }

                #header .mega-dropdown-menu .dropdown-header,
                #header .mega-dropdown-menu .dropdown-header2 {
                    padding: 0;
                    margin: 0;
                    font-weight: normal;
                }

                    #header .mega-dropdown-menu .dropdown-header a,
                    #header .mega-dropdown-menu .dropdown-header2 a {
                        display: block;
                        padding: 8px 10px;
                        white-space: normal;
                        line-height: 1.4;
                        padding-left: 0;
                    }

                #header .mega-dropdown-menu .col-sm-4,
                #header .mega-dropdown-menu .col-sm-12 {
                    position: relative;
                }

                #header .mega-dropdown-menu .col-sm-4 {
                    min-height: 1px;
                }

            #header .navbar-nav > li > a .caret {
                margin-left: 4px;
            }

            #header .header-main:before,
            #header .header-main:after,
            #header .header-right-area:before,
            #header .header-right-area:after,
            #header .header-navigation-area:before,
            #header .header-navigation-area:after {
                display: table;
                content: " ";
            }

            #header .header-main:after,
            #header .header-right-area:after,
            #header .header-navigation-area:after {
                clear: both;
            }

        @@media (min-width: 992px) and (max-width: 1199px) {

            #header .header-logo-area {
                width: 18%;
            }

            #header .header-right-area {
                width: 82%;
            }

            #header .header-partner-logos img {
                max-width: 100%;
                height: 60px;
            }

            #header .topMenuHcl ul li a {
                padding-left: 5px;
                padding-right: 5px;
            }

            #header .navbar-nav > li > a {
                padding-left: 8px;
                padding-right: 8px;
            }

            #header .mega-dropdown-menu {
                max-width: 700px;
            }
        }

        @@media (min-width: 768px) and (max-width: 991px) {

            #header .header-main {
                display: flex;
            }

            #header .header-logo-area {
                width: 25%;
                margin-top: 10px;
            }

            #header .header-right-area {
                width: 75%;
                display: block;
            }

            #header .header-partner-logos {
                justify-content: flex-end;
                width: 100%;
            }

                #header .header-partner-logos img {
                    max-width: 100%;
                    height: 60px;
                }

            #header .topMenuHcl ul {
                justify-content: flex-end;
            }

            #header .js-navbar-collapse > .navbar-nav {
                justify-content: flex-start;
            }

            #header .navbar-nav > li > a {
                padding-left: 7px;
                padding-right: 7px;
            }

            #header .mega-dropdown-menu {
                max-width: 650px;
            }
        }

        @@media (max-width: 767px) {

            #header .header-main {
                display: block;
                width: 100%;
            }

            #header .header-logo-area {
                width: 100%;
                min-height: 70px;
                margin-top: 0;
                float: none;
                background: #fbdac2;
            }

            .navbar-default .navbar-toggle .icon-bar {
                background-color: #916100;
            }

            .navbar-default .navbar-toggle {
                border-color: #916100;
            }

            #header .header-logo-area .logo {
                display: inline-block;
                padding-top: 8px;
            }

                #header .header-logo-area .logo img {
                    max-width: 100%;
                    height: 60px;
                    padding-left: 10px;
                }

            #header .navbar-toggle {
                display: block;
                float: right;
                margin-top: 15px;
                margin-right: 10px;
                margin-bottom: 10px;
                padding: 9px 10px;
                border-radius: 4px;
            }

                #header .navbar-toggle .icon-bar {
                    display: block;
                    width: 22px;
                    height: 2px;
                    border-radius: 1px;
                }

            #header .header-right-area {
                width: 100%;
                display: block;
            }

            #header .header-partner-logos {
                width: 100%;
                justify-content: space-around;
                padding: 5px 0 8px;
            }

                #header .header-partner-logos .yearabc {
                    padding: 0 4px;
                }

                #header .header-partner-logos img {
                    max-width: 100% !important;
                    width: 100% !important;
                    height: 60px;
                }

            .top-head {
                display: none;
            }

            #header .navbar-collapse {
                width: 100%;
                overflow-x: visible;
                padding-right: 0;
                padding-left: 0;
                border-top: 1px solid #ddd;
                box-shadow: none;
                -webkit-overflow-scrolling: touch;
                background: #F4D390;
            }

            #header .js-navbar-collapse > .navbar-nav {
                display: block;
                width: 100%;
                margin: 0;
                padding: 0;
            }

                #header .js-navbar-collapse > .navbar-nav > li {
                    display: block;
                    width: 100%;
                    float: none;
                }

                    #header .js-navbar-collapse > .navbar-nav > li > a {
                        display: block;
                        width: 100%;
                        padding: 12px 15px;
                        white-space: normal;
                    }

            #header .mega-dropdown {
                position: relative;
            }

            #header .mega-dropdown-menu {
                position: static !important;
                float: none;
                width: 100% !important;
                min-width: 100% !important;
                max-width: none !important;
                margin: 0;
                padding: 0;
                border: 0;
                box-shadow: none;
                background: transparent;
            }

            #header .mega-dropdown.open .mega-dropdown-menu {
                display: block;
            }

            #header .mega-dropdown-menu .col-sm-4,
            #header .mega-dropdown-menu .col-sm-12 {
                width: 100%;
                float: none;
                display: block;
                padding: 0;
            }

            #header .mega-dropdown-menu ul {
                width: 100%;
                margin: 0;
                padding: 0;
            }

            #header .mega-dropdown-menu .dropdown-header,
            #header .mega-dropdown-menu .dropdown-header2 {
                width: 100%;
            }

                #header .mega-dropdown-menu .dropdown-header a,
                #header .mega-dropdown-menu .dropdown-header2 a {
                    display: block;
                    width: 100%;
                    padding: 10px 25px;
                    white-space: normal;
                    line-height: 1.4;
                }

            #header .top-head {
                min-height: auto;
            }

            #header .header-utility-wrapper {
                min-height: auto;
            }

                #header .header-utility-wrapper > .nav {
                    width: 100%;
                    float: none;
                }

            #header .login-srch-box {
                width: 100%;
                justify-content: flex-start;
                padding: 5px 0;
                overflow: visible;
            }

                #header .login-srch-box > li {
                    white-space: normal;
                }

                    #header .login-srch-box > li > a {
                        padding: 4px 6px;
                    }

            #header .header-search {
                padding: 4px 0;
            }

            #header .search-wrapper {
                width: 100%;
            }

            #header #search {
                width: 150px;
                max-width: 150px;
            }

            #header .header-navigation-area {
                background: #916100;
            }

            .topMenuHcl li a {
                color: #ffffff;
            }

            #header .topMenuHcl ul {
                justify-content: space-around;
            }

            .container > .navbar-header {
                margin-right: 0;
                margin-left: 0;
            }

            .container.header-main {
                padding-right: 0;
                padding-left: 0;
            }

            .navbar-default {
                background-color: rgb(255 255 255);
            }

            .mega-dropdown-menu .dropdown-header a,
            .mega-dropdown-menu .dropdown-header2 a {
                color: #5A3311 !important;
            }

            .mega-dropdown-menu .dropdown-header i,
            .mega-dropdown-menu .dropdown-header2 i {
                color: #5A3311;
            }

            .National-Emblem-Logo img {
                max-height: 60px;
            }

            .d-flex.gap-2 {
                gap: 0px;
            }

            .National-Emblem-Logo {
                margin: 5px;
                margin-right: 0;
            }

            #header .header-main {
                padding-top: 0;
            }
        }

        @@media (max-width: 480px) {

            #header .container {
                padding-left: 0;
                padding-right: 0;
            }

            #header .header-logo-area {
                min-height: 62px;
            }

                #header .header-logo-area .logo {
                    padding-top: 6px;
                }

                    #header .header-logo-area .logo img {
                        max-width: 100%;
                        height: 60px;
                        padding-left: 10px;
                    }

            #header .navbar-toggle {
                margin-top: 10px;
            }

            #header .header-partner-logos {
                justify-content: space-around;
                padding-top: 5px;
                padding-bottom: 8px;
            }

                #header .header-partner-logos img {
                    max-width: 100%;
                    height: 60px;
                }

            #header .login-srch-box {
                justify-content: flex-start;
            }

                #header .login-srch-box > li > a {
                    font-size: 12px;
                    padding: 3px 5px;
                }

            #header #search {
                width: 120px;
                max-width: 120px;
            }

            #header #searchBg {
                min-width: 35px;
                padding-left: 8px;
                padding-right: 8px;
            }

            #header .js-navbar-collapse > .navbar-nav > li > a {
                padding: 11px 12px;
            }

            #header .mega-dropdown-menu .dropdown-header a,
            #header .mega-dropdown-menu .dropdown-header2 a {
                padding: 9px 22px;
                font-size: 13px;
            }
        }

        @@media (max-width: 360px) {

            #header .header-logo-area .logo img {
                max-width: 100%;
                height: 60px;
                padding-left: 10px;
            }

            #header .header-partner-logos img {
                max-width: 100%;
                height: 60px;
            }

            #header .login-srch-box > li > a {
                font-size: 11px;
                padding-left: 3px;
                padding-right: 3px;
            }

            #header #search {
                width: 105px;
                max-width: 105px;
            }
        }

        @@media (min-width: 768px) {
            .navbar-nav > li.mega-dropdown.dropdown-about > ul.mega-dropdown-menu {
                padding: 10px 8px !important;
            }
        }

        /* =================================
           Language Icon
        ================================= */
        a.login.dropdown-toggle.language-icon {
            display: block !important;
        }

        .nav .open a.login.dropdown-toggle.language-icon {
            background-color: #916100;
        }

        .login-srch-box li#menuLanguage ul li:first-child {
            padding: 0px;
        }

        #menuLanguage .dropdown-menu li a:hover {
            background: #916100;
            color: #fff;
        }

        #menuLanguage .dropdown-menu {
            min-width: 160px;
            padding: 5px 0;
        }

            #menuLanguage .dropdown-menu li {
                display: block !important;
                float: none !important;
                width: 100%;
            }

                #menuLanguage .dropdown-menu li a {
                    display: block;
                    padding: 8px 15px;
                    white-space: nowrap;
                }

        #menuLanguage .language-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 0 8px !important;
            height: 29px;
            text-decoration: none;
        }

        #menuLanguage .language-label {
            color: #fff;
            font-size: 13px;
            white-space: nowrap;
        }

        /* =====================================================
           UX4G COMPLIANCE
           ===================================================== */

        /* --- MeriPehchan SSO button --- */
        .meripehchan-btn {
            display: inline-flex !important;
            align-items: center;
            gap: 6px;
            background: #ffffff;
            color: #1a1d5e !important;
            border: 1px solid #1a1d5e;
            border-radius: 4px;
            font-weight: 600;
            padding: 4px 10px !important;
            min-height: 29px;
            text-decoration: none;
        }

            .meripehchan-btn:hover, .meripehchan-btn:focus {
                background: #1a1d5e;
                color: #ffffff !important;
            }

            .meripehchan-btn img {
                height: 22px;
                width: auto;
                display: inline-block;
            }

        /* --- Visible keyboard focus --- */
        #header a:focus, #header button:focus, #footer a:focus {
            outline: 3px solid #ffbf47;
            outline-offset: 2px;
        }

        .ux4g-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 44px;
            min-width: 44px;
            padding: 8px 14px;
            background: #916100;
            color: #fff !important;
            border: 0;
            border-radius: 4px;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
        }

            .ux4g-btn:hover {
                background: #916100;
            }

        /* --- Desktop: comfortable link spacing in header --- */
        #header .topMenuHcl ul li a {
            min-height: 32px;
        }

        /* --- Mobile / touch: 44x44 px minimum targets --- */
        @@media (max-width: 767px) {

            #header .navbar-toggle {
                min-width: 44px;
                min-height: 44px;
            }

            #header .js-navbar-collapse > .navbar-nav > li > a {
                min-height: 44px;
                padding: 12px 15px;
                line-height: 20px;
            }

            #header .mega-dropdown-menu .dropdown-header a,
            #header .mega-dropdown-menu .dropdown-header2 a {
                min-height: 44px;
                padding: 12px 25px;
                font-size: 14px;
                line-height: 20px;
                border-bottom: 1px solid rgba(90,51,17,.15);
            }

            #header .topMenuHcl ul {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }

                #header .topMenuHcl ul li {
                    white-space: normal;
                    text-align: center;
                }

                    #header .topMenuHcl ul li a {
                        min-height: 44px;
                        padding: 12px 8px;
                        line-height: 20px;
                    }

            #header .header-partner-logos img {
                width: auto !important;
                max-width: 100% !important;
                height: 44px;
            }

            #header .header-partner-logos {
                justify-content: center;
                gap: 16px;
            }

            #totalCol .wrap {
                width: 100% !important;
                padding-left: 12px;
                padding-right: 12px;
                box-sizing: border-box;
            }

            .mobile-only-item {
                display: block;
            }

                .mobile-only-item form {
                    display: flex;
                    gap: 8px;
                    padding: 8px 15px;
                }

                .mobile-only-item input[type=search] {
                    flex: 1;
                    min-height: 44px;
                    padding: 6px 10px;
                    border: 1px solid #916100;
                    border-radius: 4px;
                }

                .mobile-only-item .ux4g-btn {
                    min-width: 44px;
                }
            /* footer: accordion with big touch targets */
            #footer .single_footer_widget h3 {
                min-height: 44px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                cursor: pointer;
                margin: 0;
                padding: 8px 4px;
                border-bottom: 1px solid rgba(0,0,0,.15);
            }

                #footer .single_footer_widget h3.footer-acc-toggle:after {
                    content: "\f107";
                    font-family: FontAwesome, "Font Awesome 6 Free";
                    font-weight: 900;
                    margin-left: 8px;
                }

                #footer .single_footer_widget h3.footer-acc-toggle[aria-expanded="true"]:after {
                    content: "\f106";
                }

            #footer .single_footer_widget.footer-collapsed .footer_widget_nav {
                display: none;
            }

            #footer .footer_widget_nav li {
                margin: 0;
            }

                #footer .footer_widget_nav li a {
                    display: flex;
                    align-items: center;
                    min-height: 44px;
                    padding: 10px 6px;
                    line-height: 1.5;
                }

            #footer .footer_social li a {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 44px;
                min-height: 44px;
            }

            #footer .footer-links a,
            #footer .privacy_footer_link a {
                display: inline-flex;
                align-items: center;
                min-height: 44px;
                padding: 8px 6px;
            }

            #footer a[href^="mailto"], #footer a[href^="tel"] {
                display: inline-flex;
                align-items: center;
                min-height: 44px;
            }

            .scrollToTop {
                min-width: 44px;
                min-height: 44px;
            }

            #totalCol ul li a, #totalCol ol li a {
                display: inline-block;
                padding: 8px 0;
                line-height: 1.6;
            }

            #totalCol ul li, #totalCol ol li {
                margin-bottom: 6px;
            }
        }

        @@media (min-width: 768px) {
            .mobile-only-item {
                display: none !important;
            }
        }

        /* Accessible text-size controls */
        #header .text-size-control {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 32px;
            min-height: 32px;
            padding: 4px 6px;
            border: none;
            background: transparent;
            cursor: pointer;
            vertical-align: middle;
        }

            #header .text-size-control img {
                display: block;
                max-width: 100%;
                height: auto;
            }

            #header .text-size-control:focus-visible {
                outline: 3px solid #ffbf47;
                outline-offset: 2px;
            }

        /* Hide the Google Translate top banner */
        .goog-te-banner-frame,
        .goog-te-banner,
        iframe.goog-te-banner-frame,
        body > .skiptranslate {
            display: none !important;
        }

        html {
            margin-top: 0 !important;
            top: 0 !important;
        }

        body {
            margin-top: 0 !important;
            top: 0 !important;
        }

        #header,
        #header .top-head {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }

        .mega-dropdown-menu .dropdown-header {
            display: block;
            padding: 8px 15px;
            font-weight: bold;
            /*color: #2f75b5;*/
            color: var(--dbim-primary-darkest);
            border-bottom: 1px solid #ddd;
            margin-bottom: 5px;
        }

        .text-size-control {
            background: transparent;
            border: none;
            padding: 8px 6px;
            color: inherit;
            cursor: pointer;
            line-height: 1;
        }

        .font-size-icon {
            display: inline-block;
            font-family: "Noto Sans", sans-serif !important;
            font-size: 18px !important;
            font-weight: bold;
            line-height: 1;
        }

            .font-size-icon sup {
                font-size: 18px !important;
                position: relative;
                top: -2px;
            }

        /* ===== Dropdown section headings (Services / Vigilance etc.) ===== */
        #header .mega-dropdown-menu li.menu-heading {
            display: block !important;
            margin: 8px 0 4px !important;
            padding: 8px 12px !important;
            font-size: 13px !important;
            font-weight: 700 !important;
            letter-spacing: .6px;
            text-transform: uppercase;
            color: #5a3311 !important;
            background: #fbeedd !important;
            border-left: 4px solid #916100;
            border-bottom: 1px solid #ecd7bf !important;
        }

            #header .mega-dropdown-menu li.menu-heading:first-child {
                margin-top: 0 !important;
            }

        /* ===== Footer accordion (mobile) - forced so theme CSS cannot override ===== */
        @@media (max-width: 767px) {
            #footer .single_footer_widget.footer-collapsed .footer_widget_nav {
                display: none !important;
            }

            #footer .single_footer_widget:not(.footer-collapsed) .footer_widget_nav {
                display: block !important;
            }

            #footer .single_footer_widget h3.footer-acc-toggle {
                cursor: pointer;
                pointer-events: auto !important;
                position: relative;
                z-index: 2;
                -webkit-tap-highlight-color: rgba(147,81,22,.25);
            }
        }
    </style>
