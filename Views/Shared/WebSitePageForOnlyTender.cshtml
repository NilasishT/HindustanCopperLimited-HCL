@using Hindustancopperlimited.Helpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hindustan Copper Limited</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" type="text/css" href="@CssVersionHelper.GetVersionedUrl("~/AdminCssJs/css/main1.css")">
    <link href="@CssVersionHelper.GetVersionedUrl("~/Content/css/bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/font-awesome.min.css")" rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/Content/css/superslides.css")">
    <link href="@Url.Content("~/Content/css/slick.css")" rel="stylesheet">
    <link rel='stylesheet prefetch' href='https://cdn.rawgit.com/pguso/jquery-plugin-circliful/master/css/jquery.circliful.css'>
    <link rel="stylesheet" href="@Url.Content("~/Content/css/animate.css")">

    <link type="text/css" media="all" rel="stylesheet" href="@Url.Content("~/Content/css/jquery.tosrus.all.css")" />
    <link href="@CssVersionHelper.GetVersionedUrl("~/Content/css/style.css")" rel="stylesheet">
    <link href="@CssVersionHelper.GetVersionedUrl("~/Content/css/styleInnerpage.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/owl.carousel.css")" rel="stylesheet" media="screen">
    <link href="@Url.Content("~/Content/css/owl.theme.css")" rel="stylesheet" media="screen">
    <link href='http://fonts.googleapis.com/css?family=Merriweather' rel='stylesheet' type='text/css'>
    <link href='http://fonts.googleapis.com/css?family=Varela' rel='stylesheet' type='text/css'>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href='http://fonts.googleapis.com/css?family=Baumans' rel='stylesheet' type='text/css'>
    <link href='http://fonts.googleapis.com/css?family=Poppins:400,600,700,500,300' rel='stylesheet' type='text/css'>
    <link href='http://fonts.googleapis.com/css?family=Roboto:400,900italic,900,700italic,700,400italic,500,500italic,300,100italic,100,300italic' rel='stylesheet' type='text/css'>
    <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet" type='text/css'>
    <link rel="stylesheet" href="@Url.Content("~/Content/css/sidebar-menu.css")">

    <style>
                .d-flex.gap-2 {
                    display: flex;
                    gap: 20px;
                    align-items: center;
                }

                .National-Emblem-Logo img {
                    max-height: 80px;
                }

                .top-head .container {
                    width: 99.5%;
                }

                #header {
                    width: 100%;
                    position: relative;
                    z-index: 9999;
                }

                    #header .menu_area {
                        width: 100%;
                    }

                    #header .navbar {
                        min-height: 50px;
                        margin-bottom: 0;
                        border-radius: 0;
                    }

                    #header .navbar-fixed-top {
                        width: 100%;
                        z-index: 9999;
                    }

                    #header .container {
                        position: relative;
                    }

                    #header .top-head {
                        width: 100%;
                        min-height: 35px;
                    }

                    #header .header-utility-wrapper {
                        width: 100%;
                        position: relative;
                    }

                        #header .header-utility-wrapper > .nav {
                            float: right;
                        }

                    #header .login-srch-box {
                        margin: 0;
                        padding: 0;
                        list-style: none;
                        display: flex;
                        align-items: center;
                        justify-content: flex-end;
                        flex-wrap: wrap;
                        gap: 4px
                    }

                        #header .login-srch-box > li {
                            display: inline-block;
                            vertical-align: middle;
                            white-space: nowrap;
                        }

                            #header .login-srch-box > li > a {
                                display: inline-block;
                                vertical-align: middle;
                            }

                    #header .header-search {
                        padding-left: 5px;
                    }

                    #header .search-wrapper {
                        display: flex;
                        align-items: center;
                    }

                    #header #search {
                        width: 160px;
                        height: 29px;
                        padding: 5px 10px;
                        border: 1px solid #ccc;
                        outline: none;
                        box-sizing: border-box;
                    }

                    #header #searchBg {
                        height: 29px;
                        min-width: 38px;
                        padding: 5px 10px;
                        border: 0;
                        cursor: pointer;
                    }

                        #header #searchBg i {
                            font-size: 14px;
                        }

                    #header .header-main {
                        display: flex;
                        flex-wrap: wrap;
                        align-items: center;
                        width: 100%;
                        padding-top: 8px;
                    }

                    #header .header-logo-area {
                        width: 20%;
                        margin-top: 0;
                        float: none;
                        position: relative;
                        flex-shrink: 0;
                    }

                        #header .header-logo-area .logo {
                            display: inline-block;
                            max-width: 100%;
                            margin-top: -5px;
                        }

                            #header .header-logo-area .logo img {
                                display: block;
                                max-width: 100%;
                                height: 80px;
                            }

                    #header .header-right-area {
                        width: 80%;
                        display: flex;
                        flex-wrap: wrap;
                        align-items: flex-start;
                        min-width: 0;
                    }

                    #header .header-partner-logos {
                        width: auto;
                        display: flex;
                        align-items: flex-start;
                        flex-shrink: 0;
                        padding-top: 0;
                    }

                        #header .header-partner-logos .yearabc {
                            float: none !important;
                            width: auto !important;
                            margin: 0;
                            padding: 3px 5px;
                        }

                            #header .header-partner-logos .yearabc a {
                                display: inline-block;
                            }

                        #header .header-partner-logos img {
                            display: block;
                            max-width: 100%;
                            height: 80px;
                        }

                    #header .header-navigation-area {
                        flex: 1;
                        min-width: 0;
                        width: auto;
                    }

                    #header .main-navigation-wrapper {
                        width: 100%;
                    }

                    #header .topMenuHcl {
                        width: 100%;
                        min-height: 35px;
                    }

                        #header .topMenuHcl ul {
                            margin: 0;
                            padding: 0;
                            list-style: none;
                            display: flex;
                            align-items: center;
                            justify-content: flex-end;
                            flex-wrap: wrap;
                        }

                            #header .topMenuHcl ul li {
                                display: inline-block;
                                white-space: nowrap;
                            }

                                #header .topMenuHcl ul li a {
                                    display: block;
                                    padding: 5px 8px;
                                }

                    #header .navbar-collapse {
                        padding-right: 0;
                        padding-left: 0;
                        border-top: 0;
                        box-shadow: none;
                    }

                    #header .navbar-nav {
                        margin: 0;
                    }

                        #header .navbar-nav > li {
                            position: relative;
                        }

                            #header .navbar-nav > li > a {
                                white-space: nowrap;
                            }

                    #header .js-navbar-collapse {
                        width: 100%;
                    }

                        #header .js-navbar-collapse > .navbar-nav {
                            display: flex;
                            align-items: center;
                            justify-content: flex-end;
                            flex-wrap: wrap;
                            width: 100%;
                        }

                            #header .js-navbar-collapse > .navbar-nav > li {
                                float: none;
                                display: block;
                            }

                                #header .js-navbar-collapse > .navbar-nav > li > a {
                                    display: block;
                                }

                    #header .mega-dropdown {
                        position: static;
                    }

                    #header .mega-dropdown-menu {
                        width: auto;
                        min-width: 220px;
                        left: auto;
                        right: 0;
                        padding: 15px 0;
                        box-sizing: border-box;
                    }

                        #header .mega-dropdown-menu > li {
                            list-style: none;
                        }

                        #header .mega-dropdown-menu ul {
                            margin: 0;
                            padding: 0;
                            list-style: none;
                        }

                        #header .mega-dropdown-menu .dropdown-header,
                        #header .mega-dropdown-menu .dropdown-header2 {
                            padding: 0;
                            margin: 0;
                            font-weight: normal;
                        }

                            #header .mega-dropdown-menu .dropdown-header a,
                            #header .mega-dropdown-menu .dropdown-header2 a {
                                display: block;
                                padding: 8px 10px;
                                white-space: normal;
                                line-height: 1.4;
                                padding-left: 0;
                            }

                        #header .mega-dropdown-menu .col-sm-4,
                        #header .mega-dropdown-menu .col-sm-12 {
                            position: relative;
                        }

                        #header .mega-dropdown-menu .col-sm-4 {
                            min-height: 1px;
                        }

                    #header .navbar-nav > li > a .caret {
                        margin-left: 4px;
                    }

                    #header .header-main:before,
                    #header .header-main:after,
                    #header .header-right-area:before,
                    #header .header-right-area:after,
                    #header .header-navigation-area:before,
                    #header .header-navigation-area:after {
                        display: table;
                        content: " ";
                    }

                    #header .header-main:after,
                    #header .header-right-area:after,
                    #header .header-navigation-area:after {
                        clear: both;
                    }

                @@media (min-width: 992px) and (max-width: 1199px) {

                    #header .header-logo-area {
                        width: 18%;
                    }

                    #header .header-right-area {
                        width: 82%;
                    }

                    #header .header-partner-logos img {
                        max-width: 100%;
                        height: 60px;
                    }

                    #header .topMenuHcl ul li a {
                        padding-left: 5px;
                        padding-right: 5px;
                    }

                    #header .navbar-nav > li > a {
                        padding-left: 8px;
                        padding-right: 8px;
                    }

                    #header .mega-dropdown-menu {
                        max-width: 700px;
                    }
                }

                @@media (min-width: 768px) and (max-width: 991px) {

                    #header .header-main {
                        display: flex;
                    }

                    #header .header-logo-area {
                        width: 25%;
                        margin-top: 10px;
                    }

                    #header .header-right-area {
                        width: 75%;
                        display: block;
                    }

                    #header .header-partner-logos {
                        justify-content: flex-end;
                        width: 100%;
                    }

                        #header .header-partner-logos img {
                            max-width: 100%;
                            height: 60px;
                        }

                    #header .topMenuHcl ul {
                        justify-content: flex-end;
                    }

                    #header .js-navbar-collapse > .navbar-nav {
                        justify-content: flex-start;
                    }

                    #header .navbar-nav > li > a {
                        padding-left: 7px;
                        padding-right: 7px;
                    }

                    #header .mega-dropdown-menu {
                        max-width: 650px;
                    }
                }

                @@media (max-width: 767px) {

                    #header .header-main {
                        display: block;
                        width: 100%;
                    }

                    #header .header-logo-area {
                        width: 100%;
                        min-height: 70px;
                        margin-top: 0;
                        float: none;
                        background: #fbdac2;
                    }

                    .navbar-default .navbar-toggle .icon-bar {
                        background-color: #916100;
                    }

                    .navbar-default .navbar-toggle {
                        border-color: #916100;
                    }

                    #header .header-logo-area .logo {
                        display: inline-block;
                        padding-top: 8px;
                    }

                        #header .header-logo-area .logo img {
                            max-width: 100%;
                            height: 60px;
                            padding-left: 10px;
                        }

                    #header .navbar-toggle {
                        display: block;
                        float: right;
                        margin-top: 15px;
                        margin-right: 10px;
                        margin-bottom: 10px;
                        padding: 9px 10px;
                        border-radius: 4px;
                    }

                        #header .navbar-toggle .icon-bar {
                            display: block;
                            width: 22px;
                            height: 2px;
                            border-radius: 1px;
                        }

                    #header .header-right-area {
                        width: 100%;
                        display: block;
                    }

                    #header .header-partner-logos {
                        width: 100%;
                        justify-content: space-around;
                        padding: 5px 0 8px;
                    }

                        #header .header-partner-logos .yearabc {
                            padding: 0 4px;
                        }

                        #header .header-partner-logos img {
                            max-width: 100% !important;
                            width: 100% !important;
                            height: 60px;
                        }

                    .top-head {
                        display: none;
                    }

                    #header .navbar-collapse {
                        width: 100%;
                        overflow-x: visible;
                        padding-right: 0;
                        padding-left: 0;
                        border-top: 1px solid #ddd;
                        box-shadow: none;
                        -webkit-overflow-scrolling: touch;
                        background: #F4D390;
                    }

                    #header .js-navbar-collapse > .navbar-nav {
                        display: block;
                        width: 100%;
                        margin: 0;
                        padding: 0;
                    }

                        #header .js-navbar-collapse > .navbar-nav > li {
                            display: block;
                            width: 100%;
                            float: none;
                        }

                            #header .js-navbar-collapse > .navbar-nav > li > a {
                                display: block;
                                width: 100%;
                                padding: 12px 15px;
                                white-space: normal;
                            }

                    #header .mega-dropdown {
                        position: relative;
                    }

                    #header .mega-dropdown-menu {
                        position: static !important;
                        float: none;
                        width: 100% !important;
                        min-width: 100% !important;
                        max-width: none !important;
                        margin: 0;
                        padding: 0;
                        border: 0;
                        box-shadow: none;
                        background: transparent;
                    }

                    #header .mega-dropdown.open .mega-dropdown-menu {
                        display: block;
                    }

                    #header .mega-dropdown-menu .col-sm-4,
                    #header .mega-dropdown-menu .col-sm-12 {
                        width: 100%;
                        float: none;
                        display: block;
                        padding: 0;
                    }

                    #header .mega-dropdown-menu ul {
                        width: 100%;
                        margin: 0;
                        padding: 0;
                    }

                    #header .mega-dropdown-menu .dropdown-header,
                    #header .mega-dropdown-menu .dropdown-header2 {
                        width: 100%;
                    }

                        #header .mega-dropdown-menu .dropdown-header a,
                        #header .mega-dropdown-menu .dropdown-header2 a {
                            display: block;
                            width: 100%;
                            padding: 10px 25px;
                            white-space: normal;
                            line-height: 1.4;
                        }

                    #header .top-head {
                        min-height: auto;
                    }

                    #header .header-utility-wrapper {
                        min-height: auto;
                    }

                        #header .header-utility-wrapper > .nav {
                            width: 100%;
                            float: none;
                        }

                    #header .login-srch-box {
                        width: 100%;
                        justify-content: flex-start;
                        padding: 5px 0;
                        overflow: visible;
                    }

                        #header .login-srch-box > li {
                            white-space: normal;
                        }

                            #header .login-srch-box > li > a {
                                padding: 4px 6px;
                            }

                    #header .header-search {
                        padding: 4px 0;
                    }

                    #header .search-wrapper {
                        width: 100%;
                    }

                    #header #search {
                        width: 150px;
                        max-width: 150px;
                    }

                    #header .header-navigation-area {
                        background: #916100;
                    }

                    .topMenuHcl li a {
                        color: #ffffff;
                    }

                    #header .topMenuHcl ul {
                        justify-content: space-around;
                    }

                    .container > .navbar-header {
                        margin-right: 0;
                        margin-left: 0;
                    }

                    .container.header-main {
                        padding-right: 0;
                        padding-left: 0;
                    }

                    .navbar-default {
                        background-color: rgb(255 255 255);
                    }

                    .mega-dropdown-menu .dropdown-header a,
                    .mega-dropdown-menu .dropdown-header2 a {
                        color: #5A3311 !important;
                    }

                    .mega-dropdown-menu .dropdown-header i,
                    .mega-dropdown-menu .dropdown-header2 i {
                        color: #5A3311;
                    }

                    .National-Emblem-Logo img {
                        max-height: 60px;
                    }

                    .d-flex.gap-2 {
                        gap: 0px;
                    }

                    .National-Emblem-Logo {
                        margin: 5px;
                        margin-right: 0;
                    }

                    #header .header-main {
                        padding-top: 0;
                    }
                }

                @@media (max-width: 480px) {

                    #header .container {
                        padding-left: 0;
                        padding-right: 0;
                    }

                    #header .header-logo-area {
                        min-height: 62px;
                    }

                        #header .header-logo-area .logo {
                            padding-top: 6px;
                        }

                            #header .header-logo-area .logo img {
                                max-width: 100%;
                                height: 60px;
                                padding-left: 10px;
                            }

                    #header .navbar-toggle {
                        margin-top: 10px;
                    }

                    #header .header-partner-logos {
                        justify-content: space-around;
                        padding-top: 5px;
                        padding-bottom: 8px;
                    }

                        #header .header-partner-logos img {
                            max-width: 100%;
                            height: 60px;
                        }

                    #header .login-srch-box {
                        justify-content: flex-start;
                    }

                        #header .login-srch-box > li > a {
                            font-size: 12px;
                            padding: 3px 5px;
                        }

                    #header #search {
                        width: 120px;
                        max-width: 120px;
                    }

                    #header #searchBg {
                        min-width: 35px;
                        padding-left: 8px;
                        padding-right: 8px;
                    }

                    #header .js-navbar-collapse > .navbar-nav > li > a {
                        padding: 11px 12px;
                    }

                    #header .mega-dropdown-menu .dropdown-header a,
                    #header .mega-dropdown-menu .dropdown-header2 a {
                        padding: 9px 22px;
                        font-size: 13px;
                    }
                }

                @@media (max-width: 360px) {

                    #header .header-logo-area .logo img {
                        max-width: 100%;
                        height: 60px;
                        padding-left: 10px;
                    }

                    #header .header-partner-logos img {
                        max-width: 100%;
                        height: 60px;
                    }

                    #header .login-srch-box > li > a {
                        font-size: 11px;
                        padding-left: 3px;
                        padding-right: 3px;
                    }

                    #header #search {
                        width: 105px;
                        max-width: 105px;
                    }
                }

                @@media (min-width: 768px) {
                    .navbar-nav > li.mega-dropdown.dropdown-about > ul.mega-dropdown-menu {
                        padding: 10px 8px !important;
                    }
                }
                /* =================================
           Language Icon
        ================================= */
                a.login.dropdown-toggle.language-icon {
                    display: block !important;
                }

                .nav .open a.login.dropdown-toggle.language-icon {
                    background-color: #916100;
                }

                .login-srch-box li#menuLanguage ul li:first-child {
                    padding: 0px;
                }

                #menuLanguage .dropdown-menu li a:hover {
                    background: #916100;
                    color: #fff;
                }

                #menuLanguage .language-icon {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 0 !important;
                    height: 29px;
                    text-decoration: none;
                }

                #menuLanguage .language-symbol {
                    position: relative;
                    display: inline-block;
                    width: 30px;
                    height: 29px;
                    color: #fff;
                    font-family: "Noto Sans", sans-serif !important;
                }

                /* Top letter */
                #menuLanguage .english-letter,
                #menuLanguage .hindi-letter {
                    position: absolute;
                    font-size: 16px;
                    line-height: 16px;
                }

                /* A position */
                #menuLanguage .english-letter {
                    top: 0;
                    left: 7px;
                }

                /* अ position */
                #menuLanguage .hindi-letter {
                    bottom: 0;
                    right: 6px;
                }

                /* Vertical lines */


                /* Dropdown */
                #menuLanguage .dropdown-menu {
                    min-width: 160px;
                    padding: 5px 0;
                }

                    #menuLanguage .dropdown-menu li {
                        display: block !important;
                        float: none !important;
                        width: 100%;
                    }

                        #menuLanguage .dropdown-menu li a {
                            display: block;
                            padding: 8px 15px;
                            white-space: nowrap;
                        }
    </style>
</head>
<body>

    <!-- #region MySection -->
    <header class="gx-header" id="gxHeader">

        <!-- ---------- Top bar ---------- -->
        <div class="gx-topbar">
            <div class="gx-container gx-topbar-inner">

                <div class="gx-gov-text">
                    <span lang="hi">भारत सरकार</span>
                    <span>Government of India</span>
                </div>

                <div class="gx-tools">

                    <!-- Skip to content -->
                    <div class="gx-tool">
                        <a href="#totalCol" class="gx-tool-btn" title="Skip to Content" aria-label="Skip to Content">
                            <img class="dbim-icon" src="~/Content/icon/Skip_to_Content.svg" alt="Skip to Content" />
                        </a>
                    </div>

                    <!-- Language -->
                    <div class="gx-tool">
                        <button type="button" class="gx-tool-btn" data-gx-popup="gxLangPopup" aria-expanded="false" aria-label="Select Language" title="Language">
                            <img class="dbim-icon" src="~/Content/icon/Language.svg" alt="Language" />
                        </button>
                        <ul class="gx-popup gx-lang-popup" id="gxLangPopup">
                            <li><a lang="en" hreflang="en" href="@enUrl">English</a></li>
                            <li><a lang="hi" hreflang="hi" href="@hiUrl">हिन्दी</a></li>
                        </ul>
                    </div>

                    <!-- Accessibility tools -->
                    <div class="gx-tool">
                        <button type="button" class="gx-tool-btn" data-gx-popup="gxAccessPopup" aria-expanded="false" aria-label="Accessibility Tools" title="Accessibility Tools">
                            <img class="dbim-icon" src="~/Content/icon/Accessibility.svg" alt="Accessibility" />
                        </button>

                        <div class="gx-popup gx-access-popup" id="gxAccessPopup" role="dialog" aria-label="Accessibility Tools">
                            <div class="gx-access-title">Accessibility Tools</div>

                            <div style="display:none;">
                                <h3 class="gx-access-group">Color Contrast</h3>
                                <div class="gx-access-grid">
                                    <button type="button" class="gx-access-btn" data-gx-mode="gx-high-contrast">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="12" cy="12" r="4" /><path class="gx-fill" d="M12 8a4 4 0 0 1 0 8z" /></svg>
                                        <span>High Contrast</span>
                                    </button>
                                    <button type="button" class="gx-access-btn" data-gx-reset="contrast">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M5 19l2-2" /></svg>
                                        <span>Normal Contrast</span>
                                    </button>
                                    <button type="button" class="gx-access-btn" data-gx-mode="gx-highlight-links">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg>
                                        <span>Highlight Links</span>
                                    </button>
                                    <button type="button" class="gx-access-btn" data-gx-mode="gx-invert">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path class="gx-fill" d="M12 3a9 9 0 0 1 0 18z" /></svg>
                                        <span>Invert</span>
                                    </button>
                                    <button type="button" class="gx-access-btn" data-gx-mode="gx-saturation">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z" /><path class="gx-fill" d="M12 3v17a6 6 0 0 0 6-6c0-4.5-6-11-6-11z" /></svg>
                                        <span>Saturation</span>
                                    </button>
