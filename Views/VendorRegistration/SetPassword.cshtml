@model Hindustancopperlimited.Models.VendorLogin

@{
    ViewBag.Title = "Set Password ";
    Layout = "~/Views/Shared/DashboardWithoutSideBar.cshtml";
}

@using (Html.BeginForm())
{
    <h4 style="text-align:center; color:#4d070f">This Vendor Code will be required for login. Please note it. A mail has been sent to your e-mail.</h4><br />
    <div class="row">
          <div class="col-md-12"> 
          <div class="col-lg-3">
          </div>       

              <div class="col-lg-2">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Vendor Code</label>
                        </fieldset>
                   </div>
                  </div>
                </div>              

              <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>                     
                         
                         <div class="form-group">
                          <div class="col-lg-5">
                            
                            @Html.TextBoxFor(model => model.strUserName, null, new { @class = "form-control", disabled = "disabled" }) 
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
                </div>

                <div class="col-md-12">
                <div class="col-lg-3">
          </div>
             
              <div class="col-lg-2">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Password</label> 
                        </fieldset>
                   </div>
                  </div>
                </div>              

              <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>                     
                         
                         <div class="form-group">
                          <div class="col-lg-5">
                          
                            <input id="strUserPwd" type="password" name="strUserPwd" class="form-control" required> 
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>


                
                 </div>

                 <div class="col-md-12">
                 <div class="col-lg-3">
               
          </div>
              <div class="col-lg-2">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Re-Password</label>
                        </fieldset>
                   </div>
                  </div>
                </div>              

              <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>                     
                         
                         <div class="form-group">
                          <div class="col-lg-5">
                          
                            <input id="strUserRePwd" type="password" name="strUserRePwd" class="form-control" required>
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
               
                
                 </div>
                 <div class="col-lg-12">
       <div class="form-group">
                          <div class="col-lg-10 col-lg-offset-5">                           
                            <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
                             <button type="reset" class="btn btn-default">Cancel</button>
                          </div>
                        </div>

</div>


                </div>
    

}

 @if (ViewBag.Message != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                alert("@ViewBag.Message");

            };
        </script>
    }
