                    </div>



                    <div class="col-lg-12">
                        <div class="well bs-component" style="text-align: center; padding: 4px; background-color: #935116; color: #fff; margin: 10px; height: 27px;">
                            @*<div class="form-horizontal">
                                    <fieldset>
                                        <label  style="font-size:medium">
                                            &nbsp;</label>
                                    </fieldset>
                                </div>*@
                        </div>
                    </div>
                    <div class="col-lg-12">
                    </div>


                    <div class="col-lg-12" style="padding-top: 10px">
                        <script type="text/javascript">
                            var a = Math.ceil(Math.random() * 10);
                            var b = Math.ceil(Math.random() * 10);
                            var c = a + b
                            function CaptchaRoni() {
                                document.write("What is " + a + " + " + b + " ? ");
                                document.write("<input id='CaptchaRoniInput' type='text' maxlength='2' size='2' aria-label='Captcha Roni Input' title='Enter captcha code here'/>");
                            }
                            function ValidCaptchaRoni() {
                                var d = document.getElementById('CaptchaRoniInput').value;
                                if (d == c) return true;
                                return false;
                            }
                        </script>
                        Are you human ? <span style="color: #C00000 "> (*)</span><br />
