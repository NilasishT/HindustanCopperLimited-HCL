                                            <label id="cast" runat="server">
                                               Category of MSME <span style="color: Red"> (*)</span>
                                            </label>
                                            <div class="form-group">
                                                <div class="col-lg-10">
                                                    @Html.DropDownList("intfk_CategoryID", null, "--- Select ---", new { @class = "form-control" })<span
                                                        id="errmsgStatusofMSME"></span>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>



                                <div class="well bs-component">
                                    <div class="form-horizontal">
                                        <fieldset>
                                            <label>
                                               Brief Description of Business of your Company</label>
                                            <div class="form-group">
                                             <div class="col-lg-10">


                                                     @Html.TextAreaFor(model => model.str_companydesc, new { @class = "form-control" })


                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>




                                @*<div class="well bs-component">
                                    <div  class="form-horizontal" style="height: 150px" >
                                        <fieldset>
                                            <label>
                                                Type of Items Interested for Supply/ service<span style="color: Red"> (*)</span></label><br />

                                            <div class="form-group">
