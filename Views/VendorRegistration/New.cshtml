
@model Hindustancopperlimited.Models.VendorsNew
@{
    ViewBag.Title = "Vendor Registration Form";
    Layout = "~/Views/Shared/DashboardWithoutSideBar.cshtml";
}
@using (Html.BeginForm("New", "VendorRegistration", FormMethod.Post, new { enctype = "multipart/form-data", id = "VendorsNew" }))
{
    @Html.AntiForgeryToken()
    <div id="spinner" style="z-index: 10; margin-top: 100px; position: fixed; margin-left: 30%">
        <p style="vertical-align: middle; text-align: center;">
            <img src="@Url.Content("~/Content/images/please_wait.gif")" alt="" />
        </p>
    </div>

    <div class="row" style="z-index: 1; position: relative">
        <div class="col-md-12" style="text-align: right">
            <span style="color: #C00000; font-size: 14px; padding-left: 70%">(*) Fields are Mandatory</span>
        </div>
        <div class="col-md-12">

            <div class="card">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="well bs-component" style="text-align: center; padding: 4px; background-color: #935116; color: #fff; margin: 10px; ">
                            <div class="form-horizontal">
                                <fieldset>
                                    <label style="font-size:medium">
                                        GST No. and PAN No. is Mandatory in India.
                                    </label>
                                </fieldset>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-12">
                        <div class="col-lg-4">
                            <div class="well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <label>
                                            Name of Firm/ Company<span style="color: #C00000"> (*)</span>
                                        </label>
                                        <div class="form-group">
                                            <div class="col-lg-10">

                                                @Html.TextBoxFor(model => model.strNameofFirmCompany, null, new { @class = "form-control", aria_label = "Name of Firm/ Company" })
                                                @Html.ValidationMessageFor(model => model.strNameofFirmCompany)
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>

                        @* Type of firm*@
                        <div class="col-lg-4">
                            <div class="well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <label>
                                            Type of the Firm<span style="color: #C00000"> (*)</span>
                                        </label>
                                        <div class="form-group">
                                            <div class="col-lg-10">
                                                @Html.DropDownList("fk_intConstitutionFirmID", null, "--- Select ---", new { @class = "form-control", aria_label = "Type of the Firm" })
                                            </div>
                                        </div>

                                    </fieldset>
                                </div>
                            </div>
                        </div>

                        @* Specify*@
                        <div class="col-lg-4">
                            <div class="well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>

                                        <label id="Others">
                                            Please Specify<span style="color: #C00000"> (*)</span>
                                        </label>
                                        <div class="form-group">
                                            <div class="col-lg-10">

                                                @Html.TextBoxFor(model => model.str_company_others, null, new { @class = "form-control", aria_label = "Please Specify" })
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>
                    </div>



                    <div class="col-lg-12">


                        <div class="col-lg-4">
                            <div class="well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <div class="form-group">
                                            <div class="col-lg-10">
                                                <label>
                                                    Country<span style="color: #C00000"> (*)</span>
                                                </label>
                                                @Html.DropDownList("str_country", null, "--- Select ---", new { @class = "form-control", aria_label = "Country" })
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>

                        @* GST No.*@
                        <div class="col-lg-4">
                            <div class="well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <div class="form-group">
                                            <div class="col-lg-10">
                                                <label id="GST" runat="server">
                                                    GST No.<span style="color: #C00000"> (*)</span>
                                                </label>
                                                @Html.TextBoxFor(model => model.strGSTNo, null, new { @class = "form-control", aria_label = "GST No" })
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>

                        @* PAN No.*@
                        <div class="col-lg-4">
                            <div class="well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <label id="PAN" runat="server">
                                            PAN No.<span style="color: #C00000"> (*)</span>
                                        </label>
                                        <div class="form-group">
                                            <div class="col-lg-10">
                                                @if (TempData["PanNo"] == "YES")
                                                {
                                                    @Html.TextBoxFor(model => model.strPANNo, null, new { @class = "form-control", aria_label = "PAN No" })
                                                }
                                                else
                                                {
                                                    @Html.TextBoxFor(model => model.strPANNo, null, new { @class = "form-control", aria_label = "PAN No" })
                                                }

                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        @* Status of Company*@
                        <div class="col-lg-4">
                            <div class="well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <label>
                                            Status of Company<span style="color: #C00000"> (*)</span>
                                        </label>
                                        <div class="form-group">
                                            <div class="col-lg-10">
                                                @Html.DropDownList("int_fk_CompanyStatusID", null, "--- Select ---", new { @class = "form-control", aria_label = "Status of Company" })
                                            </div>
                                        </div>

                                    </fieldset>
                                </div>
                            </div>
                        </div>

                        @* Type of Service Provide*@
                        <div class="col-lg-4">
                            <div class="well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>

                                        <label id="ServiceProvided">
                                            Type of Service Provide<span style="color: #C00000"> (*)</span>
                                        </label>
                                        <div class="form-group">
                                            <div class="col-lg-10">

                                                @Html.DropDownList("str_serviceprovidertype", null, "--- Select ---", new { @class = "form-control", aria_label = "Type of Service Provide" })
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>



                        @* Manpower Provided*@
                        <div class="col-lg-4">
                            <div class="well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>

                                        <label id="ShowManProvided">
                                            Manpower Provided<span style="color: #C00000"> (*)</span>
                                        </label>
                                        <div class="form-group">
                                            <div class="col-lg-10">

                                                @Html.DropDownList("strIsManpowerSupplier", new List<SelectListItem> {
                                                  new SelectListItem {Text="Yes",Value="Yes"},
                                                  new SelectListItem {Text="No",Value="No"}
                                                                           }, "--- Select ---", new { @class = "form-control", aria_label = "Manpower Provided" })
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>

                    </div>



                    <div class="col-lg-12">
                        <div class="well bs-component" style="text-align: center; padding: 4px; background-color: #935116;
                            color: #fff; margin: 10px;">
                            <div class="form-horizontal">
                                <fieldset>
                                    <label style="font-size:medium">
                                        Details of Vendor
                                    </label>
                                </fieldset>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="well bs-component">
                            <div class="form-horizontal" style="border-right: 1px solid #999; height:380px">
                                <fieldset>
                                    <label>
                                        Address<span style="color: #C00000"> (*)</span>
                                    </label>
                                    <div class="form-group">
                                        <div class="col-lg-10">

                                            @Html.TextAreaFor(model => model.strCorrespondenceAddress, new { @class = "form-control", aria_label = "Address" })

                                        </div>
                                    </div>
                                    <label>
                                        City<span style="color: #C00000"> </span>
                                    </label>
                                    <div class="form-group">
                                        <div class="col-lg-10">

                                            @Html.TextBoxFor(model => model.str_city, null, new { @class = "form-control", aria_label = "City" })

                                        </div>
                                    </div>
                                    <label>
                                        State <span id="State" style="color: #C00000"> (*)</span>
                                    </label>
                                    <div class="form-group">
                                        <div class="col-lg-10">


                                            @Html.DropDownList("str_state", null, "--- Select ---", new { @class = "form-control", aria_label = "State" })
                                        </div>
                                    </div>

                                    <label>
                                        Country <span style="color: #C00000"> (*)</span>
                                    </label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @*   @Html.DropDownList("str_country", null, "--- Select ---", new { @class = "form-control" })*@
                                            @Html.TextBox("country", null, new { @class = "form-control", @readonly = "readonly", aria_label = "Country" })

                                        </div>
                                    </div>


                                    <label>
