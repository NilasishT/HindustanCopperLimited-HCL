                                    <p class="vendor-banner-title" style="color: var(--dbim-bg-page)!important;">Details of Vendor</p>
                                </fieldset>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="-well bs-component">
                            <div class="form-horizontal vendor-col-box">
