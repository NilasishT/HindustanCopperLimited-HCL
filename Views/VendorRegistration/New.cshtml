
@model Hindustancopperlimited.Models.VendorsNew
@{
    ViewBag.Title = "Vendor Registration Form | Hindustan Copper Limited";
    ViewBag.MetaDescription = "Hindustan Copper Limited (HCL) is India’s leading copper producer, engaged in copper mining, beneficiation, smelting, refining and downstream products.";
    ViewBag.MetaKeywords = "Hindustan Copper Limited, HCL, copper producer, copper mining, copper beneficiation, copper smelting, copper refining, copper products, copper cathodes, copper concentrates, copper rods, Ministry of Mines, HCL India.";

    Layout = "~/Views/Shared/DashboardWithoutSideBar.cshtml";
}
<meta name="viewport" content="width=device-width, initial-scale=1">
@using (Html.BeginForm("New", "VendorRegistration", FormMethod.Post, new { enctype = "multipart/form-data", id = "VendorsNew" }))
{
    @Html.AntiForgeryToken()
    <div id="spinner" role="status" style="z-index: 10; margin-top: 100px; position: fixed; margin-left: 30%">
        <span class="sr-only">Please wait, loading&hellip;</span>
        <p style="vertical-align: middle; text-align: center;">
            <img src="@Url.Content("~/Content/images/please_wait.gif")" alt="" />
        </p>
    </div>

    <div class="row" style="z-index: 1; position: relative">

        <div class="col-md-12">

            <div class="card" style="margin-top: 2%;">

                <div class="row">
                    <div class="col-md-12" style="text-align: right">
                        <span style="color: #DC3545; font-size: 14px; padding-right: 10px">(*) Fields are Mandatory</span>
                    </div>

                    <div class="col-lg-12">
                        <div class="well bs-component" style="text-align: center; padding: 4px; background-color: #916100; color: #fff; margin: 10px; ">
                            <div class="form-horizontal">
                                <fieldset>
                                    <p class="vendor-banner-title" style="color: var(--dbim-bg-page)!important;">GST No. and PAN No. is Mandatory in India.</p>
                                </fieldset>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-12">
                        <div class="col-lg-4">
                            <div class="-well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <label for="strNameofFirmCompany">Name of Firm/ Company<span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
                                        <div class="form-group">
                                            <div class="col-lg-10">

                                                @Html.TextBoxFor(model => model.strNameofFirmCompany, null, new { @class = "form-control", autocomplete = "organization" })
                                                @Html.ValidationMessageFor(model => model.strNameofFirmCompany)
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>

                        @* Type of firm*@
                        <div class="col-lg-4">
                            <div class="-well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <label for="fk_intConstitutionFirmID">Type of the Firm<span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
                                        <div class="form-group">
                                            <div class="col-lg-10">
                                                @Html.DropDownList("fk_intConstitutionFirmID", null, "--- Select ---", new { @class = "form-control" })
                                            </div>
                                        </div>

                                    </fieldset>
                                </div>
                            </div>
                        </div>

                        @* Specify*@
                        <div class="col-lg-4">
                            <div class="-well bs-component" aria-live="polite">
                                <div class="form-horizontal">
                                    <fieldset>

                                        <label id="Others" for="str_company_others">Please Specify Type of Firm<span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
                                        <div class="form-group">
                                            <div class="col-lg-10">

                                                @Html.TextBoxFor(model => model.str_company_others, null, new { @class = "form-control" })
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>
                    </div>



                    <div class="col-lg-12">


                        <div class="col-lg-4">
                            <div class="-well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <div class="form-group">
                                            <div class="col-lg-10">
                                                <label for="str_country">Country<span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
                                                @Html.DropDownList("str_country", null, "--- Select ---", new { @class = "form-control" })
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>

                        @* GST No.*@
                        <div class="col-lg-4">
                            <div class="-well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <div class="form-group">
                                            <div class="col-lg-10">
                                                <label id="GST" for="strGSTNo">GST No.<span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
                                                @Html.TextBoxFor(model => model.strGSTNo, null, new { @class = "form-control" })
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>

                        @* PAN No.*@
                        <div class="col-lg-4">
                            <div class="-well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <label id="PAN" for="strPANNo">PAN No.<span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
                                        <div class="form-group">
                                            <div class="col-lg-10">
                                                @if (TempData["PanNo"] == "YES")
                                                {
                                                    @Html.TextBoxFor(model => model.strPANNo, null, new { @class = "form-control" })
                                                }
                                                else
                                                {
                                                    @Html.TextBoxFor(model => model.strPANNo, null, new { @class = "form-control" })
                                                }

                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        @* Status of Company*@
                        <div class="col-lg-4">
                            <div class="-well bs-component">
                                <div class="form-horizontal">
                                    <fieldset>
                                        <label for="int_fk_CompanyStatusID">Status of Company<span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
                                        <div class="form-group">
                                            <div class="col-lg-10">
                                                @Html.DropDownList("int_fk_CompanyStatusID", null, "--- Select ---", new { @class = "form-control" })
