                                    </label>
                                    <div class="form-group">
                                        <div class="col-lg-10">

                                            @Html.TextBoxFor(model => model.str_pin, null, new { @class = "form-control", aria_label = "Pin" })
                                        </div>
                                    </div>
                                </fieldset>

                            </div>
                        </div>
                    </div>





                    <div class="col-lg-3">
                        <div class="well bs-component">
                            <div class="form-horizontal" style="border-right: 1px solid #999; height:380px">
                                <fieldset>
                                    <label>
