                                <div class="form-horizontal">
                                    <fieldset>

                                        <label id="ServiceProvided" for="str_serviceprovidertype">Type of Service Provide<span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
                                        <div class="form-group">
                                            <div class="col-lg-10">

                                                @Html.DropDownList("str_serviceprovidertype", null, "--- Select ---", new { @class = "form-control" })
                                            </div>
                                        </div>
