                                    <div id="msmeCategorySection" style="display: none;">
                                        <label id="cast" for="intfk_CategoryID">Category of MSME <span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
                                        <div class="form-group">
