                    <div class="col-lg-12" style="padding-top: 10px">
                        <div class="form-group">
                            <label for="CaptchaRoniInput" id="CaptchaRoniLabel">
                                Are you human? Please answer: What is <span id="CaptchaRoniQuestion"></span> ?<span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span>
                            </label>
                            <noscript><span class="error-text" style="color: #B00020"> JavaScript is required to show this security question.</span></noscript>
                            <br />
                            <input id="CaptchaRoniInput" type="text" maxlength="2" size="4" inputmode="numeric" autocomplete="off" class="form-control" style="width: 90px; display: inline-block;" title="Enter the answer as a number" />
                        </div>
                        <script type="text/javascript">
                            var a = Math.ceil(Math.random() * 10);
                            var b = Math.ceil(Math.random() * 10);
                            var c = a + b
                            function CaptchaRoni() {
                                var q = document.getElementById('CaptchaRoniQuestion');
                                if (q) { q.textContent = a + " + " + b; }
                            }
                            function ValidCaptchaRoni() {
                                var d = document.getElementById('CaptchaRoniInput').value;
                                if (d == c) return true;
                                return false;
                            }
                            CaptchaRoni();
                        </script>
                    </div>
                    <div class="col-lg-12" style="padding-top: 10px">
