@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        alert("@ViewBag.Message");


    </script>
}

<script>
    $(document).ready(function () {
        $('.ms-choice').attr('aria-label', 'Select Type of Items Interested for Supply or service');


        $('#strTypeofIndustry').change(function () {
            var selectedValue = $(this).val();

            if (selectedValue === "MSME") {
                $('#msmeCategorySection').show();
            } else {
                $('#msmeCategorySection').hide();
            }
        });

        if ($('#strTypeofIndustry').val() === "MSME") {
            $('#msmeCategorySection').show();
        }

    });
</script>
<script src="@Url.Content("~/Content/js/VendorNew.js")"></script>
<style>
    .well {
        background-color: #916100 !important;
        border: 1px solid #916100 !important;
    }

    .card {
        background: #fff;
        width: 90%;
        margin: 0 auto;
    }

    .ms-choice {
        border: 1px solid #C6C6C6;
        background-color: #916100;
        color: #fff;
    }

        .ms-choice > span {
            color: #fff;
        }

    .sr-only {
        position: absolute !important;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .vendor-banner-title {
        font-size: medium;
        font-weight: bold;
        margin: 0;
        color: #fff;
    }

    legend.vendor-legend {
        font-size: inherit;
        font-weight: bold;
        line-height: inherit;
        border: 0;
        margin: 0 0 5px 0;
        padding: 0;
        width: auto;
        color: inherit;
    }

    /* Same look as before on large screens; fluid below that so the page can reflow */
    .vendor-col-box {
        border-right: 1px solid #C6C6C6;
        height: 380px;
    }

    .vendor-items-box {
        height: 300px;
    }

    .vendor-items-col {
        height: 430px;
    }

    .form-control:focus-visible,
    .btn:focus-visible,
    .ms-choice:focus-visible {
        outline: 3px solid #0B57D0;
        outline-offset: 2px;
    }

    @@media (max-width: 1199px) {
        .vendor-col-box,
        .vendor-items-box,
        .vendor-items-col {
            height: auto;
        }

        .vendor-col-box {
            border-right: 0;
