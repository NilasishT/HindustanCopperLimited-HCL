                                        </div>
                                    </div>

                                    <label for="strWebsite1">Website</label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.TextBoxFor(model => model.strWebsite1, null, new { @class = "form-control", autocomplete = "url" })
                                            @Html.ValidationMessageFor(model => model.strWebsite1, "", new { @class = "text-danger" })
                                        </div>
                                    </div>



                                    <label for="strMobile">Mobile<span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.TextBoxFor(model => model.strMobile, null, new { @class = "form-control", autocomplete = "tel" })
                                            @Html.ValidationMessageFor(model => model.strMobile, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <label for="strEmail">E-mail<span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.TextBoxFor(model => model.strEmail, null, new { @class = "form-control", autocomplete = "email" })
                                            @Html.ValidationMessageFor(model => model.strEmail, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </fieldset>

                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="-well bs-component">
                            <div class="form-horizontal vendor-col-box">
                                <fieldset>
                                    <label for="strNameContactPerson">Name of Contact Person<span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.TextBoxFor(model => model.strNameContactPerson, null, new { @class = "form-control", autocomplete = "name" })
                                        </div>
                                    </div>
                                    <label for="strDesignationofContactPerson">Designation of Contact Person<span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.TextBoxFor(model => model.strDesignationofContactPerson, null, new { @class = "form-control", autocomplete = "organization-title" })
                                        </div>
                                    </div>

                                    <label for="strTypeofIndustry">Is your Firm MSME ?<span id="MSME" style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.DropDownList("strTypeofIndustry", new List<SelectListItem> {
                                              new SelectListItem {Text="Yes",Value="MSME"},
                                              new SelectListItem {Text="No",Value="OTHERS"}
                                                                       }, "--- Select ---", new { @id = "strTypeofIndustry", @class = "form-control" })

