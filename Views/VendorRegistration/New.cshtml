                                <div class="form-horizontal">
                                    <fieldset>

                                        <label id="ShowManProvided" for="strIsManpowerSupplier">Manpower Provided<span style="color: #DC3545"><span aria-hidden="true"> (*)</span><span class="sr-only"> (required)</span></span></label>
