@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        alert("@ViewBag.Message");


    </script>
}

<script>
    $(document).ready(function () {
        $('.ms-choice').attr('aria-label', 'Select Type of Items Interested for Supply or service');


        $('#strTypeofIndustry').change(function () {
            var selectedValue = $(this).val();

            if (selectedValue === "MSME") {
                $('#msmeCategorySection').show();
            } else {
                $('#msmeCategorySection').hide();
            }
        });

        if ($('#strTypeofIndustry').val() === "MSME") {
            $('#msmeCategorySection').show();
        }

    });
</script>
<script src="@Url.Content("~/Content/js/VendorNew.js")"></script>
