                                    <div class="form-group">
                                        <div class="col-lg-10">

                                            @Html.TextBoxFor(model => model.strFax, null, new { @class = "form-control", aria_label = "Fax" })
                                            @Html.ValidationMessageFor(model => model.strFax, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <label>
                                        Website
                                    </label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.TextBoxFor(model => model.strWebsite1, null, new { @class = "form-control", aria_label = "Website" })
                                            @Html.ValidationMessageFor(model => model.strWebsite1, "", new { @class = "text-danger" })
                                        </div>
                                    </div>



                                    <label>
                                        Mobile<span style="color: #C00000"> (*)</span>
                                    </label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.TextBoxFor(model => model.strMobile, null, new { @class = "form-control", aria_label = "Mobile" })
                                            @Html.ValidationMessageFor(model => model.strMobile, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <label>
                                        E-mail<span style="color: #C00000"> (*)</span>
                                    </label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.TextBoxFor(model => model.strEmail, null, new { @class = "form-control", aria_label = "E-mail" })
                                            @Html.ValidationMessageFor(model => model.strEmail, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </fieldset>

                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="well bs-component">
                            <div class="form-horizontal" style="border-right: 1px solid #999; height:380px">
                                <fieldset>
                                    <label>
                                        Name of Contact Person<span style="color: #C00000"> (*)</span>
                                    </label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.TextBoxFor(model => model.strNameContactPerson, null, new { @class = "form-control", aria_label = "Name of Contact Person" })
                                        </div>
                                    </div>
                                    <label>
                                        Designation of Contact Person<span style="color: #C00000"> (*)</span>
                                    </label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.TextBoxFor(model => model.strDesignationofContactPerson, null, new { @class = "form-control", aria_label = "Designation of Contact Person" })
                                        </div>
                                    </div>

                                    <label>
                                        Is your Firm MSME ?<span id="MSME" style="color: #C00000"> (*)</span>
                                    </label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.DropDownList("strTypeofIndustry", new List<SelectListItem> {
                                              new SelectListItem {Text="Yes",Value="MSME"},
                                              new SelectListItem {Text="No",Value="OTHERS"}
                                                                       }, "--- Select ---", new { @id = "strTypeofIndustry", @class = "form-control", aria_label = "Is your Firm MSME" })

                                        </div>
                                    </div>
                                    <div id="msmeCategorySection" style="display: none;">
                                        <label id="cast" runat="server" ClientIDMode="Static" for="intfk_CategoryID">
                                            Category of MSME <span style="color: #C00000"> (*)</span>
                                        </label>
                                        <div class="form-group">
                                            <div class="col-lg-10">
                                                @Html.DropDownList("intfk_CategoryID", null, "--- Select ---", new { @class = "form-control", aria_label = "Category of MSME" })<span id="errmsgStatusofMSME"></span>
                                            </div>
                                        </div>
                                    </div>
                                    


                                    <label>
                                        Brief Description of Business of your Company
                                    </label>
                                    <div class="form-group">
                                        <div class="col-lg-10">


                                            @Html.TextAreaFor(model => model.str_companydesc, new { @class = "form-control", aria_label = "Brief Description of Business of your Company" })


                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                    </div>
