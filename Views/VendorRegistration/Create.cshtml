                            @Html.ValidationMessageFor(model => model.strPhone1, "", new { @class = "text-danger" })
                          </div>
                        </div>


                       <label> Fax</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                           @* <input id="txtFax1" type="text" name="strFax1" placeholder="Enter Fax Number" class="form-control">*@
