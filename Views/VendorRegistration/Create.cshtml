                          <div class="col-lg-10">
                             @Html.TextAreaFor(model => model.strstrRegisteredOfficeAddress, new { @class = "form-control"})<span id="errmsg6"></span>
                             
                             <label> <input type="radio" name="SameF" id="SameF" runat="server"/>Same As Correspondence Address </label>
                          </div>
                        </div>



                             


                             <label id="telephoneLabel">STD Code with Phone No.<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                             @Html.TextBoxFor(model => model.strPhone2, null, new { @class = "form-control"})<span id="errmsg7"></span>
                              @Html.ValidationMessageFor(model => model.strPhone2, "", new { @class = "text-danger" })
                          </div>
                        </div>

                            <label>Fax</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                            @Html.TextBoxFor(model => model.strFax1, null, new { @class = "form-control" })<span id="errmsg8"></span>
                            @Html.ValidationMessageFor(model => model.strFax1, "", new { @class = "text-danger" })
                          </div>
                        </div>


