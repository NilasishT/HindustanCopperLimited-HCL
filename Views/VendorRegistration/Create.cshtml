                            @Html.ValidationMessageFor(model => model.strFax, "", new { @class = "text-danger" })
                          </div>
                        </div>


                         <label id="emailLabel"> E-mail<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                              @Html.TextBoxFor(model => model.strEmail1, null, new { @class = "form-control"})<span id="errmsg4"></span><label></label>
                              @Html.ValidationMessageFor(model => model.strEmail1, "", new { @class = "text-danger" })

                          </div>
                        </div>




                         <label> Website</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                              @Html.TextBoxFor(model => model.strWebsite1, null, new { @class = "form-control" })<span id="errmsg5"></span>
                               @Html.ValidationMessageFor(model => model.strWebsite1, "", new { @class = "text-danger" })
                            
                          </div>
                        </div>


                      </fieldset>
                   <!-- </form>-->
                    </div>
                  </div>
                </div>

                <div class="col-lg-3">
