                         <div class="form-group">
                          <div class="col-lg-10">
                            @Html.TextBoxFor(model => model.strEmail2, null, new { @class = "form-control"})<span id="errmsg9"></span><label></label>
                             @Html.ValidationMessageFor(model => model.strEmail2, "", new { @class = "text-danger" })
                          </div>
                        </div>


                            <label> Website</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                             @Html.TextBoxFor(model => model.strWebsite2, null, new { @class = "form-control" })<span id="errmsg10"></span>
                              @Html.ValidationMessageFor(model => model.strWebsite2, "", new { @class = "text-danger" })
                          </div>
                        </div>

                      </fieldset>
                    </div>
                  </div>
                </div>

                <div class="col-lg-3">
                  <div class="well bs-component" style="border-right:1px solid #999">
                   <div class="form-horizontal">
                  <fieldset>                       
                        
                        @* <label>ii) SSI Certificate No.</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                            <input id="txtSSICertificateNO" type="text" name="strSSICertificateNo" placeholder="Enter SSI Certificate No." class="form-control">
                          </div>
                        </div>*@

                         <label>Factory Address</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                             @Html.TextAreaFor(model => model.strFactoryAddress, new { @class = "form-control" })<span id="errmsg11"></span>
                             <label></label>
                          </div>
                        </div>


                           

                            <label>STD Code with Phone No.</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                            @Html.TextBoxFor(model => model.strPhone3, null, new { @class = "form-control" })<span id="errmsg12"></span>                           
                            @Html.ValidationMessageFor(model => model.strPhone3, "", new { @class = "text-danger" })
                            
                          </div>
                        </div>

                            <label>Fax</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                             @Html.TextBoxFor(model => model.strFax2, null, new { @class = "form-control" })<span id="errmsg13"></span>
                             @Html.ValidationMessageFor(model => model.strFax2, "", new { @class = "text-danger" })
                          </div>
                        </div>


