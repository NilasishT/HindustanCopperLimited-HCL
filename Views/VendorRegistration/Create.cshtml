                         <div class="form-group">
                          <div class="col-lg-10">
                            @Html.TextBoxFor(model => model.strNameContactPerson1, null, new { @class = "form-control" })<span id="errmsg14"></span> <label></label>
                          </div>
                          
                        </div>

                             <label>Designation of Contact Person/Factory Manager</label>
                        
                         <div class="form-group">
                          <div class="col-lg-10">
                            @Html.TextBoxFor(model => model.strDesignationofContactPerson1, null, new { @class = "form-control" })<span id="errmsg15"></span>
                          </div>
                        </div>
                       

                       
                         
                           </fieldset>
                    </div>
                  </div>
                </div>

                <div class="col-lg-3">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                  <fieldset>                       
                        
                         <label>Name of Contact Person<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                           @Html.TextBoxFor(model => model.strNameContactPerson, null, new { @class = "form-control"})<span id="errmsg16"></span>
                          </div>
                        </div>


                        <label>Designation of Contact Person<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                              @Html.TextBoxFor(model => model.strDesignationofContactPerson, null, new { @class = "form-control"})<span id="errmsg17"></span>
                          </div>
                        </div>


                          

                           <label>STD Code with Phone No. (Office)<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                            @Html.TextBoxFor(model => model.strPhoneoffice, null, new { @class = "form-control"})<span id="errmsg18"></span>
                            @Html.ValidationMessageFor(model => model.strPhoneoffice, "", new { @class = "text-danger" })
                          </div>
                        </div>

                          <label>STD Code with Phone No. (Residence)</label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                             @Html.TextBoxFor(model => model.strPhoneResidence, null, new { @class = "form-control" })<span id="errmsg19"></span>
                             @Html.ValidationMessageFor(model => model.strPhoneResidence, "", new { @class = "text-danger" })
                          </div>
                        </div>

                           <label>Mobile<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                            @Html.TextBoxFor(model => model.strMobile, null, new { @class = "form-control"})<span id="errmsg20"></span>
                            @Html.ValidationMessageFor(model => model.strMobile, "", new { @class = "text-danger" })
                          </div>
                        </div>

                            <label>E-mail<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                             @Html.TextBoxFor(model => model.strEmail, null, new { @class = "form-control"})<span id="errmsg21"></span>
                             @Html.ValidationMessageFor(model => model.strEmail, "", new { @class = "text-danger" })
                          </div>
                        </div>
                       
                         
                           
                      </fieldset>
                    </div>
                  </div>
                </div>   
               
                <div class="col-lg-12" style="border-top:1px solid #999">
                 
                </div>


                     <div class="col-lg-12" style="padding-top:10px">  


                     <script type="text/javascript">
                         var a = Math.ceil(Math.random() * 10);
                         var b = Math.ceil(Math.random() * 10);
                         var c = a + b
                         function CaptchaRoni() {
                             document.write("What is " + a + " + " + b + "? ");
                             document.write("<input id='CaptchaRoniInput' type='text' maxlength='2' size='2'/>");
                         }
                         function ValidCaptchaRoni() {
                             var d = document.getElementById('CaptchaRoniInput').value;
                             if (d == c) return true;
                             return false;

                         }
                       </script>
                       Are you human?<br />

                       <script type="text/javascript">CaptchaRoni()</script><span id="errmsg22"></span>

                     
                                                            
                    </div>

       <div class="col-lg-12" style="padding-top:10px">
       <div class="form-group">
                          <div class="col-lg-10 col-lg-offset-5">                           
                            <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
                             @*<button type="reset" class="btn btn-default">Cancel</button>*@
                              @Html.ActionLink("Cancel", "Index","Home", null, new { @class = "btn btn-default" })
                          </div>
                        </div>

</div>
              </div>
            </div>
          </div>
        </div>
   
}

 @if (ViewBag.Message != null)
 {
        <script type="text/javascript">            
            alert("@ViewBag.Message");

                
        </script>
    } 




<script src="@Url.Content("~/Content/js/VendorRegistration.js")"></script>
