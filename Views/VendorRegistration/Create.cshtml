@model Hindustancopperlimited.Models.VendorRegistration

@{
    ViewBag.Title = "Vendor Registration Form";
    Layout = "~/Views/Shared/DashboardWithoutSideBar.cshtml";
}


            
@using (Html.BeginForm("Create", "VendorRegistration", FormMethod.Post, new { enctype = "multipart/form-data", id = "VendorRegistration" }))
{
    @Html.AntiForgeryToken()
   <div id="spinner" style="z-index:10; margin-top:100px; position:fixed; margin-left:30%" >
     <p style="vertical-align: middle; text-align:center;">
        <img src="@Url.Content("~/Content/images/please_wait.gif")" alt=""/>
    </p>
</div> 

    <div class="row" style="z-index:1; position:relative">
      <div class="col-md-12" style="text-align:right"><span style="color:Red; font-size:14px; padding-left:70%"> ( * Fields are Mandatory )</span></div>
          <div class="col-md-12">
            <div class="card">

            

             <div class="row">
              <div class="col-lg-4" style="height:250px">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Select the HCL Plant/Unit for which Registration is Applied<span style="color:#C00000"> (*)</span></label><br /><span id="errmsg23"></span>
                         
                         <div class="form-group">
                          <div class="col-lg-8">
                             @Html.ListBox("Fk_intUnitId")
                          @Html.Hidden("hidFk_intUnitId")
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>     
                
                
                <div class="col-lg-2" style="height:250px">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>

                    <label>Status of Company<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-12">
                          @Html.DropDownList("int_fk_CompanyStatusID", null, "Select", new { @class = "form-control"})<span id="errmsg26"></span>
                         
                          </div>
                        </div>


                         <label id="ShowManProvided">Manpower provided<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-6">
                         @Html.DropDownList("ifManpowerSupply", new List<SelectListItem> {
                                              new SelectListItem {Text="Yes",Value="Yes"},
                                              new SelectListItem {Text="No",Value="No"}
                                                                       }, "Select", new { @class = "form-control" })<span id="errmsg24"></span>
                                                                      
                          </div>
                        </div>
                         
                        </fieldset>
                   </div>
                  </div>
                </div>     
                
                
