@model Hindustancopperlimited.Models.VendorLogin

@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/DashboardWithoutSideBar.cshtml";
}

@using (Html.BeginForm())
{
    
    <div class="row">
          <div class="col-md-12"> 
          <div class="col-lg-2">
          </div>       

              <div class="col-lg-2">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Current Password</label>
                        </fieldset>
                   </div>
                  </div>
                </div>              

              <div class="col-lg-7">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>                     
                         
                         <div class="form-group">
                          <div class="col-lg-5">
                            
                           <input id="strUsercurrentPwd" type="password" name="strUsercurrentPwd" class="form-control" required>
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
                </div>

                <div class="col-md-12">
                <div class="col-lg-2">
          </div>
             
              <div class="col-lg-2">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>New Password</label>
                        </fieldset>
                   </div>
                  </div>
                </div>              

              <div class="col-lg-7">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>                     
                         
                         <div class="form-group">
                          <div class="col-lg-5">
                            <input id="strUserPwd" type="password" name="strUserPwd" class="form-control" required>
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>


                
                 </div>

                 <div class="col-md-12">
                 <div class="col-lg-2">
          </div>
              <div class="col-lg-2">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Re-Password</label>
                        </fieldset>
                   </div>
                  </div>
                </div>              

              <div class="col-lg-7">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>                     
                         
                         <div class="form-group">
                          <div class="col-lg-5">
                            <input id="strUserRePwd" type="password" name="strUserRePwd" class="form-control" required>
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
               
                
                 </div>
                 <div class="col-lg-12">
       <div class="form-group">
                          <div class="col-lg-10 col-lg-offset-5">
                            
                            <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
                            @*<button type="reset" class="btn btn-default">Cancel</button>*@
                            @Html.ActionLink("Cancel", "Dashboard","Admin", null, new { @class = "btn btn-default" })
                          </div>
                        </div>

</div>


                </div>
    

}

 @if (ViewBag.Message != null)
 {
        <script type="text/javascript">
            window.onload = function () {
                alert("@ViewBag.Message");

            };
        </script>
    }
