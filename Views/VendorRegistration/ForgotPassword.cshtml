@model Hindustancopperlimited.Models.VendorLogin

@{
    ViewBag.Title = "Forgot Password";
    Layout = null;
}

<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- CSS-->
    <link rel="stylesheet" type="text/css" href="../AdminCssJs/css/main.css?a=1">
    <title>Forgot Password</title>

</head>
<body>
    <section class="material-half-bg">
        <div class="cover"></div>
    </section>
    <section class="login-content">
        <header role="banner" style="text-align:center">
            <a href="@Url.Action("index", "Home")">
                <img src="@Url.Content("~/Content/img/logo.png")" class="img-responsive" alt="Hindustan Copper Limited Logo" />
            </a>
        </header>

        <main role="main">

            <div class="logo" style="background-color: #6F3706; text-align: center;">

                <h1>Forgot Password</h1>
            </div>

            <div class="login-box">
                <h2 class="login-head"><i class="fa fa-lg fa-fw fa-user"></i>Forgot Password</h2>
                <form class="login-form" method="post" autocomplete="off">

                    <div class="form-group">
                        <label class="control-label">VENDOR CODE</label>
                        <input type="text" aria-label="VENDOR CODE" placeholder="Vendor Code" id="forEmail" name="forEmail" autofocus class="form-control">
                    </div>

                    <div class="form-group">
                        <label class="control-label">EMAIL</label>
                        <input type="text" aria-label="EMAIL" placeholder="EMAIL" id="forCONEmail" name="forCONEmail" autofocus class="form-control">
                    </div>

                    <div class="form-group">
                        <label class="control-label">MOBILE NUMBER</label>
                        <input type="text" aria-label="MOBILE NUMBER" placeholder="MOBILE NUMBER" id="MOBILEforEmail" name="MOBILEforEmail" autofocus class="form-control">
                    </div>






                    <div class="form-group btn-container">
                        <button class="btn btn-primary btn-block">Submit <i class="fa fa-sign-in fa-lg"></i></button>



                    </div>
                    <div style="color:Red; text-align:center; font-size:16px">@ViewBag.Message</div>
                </form>

            </div>
        </main>
    </section>
</body>



</html>
<style>
    .login-box .login-head {
        padding-top: 20px !important;
    }
    .login-content .login-box .login-form, .login-content .login-box .forget-form {
        padding-top: 100px;
    }
</style>