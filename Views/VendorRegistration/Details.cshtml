         var end = this.value;
         if (end == 'OTHERS') {
             $("#intfk_CasteID").hide();
             $("#txtlagescaleforOthers").show();
         }
         else {
             $("#intfk_CasteID").show();
             $("#txtlagescaleforOthers").hide();
         }
     });


     $('#strRegistrationApplied').multipleSelect({
         isOpen: true,
         keepOpen: true,
         selectAll: true,
         minimumCountSelected: 1,
         single: false,
         maxHeight: 200
     });


     

   
     $('#SameF').click(function () {
