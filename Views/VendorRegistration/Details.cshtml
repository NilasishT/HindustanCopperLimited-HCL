             var Phone = $("#txtPhone1").val();
             var Fax = $("#txtFax1").val();
             var Email = $("#txtEmail1").val();
             var Website = $("#txtWebsite1").val();

             $("#txtRegisteredAddress").val(CorrespondenceAddress);

             $("#txtSTD2").val(STD);
