@model IEnumerable<Hindustancopperlimited.Models.VendorRegistration>

@{
    ViewBag.Title = "Vendor Profile View";
    Layout = "~/Views/Shared/Dashboard.cshtml";
    //Layout = "~/Views/Shared/Datatable.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{

    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered" >
                  <thead>
                    <tr>
                    <th>Details</th>
                     <th>Status</th>
                   <th>Vendor Code</th>
                      <th>Name of FirmCompany</th>
                      <th>Correspondence Address</th>
                      <th>Registered Office Address</th>
                      <th>Email</th>
                      <th>Mobile</th>
                      
                     @*  <th>Comments</th>*@
                      
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                  @*  <td>@Html.ActionLink("View/Edit", "DataViewDetailsNew", new { id = item.Pk_intNewVendorRegistrationID })</td>*@
                     <td>@Html.ActionLink("View/Edit", "DataViewDetails", new { id = item.Pk_intNewVendorRegistrationID })</td>
                     @if (item.strVerify == "YES")
                     { 
                    <td>Approved</td>
                     }
                    else
                    {
                         <td>Not Approved</td>
                    }
                     <td> @item.strVendorRegistrationID</td>
                       <td>@item.strNameofFirmCompany</td>
                       <td>@item.strCorrespondenceAddress</td>
                        <td>@item.strstrRegisteredOfficeAddress</td>
                        <td>@item.strEmail</td>
                       <td>@item.strMobile</td>
                     
                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
 
   

