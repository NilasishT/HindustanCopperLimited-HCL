                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.TextBoxFor(model => model.strDesignationofContactPerson, null, new { @class = "form-control" })
                                        </div>
                                    </div>
                                   
                                     <label>
                                        Is your Firm MSME ?<span id="MSME" style="color: Red"> (*)</span>
                                    </label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.DropDownList("strTypeofIndustry", new List<SelectListItem> {
                                              new SelectListItem {Text="Yes",Value="MSME"},
                                              new SelectListItem {Text="No",Value="OTHERS"}
                                                                       }, "--- Select ---", new { @class = "form-control"})
                                           
                                        </div>
                                    </div>
                                    <label id="cast" runat="server">
                                       Category of MSME <span style="color: Red"> (*)</span>
                                    </label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.DropDownList("intfk_CategoryID", null, "--- Select ---", new { @class = "form-control" })<span
                                                id="errmsgStatusofMSME"></span> 
                                        </div>
                                    </div>


                                    <label>
                                       Brief Description of Business of your Company</label>    
                                    <div class="form-group">
                                     <div class="col-lg-10">
                                                                 
                                               
                                             @Html.TextAreaFor(model => model.str_companydesc, new { @class = "form-control" })
                                           
                                            
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                    </div>
