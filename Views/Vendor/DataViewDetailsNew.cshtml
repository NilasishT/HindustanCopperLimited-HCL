                                            @Html.Hidden("dtEntryDate")
                                            @Html.Hidden("Pk_intNewVendorRegistrationID")
                                            @Html.Hidden("strVendorRegistrationID")  
                                            @Html.Hidden("hidstrIsManpowerSupplier")
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                           </div>

                             @* Type of firm*@
                 <div class="col-lg-4">
                    <div class="well bs-component">
                            <div class="form-horizontal">
                                <fieldset>
                                    <label>
                                        Type of the Firm<span style="color: Red"> (*)</span></label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.DropDownList("fk_intConstitutionFirmID", null, "--- Select ---", new { @class = "form-control"})
                                        </div>
                                    </div>

                                    </fieldset>
                            </div>
                        </div> 
                        </div>

                       @* Specify*@
