        <div class="col-md-12">      

            <div class="card">
                <div class="row"> 
                    <div class="col-lg-12">
                        <div class="well bs-component" style="text-align: center; padding: 4px; background-color: #a98344;
                            color: #fff; margin: 10px;">
                            <div class="form-horizontal">
                                <fieldset>
                                    <label style="font-size:medium">
                                        GST No. and PAN No. is Mandatory in India.  </label>
                                </fieldset>
                            </div>
                        </div>
                    </div>

                     <div class="col-lg-12">
                       <div class="col-lg-4">
                        <div class="well bs-component">
                            <div class="form-horizontal">
                                <fieldset>
                                    <label>
                                        Name of Firm/ Company<span style="color: Red"> (*)</span></label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            
                                            @Html.TextBoxFor(model => model.strNameofFirmCompany, null, new { @class = "form-control" })
