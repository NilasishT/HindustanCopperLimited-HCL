                                            @Html.ValidationMessageFor(model => model.strWebsite1, "", new { @class = "text-danger" })
                                        </div>
                                    </div>



                                    <label>
                                        Mobile<span style="color: Red"> (*)</span></label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.TextBoxFor(model => model.strMobile, null, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.strMobile, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <label>
                                        E-mail<span style="color: Red"> (*)</span></label>
                                    <div class="form-group">
                                        <div class="col-lg-10">
                                            @Html.TextBoxFor(model => model.strEmail, null, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.strEmail, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </fieldset>
                               
                            </div>
                        </div>
                    </div>
                   
                    <div class="col-lg-3">
                        <div class="well bs-component">
                            <div  class="form-horizontal" style="border-right: 1px solid #999; height:380px">
