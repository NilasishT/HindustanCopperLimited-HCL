                                            @Html.TextBoxFor(model => model.str_company_others, null, new { @class = "form-control" })
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                        </div> 
                        </div>
                      </div>



                      <div class="col-lg-12"> 
                    

                         <div class="col-lg-4">
