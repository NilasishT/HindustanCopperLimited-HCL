                                            @Html.DropDownList("int_fk_CompanyStatusID", null, "--- Select ---", new { @class = "form-control" })
                                        </div>
                                    </div>
                                   
                                </fieldset>
                            </div>
                        </div>
                      </div>
                  
                        @* Type of Service Provide*@
