
@model Hindustancopperlimited.Models.VendorsNew
@{
    ViewBag.Title = "Vendor Registration Form";
    Layout = "~/Views/Shared/DashboardWithoutSideBar.cshtml";
}
@using (Html.BeginForm("DataViewDetailsNew", "Vendor", FormMethod.Post, new { enctype = "multipart/form-data", id = "VendorsNew" }))
{
    @Html.AntiForgeryToken()
