                  @Html.AntiForgeryToken()
                      <fieldset>
                        <legend> Excel File Upload</legend>

                 <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>@Html.LabelFor(model => model.WORKORDERID)<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                          
                             @Html.DropDownList("WORKORDERID", null, "Select", new { @class = "form-control", required="required" })
                             @Html.ValidationMessageFor(model => model.WORKORDERID, "", new { @class = "text-danger" })<br />
                               <button type="submit" id="DownloadtheExcelFile" class="btn btn-primary" name="submit" value="Download the Excel File"> Download the Excel File </button>
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
 

