@model Hindustancopperlimited.Models.CONTRACT_WORKMAN_WAGES
@{
    ViewBag.Title = "ExcelUploadForWorkmanWages";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}


<div class="col-lg-8">
                  <div class="well bs-component">
                 @using (Html.BeginForm("ExcelUploadForWorkmanWages", "Vendor", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
