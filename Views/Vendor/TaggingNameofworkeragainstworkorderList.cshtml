@model IEnumerable<Hindustancopperlimited.Models.vw_CONTRACT_WORKMAN_WORK>

@{
    ViewBag.Title = "Tagging Name of worker against workorderList";
    Layout = "~/Views/Shared/Dashboard.cshtml";
    //Layout = "~/Views/Shared/Datatable.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{
    
    @Html.ActionLink("Tagging Name of worker against workorderList", "TaggingNameofworkeragainstworkorder", null, new { @class = "btn btn-primary" })
    <br />
    <br />
    
    
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered" >
                  <thead>
                    <tr>
                    <th>Delete</th>
                    <th>Edit</th>
                    <th>WORKORDER NO</th>
                    <th>NAME OF THE WORK</th>
                   <th>Name</th>
                   <th>Surname</th>
                   <th>Father's Name</th>
                   <th>START DATE</th>
                   <th>END DATE</th>
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>
                    

                 

                    <td>@Html.ActionLink("Delete", "TaggingNameofworkeragainstworkorderDelete", "Vendor", new { id = item.ID }, new { id = item.ID, onclick = "return confirm('Are you sure you want to click this link?')" })</td>  
                    <td>@Html.ActionLink("Edit", "TaggingNameofworkeragainstworkorderEdit", new { id = item.ID })</td>                      
                    <td> @item.WORKORDERNO</td>
                    <td> @item.NAMEOFTHEWORK</td>
                     <td> @item.NAME</td>
                      <td> @item.SURNAME</td>
                       <td> @item.FATHERNAME</td>
                      <td> @item.STARTDATE.Value.ToString("dd-MMM-yyyy")</td>
                      <td> @item.ENDDATE.Value.ToString("dd-MMM-yyyy")</td>                        
                     
                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>


<script>
    function DeleteConfirm() {
        if (confirm("Are you sure want to delete record"))
            return true;
        else
            return false;
    }
</script>