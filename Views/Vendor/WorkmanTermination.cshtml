@model Hindustancopperlimited.Models.CONTRACT_WORKMAN_DETAILS
@{
    ViewBag.Title = "Workman Termination";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}

<div class="col-lg-8">
                  <div class="well bs-component">
                 @using (Html.BeginForm("WorkmanTermination", "Vendor", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
                 {
                  @Html.AntiForgeryToken()
                      <fieldset>
                        <legend> Workman Termination<span style="color:Red; font-size:14px; padding-left:40%"> ( * Fields are Mandatory )</span></legend>

                         <div class="row">
          <div class="col-md-12">
            <div class="card">
             <div class="row">
            <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>@Html.LabelFor(model => model.NAME)<span style="color:Red"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                          
                             @Html.TextBoxFor(model => model.NAME, null, new { @class = "form-control", disabled = "disabled" })
                              @Html.ValidationMessageFor(model => model.NAME, "", new { @class = "text-danger" })
                              @Html.HiddenFor(model => model.ID)
                              @Html.HiddenFor(model => model.CREATIONTIME)
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
             <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>@Html.LabelFor(model => model.SURNAME)<span style="color:Red"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                            
                             @Html.TextBoxFor(model => model.SURNAME, null, new { @class = "form-control", disabled = "disabled" })
                              @Html.ValidationMessageFor(model => model.SURNAME, "", new { @class = "text-danger" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
             <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>@Html.LabelFor(model => model.DATEOFBIRTH)<span style="color:Red"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                          
                             @Html.TextBoxFor(model => model.DATEOFBIRTH, null, new { @class = "date form-control", disabled = "disabled" })
                              @Html.ValidationMessageFor(model => model.DATEOFBIRTH, "", new { @class = "text-danger" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>

             <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>@Html.LabelFor(model => model.DATEOFTERMINATION)<span style="color:Red"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                            
                          @Html.TextBoxFor(model => model.DATEOFTERMINATION, null, new { @class = "date form-control", required = "required" })
                              @Html.ValidationMessageFor(model => model.DATEOFTERMINATION, "", new { @class = "text-danger" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>

                <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>@Html.LabelFor(model => model.REASONS)<span style="color:Red"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                            
                          @Html.TextAreaFor(model => model.REASONS, new { @class = "form-control", required = "required", id = "REASONS" })<span id="errmsg"></span>
                              @Html.ValidationMessageFor(model => model.REASONS, "", new { @class = "text-danger" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
           

             </div>
             </div>
             </div>
             </div>

               <div class="form-group">
                          <div class="col-lg-10 col-lg-offset-4">
                           
                         
                            <button type="submit" name="btnAction" value="Termination" class="btn btn-danger">Terminated</button>
                             <button type="submit" name="btnAction" value="Non-Terminating" class="btn btn-primary"style="background-color:green;color:#fff;">Not-Terminated</button>
                             @*<button type="reset" class="btn btn-default">Cancel</button>*@
                             @Html.ActionLink("Cancel", "WorkmanListforTermination", null, new { @class = "btn btn-default" })
                          </div>
                        </div>
             </fieldset>


                 }
                
                  </div>
                </div>
 @if (ViewBag.Message != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                alert("@ViewBag.Message");
                window.location.href = '/Vendor/WorkmanListforTermination';

            };
        </script>
    }
<script>
    
    
    $("#REASONS").on("input", function () {
        LimtCharacters(this, 150, 'errmsg');
    });
    function LimtCharacters(txtMsg, CharLength, errmsg) {
        chars = txtMsg.value.length;
        if (chars > CharLength) {
            txtMsg.value = txtMsg.value.substring(0, CharLength);
            $("#" + errmsg).html("Max Length reached..").show().fadeOut("slow").css("color", "red");
        }
    }



    $("#REASONS").keyup(function () {
        if (this.value.length == 0) {
            $("#errmsg").html('This field is required').show().css("color", "red");
            return false;
        }
        else {
            $("#errmsg").html('');
            return true;
        }
    });
</script>