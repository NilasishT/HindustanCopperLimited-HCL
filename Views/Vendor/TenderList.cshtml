@model IEnumerable<Hindustancopperlimited.Models.tbl_mst_tender>

@{
    ViewBag.Title = "Tender List";
    Layout = "~/Views/Shared/Dashboard.cshtml";
    //Layout = "~/Views/Shared/Datatable.cshtml";
}



                <div class="col-lg-12">
                  <div class="well bs-component">

@using (Html.BeginForm())
{
    
    <fieldset>
   <div>
        
        <div class="row" >
          <div class="col-md-18">
            <div class="card">
              <div class="card-body">
                <table id="sampleTable" class="table table-hover table-bordered" >
                  <thead>
                    <tr>
                 
                  <th>Enquiry No.</th>
                  <th>Enquiry Date</th>
                  <th>Enquiry Title</th>
                   <th>	Closing Date/Time</th>
                   <th> Cost of Tender Document</th>
                   <th> EMD (Rs.) </th>
                    <th>Document</th>
                    </tr>
                  </thead>
                 <tbody>

            @foreach (var item in Model)
            {
                    <tr>                 
                     
                     <td> @item.strEnquiryNo</td>
                     <td> @item.dtEnquiryDate.Value.ToString("dd/MMM/yyyy")</td>
                      <td> @item.strEnquiryTitle</td>
                        <td> @item.dtClosingDate</td>
                        <td> @item.numCostofTender</td>
                        <td> @item.numEarnestMoney</td>
                      <td><a href=@item.strFilePath.Replace("~", "../..") target="_blank">Download</a></td>
                    </tr>

            }
                    
            
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      </fieldset>
	
}
</div>
</div>
