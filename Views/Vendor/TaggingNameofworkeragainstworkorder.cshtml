@model Hindustancopperlimited.Models.CONTRACT_WORKMAN_WORK
@{
    ViewBag.Title = "Tagging Name of Worker against Work Order";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}

<div class="col-lg-12">
                  <div class="well bs-component">
                 @using (Html.BeginForm("TaggingNameofworkeragainstworkorder", "Vendor", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
                 {
                  @Html.AntiForgeryToken()
                      <fieldset>
                        <legend> Tagging Name of Worker against Work Order<span style="color:Red; font-size:14px; padding-left:40%"> ( * Fields are Mandatory )</span></legend>

                         <div class="row">
          <div class="col-md-12">
            <div class="card" style="height:400px">
             <div class="row">

             <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Start Date<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10" style="z-index:1111111111111">
                          @Html.TextBoxFor(model => model.STARTDATE, null, new { @class = "date form-control", required = "required" })
                            
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>


                <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>End Date<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10" style="z-index:1111111111111">
                         @Html.TextBoxFor(model => model.ENDDATE, null, new { @class = "date form-control", required = "required" })
                            
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>


            <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Work Order No.<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                          @Html.DropDownList("WorkorderNo", null, "Select", new { @class = "form-control", required = "required" })
                            
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
             
              <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>Workman Name<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                          @Html.ListBox("WorkmanName")
                             @Html.Hidden("hidWorkmanName")
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
           

             </div>
             </div>
             </div>
             </div>

               <div class="form-group">
                          <div class="col-lg-10 col-lg-offset-4">
                           
                            <button type="submit" class="btn btn-primary" onclick="return error()">Submit</button>
                             @*<button type="reset" class="btn btn-default">Cancel</button>*@
                             @Html.ActionLink("Cancel", "TaggingNameofworkeragainstworkorderList", null, new { @class = "btn btn-default" })
                          </div>
                        </div>
             </fieldset>


                 }
                
                  </div>
                </div>
                 @if (ViewBag.Message != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var aa = "@ViewBag.Message";
                alert(aa);
                if (aa == "Data saved Successfully.") {
                    window.location.href = '/Vendor/TaggingNameofworkeragainstworkorderList';
                }
                

            };


        </script>
    }
