@model Hindustancopperlimited.Models.CONTRACT_WORKMAN_DETAILS
@{
    ViewBag.Title = "Photo Upload";
    Layout = "~/Views/Shared/Dashboard.cshtml";
}

<div class="col-lg-12">
                  <div class="well bs-component">
                 @using (Html.BeginForm("PhotoUpload", "Vendor", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
                 {
                  @Html.AntiForgeryToken()
                      <fieldset>
                        <legend> Photo Upload<span style="color:Red; font-size:14px; padding-left:70%"> ( * Fields are Mandatory )</span></legend>

                         <div class="row">
          <div class="col-md-12">
            <div class="card">
             <div class="row">
            <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>@Html.LabelFor(model => model.NAME)<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                          
                             @Html.TextBoxFor(model => model.NAME, null, new { @class = "form-control", disabled = "disabled" })
                              @Html.ValidationMessageFor(model => model.NAME, "", new { @class = "text-danger" })
                              @Html.HiddenFor(model => model.ID)
                              @Html.HiddenFor(model => model.CREATIONTIME)
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
             <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>@Html.LabelFor(model => model.SURNAME)<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                            
                             @Html.TextBoxFor(model => model.SURNAME, null, new { @class = "form-control", disabled = "disabled" })
                              @Html.ValidationMessageFor(model => model.SURNAME, "", new { @class = "text-danger" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>
             <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>@Html.LabelFor(model => model.DATEOFBIRTH)<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">
                          
                             @Html.TextBoxFor(model => model.DATEOFBIRTH, null, new { @class = "date form-control", disabled = "disabled" })
                              @Html.ValidationMessageFor(model => model.DATEOFBIRTH, "", new { @class = "text-danger" })
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>

             <div class="col-lg-4">
                  <div class="well bs-component">
                   <div class="form-horizontal">
                    <fieldset>
                         <label>@Html.LabelFor(model => model.PHOTO)<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-10">                            
                            <input type="file" name="PHOTO" id="PHOTO" onchange="readURL(this);" required   />
                            @*shoumya*@
                            
                                     <img id="blah" src="#" alt="your image" />
                              
                          </div>
                        </div>
                        </fieldset>
                   </div>
                  </div>
                </div>

           

             </div>
             </div>
             </div>
             </div>

               <div class="form-group">
                          <div class="col-lg-10 col-lg-offset-4">
                           
                            <button type="submit" class="btn btn-primary">Submit</button>
                             @*<button type="reset" class="btn btn-default">Cancel</button>*@
                             @Html.ActionLink("Cancel", "WorkmanDetailsforUploadingPhoto", null, new { @class = "btn btn-default" })
                          </div>
                        </div>
             </fieldset>


                 }
                
                  </div>
                </div>
                 @if (ViewBag.Message != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                alert("@ViewBag.Message");

                window.location.href = '/Vendor/WorkmanDetailsforUploadingPhoto';

            };
        </script>
    }
    
    <script>
        
        $('input[type="file"]').change(function (e) {
            var extension = $(this).val().replace(/^.*\./, '');

            if (extension.toLowerCase() == 'jpg' || extension.toLowerCase() == 'png') {
                var size = this.files[0].size / 1048576;
                if (parseFloat(size) <= 10) {
                }
                else {
                    alert('Please check file Size');
                    $(this).val('');
                }

            }
            else {
                alert('Please Upload only .jpg or .png file');
                $(this).val('');
            }


        })

        function readURL(input) {

            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $('#blah')
                        .attr('src', e.target.result)
                        .width(100)
                        .height(100);
                };

                reader.readAsDataURL(input.files[0]);
            }
        }
        
    </script>