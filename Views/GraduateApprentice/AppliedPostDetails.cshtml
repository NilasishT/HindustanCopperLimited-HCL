 @model Hindustancopperlimited.Models.tbl_mst_GraduateApprenticeAppliedPostDetails

@{
    ViewBag.Title = "Applied Post Details";
    Layout = "~/Views/Shared/ITIDashboard.cshtml";
}

<style>
    
.white
{
    color:#4d070f;
    padding-right:10px;
    padding-left:10px;
}
.white:hover
{
    color:White;
}

</style>

            
@using (Html.BeginForm("AppliedPostDetails", "GraduateApprentice", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
   
    @Html.AntiForgeryToken()   

    <div class="row" style="z-index:1; position:relative"> 
          <div class="col-md-12">          
            <div class="card">
            <div class="row">
             <div class="col-md-12" style="text-align:right">
             <span style="color:Red; font-size:14px; padding-left:65%"> (*) Fields are Mandatory </span>
             </div>

             <div class="col-lg-12">
                  <div class="well bs-component" style="text-align:center; padding:4px;  color:#6f3706; margin:8px; border:solid 1px #6f3706">
                   <div class="form-horizontal">
                    <fieldset>
                          <label style="font-size:medium"><b>Applied Trade Details</b></label>
                        </fieldset>
                   </div>
                  </div>
                </div>   

           <div class="col-lg-12">
           <div class="well bs-component" style="text-align:center">
                    
                    <div class="form-horizontal">
                    <fieldset>
                          <label class="col-lg-5 control-label">Unit<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-4">                       
                                  @Html.DropDownList("fk_unitId", null,"Select", new { @class = "form-control" })
                                 </div>
                                 </div>
                            </fieldset>
                          </div>


                   <div class="form-horizontal">
                    <fieldset>
                          <label class="col-lg-5 control-label">Application for Apprenticeship Training in the Trade<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-4"> 
                                 @Html.DropDownList("strTradeName",null, new { @class = "form-control" })
                                 </div>
                                 </div>
                            </fieldset>
                          </div>

                    
                    
                        </div>
                        </div>  


              

                 <div class="col-lg-12" style="border-top:1px solid #6f3706">                 
                </div>    

                 <div class="col-lg-12" style="padding-top:10px">
       <div class="form-group">
                          <div class="col-lg-10 col-lg-offset-5">                    
                            <button type="submit" class="btn btn-primary" onclick="return error()" value="Submit" name="strSubmit" id="Submit">Save & Next</button>
                            <button type="button" class="btn btn-primary" onclick="location.href = '../Dashboard/@Url.RequestContext.RouteData.Values["id"]';" value="Submit" name="strSubmit">Dashboard</button>
                          </div>
                        </div>

</div>

                 </div>
            </div>
          </div>
        </div>
    
    
    
    
   
}

@if (ViewBag.Message != null)
{
        <script type="text/javascript">
            window.onload = function () {
                var aa = "@ViewBag.Message";
                alert(aa);
            };
        </script>
}

<script>

    //ERROR
    function error() {
        var noerror = 1;

        if ($("#fk_unitId").val() == "") {
            $("#fk_unitId").next("span").remove();
            $("#fk_unitId").after("<span style='color:Red'> This field is required</span>");
            noerror = 0;
        }

        if ($("#strTradeName").val() == "") {
            $("#strTradeName").next("span").remove();
            $("#strTradeName").after("<span style='color:Red'> This field is required</span>");
            noerror = 0;
        }

        if (noerror == 1) {
            if (confirm("Are you sure ?")) {

                if ($('#tbl_mst_Order')[0].checkValidity()) {
                    return true;
                }
            }
            else {
                return false;
            }

        }


        if (noerror == 0) {
            return false;



        }
    }


    $("#fk_unitId").change(function () {
        var fk_unitId = $("#fk_unitId").val();

        if (fk_unitId == "") {
            alert("Please Select Unit.");
        }
        
        else {
            $.ajax({
                type: 'POST',
                dataType: 'json',
                url: '/GraduateApprentice/FillPost',
                data: { 'unitId': fk_unitId },
                success: function (result) {
                    $('#strTradeName').empty();
                    if (result.PostList.length > 0) {
                        $('#strTradeName').append($('<option/>').attr('value', " ").text("Select"));
                        $.each(result.PostList, function (result) {
                            $('#strTradeName').append($('<option/>').attr('value', this.strPostName).text(this.strPostName));
                        });
                    }
                }
            });
        }
    });

</script>