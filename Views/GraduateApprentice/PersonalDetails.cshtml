 @model Hindustancopperlimited.Models.tbl_mst_GraduateApprenticeCandidatePersonalDetails

@{
    ViewBag.Title = "Personal Details";
    Layout = "~/Views/Shared/ITIDashboard.cshtml";
}

<style>
    
.white
{
    color:#4d070f;
    padding-right:10px;
    padding-left:10px;
}
.white:hover
{
    color:White;
}

</style>

            
@using (Html.BeginForm("PersonalDetails", "GraduateApprentice", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
   
    @Html.AntiForgeryToken()   

    <div class="row" style="z-index:1; position:relative"> 
          <div class="col-md-12">          
            <div class="card">
            <div class="row">
             <div class="col-md-12" style="text-align:right">
             <span style="color:Red; font-size:14px; padding-left:65%"> (*) Fields are Mandatory </span>
             </div>

           


              <div class="col-lg-12">
                  <div class="well bs-component" style="text-align:center; padding:4px;  color:#6f3706; margin:8px; border:solid 1px #6f3706">
                   <div class="form-horizontal">
                    <fieldset>
                          <label style="font-size:medium"><b>Personal Information</b></label>
                        </fieldset>
                   </div>
                  </div>
                </div>    
              
                <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal" style="border-right:1px solid #6f3706">
                      <fieldset>
                       <label class="col-lg-4 control-label">Applicant Name<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                            @Html.TextBox("strApplicantName", null, new { @class = "form-control", @readonly = "readonly" })
                            
                          </div>
                        </div>


                         <label class="col-lg-4 control-label"> Date of Birth<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-6">
                              @Html.TextBox("dtDOB", null, new { @class = "form-control", @readonly = "readonly" })
                          </div>
                        </div>

                         <label class="col-lg-4 control-label"> Father's Full Name</label>
                         <div class="form-group">
                          <div class="col-lg-6">
                              @Html.TextBox("strFatherName", null, new { @class = "form-control" })
                          </div>
                        </div>


                        <label class="col-lg-4 control-label"> Mother's Full Name</label>
                         <div class="form-group">
                          <div class="col-lg-6">
                              @Html.TextBox("strMotherName", null, new { @class = "form-control" })
                          </div>
                        </div>


                         <label class="col-lg-4 control-label"> Spouse Full Name</label>
                         <div class="form-group">
                          <div class="col-lg-6">
                              @Html.TextBox("strSpouseName", null, new { @class = "form-control" })
                          </div>
                        </div>


                        <label class="col-lg-4 control-label">Email ID<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                            @Html.TextBox("strEmail", null, new { @class = "form-control", @readonly = "readonly" })
                          </div>
                        </div>

                          <label class="col-lg-4 control-label">Alternate Email ID</label>
                         <div class="form-group">
                          <div class="col-lg-6">
                            @Html.TextBox("strAlternate_EmaiID", null, new { @class = "form-control"})
                          </div>
                        </div>


                        <label class="col-lg-4 control-label">Nationality<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextBoxFor(model => model.strNationality, null, new { @Value = "Indian", @class = "form-control" })
                          </div>
                        </div>

                          <label class="col-lg-4 control-label"> Gender<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.DropDownList("strGender", null, "Select", new { @class = "form-control" })
                          </div>
                        </div>
                        
                        <label class="col-lg-4 control-label">Aadhar No.<span style="color:#C00000"></span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.strAadharNo, new { @class = "form-control" })
                          </div>
                        </div>



                        <label class="col-lg-4 control-label">PAN No.<span style="color:#C00000"> </span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.strPANNo, new { @class = "form-control" })
                             
                             
                          </div>
                        </div>

                         <label class="col-lg-4 control-label"> Marital Status<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6" style="padding-top:1%">
                             @Html.DropDownList("strMaritalStatus", new List<SelectListItem> {
                                              new SelectListItem {Text="Unmarried",Value="Unmarried"},
                                              new SelectListItem {Text="Married",Value="Married"},
                                              new SelectListItem {Text="Widow",Value="Widow"},
                                                new SelectListItem {Text="Widower",Value="Widower"}
                                                                       }, "Select", new { @class = "form-control" })
                              
                          </div>
                        </div>
                                           
                         
                      </fieldset>
                    </div>
                  </div>
                </div>

                <div class="col-lg-6">
                   <div class="form-horizontal">
                  <fieldset>
                         <label class="col-lg-4 control-label">Category<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                              @Html.DropDownList("strCategory", null, "Select", new { @class = "form-control" })
                          </div>
                        </div>

                         <label class="col-lg-4 control-label" >Sub-Caste<span style="color:#C00000" id="lblsubcaste"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextBoxFor(model => model.strsubcaste, new { @class = "form-control" })
                          </div>
                        </div>

                        <label class="col-lg-4 control-label">Certificate No.<span style="color:#C00000" id="lblcertificateno"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextBoxFor(model => model.strcertificateno, new { @class = "form-control" })
                          </div>
                        </div>

                        <label class="col-lg-4 control-label">Certificate Issue Date<span style="color:#C00000" id="lblissuedate"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextBoxFor(model => model.dt_certificateissuedate, null, new { @class = "form-control input-append date", @placeholder = "dd-mm-yyyy" })
                          </div>
                        </div>

                        <label class="col-lg-4 control-label">Issuing Authority Details,Name of the Post& Place<span style="color:#C00000" id="lblcertificateissue"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextAreaFor(model => model.strcertificateissue, new { @class = "form-control" })
                            
                          </div>
                        </div>


                         <label class="col-lg-4 control-label">PWD (40% or more Disability) <span style="color:#C00000" > (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6" style="padding-top:1%">
                             @Html.DropDownList("strPWD", new List<SelectListItem> {
                                              new SelectListItem {Text="Yes",Value="Yes"},
                                              new SelectListItem {Text="No",Value="No"}
                                                                       }, "Select", new { @class = "form-control" })
                            
                          </div>
                        </div>
                        
                           <label class="col-lg-4 control-label">Type of Disability<span style="color:#C00000" id="lbltypeofdisable"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.DropDownList("strtypeofdisable", null, "Select", new { @class = "form-control" })
                          </div>
                        </div>

                        <label class="col-lg-4 control-label">Certificate No.<span style="color:#C00000" id="lblcertificateno1"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextBoxFor(model => model.strcertificateno1, new { @class = "form-control" })
                          </div>
                        </div>

                        <label class="col-lg-4 control-label">Certificate Issue Date<span style="color:#C00000" id="lblcertificateissuedate1"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextBoxFor(model => model.dt_certificateissuedate1, null, new { @class = "form-control input-append date", @placeholder = "dd-mm-yyyy" })
                            
                          </div>
                        </div>

                        <label class="col-lg-4 control-label">Issuing Authority Details,Name of the Post& Place<span style="color:#C00000" id="lblcertificateissue1"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextAreaFor(model => model.strcertificateissue1, new { @class = "form-control" })
                            
                          </div>
                        </div>
                         <label class="col-lg-4 control-label">Apprenticeship Registration No:<span style="color:#C00000" id="lblApprenticeship"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextBoxFor(model => model.strApprenticeshipRegNo, new { @class = "form-control" })
                            
                          </div>
                        </div>

                         
                      </fieldset>
                    </div>
                </div>


                <div class="col-lg-12">
                   <div class="well bs-component" style="text-align:center; padding:4px;  color:#6f3706; margin:8px; border:solid 1px #6f3706">
                   <div class="form-horizontal">
                    <fieldset>
                          <label style="font-size:medium"><b>Address Details</b> </label>
                        </fieldset>
                   </div>
                  </div>
                </div>  
                 <div class="col-lg-6">
                  <div class="well bs-component">
                   <div class="form-horizontal" style="border-right:1px solid #6f3706">
                      <fieldset>
                           <label class="col-lg-4 control-label">Correspondence Address<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextAreaFor(model => model.strCorrespondenceAddress, new { @class = "form-control" })
                            
                          </div>
                        </div>


                       <label class="col-lg-4 control-label">State<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                              @Html.DropDownList("strState", null, "Select", new { @class = "form-control" })
                           
                          </div>
                        </div>


                         <label class="col-lg-4 control-label"> District<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                              @Html.TextBoxFor(model => model.strDistrict, null, new { @class = "form-control" })
                             
                          </div>
                        </div>

                         <label class="col-lg-4 control-label">Nearest Post Office</label>
                         <div class="form-group">
                          <div class="col-lg-6">
                              @Html.TextBoxFor(model => model.strNearestPostOffice, null, new { @class = "form-control" })
                          </div>
                        </div>
                        <label class="col-lg-4 control-label">Nearest Police Station</label>
                         
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextBoxFor(model => model.strNearestPoliceStation, new { @class = "form-control" })
                          </div>
                        </div>
                        <label class="col-lg-4 control-label">Nearest Railway Station<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextBoxFor(model => model.strNearestRailwaystation, null, new { @class = "form-control" })
                          </div>
                        </div>

                         <label class="col-lg-4 control-label">Pin<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.strPin, null, new { @class = "form-control" })
                            
                          </div>
                        </div>

                            <label class="col-lg-4 control-label">Telephone No.(With STD Code)</label>
                         <div class="form-group">
                          <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.strTelephone, null, new { @class = "form-control" })
                          </div>
                        </div>

                        <label class="col-lg-4 control-label">Mobile No.</label>
                         <div class="form-group">
                          <div class="col-lg-6">
                            @Html.TextBox("strMobileNo",null, new { @class = "form-control" })
                           
                          </div>
                        </div>
                      </fieldset>
                    </div>
                  </div>
                </div>
                
                <div class="col-lg-6">
                   <div class="form-horizontal">
                  <fieldset>
                         <label class="col-lg-4 control-label">Permanent Address<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextAreaFor(model => model.strPermanentAddress, new { @class = "form-control" })
                             <label> <input type="radio" name="SameF" id="SameF" runat="server"/>Same As Correspondence Address </label>
                          </div>
                        </div>

                       <label class="col-lg-4 control-label">State<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.DropDownList("strPermanentState", null, "Select", new { @class = "form-control" })
                            
                          </div>
                        </div>

                         <label class="col-lg-4 control-label"> District<span style="color:#C00000"> (*)</span></label>
                         <div class="form-group">
                          <div class="col-lg-6">
                              @Html.TextBoxFor(model => model.strPermanentDistrict, null, new { @class = "form-control" })
                            
                          </div>
                        </div>

                         <label class="col-lg-4 control-label">Nearest Post Office</label>
                         <div class="form-group">
                          <div class="col-lg-6">
                              @Html.TextBoxFor(model => model.strPermanentNearestPostOffice, null, new { @class = "form-control" })
                              
                          </div>
                        </div>
                        <label class="col-lg-4 control-label">Nearest Police Station</label>
                         
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextBoxFor(model => model.strPermanentNearestPoliceStation, new { @class = "form-control" })
                             
                             
                          </div>
                        </div>
                        <label class="col-lg-4 control-label">Nearest Railway Station<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-6">
                             @Html.TextBoxFor(model => model.strPermanentNearestRailwayStation, null, new { @class = "form-control" })
                             
                          </div>
                        </div>
                         <label class="col-lg-4 control-label">Pin<span style="color:#C00000"> (*)</span></label>
                         
                         <div class="form-group">
                          <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.strPermanentPinCode, null, new { @class = "form-control" })
                            
                          </div>
                        </div>
                            <label class="col-lg-4 control-label">Telephone No.(With STD Code)</label>
                         
                         <div class="form-group">
                          <div class="col-lg-6">
                            @Html.TextBoxFor(model => model.strPermanentTelephoneNo, null, new { @class = "form-control" })
                           
                          </div>
                        </div>
                        <label class="col-lg-4 control-label">Mobile No.</label>
                         
                         <div class="form-group">
                          <div class="col-lg-6">
                            @Html.TextBox("strPermanentMobile1", null, new { @class = "form-control" })
                            
                          </div>
                        </div>
                      </fieldset>
                    </div>
                </div>

                 <div class="col-lg-12" style="border-top:1px solid #6f3706">                 
                </div>    

                 <div class="col-lg-12" style="padding-top:10px">
       <div class="form-group">
                          <div class="col-lg-10 col-lg-offset-5">                    
                            <button type="submit" class="btn btn-primary" onclick="return error()" value="Submit" name="strSubmit" id="Submit">Save & Next</button>
                            <button type="button" class="btn btn-primary" onclick="location.href = '../Dashboard/@Url.RequestContext.RouteData.Values["id"]';" value="Submit" name="strSubmit">Dashboard</button>
                          </div>
                        </div>

</div>

                 </div>
            </div>
          </div>
        </div>
   
}

@if (ViewBag.Message != null)
{
        <script type="text/javascript">
            window.onload = function () {
                var aa = "@ViewBag.Message";
                alert(aa);
            };
        </script>
}
    
<script src="@Url.Content("~/Content/js/GraduateApprenticePersonalDetails.js?a=bhashkarghosjh011")"></script>