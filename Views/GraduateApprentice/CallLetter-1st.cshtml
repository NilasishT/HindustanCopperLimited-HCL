@{
    ViewBag.Title = "Call Letter";
}

<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN">
<html lang="en">
<HEAD>
	<META HTTP-EQUIV="CONTENT-TYPE" CONTENT="text/html; charset=utf-8">
	<TITLE>Call Letter</TITLE>
	<META NAME="GENERATOR" CONTENT="LibreOffice 4.1.6.2 (Linux)">
	<META NAME="AUTHOR" CONTENT="Susanta">
	<META NAME="CREATED" CONTENT="20200118;84100000000000">
	<META NAME="CHANGEDBY" CONTENT="Susanta">
	<META NAME="CHANGED" CONTENT="20200118;91100000000000">
	<META NAME="AppVersion" CONTENT="12.0000">
	<META NAME="DocSecurity" CONTENT="0">
	<META NAME="HyperlinksChanged" CONTENT="false">
	<META NAME="LinksUpToDate" CONTENT="false">
	<META NAME="ScaleCrop" CONTENT="false">
	<META NAME="ShareDoc" CONTENT="false">
	<STYLE TYPE="text/css">
	
	</STYLE>
</HEAD>
<BODY LANG="en-US" DIR="LTR">
<center>
<TABLE WIDTH=90%; CELLPADDING=7 CELLSPACING=0 STYLE="page-break-before: always">
	<COL WIDTH=15%>
	<COL WIDTH=25%>
	<COL WIDTH=30%>
	<COL WIDTH=30%;>
	<TR VALIGN=TOP>
		<TD WIDTH=73 STYLE="border-top: 1px solid #000001;border-left: 1px solid #000001;border-right: 1px solid #000001; padding-top: 0in; padding-bottom: 0in; padding-left: 0.08in; padding-right: 0.08in">
			<P ALIGN=CENTER><img style="width:50%; padding-top:10px;" src="@Url.Content("~/Content/img/logo.png")" alt="logo"/></P>
		</TD>
		<TD COLSPAN=3 WIDTH=571 STYLE="border-top: 1px solid #000001;border-right: 1px solid #000001; padding-top: 0in; padding-bottom: 0in; padding-left: 0.08in; padding-right: 0.08in">
			<P ALIGN=CENTER STYLE="margin-top: 0.08in; margin-bottom: 0"><FONT FACE="ArialNarrow-Bold, serif"><B>Hindustan
			Copper Limited</B></FONT></P>
			<P ALIGN=CENTER STYLE="margin-bottom: 0in; margin-top:0; padding-top: 0"><FONT FACE="ArialNarrow, serif">(A
			Govt. of India Enterprise)<br/>Tamra Bhawan, <br/>1, Ashutosh
			Chowdhury Avenue, Kolkata – 700019</FONT></P>
		</TD>
	</TR>
	<TR>
		<TD COLSPAN=4 WIDTH=658 VALIGN=TOP STYLE="border-top: 1px solid #000001;border-left: 1px solid #000001;border-right: 1px solid #000001; padding-top: 0in; padding-bottom: 0in; padding-left: 0.08in; padding-right: 0.08in">
			<P STYLE="margin-top: 0.04in; margin-bottom: 0.04in; text-align:center; font-weight:bold"><FONT FACE="Arial, serif">Call
			letter for Document Verification for engagement as Graduate
			Apprentices Training</FONT></P>
            <P STYLE="margin-top: 0.04in; margin-bottom: 0.04in; text-align:center; font-weight:bold"><FONT FACE="Arial, serif">Acknowledgement No.: @ViewBag.AcknowledgementNo</FONT></P>
            <P STYLE="margin-top: 0.04in; margin-bottom: 0.04in; text-align:center; font-weight:bold"><FONT FACE="Arial, serif">Trade: @ViewBag.Trade</FONT></P>

			
			
		</TD>
	</TR>
	<TR>
		<TD ROWSPAN=2 COLSPAN=3 VALIGN=TOP STYLE="border-top: 1px solid #000001;border-left: 1px solid #000001; border-right:none !important; padding-top: 0in; padding-bottom: 0in; padding-left: 0.08in; padding-right: 0.08in">
			<P STYLE="margin-bottom: 0in; line-height: 100%; padding-top:6px;"><FONT FACE="Arial, serif">To , <br/><br/> <span style="padding-left:20px"> @ViewBag.Name </span><br/>
			<span style="padding-left:20px"> @ViewBag.Address ,</span><br />
            <span style="padding-left:20px"> @ViewBag.District ,</span><br />
            <span style="padding-left:20px"> @ViewBag.State ,</span><br />
            <span style="padding-left:20px"> @ViewBag.Pin </span><br />
            
            </FONT></P>
		</TD>
		
		<TD STYLE="border-top: 1px solid #000001;border-right: 1px solid #000001;border-left: 1px solid #000001; padding-top: 0in; padding-bottom: 0in; padding-left: 0.0in; padding-right: 0.0in">			
			<P ALIGN=CENTER STYLE="margin-bottom: 0in; line-height: 100%"><FONT FACE="Arial, serif"><img src="@ViewBag.Photo"  width="80"/> </FONT></P>			
			<P ALIGN=CENTER STYLE="margin-bottom: 0in; line-height: 100%"><img src="@ViewBag.Signature" width="200" /></P>
		</TD>
	</TR>
    <tr></tr>
	


	<TR>
		<TD COLSPAN=4 WIDTH=658 HEIGHT=200 VALIGN=TOP STYLE="border: 1px solid #000001; padding-top: 0; padding-bottom: 0in; padding-left: 0.08in; padding-right: 0.08in">
			<P STYLE="margin-bottom: 0in; padding-top: 5px; line-height: 100%"><FONT FACE="Arial, serif">Sir
			/ Madam,</FONT></P>
			<OL>
				<LI><P ALIGN=JUSTIFY STYLE="margin-bottom: 0in; line-height: 100%">
				<FONT FACE="Arial, serif">We are pleased to inform you that you
				have been provisionally shortlisted for document verification
				(Merit List drawn in the ratio </FONT><FONT FACE="Arial, serif">of
				two candidates for every seat, subject to minimum of three
				candidates per seat in each category where the number of seat is
				one), as per shortlisting criteria detailed in the HCL
				advertisement No. HCL/HR/Graduate Apprentices/2019-20 dated
				11/11/2019. The final selection list will be drawn on the basis
				of marks obtained in the qualifying exam, after verification of
				original documents relating to educational qualification, Caste
				Certificate, etc., of shortlisted candidates.</FONT></P>
				<LI><P STYLE="margin-bottom: 0in; line-height: 100%"><FONT FACE="Arial, serif">Accordingly,
				you are hereby advised to appear for document verification, as
				per scheduled given below:<br/><br /></FONT><FONT FACE="Arial, serif"><B>Date:
				30/01/2020			<br /><br />	Reporting Time: 09.00 AM – 10.00 AM</B></FONT></P>
			</OL>
			<P ALIGN=JUSTIFY STYLE="margin-left: 0.25in; margin-bottom: 0in; margin-left:0.45in; line-height: 100%; font-family:Arial, serif ; font-weight:bold">
			<FONT FACE="Arial, serif"><B>Venue:</B></FONT>
			Hindustan Copper Limited,  <p style="padding-left: 6.2em;font-family:Arial, serif ; font-weight:bold; padding-top:0; margin-top:0">@ViewBag.Venue </p></FONT></P>
			
			
			<OL START=3>
				<LI><P ALIGN=JUSTIFY STYLE="margin-bottom: 0in; line-height: 100%">
				<FONT FACE="Arial, serif">For document verification, you are
				required to bring the following documents in Original together
				with 3 (three) sets of self attested photocopy for verification
				arranged in order given below.</FONT></P>
			</OL>
			<OL  TYPE=i STYLE="margin-left: 0.3in; font-family:Arial, Helvetica, sans-serif;">
				<LI><P STYLE="margin-bottom: 0in; line-height: 100%;"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">Copy
				of the call letter for Document Verification.</SPAN></FONT></P>
				<LI><P STYLE="margin-bottom: 0in; line-height: 100%"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">Systems
				generated copy of Acknowledgement generated after submission of
				the Online Application Form.</SPAN></FONT></P>
				<LI><P STYLE="margin-bottom: 0in; line-height: 100%"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">Systems
				generated copy of online Application filled up by you.</SPAN></FONT></P>
				<LI><P STYLE="margin-bottom: 0in; line-height: 100%"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">Proof
				of enrolment / registration on NATS web portal
				(www.mhrdnats.gov.in).</SPAN></FONT></P>
				<LI><P STYLE="margin-bottom: 0in; line-height: 100%"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">Copy
				of Secondary School Certificate (SSC/10th) and Mark-sheet.</SPAN></FONT></P>
				<LI><P STYLE="margin-bottom: 0in; line-height: 100%"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">Copy
				of Higher Secondary School Certificate (HSC/12th) and Mark-sheet.</SPAN></FONT></P>

				<LI><P STYLE="margin-bottom: 0in; line-height: 100%"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">Copy
				of Engineering Diploma Certificate and Mark-sheet (All Semester),
				if applicable.</SPAN></FONT></P>
				<LI><P STYLE="margin-bottom: 0in; line-height: 100%"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">Copy
				of Graduate Degree Certificate and Mark-sheets (All Semester).</SPAN></FONT></P>
				<LI><P STYLE="margin-bottom: 0in; line-height: 100%"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">Disability
				/ Discharge Certificate (if applicable)</SPAN></FONT></P>
				<LI><P STYLE="margin-bottom: 0in; line-height: 100%"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">SC
				/ ST / OBC / EWS Certificate (if applicable)</SPAN></FONT></P>
				<LI><P STYLE="margin-bottom: 0in; line-height: 100%"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">Photo
				Identification Card (Aadhar / Voters / Driving License / PAN /
				Passport)</SPAN></FONT></P>
				<LI><P STYLE="margin-bottom: 0in; line-height: 100%"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">Passport
				Size Photo [2 (two) nos.]</SPAN></FONT></P>
			</OL>
			<OL START=4>
				<LI><P ALIGN=JUSTIFY STYLE="margin-bottom: 0in; line-height: 100%">
				<FONT FACE="Arial, serif">General:</FONT></P>
			</OL>
			<OL TYPE=i style=" margin-left:0.25in; font-family:Arial, Helvetica, sans-serif;">
				<LI><P STYLE="line-height: 100%"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">You
				are advised to reach the above venue well in time.</SPAN></FONT></P>
				<LI><P ALIGN=JUSTIFY STYLE="line-height: 100%; font-weight:bold"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">Mere
				invitation to attend the process of Document Verification does
				not confer any right / claim for engagement as Graduate
				Apprentices Trainee in </SPAN>Hindustan
				Copper Limited<SPAN LANG="en-GB">.</SPAN></FONT></P>
				<LI><P ALIGN=JUSTIFY STYLE="line-height: 100%"><FONT FACE="Arial, serif">You
				should note that the details provided in your on-line application
				are taken on their face value and the onus of proving the
				correctness and authenticity of the same as and when required,
				lies with you.</FONT></P>
				<LI><P ALIGN=JUSTIFY STYLE="line-height: 100% ; font-weight:bold"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">You
				are therefore advised in your own interest to check, confirm and
				ensure that you meet the prescribed eligibility criteria for the
				trade applied by you as detailed in the advertisement before
				presenting yourself for the Document Verification.</SPAN><SPAN LANG="en-GB"></SPAN></FONT></P>
			</OL>
			<P ALIGN=JUSTIFY STYLE="margin-left: 0.65in; line-height: 100%; font-weight:bold"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">You
			must also ensure that all requisite documents and copies thereof
			as detailed above are made available for submission and
			verification at the venue.</SPAN></FONT></P>
			<P ALIGN=JUSTIFY STYLE="margin-left: 0.65in; line-height: 100%; font-weight:bold"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">Please note that failure on any of these counts shall render you
			ineligible and no communication shall be entertained by the
			Company in this regard.</SPAN></FONT></P>
			<OL TYPE=i START=5 style=" margin-left:0.25in; font-family:Arial, Helvetica, sans-serif;">
				<LI><P ALIGN=JUSTIFY STYLE="line-height: 100% ; font-weight:bold"><FONT FACE="Arial, serif"><SPAN LANG="en-GB">Your
				short-listing call for the Document Verification is based on the
				facts / statements made by you in your online application. If the
				details are found to be materially wrong or incorrect or
				misleading, your candidature shall be liable to be cancelled at
				any stage of the process.</SPAN></FONT></P>
				<LI><P ALIGN=JUSTIFY STYLE="line-height: 100%"><FONT FACE="Arial, serif">No
				TA / DA will be paid to the applicants called for any stage of
				engagement process.</FONT></FONT></P>
			</OL>
		</TD>
	</TR>
</TABLE>
</center>
<P STYLE="margin-bottom: 0.14in"><BR><BR>
</P>
</BODY>
</HTML>